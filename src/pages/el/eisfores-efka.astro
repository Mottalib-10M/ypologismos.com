---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { salary, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney } from '../../lib/format';
import { EFKA_DETAIL as D } from '../../lib/mini-extra-b';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const $2 = (x: number) => formatMoney(x, 2, lang);
const p = F.pct;
const E = P.efka;
const r4 = (x: number) => Math.round(x * 10000) / 10000;
const grosses = [P.minimum_wage.monthly, 1200, 1500, 2000, 3000, 5000, E.ceiling_monthly, 10000];
const rows = grosses.map((g) => { const s = salary({ gross: g }); const base = Math.min(g, E.ceiling_monthly); return [$(g), $2(s.efka), $2(base * E.employee_health), $2(s.employer), $2(s.efka + s.employer), $(s.cost)]; });
const ex = salary({ gross: 1500 });
const exHealth = Math.min(1500, E.ceiling_monthly) * E.employee_health;
const maxEe = E.ceiling_monthly * E.employee_rate, maxEr = E.ceiling_monthly * E.employer_rate;
const before = { ee: r4(E.employee_rate + D.cut2025), er: r4(E.employer_rate + D.cut2025) };
const gain1500 = 1500 * D.cut2025 * 14;
// Πόσο φόρο «επιστρέφει» η αφαίρεση των εισφορών (οριακός συντελεστής).
const ex2 = salary({ gross: 2000 });
const taxSaved = ex2.efkaAnnual * ex2.marginal;
const halfMin = salary({ gross: P.minimum_wage.monthly / 2 }), fullMin = salary({ gross: P.minimum_wage.monthly });
const yearTotal = ex.efkaAnnual + ex.employerAnnual;
const heavy = { ee: 1500 * D.kpk105.ee, er: 1500 * D.kpk105.er };
const faqs = [
  { q: `Πόσες εισφορές κρατούνται από μισθό ${$(1500)} μικτά;`, a: `${$2(ex.efka)} τον μήνα, δηλαδή ${F.efkaEe} του μικτού για υπάλληλο ιδιωτικού τομέα με ΚΠΚ ${F.kpk}. Από αυτά, ${$2(exHealth)} πηγαίνουν στην υγειονομική περίθαλψη. Σε 14 καταβολές οι εισφορές του εργαζομένου φτάνουν τα ${$(ex.efkaAnnual)} τον χρόνο. Ο εργοδότης πληρώνει επιπλέον ${$2(ex.employer)} τον μήνα, που δεν φαίνονται στα καθαρά αλλά ανεβάζουν το κόστος της θέσης στα ${$(ex.cost)}.` },
  { q: 'Πόσο μειώθηκαν οι εισφορές το 2025;', a: `Κατά ${p(D.cut2025)} για τον εργαζόμενο και ${p(D.cut2025)} για τον εργοδότη, από 1η Ιανουαρίου 2025. Η μείωση έγινε στον κλάδο υγειονομικής περίθαλψης (παροχές σε είδος), με το άρθρο 12 του ν. 5162/2024, και η εγκύκλιος 38/2024 του e-ΕΦΚΑ την εφάρμοσε. Ο ΚΠΚ ${F.kpk} πέρασε από ${p(before.ee)} σε ${F.efkaEe} για τον εργαζόμενο και από ${p(before.er)} σε ${F.efkaEr} για τον εργοδότη. Τα ποσοστά δεν άλλαξαν το ${F.year}.` },
  { q: 'Οι εισφορές κρατούνται και από το δώρο Χριστουγέννων;', a: `Ναι. Η εγκύκλιος του e-ΕΦΚΑ εφαρμόζει τα ποσοστά «επί των πάσης φύσεως αποδοχών», άρα και στα δώρα Χριστουγέννων και Πάσχα και στο επίδομα αδείας, με το ίδιο ${F.efkaEe} για τον εργαζόμενο και ${F.efkaEr} για τον εργοδότη. Ένα δώρο ίσο με μισθό ${$(1500)} έχει έτσι ${$2(ex.efka)} κράτηση, όσο και ο μηνιαίος μισθός, και αυτός είναι ένας από τους λόγους που το καθαρό δώρο φαίνεται μικρότερο από το αναμενόμενο.` },
  { q: 'Γιατί ο συνάδελφός μου στα βαρέα πληρώνει περισσότερες εισφορές;', a: `Επειδή ασφαλίζεται με άλλον κωδικό πακέτου κάλυψης. Για τα βαρέα και ανθυγιεινά επαγγέλματα με επικουρική ΙΚΑ-ΤΕΑΜ, ο ΚΠΚ ${D.kpk105.kpk} έχει ${p(D.kpk105.ee)} για τον εργαζόμενο και ${p(D.kpk105.er)} για τον εργοδότη. Σε μισθό ${$(1500)}, αυτό σημαίνει ${$2(heavy.ee)} κράτηση τον μήνα αντί για ${$2(ex.efka)}. Ο κωδικός τον ορίζει το είδος της δουλειάς, όχι η επιλογή του εργαζομένου ή του εργοδότη.` },
  { q: 'Οι εισφορές μειώνουν τον φόρο που πληρώνω;', a: `Ναι, έμμεσα. Ο φόρος υπολογίζεται στο φορολογητέο, δηλαδή στο μικτό μείον τις εισφορές του εργαζομένου. Με μικτά ${$(2000)} τον μήνα, οι ετήσιες εισφορές σας είναι ${$(ex2.efkaAnnual)}· επειδή αφαιρούνται πριν από την κλίμακα, ο φόρος σας είναι μικρότερος κατά περίπου ${$(taxSaved)} σε σχέση με το αν φορολογούνταν όλο το μικτό, με οριακό συντελεστή ${p(ex2.marginal)}.` },
];
---
<GuideLayout lang={lang} id="efka" breadcrumbLabel={label('efka', lang)}
  title={`Εισφορές ΕΦΚΑ ${F.year}: ${F.efkaEe} εργαζόμενος, ${F.efkaEr} εργοδότης`}
  h1={`Εισφορές ΕΦΚΑ ${F.year}: πόσα κρατούνται από τον μισθό σας`}
  description={`Εισφορές ΕΦΚΑ ${F.year} για μισθωτούς: ${F.efkaEe} ο εργαζόμενος και ${F.efkaEr} ο εργοδότης (ΚΠΚ ${F.kpk}), πλαφόν ${F.ceiling}, μείωση του 2025 και πίνακας κρατήσεων ανά μισθό.`}
  intro={`Οι εισφορές του e-ΕΦΚΑ για τους μισθωτούς του ιδιωτικού τομέα είναι ${F.efkaEe} για τον εργαζόμενο και ${F.efkaEr} για τον εργοδότη το ${F.year}.`}
  resume={`Για τον μισθωτό του ιδιωτικού τομέα με τον γενικό κωδικό πακέτου κάλυψης ΚΠΚ ${F.kpk}, οι εισφορές e-ΕΦΚΑ το ${F.year} είναι ${F.efkaEe} του μικτού μισθού για τον εργαζόμενο και ${F.efkaEr} για τον εργοδότη, συνολικά ${F.efkaTotal}. Από το μερίδιο του εργαζομένου, ${F.efkaHealthEe} είναι για την υγειονομική περίθαλψη (${p(D.eeKind)} για παροχές σε είδος και ${p(D.eeCash)} σε χρήμα), ενώ ο εργοδότης πληρώνει ${F.efkaHealthEr} για τον ίδιο κλάδο. Τα ποσοστά ισχύουν από 1η Ιανουαρίου 2025, όταν η εισφορά υγείας μειώθηκε κατά ${p(D.cut2025)} για κάθε πλευρά, και δεν άλλαξαν το ${F.year}. Οι εισφορές υπολογίζονται μέχρι το ανώτατο όριο των ${F.ceiling} τον μήνα. Σε μισθό ${$(1500)} μικτά, ο εργαζόμενος πληρώνει ${$2(ex.efka)} τον μήνα και ο εργοδότης ${$2(ex.employer)}, και το κόστος της θέσης φτάνει τα ${$(ex.cost)}. Οι εισφορές αφαιρούνται από το μικτό πριν από τον υπολογισμό του φόρου. Ο υπολογιστής δίνει τις δικές σας εισφορές.`}
  faqs={faqs}
  related={[{ href: route('ceiling', lang), name: label('ceiling', lang), description: `Το όριο των ${F.ceiling} και ποιους αφορά.` }, { href: route('employer', lang), name: label('employer', lang), description: 'Το πλήρες κόστος μιας θέσης εργασίας.' }, { href: route('home', lang), name: label('home', lang), description: 'Καθαρά από τον μικτό, με εισφορές και φόρο.' }]}
  sources={[src('efka_rates', lang), src('efka_ceiling', lang), src('tax_scale', lang)]}>
  <div data-chrome><MiniSim client:load kind="efka" lang={lang} href={route('employer', lang)} /></div>

  <h2>Κρατήσεις και εργοδοτικές εισφορές ανά μισθό</h2>
  <ContentTable headers={['Μικτά τον μήνα', 'Εργαζόμενος', 'εκ των οποίων υγεία', 'Εργοδότης', 'Σύνολο προς e-ΕΦΚΑ', 'Κόστος θέσης']} align={['l', 'r', 'r', 'r', 'r', 'r']} rows={rows} highlightRow={2} />
  <p>Τα ποσά είναι ανά καταβολή και αφορούν τον ΚΠΚ {F.kpk}, που καλύπτει τη γενική περίπτωση του υπαλλήλου ιδιωτικού τομέα με κύρια σύνταξη, επικουρική και υγεία. Στις δύο τελευταίες γραμμές φαίνεται το πλαφόν: με μικτά {$2(E.ceiling_monthly)} ή περισσότερα, οι εισφορές σταματούν να αυξάνονται, στα {$2(maxEe)} για τον εργαζόμενο και στα {$2(maxEr)} για τον εργοδότη.</p>

  <h2>Τι πληρώνει ο καθένας και για ποιο σκοπό</h2>
  <p>Η μόνη κατανομή ανά κλάδο που δημοσιεύει η εγκύκλιος 38/2024 μαζί με τα ποσοστά αφορά την υγεία. Η εισφορά υγειονομικής περίθαλψης είναι συνολικά {p(D.eeKind + D.erKind + D.eeCash + D.erCash)}: {p(D.eeKind + D.erKind)} για παροχές σε είδος, όπως γιατρούς, φάρμακα και νοσηλεία, από τα οποία {p(D.eeKind)} βαρύνει τον εργαζόμενο και {p(D.erKind)} τον εργοδότη, και {p(D.eeCash + D.erCash)} για παροχές σε χρήμα, όπως το επίδομα ασθενείας, με {p(D.eeCash)} από τον εργαζόμενο και {p(D.erCash)} από τον εργοδότη.</p>
  <p>Το υπόλοιπο του {F.efkaEe} του εργαζομένου, δηλαδή {p(r4(E.employee_rate - E.employee_health))}, χρηματοδοτεί τους άλλους κλάδους του πακέτου, ανάμεσά τους την κύρια σύνταξη και την επικουρική του ΙΚΑ-ΤΕΑΜ. Η ακριβής κατανομή ανά κλάδο βρίσκεται στο αρχείο excel των ενεργών ΚΠΚ που αναρτά ο e-ΕΦΚΑ. Το ότι η επικουρική περιλαμβάνεται φαίνεται από τη σύγκριση με τον ΚΠΚ {D.kpk103.kpk}, χωρίς κάλυψη ΙΚΑ-ΤΕΑΜ, που έχει {p(D.kpk103.ee)} για τον εργαζόμενο και {p(D.kpk103.er)} για τον εργοδότη.</p>

  <div data-chrome><MiniSim client:load kind="efkasplit" lang={lang} href={route('employer', lang)} /></div>

  <h2>Ο κωδικός πακέτου κάλυψης</h2>
  <p>Κάθε εργαζόμενος δηλώνεται στον e-ΕΦΚΑ με έναν κωδικό πακέτου κάλυψης (ΚΠΚ), που ορίζει σε ποιους κλάδους ασφαλίζεται και με ποια ποσοστά. Ο {F.kpk} είναι ο γενικός κωδικός του ιδιωτικού τομέα. Η εγκύκλιος 38/2024 απαριθμεί δεκάδες ενεργούς κωδικούς, γιατί άλλα ποσοστά ισχύουν για τα βαρέα επαγγέλματα, άλλα για όσους δεν έχουν επικουρική στο ΙΚΑ-ΤΕΑΜ και άλλα για ειδικές κατηγορίες. Για τα βαρέα και ανθυγιεινά με ΙΚΑ-ΤΕΑΜ, ο ΚΠΚ {D.kpk105.kpk} φτάνει τα {p(D.kpk105.ee)} για τον εργαζόμενο και {p(D.kpk105.er)} για τον εργοδότη.</p>
  <p>Ο κωδικός σας φαίνεται στα στοιχεία ασφάλισης που δηλώνει ο εργοδότης. Αν τα ποσοστά στο εκκαθαριστικό δεν είναι {F.efkaEe} και δεν κάνετε βαριά εργασία, ρωτήστε με ποιον ΚΠΚ είστε ασφαλισμένοι: ο υπολογιστής μας εφαρμόζει τον {F.kpk}.</p>

  <h2>Εισφορές στη μερική απασχόληση και στον κατώτατο</h2>
  <p>Οι εισφορές ακολουθούν τον μισθό. Με τον κατώτατο μισθό των {F.minWage}, ο εργαζόμενος πληρώνει {$2(fullMin.efka)} τον μήνα· με μισό ωράριο και {$(P.minimum_wage.monthly / 2)} μικτά, πληρώνει {$2(halfMin.efka)}. Σε ετήσια βάση, για μισθό {$(1500)} με 14 καταβολές, εργαζόμενος και εργοδότης στέλνουν μαζί {$(yearTotal)} στον e-ΕΦΚΑ, ποσό που αντιστοιχεί σε {F.dec(yearTotal / 1500, 1)} μηνιαίους μικτούς μισθούς.</p>

  <h2>Η μείωση του 2025 σε ευρώ</h2>
  <p>Από τον Ιανουάριο 2025 η εισφορά υγείας για παροχές σε είδος μειώθηκε κατά {p(D.cut2025)} για τον εργαζόμενο και κατά {p(D.cut2025)} για τον εργοδότη. Η μείωση αφορά όλους όσοι απασχολούνται με σχέση ιδιωτικού δικαίου, στον ιδιωτικό αλλά και στον δημόσιο τομέα (ΙΔΑΧ και ΙΔΟΧ). Σε μισθό {$(1500)} με 14 καταβολές, ο εργαζόμενος κρατά {$(gain1500)} περισσότερα τον χρόνο πριν από τον φόρο, και ο εργοδότης γλιτώνει άλλα τόσα. Το {F.year} τα ποσοστά έμειναν ίδια· άλλαξε μόνο το πλαφόν, που αναπροσαρμόστηκε με βάση τον δείκτη τιμών καταναλωτή του 2025.</p>

  <h2>Το ανώτατο όριο ασφαλιστέων αποδοχών</h2>
  <p>Οι εισφορές υπολογίζονται μόνο έως {F.ceiling} τον μήνα, ποσό που ισχύει από 1η Ιανουαρίου {F.year} σύμφωνα με την εγκύκλιο 4/2026. Ό,τι υπερβαίνει το όριο δεν επιβαρύνεται με εισφορές, ούτε για τον εργαζόμενο ούτε για τον εργοδότη. Αφορά λίγους μισθωτούς, αλλά για αυτούς η διαφορά είναι σημαντική: με μικτά {$(10000)}, η κράτηση μένει στα {$2(maxEe)} αντί για {$2(10000 * E.employee_rate)}. Ο οδηγός για το <a href={route('ceiling', lang)}>πλαφόν εισφορών</a> δείχνει από ποιο μισθό και πάνω αρχίζει να μετράει.</p>

  <h2>Εισφορές, φόρος και καθαρά</h2>
  <p>Ένα πλήρες παράδειγμα δείχνει πόσο βαραίνουν οι εισφορές μέσα στις συνολικές κρατήσεις. Από μικτά {$(2000)} τον μήνα, ο e-ΕΦΚΑ παίρνει {$2(ex2.efka)} και ο φόρος {$2(ex2.tax)} ανά καταβολή, οπότε μένουν {$2(ex2.net)} καθαρά. Οι εισφορές είναι δηλαδή η μεγαλύτερη κράτηση σε αυτό το επίπεδο μισθού, μεγαλύτερη από τον φόρο. Μόνο σε υψηλότερους μισθούς ο φόρος τις ξεπερνά, επειδή η κλίμακα είναι προοδευτική ενώ οι εισφορές έχουν σταθερό ποσοστό.</p>
  <p>Η σειρά στη μισθοδοσία είναι πάντα η ίδια. Πρώτα αφαιρούνται οι εισφορές του εργαζομένου από το μικτό, και στο υπόλοιπο, το φορολογητέο, υπολογίζεται ο φόρος. Γι' αυτό οι εισφορές «κοστίζουν» λιγότερο από όσο δείχνει το ποσοστό τους: κάθε ευρώ εισφοράς μειώνει τον φόρο κατά τον οριακό σας συντελεστή. Σε μισθό {$(2000)}, η εξοικονόμηση φόρου από τις εισφορές είναι περίπου {$(taxSaved)} τον χρόνο.</p>
  <p>Οι εργοδοτικές εισφορές δεν περνούν από τον μισθό σας, αλλά καθορίζουν πόσο κοστίζει η θέση. Σε κάθε {$(100)} μικτών, ο εργοδότης πληρώνει άλλα {$2(100 * E.employer_rate)} στον e-ΕΦΚΑ. Για να δείτε το συνολικό κόστος για οποιονδήποτε μισθό, χρησιμοποιήστε τον υπολογιστή <a href={route('employer', lang)}>κόστους εργοδότη</a>. Όσοι ψάχνουν «εισφορες εφκα 2026» θα βρουν τα ίδια ποσοστά στα επίσημα έγγραφα του e-ΕΦΚΑ, που παραθέτουμε στις πηγές· ο <a href={route('home', lang)}>υπολογισμός μισθού</a> τα εφαρμόζει αυτόματα.</p>
</GuideLayout>
