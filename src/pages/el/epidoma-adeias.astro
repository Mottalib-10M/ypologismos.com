---
import ToolCalc from '../../components/calc/ToolCalc';
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { leaveAllowance, bonusNet, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const M = P.minimum_wage;
const ex = 1500;
const full = leaveAllowance({ pay: ex });
const fullNet = bonusNet(full.amount, { gross: ex });
const minA = leaveAllowance({ pay: M.monthly });
const minNet = bonusNet(minA.amount, { gross: M.monthly });
const dailyA = leaveAllowance({ pay: M.daily, daily: true });
const five = leaveAllowance({ pay: ex, months: 5 });
const rows = [M.monthly, 1200, 1500, 1900, 2400, 3000].map((g) => [$(g), ...[3, 6, 9, 12].map((m) => $(leaveAllowance({ pay: g, months: m }).amount)), $(bonusNet(leaveAllowance({ pay: g }).amount, { gross: g }).net)]);
const faqs = [
  { q: 'Πότε πληρώνεται το επίδομα αδείας: τον Ιούλιο ή όταν πάρω την άδεια;', a: `Όταν πάρετε την άδεια. Το α.ν. 539/1945 (άρθρο 3 παρ. 8) ορίζει ότι το επίδομα καταβάλλεται στην αρχή της άδειας, μαζί με τις αποδοχές αδείας. Δεν υπάρχει μία ημερομηνία για όλους, όπως στα δώρα. Αν βγείτε σε άδεια τον Οκτώβριο, το επίδομα οφείλεται τον Οκτώβριο. Για μισθό ${$(ex)} το πλήρες επίδομα είναι ${$(full.amount)} μικτά.` },
  { q: 'Είναι πάντα μισός μισθός το επίδομα αδείας;', a: `Όχι, ο μισός μισθός είναι το ανώτατο. Το επίδομα ισούται με τις αποδοχές της άδειας που δικαιούστε, αλλά δεν μπορεί να ξεπεράσει τον μισό μηνιαίο μισθό ή τα ${F.leaveDaily} ημερομίσθια. Όποιος έχει πλήρες δικαίωμα άδειας φτάνει στο ανώτατο, δηλαδή ${$(minA.amount)} στον κατώτατο μισθό. Όποιος έχει δουλέψει λίγους μήνες δικαιούται λιγότερες ημέρες, άρα και μικρότερο επίδομα.` },
  { q: 'Φεύγω από τη δουλειά χωρίς να έχω πάρει άδεια. Τι γίνεται με το επίδομα;', a: `Ο ν. 1346/1983 προβλέπει ότι η άδεια που δεν χορηγήθηκε πληρώνεται κατά τη λύση της σύμβασης, μαζί με το αντίστοιχο επίδομα αδείας. Το ποσό μπαίνει στην τελική εκκαθάριση, είτε παραιτηθείτε είτε απολυθείτε. Για πέντε μήνες εργασίας με ${$(ex)} μικτά, η εκτίμησή μας για το επίδομα είναι ${$(five.amount)}.` },
  { q: 'Πληρώνομαι με ημερομίσθιο. Πόσο είναι το δικό μου επίδομα;', a: `Το ανώτατο για τους ημερομίσθιους είναι ${F.leaveDaily} ημερομίσθια, όχι μισός μήνας. Με το κατώτατο ημερομίσθιο των ${F.minDaily} αυτό κάνει ${$(dailyA.amount)} μικτά, λίγο πάνω από τον μισό κατώτατο μηνιαίο μισθό. Στον υπολογιστή επιλέξτε «Ημερομίσθιο» και βάλτε το ποσό της ημέρας.` },
  { q: 'Φορολογείται το επίδομα αδείας;', a: `Ναι, όπως ο μισθός: κρατούνται ${F.efkaEe} εισφορές e-ΕΦΚΑ και φόρος εισοδήματος. Ο υπολογιστής εφαρμόζει τον μέσο φορολογικό συντελεστή του έτους σας. Για ${$(ex)} μικτά, από επίδομα ${$(full.amount)} μένουν περίπου ${$(fullNet.net)} καθαρά, ενώ στον κατώτατο μισθό περίπου ${$(minNet.net)}.` },
];
---
<GuideLayout lang={lang} id="leave" breadcrumbLabel={label('leave', lang)}
  title={`Επίδομα αδείας ${F.year}: έως μισός μισθός, πότε και πόσο`}
  h1={`Επίδομα αδείας ${F.year}: πόσο δικαιούστε και πότε πληρώνεται`}
  description={`Επίδομα αδείας ${F.year}: έως μισός μισθός ή ${F.leaveDaily} ημερομίσθια, πληρωμή στην αρχή της άδειας, πληρωμή και στη λύση της σύμβασης. Υπολογιστής μικτού και καθαρού.`}
  intro={`Το επίδομα αδείας είναι η τρίτη έξτρα καταβολή του έτους: έως μισός μηνιαίος μισθός ή ${F.leaveDaily} ημερομίσθια, που πληρώνεται όταν βγαίνετε σε άδεια.`}
  resume={`Το επίδομα αδείας ισούται με τις αποδοχές της ετήσιας άδειας που δικαιούστε, με ανώτατο όριο τον μισό μηνιαίο μισθό για όσους αμείβονται με μισθό και τα ${F.leaveDaily} ημερομίσθια για όσους αμείβονται με ημερομίσθιο. Ένας εργαζόμενος με πλήρες δικαίωμα άδειας και μισθό ${$(ex)} μικτά παίρνει ${$(full.amount)} μικτά, δηλαδή περίπου ${$(fullNet.net)} καθαρά μετά τις εισφορές e-ΕΦΚΑ και τον φόρο. Στον κατώτατο μισθό των ${F.minWage} το επίδομα είναι ${$(minA.amount)} μικτά και στο κατώτατο ημερομίσθιο ${$(dailyA.amount)}. Σε αντίθεση με τα δώρα, δεν έχει σταθερή ημερομηνία: σύμφωνα με το α.ν. 539/1945 καταβάλλεται στην αρχή της άδειας. Όποιος αποχωρεί χωρίς να έχει εξαντλήσει την άδειά του πληρώνεται την άδεια και το επίδομα με την τελική εκκαθάριση. Ο υπολογιστής μας εκτιμά το επίδομα αναλογικά με τους μήνες εργασίας στο έτος, μια προσέγγιση που εξηγούμε παρακάτω.`}
  faqs={faqs}
  related={[{ href: route('christmas', lang), name: label('christmas', lang), description: 'Το μεγαλύτερο από τα δύο δώρα, έως 21 Δεκεμβρίου.' }, { href: route('fourteen', lang), name: label('fourteen', lang), description: 'Γιατί ο μισθός πληρώνεται 14 φορές.' }, { href: route('home', lang), name: label('home', lang), description: 'Ο βασικός υπολογισμός καθαρών αποδοχών.' }]}
  sources={[src('hli_bonuses', lang), src('efka_rates', lang), src('tax_scale', lang)]}>
  <div data-outil><ToolCalc client:load kind="leave" lang={lang} methodHref={route('method', lang)} /></div>

  <h2>Επίδομα και αποδοχές αδείας: δύο διαφορετικά ποσά</h2>
  <p>Στην άδεια πληρώνεστε κανονικά τον μισθό των ημερών που λείπετε: αυτές είναι οι αποδοχές αδείας. Το επίδομα αδείας είναι κάτι επιπλέον, ένα ποσό που προστίθεται για να καλύψει το κόστος των διακοπών. Ο νόμος το συνδέει με τις αποδοχές αδείας, δηλαδή είναι ίσο με αυτές, αλλά βάζει ταβάνι: μισός μισθός ή {F.leaveDaily} ημερομίσθια. Στην πράξη, όποιος έχει πλήρες δικαίωμα άδειας φτάνει πάντα στο ταβάνι, και γι' αυτό συνήθως λέμε απλώς «μισός μισθός».</p>
  <p>Το εργαλείο ζητά μισθό ή ημερομίσθιο, τους μήνες εργασίας στο τρέχον έτος, ηλικία και παιδιά. Δίνει το μικτό επίδομα, το ανώτατο όριο, τις κρατήσεις και το καθαρό.</p>

  <h2>Επίδομα αδείας ανά μισθό και μήνες εργασίας</h2>
  <ContentTable headers={['Μικτός μισθός', '3 μήνες', '6 μήνες', '9 μήνες', '12 μήνες', 'Καθαρό (12 μήνες)']} align={['l', 'r', 'r', 'r', 'r', 'r']} rows={rows} highlightRow={2} />
  <p>Τα ποσά των στηλών 3, 6 και 9 μηνών είναι αναλογικά: το πλήρες επίδομα επί τους μήνες εργασίας διά δώδεκα. Η τελευταία στήλη αφορά εργαζόμενο άνω των 30 ετών χωρίς παιδιά.</p>

  <h2>Γιατί η αναλογία ανά μήνα είναι προσέγγιση</h2>
  <p>Το επίδομα ακολουθεί τις ημέρες άδειας που δικαιούστε, και οι ημέρες άδειας κατά τον πρώτο χρόνο εργασίας χτίζονται σταδιακά, με κανόνες που εξαρτώνται από τον χρόνο υπηρεσίας. Ο υπολογιστής δεν μετράει ημέρες άδειας· μοιράζει το ανώτατο ποσό στους μήνες. Για όποιον δουλεύει όλο τον χρόνο το αποτέλεσμα είναι ακριβές, γιατί το ποσό φτάνει στο ταβάνι. Για όποιον έχει λίγους μήνες, είναι μια καλή εκτίμηση αλλά όχι ο λογαριασμός του λογιστηρίου. Αν έχετε την καταμέτρηση των ημερών, εμπιστευτείτε εκείνη.</p>

  <h2>Πότε πρέπει να πληρωθεί</h2>
  <p>Το α.ν. 539/1945, άρθρο 3 παράγραφος 8, ορίζει ότι οι αποδοχές και το επίδομα αδείας δίνονται στην αρχή της άδειας. Δεν είναι λοιπόν «το επίδομα του Ιουλίου», όπως το λένε πολλοί επειδή οι περισσότεροι βγαίνουν σε άδεια το καλοκαίρι. Όποιος παίρνει την άδειά του τον χειμώνα, πληρώνεται το επίδομα τον χειμώνα.</p>
  <p>Όταν η σύμβαση λύνεται και έχουν μείνει ημέρες άδειας που δεν πήρατε, ο ν. 1346/1983 προβλέπει ότι πληρώνονται στην εκκαθάριση, μαζί με το επίδομα που τους αναλογεί. Πολλοί εργαζόμενοι το ξεχνούν όταν ελέγχουν την τελική πληρωμή, ειδικά μετά από μια <a href={route('severance', lang)}>απόλυση</a>, όπου η προσοχή πέφτει στην αποζημίωση.</p>

  <div data-chrome><MiniSim client:load kind="fourteen" lang={lang} href={route('fourteen', lang)} /></div>

  <h2>Η σχέση με τα δώρα και τι δεν υπολογίζεται</h2>
  <p>Το επίδομα αδείας «εμφανίζεται» και μέσα στα δώρα: το <a href={route('christmas', lang)}>δώρο Χριστουγέννων</a> και το δώρο Πάσχα περιέχουν την αναλογία του επιδόματος αδείας, που εδώ εφαρμόζεται ως {F.leaveShare}. Δεν πρόκειται για διπλή πληρωμή: είναι δύο διαφορετικές υποχρεώσεις. Το εργαλείο δεν λαμβάνει υπόψη ευνοϊκότερες συλλογικές συμβάσεις, ούτε την ακριβή κλίμακα ημερών άδειας. Ο φόρος υπολογίζεται με τον μέσο συντελεστή του έτους, όπως στον βασικό <a href={route('home', lang)}>υπολογισμό μισθού</a>.</p>
</GuideLayout>
