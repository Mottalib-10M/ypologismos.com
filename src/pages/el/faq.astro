---
import PageLayout from '../../layouts/PageLayout.astro';
import MiniSim from '../../components/calc/MiniSim';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { t } from '../../i18n/ui';
import { facts, src } from '../../lib/facts';
import { salary, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney, displayDate } from '../../lib/format';
import { faqSchema, webPageSchema, breadcrumbSchema } from '../../lib/seo';
import { LANG_TAGS, AUTHOR_NAME, CONTACT_EMAIL, REVIEW_CYCLE_MONTHS } from '../../data/site-config';

const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const $2 = (x: number) => formatMoney(x, 2, lang);
const checked = displayDate(F.retrieved, LANG_TAGS[lang]);
const maxDiff = Math.max(...P.minimum_wage.official_examples.map((e) => Math.abs(salary({ gross: e.gross, children: e.children }).net - e.net)));
const a = salary({ gross: 1400 }), a12 = salary({ gross: 1400 * 14 / 12, payments: 12 });

const faqs = [
  { q: 'Πρέπει να πληρώσω ή να φτιάξω λογαριασμό για να χρησιμοποιήσω τους υπολογιστές;', a: `Όχι. Όλοι οι υπολογιστές και οι οδηγοί είναι ελεύθεροι, χωρίς εγγραφή, χωρίς email και χωρίς όριο υπολογισμών. Δεν υπάρχει «premium» έκδοση ούτε αποτέλεσμα κρυμμένο πίσω από φόρμα. Μπορείτε να δοκιμάσετε όσα σενάρια θέλετε: μισθό με και χωρίς τέκνα, 14 ή 12 καταβολές, άλλη ηλικία, και να επιστρέψετε όποτε αλλάξει κάτι στη μισθοδοσία σας. Ο ιστότοπος δεν δείχνει σήμερα διαφημίσεις.` },
  { q: 'Τα ποσά που πληκτρολογώ φτάνουν σε κάποιον διακομιστή;', a: `Όχι. Ο υπολογισμός γίνεται εξ ολοκλήρου στον browser της συσκευής σας και ο κώδικας δεν στέλνει τα στοιχεία πουθενά. Ο μισθός, τα τέκνα και η ηλικία δεν αποθηκεύονται σε βάση δεδομένων και δεν συνδέονται με την ταυτότητά σας. Μόνο μετά από αλλαγή κάποιου πεδίου, οι τιμές γράφονται στη διεύθυνση της σελίδας, ώστε να μπορείτε να μοιραστείτε τον λογαριασμό. Σε ιδιωτικό παράθυρο δεν μένουν ούτε στο ιστορικό.` },
  { q: 'Το εκκαθαριστικό μου διαφέρει ένα ή δύο ευρώ από τον υπολογιστή. Ποιο είναι σωστό;', a: `Πιθανότατα και τα δύο. Ο μηχανισμός υπολογίζει με λεπτά και στρογγυλοποιεί στο τέλος, ενώ τα προγράμματα μισθοδοσίας στρογγυλοποιούν κάθε γραμμή χωριστά. Στα δώδεκα επίσημα παραδείγματα του Υπουργείου Εργασίας για τον κατώτατο μισθό, η μέγιστη απόκλισή μας είναι ${$2(maxDiff)}. Διαφορά δεκάδων ευρώ, αντίθετα, δείχνει συνήθως τέκνα που δεν δηλώθηκαν στον εργοδότη, επίδομα ή κράτηση εκτός φόρου.` },
  { q: 'Πότε ενημερώνονται οι συντελεστές όταν αλλάζει ο νόμος;', a: `Κάθε φορά που δημοσιεύεται αλλαγή που επηρεάζει τα καθαρά: νέος κατώτατος μισθός, εγκύκλιος του e-ΕΦΚΑ για το πλαφόν, τροποποίηση της κλίμακας ή του ΕΝΦΙΑ. Ενημερώνουμε όταν η ρύθμιση έχει ψηφιστεί ή εκδοθεί, όχι με βάση εξαγγελίες. Ανεξάρτητα από αλλαγές, όλο το αρχείο παραμέτρων ελέγχεται τουλάχιστον κάθε ${REVIEW_CYCLE_MONTHS} μήνες. Ο τελευταίος πλήρης έλεγχος έγινε στις ${checked}.` },
  { q: 'Ισχύει ο υπολογισμός για δημόσιους υπαλλήλους ή για όσους κόβουν μπλοκάκι;', a: `Ο υπολογιστής μισθού αφορά μισθωτούς του ιδιωτικού τομέα με τον γενικό κωδικό πακέτου κάλυψης ${F.kpk}: εισφορές ${F.efkaEe} για τον εργαζόμενο και ${F.efkaEr} για τον εργοδότη. Η φορολογική κλίμακα και η μείωση του άρθρου 16 ισχύουν για κάθε μισθωτό, όμως οι εισφορές του Δημοσίου, των βαρέων και των ελεύθερων επαγγελματιών είναι διαφορετικές και δεν μοντελοποιούνται. Για αυτούς το αποτέλεσμα είναι μόνο ενδεικτικό.` },
  { q: 'Πώς στέλνω σε κάποιον το αποτέλεσμα που βρήκα;', a: `Αφού αλλάξετε τα πεδία, αντιγράψτε τη διεύθυνση από τη γραμμή του browser και στείλτε την με email ή μήνυμα. Όποιος την ανοίξει βλέπει τις ίδιες επιλογές και το ίδιο αποτέλεσμα, γιατί ο υπολογιστής διαβάζει τις τιμές από τη διεύθυνση. Θυμηθείτε ότι ο σύνδεσμος περιέχει τον μισθό σας. Για εκτύπωση αρκεί η εντολή εκτύπωσης του browser, μαζί με την ανάλυση σε εισφορές και φόρο.` },
  { q: 'Ποιους υπολογισμούς μπορώ να κάνω εδώ;', a: `Δέκα υπολογιστές: καθαρός μισθός από μικτό, αντίστροφα από καθαρά σε μικτά, κόστος εργοδότη, δώρο Χριστουγέννων, δώρο Πάσχα, επίδομα αδείας, αποζημίωση απόλυσης, τέλη κυκλοφορίας, ΕΝΦΙΑ και εκτίμηση σύνταξης. Κάθε οδηγός έχει επιπλέον έναν μικρό υπολογιστή για το θέμα του. Όλοι χρησιμοποιούν τον ίδιο μηχανισμό και τις ίδιες παραμέτρους του ${F.year}, άρα τα ποσά συμφωνούν από σελίδα σε σελίδα.` },
  { q: 'Μπορώ να χρησιμοποιήσω το αποτέλεσμα για δάνειο, ενοίκιο ή διαφορά με τον εργοδότη;', a: `Ως εκτίμηση ναι, ως αποδεικτικό όχι. Δεσμευτικά είναι η μισθοδοσία του εργοδότη, οι δηλώσεις στον e-ΕΦΚΑ και το εκκαθαριστικό της ΑΑΔΕ. Ο υπολογιστής βοηθά να ελέγξετε ένα εκκαθαριστικό, να συγκρίνετε προσφορές ή να ετοιμάσετε μια διαπραγμάτευση. Σε διαφορά για δεδουλευμένα ή απόλυση, απευθυνθείτε στην Επιθεώρηση Εργασίας ή σε δικηγόρο, και για φορολογικά θέματα σε λογιστή.` },
  { q: 'Ποιος φτιάχνει τον ιστότοπο και έχει σχέση με την ΑΑΔΕ ή τον e-ΕΦΚΑ;', a: `Τον ιστότοπο εκδίδει η ${AUTHOR_NAME}, που δημοσιεύει δωρεάν υπολογιστές μισθού και φόρων με δημοσιευμένη μέθοδο. Δεν συνδέεται με την ΑΑΔΕ, τον e-ΕΦΚΑ, το Υπουργείο Εργασίας ή άλλη υπηρεσία και δεν μιλά εκ μέρους τους. Κάθε συντελεστής παραπέμπει σε νόμο, εγκύκλιο ή ανακοίνωση, με τον σύνδεσμο στις πηγές κάθε σελίδας. Οι κανόνες περιγράφονται στη συντακτική πολιτική.` },
  { q: 'Βρήκα λάθος σε έναν υπολογισμό. Πού το αναφέρω;', a: `Στείλτε email στο ${CONTACT_EMAIL} με τον σύνδεσμο του υπολογισμού (περιέχει όλες τις επιλογές), το ποσό που περιμένατε και από πού προέρχεται, π.χ. το εκκαθαριστικό χωρίς ονόματα και ΑΦΜ. Ελέγχουμε κάθε αναφορά στον νόμο. Αν το λάθος επιβεβαιωθεί, διορθώνουμε τον μηχανισμό, προσθέτουμε την περίπτωσή σας στους αυτόματους ελέγχους και ενημερώνουμε την ημερομηνία στις σελίδες που αφορά.` },
];

const title = `Καθαρά, φόροι και τέλη ${F.year}: συχνές ερωτήσεις και απαντήσεις`;
const description = `Ερωτήσεις για τους υπολογιστές ${F.year}: κόστος, απόρρητο, ενημερώσεις, διαφορά με το εκκαθαριστικό, ποιους αφορά ο μισθός ΚΠΚ ${F.kpk} και πώς στέλνετε ένα αποτέλεσμα.`;
const path = route('faq', lang);
const h1 = 'Συχνές ερωτήσεις για τους υπολογισμούς';
const jsonLd = [webPageSchema({ name: h1, description, path, lang }), breadcrumbSchema([{ name: t(lang).breadcrumbHome, path: route('home', lang) }, { name: label('faq', lang), path }]), faqSchema(faqs, lang)];
const groups = [
  { h: 'Μισθός και φόρος', ids: ['minimum', 'brackets', 'youth', 'children', 'efka', 'fourteen', 'withholding'] },
  { h: 'Δώρα, απόλυση, σύνταξη', ids: ['christmas', 'easter', 'leave', 'severance', 'notice', 'pension'] },
  { h: 'Αυτοκίνητο και ακίνητα', ids: ['road', 'roadco2', 'enfia', 'enfiadisc', 'zone'] },
];
---
<PageLayout title={title} description={description} lang={lang} jsonLd={jsonLd} faqs={faqs} breadcrumbs={[{ label: label('faq', lang) }]}
  sources={[src('tax_scale', lang), src('efka_rates', lang), src('min_wage', lang)]}
  related={[{ href: route('home', lang), name: label('home', lang), description: 'Καθαρά από μικτά, με τέκνα, ηλικία και 14 ή 12 καταβολές.' }, { href: route('method', lang), name: label('method', lang), description: 'Οι τύποι, οι έλεγχοι και τα όρια του μηχανισμού.' }, { href: route('widget', lang), name: label('widget', lang), description: 'Δωρεάν ενσωμάτωση του υπολογιστή με ένα iframe.' }]}>
  <article>
    <header class="mb-6">
      <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">{h1}</h1>
      <p class="mt-3 text-lg text-navy-600">Τι κάνει ο ιστότοπος με τα ποσά σας, πόσο ακριβή είναι τα αποτελέσματα και πού σταματούν.</p>
    </header>
    <div class="prose prose-slate max-w-none">
      <p>Εδώ απαντάμε σε όσα ρωτούν οι επισκέπτες για τον ίδιο τον ιστότοπο: κόστος, ιδιωτικότητα, ενημέρωση των συντελεστών, ακρίβεια και όρια. Για συγκεκριμένους κανόνες, όπως η κλίμακα, το δώρο ή η αποζημίωση, κάθε θέμα έχει δικό του οδηγό με υπολογιστή. Αν θέλετε να ελέγξετε ένα εκκαθαριστικό αμέσως, βάλτε μικτά και καθαρά στο παρακάτω πεδίο: για {$(1400)} μικτά, άνω των 30 χωρίς τέκνα, τα αναμενόμενα καθαρά είναι {$(a.net)} σε κάθε μία από τις 14 καταβολές, ενώ με σύμβαση 12 καταβολών του ίδιου ετήσιου ποσού γίνονται {$(a12.net)} τον μήνα.</p>
      <div data-chrome><MiniSim client:load kind="payslipcheck" lang={lang} href={route('home', lang)} /></div>
      <h2>Οδηγοί ανά θέμα</h2>
      {groups.map((g) => <p><strong>{g.h}:</strong> {g.ids.map((id, i) => <>{i > 0 && ' · '}<a href={route(id, lang)}>{label(id, lang)}</a></>)}</p>)}
      <p>Ο τρόπος υπολογισμού, βήμα προς βήμα, βρίσκεται στη <a href={route('method', lang)}>μεθοδολογία</a> και οι όροι της μισθοδοσίας στο <a href={route('glossary', lang)}>γλωσσάρι</a>.</p>
    </div>
  </article>
</PageLayout>
