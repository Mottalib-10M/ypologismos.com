---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { salary, minimumWage, christmasBonus, easterBonus, leaveAllowance, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const $2 = (x: number) => formatMoney(x, 2, lang);
const M = P.minimum_wage;
const base = salary({ gross: M.monthly });
const old = salary({ gross: M.monthly_2025 });
const k1 = salary({ gross: M.monthly, children: 1 }), k2 = salary({ gross: M.monthly, children: 2 });
const young = salary({ gross: M.monthly, age: 'u25' });
const rows = [0, 1, 2, 3].map((t) => { const g = minimumWage(t); const s = salary({ gross: g }); return [t === 0 ? 'Χωρίς τριετία' : `${t} τριετί${t === 1 ? 'α' : 'ες'}`, $(g), $(s.efka), $(s.tax), $(s.net), $(s.netPer12)]; });
const xmas = christmasBonus({ pay: M.monthly }), easter = easterBonus({ pay: M.monthly }), leave = leaveAllowance({ pay: M.monthly });
const yearGross = M.monthly * 14;
const half = salary({ gross: M.monthly / 2 });
const dailyMonth = M.daily * 25;
const faqs = [
  { q: 'Πόσα καθαρά παίρνω με τον κατώτατο μισθό το 2026;', a: `Με μικτό ${F.minWage} και 14 καταβολές τον χρόνο, ένας εργαζόμενος άνω των 30 χωρίς παιδιά παίρνει ${$(base.net)} καθαρά σε κάθε καταβολή. Από το μικτό αφαιρούνται ${$(base.efka)} εισφορές e-ΕΦΚΑ (${F.efkaEe}) και περίπου ${$(base.tax)} φόρος. Με ένα παιδί τα καθαρά γίνονται ${$(k1.net)} και με δύο ${$(k2.net)}, ποσά που επιβεβαιώνει και η ανακοίνωση του Υπουργείου Εργασίας.` },
  { q: 'Από πότε ισχύει ο νέος κατώτατος μισθός και πόσο αυξήθηκε;', a: `Ο κατώτατος μισθός των ${F.minWage} ισχύει από την 1η Απριλίου 2026, έναντι ${F.minWage2025} το 2025, δηλαδή αύξηση ${F.minIncrease}. Το κατώτατο ημερομίσθιο των εργατοτεχνιτών ανέβηκε στα ${F.minDaily}. Για τους μήνες Ιανουάριο έως Μάρτιο του 2026 ίσχυε ακόμη το ποσό του 2025, οπότε ο μισθός του Μαρτίου δεν αναπροσαρμόζεται αναδρομικά.` },
  { q: 'Οι τριετίες προστίθενται στον κατώτατο μισθό;', a: `Ναι. Κάθε τριετία προϋπηρεσίας προσθέτει ${F.triennium} στον κατώτατο μισθό, έως ${F.trienniumMax} τριετίες. Με μία τριετία το μικτό γίνεται ${F.minWithT(1)}, με δύο ${F.minWithT(2)} και με τρεις ${F.minWithT(3)}. Η προσαύξηση μετράει και στα δώρα και στο επίδομα αδείας, γιατί αυτά υπολογίζονται στις τακτικές αποδοχές.` },
  { q: 'Δουλεύω 4 ώρες την ημέρα. Ποιος είναι ο δικός μου κατώτατος;', a: `Στη μερική απασχόληση ο κατώτατος υπολογίζεται αναλογικά με τις ώρες. Για τετράωρη απασχόληση, δηλαδή μισό ωράριο, το μικτό ελάχιστο είναι ${$(M.monthly / 2)} και τα καθαρά περίπου ${$(half.net)}, χωρίς φόρο, γιατί η μείωση φόρου καλύπτει τον φόρο της κλίμακας. Οι εισφορές e-ΕΦΚΑ παρακρατούνται κανονικά.` },
  { q: 'Είμαι 23 ετών. Πληρώνω φόρο με τον κατώτατο μισθό;', a: `Όχι. Από το 2026, για φορολογούμενους έως 25 ετών, τα δύο πρώτα κλιμάκια έως ${F.youthLimit} φορολογούνται με ${F.youthU25}. Ο ετήσιος μισθός ${$(yearGross)} μένει ολόκληρος κάτω από το όριο, οπότε τα καθαρά είναι ${$(young.net)}, όσο δηλαδή το μικτό μείον τις εισφορές e-ΕΦΚΑ. Ο εργοδότης εφαρμόζει τη μείωση στην παρακράτηση.` },
];
---
<GuideLayout lang={lang} id="minimum" breadcrumbLabel={label('minimum', lang)}
  title={`Κατώτατος μισθός ${F.year}: ${F.minWage} μικτά, ${F.minNet} καθαρά τον μήνα`}
  h1={`Κατώτατος μισθός ${F.year}: ${F.minWage} μικτά και πόσα καθαρά`}
  description={`Κατώτατος μισθός ${F.year}: ${F.minWage} μικτά από 1/4, ${F.minNet} καθαρά τον μήνα, ημερομίσθιο ${F.minDaily}. Τριετίες, δώρα, νέοι έως 25 χωρίς φόρο, δωρεάν υπολογιστής καθαρών.`}
  intro={`Από την 1η Απριλίου ${F.year} ο κατώτατος μισθός είναι ${F.minWage} μικτά τον μήνα και το κατώτατο ημερομίσθιο ${F.minDaily}.`}
  resume={`Ο κατώτατος μισθός ${F.year} είναι ${F.minWage} μικτά για υπαλλήλους πλήρους απασχόλησης, από την 1η Απριλίου, με αύξηση ${F.minIncrease} σε σχέση με τα ${F.minWage2025} του 2025. Σε καθαρά, ένας εργαζόμενος άνω των 30 χωρίς παιδιά παίρνει ${$(base.net)} σε καθεμία από τις 14 καταβολές του έτους: αφαιρούνται ${$(base.efka)} εισφορές e-ΕΦΚΑ και περίπου ${$(base.tax)} φόρος. Με ένα παιδί τα καθαρά ανεβαίνουν στα ${$(k1.net)}, με δύο στα ${$(k2.net)}, και όποιος είναι έως 25 ετών δεν πληρώνει καθόλου φόρο, άρα κρατά ${$(young.net)}. Σε 12μηνη βάση, αν μοιράσουμε και τα δώρα στους μήνες, το καθαρό εισόδημα είναι ${$(base.netPer12)} τον μήνα. Για τους εργατοτεχνίτες το κατώτατο ημερομίσθιο είναι ${F.minDaily}, ενώ κάθε τριετία προϋπηρεσίας προσθέτει ${F.triennium} στον μισθό. Ο υπολογιστής παρακάτω δίνει τα καθαρά σας με τριετίες και παιδιά.`}
  faqs={faqs}
  related={[{ href: route('home', lang), name: label('home', lang), description: 'Καθαρά από οποιονδήποτε μικτό μισθό, με ηλικία και παιδιά.' }, { href: route('trienniums', lang), name: label('trienniums', lang), description: `Πώς προστίθεται το ${F.triennium} κάθε τριετίας.` }, { href: route('parttime', lang), name: label('parttime', lang), description: 'Αναλογικός μισθός για λιγότερες ώρες.' }]}
  sources={[src('min_wage', lang), src('efka_rates', lang), src('tax_scale', lang), src('tax_credit', lang)]}>
  <div data-chrome><MiniSim client:load kind="minimum" lang={lang} href={route('home', lang)} /></div>

  <h2>Πόσα καθαρά ανά τριετία</h2>
  <ContentTable headers={['Προϋπηρεσία', 'Μικτά', 'ΕΦΚΑ', 'Φόρος', 'Καθαρά (×14)', 'Καθαρά σε 12μηνη βάση']} align={['l', 'r', 'r', 'r', 'r', 'r']} rows={rows} highlightRow={0} />
  <p>Ο πίνακας αφορά εργαζόμενο άνω των 30 ετών χωρίς εξαρτώμενα τέκνα, με 14 καταβολές. Τα ποσά προκύπτουν από τον ίδιο υπολογισμό που κάνει το λογιστήριο: μικτά επί 14, μείον τις εισφορές του εργαζομένου, φόρος με την κλίμακα του {F.year} και τη μείωση φόρου του άρθρου 16 ΚΦΕ, και ο ετήσιος φόρος μοιρασμένος ισόποσα στις καταβολές. Στη σύγκριση με τα παραδείγματα που δημοσίευσε το Υπουργείο Εργασίας για τον νέο κατώτατο, η απόκλιση είναι το πολύ ένα ευρώ, που οφείλεται σε στρογγυλοποιήσεις.</p>
  <p>Η στήλη «12μηνη βάση» απαντά σε μια συνηθισμένη απορία: πόσα είναι τα καθαρά «τον μήνα» αν μετρήσουμε το δώρο Χριστουγέννων, το δώρο Πάσχα και το επίδομα αδείας. Αφού ο μισθός πληρώνεται 14 φορές, τα ετήσια καθαρά διαιρούμενα με 12 δίνουν ένα μεγαλύτερο μηνιαίο ποσό, χρήσιμο για τον οικογενειακό προϋπολογισμό ή για την αίτηση ενός δανείου.</p>

  <h2>Τι αλλάζει από την 1η Απριλίου {F.year}</h2>
  <p>Η αύξηση από {F.minWage2025} σε {F.minWage} δεν ισχύει από τον Ιανουάριο: όπως και τα προηγούμενα χρόνια, ο νέος κατώτατος μισθός εφαρμόζεται από την 1η Απριλίου. Έτσι, οι μισθοί Ιανουαρίου έως Μαρτίου πληρώθηκαν με το παλιό ποσό, ενώ από τον Απρίλιο η μισθοδοσία πρέπει να δείχνει τουλάχιστον {F.minWage}. Σε καθαρά, η διαφορά για εργαζόμενο χωρίς παιδιά είναι {$(base.net - old.net)} ανά καταβολή, δηλαδή {$(base.netAnnual - old.netAnnual)} τον χρόνο αν μετρήσουμε και τις 14 πληρωμές.</p>
  <p>Η αύξηση δεν αφορά μόνο όσους αμείβονται ακριβώς με τον κατώτατο. Πολλά επιδόματα της ΔΥΠΑ υπολογίζονται με βάση αυτόν, όπως το <a href={route('parental', lang)}>επίδομα γονικής άδειας</a>, ενώ οι τριετίες του κατώτατου μισθού ακολουθούν αυτόματα το νέο ποσό. Σύμφωνα με το Υπουργείο, ο μέσος μισθός του 2025 στο σύστημα ΕΡΓΑΝΗ ήταν {F.avgWage}, δηλαδή ο κατώτατος αντιστοιχεί σε λίγο περισσότερο από τα τρία πέμπτα του.</p>
  <p>Για να ελέγξετε τη μισθοδοσία του Απριλίου, κοιτάξτε τρία σημεία: ότι οι «μικτές αποδοχές» δεν είναι κάτω από {F.minWage} για πλήρες ωράριο, ότι οι εισφορές του εργαζομένου είναι {F.efkaEe} του μικτού, και ότι ο φόρος δεν είναι μεγαλύτερος από τον πίνακα παραπάνω. Αν ο μισθός σας είναι χαμηλότερος για πλήρη απασχόληση, μπορείτε να απευθυνθείτε στην Επιθεώρηση Εργασίας.</p>

  <h2>Υπάλληλοι και εργατοτεχνίτες: μισθός και ημερομίσθιο</h2>
  <p>Ο κατώτατος έχει δύο μορφές. Για όσους αμείβονται με μηνιαίο μισθό, κυρίως υπαλλήλους, είναι {F.minWage}. Για όσους αμείβονται με ημερομίσθιο, κυρίως εργατοτεχνίτες, είναι {F.minDaily} την ημέρα. Με 25 ημερομίσθια τον μήνα, το ημερομίσθιο δίνει {$(dailyMonth)} μικτά, λίγο πάνω από τον μηνιαίο κατώτατο. Ο <a href={route('daily', lang)}>οδηγός για το ημερομίσθιο</a> δείχνει πώς μετατρέπεται σε μηνιαία καθαρά.</p>
  <p>Η διάκριση μετράει και στα δώρα. Το δώρο Χριστουγέννων ενός ημερομίσθιου είναι 25 ημερομίσθια και όχι ένας μηνιαίος μισθός, ενώ το δώρο Πάσχα είναι 15 ημερομίσθια. Στην αποζημίωση απόλυσης, από το 2022 υπάλληλοι και εργατοτεχνίτες έχουν ενιαίο καθεστώς και ο μισθός του εργατοτεχνίτη λογίζεται ως 22 ημερομίσθια.</p>

  <h2>Νέοι έως 30 ετών και παιδιά: γιατί τα καθαρά διαφέρουν</h2>
  <p>Η μεταρρύθμιση του ν. 5246/2025 άλλαξε τον φόρο των χαμηλών μισθών περισσότερο από κάθε άλλη πρόσφατη ρύθμιση. Για νέους έως 25 ετών, τα δύο πρώτα κλιμάκια μέχρι {F.youthLimit} φορολογούνται με {F.youthU25}, και ο ετήσιος κατώτατος μισθός των {$(yearGross)} βρίσκεται ολόκληρος μέσα σε αυτό το όριο. Αποτέλεσμα: καθόλου φόρος, και καθαρά {$(young.net)} αντί για {$(base.net)}. Από 26 έως 30 ετών ο συντελεστής των δύο κλιμακίων είναι {F.youth2630}, οπότε η διαφορά είναι μικρότερη. Λεπτομέρειες στον οδηγό για τον <a href={route('youth', lang)}>φόρο των νέων</a>.</p>
  <p>Τα παιδιά επηρεάζουν διπλά. Μειώνουν τον συντελεστή του δεύτερου κλιμακίου ({F.second[1]} με ένα, {F.second[2]} με δύο παιδιά) και αυξάνουν τη μείωση φόρου του άρθρου 16 από {F.credit[0]} σε {F.credit[1]} και {F.credit[2]}. Στον κατώτατο μισθό, με δύο παιδιά ο φόρος μηδενίζεται εντελώς.</p>

  <div data-chrome><MiniSim client:load kind="parttime" lang={lang} href={route('parttime', lang)} /></div>

  <h2>Δώρα και επίδομα αδείας με τον κατώτατο</h2>
  <p>Όποιος δουλεύει όλο το έτος με τον κατώτατο μισθό λαμβάνει τρεις επιπλέον καταβολές. Το δώρο Χριστουγέννων είναι ένας μισθός προσαυξημένος με την αναλογία του επιδόματος αδείας, δηλαδή {$(xmas.amount)} μικτά, και πληρώνεται έως τις 21 Δεκεμβρίου. Το δώρο Πάσχα είναι μισός μισθός με την ίδια προσαύξηση, {$(easter.amount)} μικτά. Το επίδομα αδείας είναι έως μισός μισθός, δηλαδή {$(leave.amount)}. Και τα τρία υπόκεινται σε εισφορές και φόρο όπως ο μισθός.</p>
  <p>Αν η σχέση εργασίας ξεκίνησε μέσα στο έτος, τα δώρα δίνονται αναλογικά: για το δώρο Χριστουγέννων 2/25 του μισθού για κάθε 19 ημέρες από την 1η Μαΐου, για το δώρο Πάσχα 1/15 του μισού μισθού για κάθε 8 ημέρες από την 1η Ιανουαρίου. Οι υπολογιστές για το <a href={route('christmas', lang)}>δώρο Χριστουγέννων</a> και το <a href={route('easter', lang)}>δώρο Πάσχα</a> κάνουν την αναλογία αυτόματα.</p>

  <h2>Πόσο κοστίζει ο κατώτατος στον εργοδότη</h2>
  <p>Πάνω από το μικτό, ο εργοδότης πληρώνει τις δικές του εισφορές, {F.efkaEr} για ιδιωτικούς υπαλλήλους, δηλαδή {$(base.employer)} τον μήνα. Το συνολικό κόστος ενός εργαζομένου με κατώτατο μισθό είναι {$(base.cost)} ανά καταβολή και {$(base.costAnnual)} τον χρόνο. Από κάθε ευρώ που πληρώνει η επιχείρηση, ο εργαζόμενος κρατά καθαρά περίπου {F.pct(base.net / base.cost)}. Τον λογαριασμό για άλλους μισθούς κάνει ο υπολογιστής <a href={route('employer', lang)}>κόστους εργοδότη</a>.</p>
  <p>Όσοι ψάχνουν στο διαδίκτυο «κατωτατος μισθος» ή «katotatos misthos» βρίσκουν συχνά το μικτό ποσό χωρίς να βλέπουν τι μένει στην τσέπη. Γι' αυτό σε αυτή τη σελίδα όλα τα ποσά υπολογίζονται από τον ίδιο μηχανισμό με τον βασικό <a href={route('home', lang)}>υπολογισμό μισθού</a>, με τις παραμέτρους που ισχύουν το {F.year}: τις εισφορές της εγκυκλίου του e-ΕΦΚΑ, την κλίμακα του ν. 5246/2025 και τη μείωση φόρου του άρθρου 16. Όταν αλλάξει κάποιος συντελεστής, αλλάζουν μαζί όλοι οι πίνακες.</p>
</GuideLayout>
