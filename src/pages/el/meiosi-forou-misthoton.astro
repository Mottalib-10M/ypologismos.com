---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { salary, incomeTax, taxCredit, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney } from '../../lib/format';
import { creditZeroAt, ART29_SOURCE } from '../../lib/mini-extra-b';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const p = F.pct;
const T = P.tax;
// Εισόδημα έως το οποίο ο φόρος μηδενίζεται (η μείωση καλύπτει όλο τον φόρο της κλίμακας).
const taxFreeUpTo = (k: number) => { let lo = 0, hi = 200000; for (let i = 0; i < 60; i++) { const m = (lo + hi) / 2; if (incomeTax(m, k).tax > 0.005) hi = m; else lo = m; } return Math.floor(lo / 10) * 10; };
const kids = [0, 1, 2, 3, 4, 5, 6];
const ref = 30000;
const rows = kids.map((k) => { const z = creditZeroAt(k); return [String(k), $(taxCredit(0, k)), $(taxFreeUpTo(k)), z === null ? 'δεν μηδενίζεται' : $(z), $(taxCredit(ref, k))]; });
const z0 = creditZeroAt(0) as number, z2 = creditZeroAt(2) as number;
const free0 = taxFreeUpTo(0), free2 = taxFreeUpTo(2);
const c20 = taxCredit(20000, 0);
// Ενεργός οριακός συντελεστής στη ζώνη σταδιακής μείωσης.
const taperRate = T.credit_taper_per_1000 / 1000;
const eff3 = T.brackets[2].rate + taperRate;
// Κατώτατος μισθός: πόση μείωση μένει αχρησιμοποίητη.
const minS = salary({ gross: P.minimum_wage.monthly, children: 2 });
const minFull = taxCredit(minS.taxableAnnual, 2);
const unused = minFull - minS.creditAnnual;
const pay = salary({ gross: 1500 });
const perPay = pay.creditAnnual / 14;
// Πέντε παιδιά.
const big = 4000;
const b4 = salary({ gross: big, children: 4 }), b5 = salary({ gross: big, children: 5 });
const c4 = taxCredit(b4.taxableAnnual, 4), c5 = taxCredit(b5.taxableAnnual, 5);
const faqs = [
  { q: 'Τι είναι τελικά το «αφορολόγητο» των μισθωτών;', a: `Ο νόμος δεν ορίζει αφορολόγητο ποσό εισοδήματος. Ορίζει τη μείωση φόρου του άρθρου 16, που αφαιρείται από τον φόρο της κλίμακας. Επειδή καλύπτει τον φόρο των πρώτων ευρώ, λειτουργεί σαν αφορολόγητο: χωρίς παιδιά δεν πληρώνετε φόρο έως περίπου ${$(free0)} φορολογητέο, με δύο παιδιά έως ${$(free2)}. Πάνω από αυτά τα ποσά πληρώνετε φόρο για ολόκληρο το εισόδημα μείον τη μείωση.` },
  { q: 'Σε ποιο εισόδημα χάνω εντελώς τη μείωση φόρου;', a: `Χωρίς παιδιά, στα ${$(z0)} φορολογητέο. Η μείωση των ${F.credit[0]} χάνει ${F.creditTaper} για κάθε 1.000 € πάνω από ${F.creditThreshold}, άρα χρειάζονται ${$(z0 - T.credit_taper_threshold)} επιπλέον για να μηδενιστεί. Με ένα παιδί σβήνει στα ${$(creditZeroAt(1) as number)}, με δύο στα ${$(z2)}, με τρία στα ${$(creditZeroAt(3) as number)} και με τέσσερα στα ${$(creditZeroAt(4) as number)}. Από πέντε παιδιά δεν μηδενίζεται ποτέ.` },
  { q: 'Η μείωση φόρου επιστρέφεται αν δεν έχω αρκετό φόρο;', a: `Όχι. Το άρθρο 16 ορίζει ότι όταν ο φόρος της κλίμακας είναι μικρότερος από τη μείωση, η μείωση περιορίζεται στο ποσό του φόρου. Ένας γονιός δύο παιδιών με τον κατώτατο μισθό των ${F.minWage} δικαιούται ${$(minFull)} μείωση, αλλά ο φόρος της κλίμακας είναι μόνο ${$(minS.creditAnnual)}. Τα υπόλοιπα ${$(unused)} δεν επιστρέφονται ούτε μεταφέρονται σε επόμενο έτος.` },
  { q: 'Ισχύει η μείωση του άρθρου 16 για ελεύθερους επαγγελματίες;', a: `Όχι για τα κέρδη τους. Το άρθρο 29 ΚΦΕ ορίζει ότι τα κέρδη από επιχειρηματική δραστηριότητα προστίθενται στον μισθό για να βρεθεί το κλιμάκιο, αλλά οι μειώσεις του άρθρου 16 δεν εφαρμόζονται σε αυτά. Όποιος έχει και μισθό και μπλοκάκι παίρνει τη μείωση που αναλογεί στο μέρος του εισοδήματος από μισθό. Και η περικοπή των ${F.creditTaper} ανά 1.000 € μετρά μόνο το φορολογητέο από μισθούς και συντάξεις.` },
  { q: 'Με πέντε παιδιά και υψηλό μισθό, πόση μείωση κρατάω;', a: `Ολόκληρη: ${F.credit[5]} με πέντε παιδιά και ${F.creditStep} επιπλέον για κάθε παιδί μετά το πέμπτο, σε οποιοδήποτε εισόδημα. Με μικτά ${$(big)} τον μήνα, ένας γονιός τεσσάρων παιδιών κρατά μόνο ${$(c4)} από τα ${F.credit[4]}, γιατί η μείωση έχει ήδη συρρικνωθεί. Με πέντε παιδιά, η μείωση είναι ${$(c5)} χωρίς καμία περικοπή.` },
];
---
<GuideLayout lang={lang} id="credit" breadcrumbLabel={label('credit', lang)}
  title={`Μείωση φόρου μισθωτών ${F.year}: ${F.credit[0]} και πότε μηδενίζεται`}
  h1={`Μείωση φόρου μισθωτών ${F.year}: το άρθρο 16 στην πράξη`}
  description={`Μείωση φόρου ${F.year} για μισθωτούς: ${F.credit[0]} χωρίς παιδιά έως ${F.credit[5]} με πέντε, μείον ${F.creditTaper} ανά 1.000 € πάνω από ${F.creditThreshold} φορολογητέο. Σε ποιο εισόδημα σβήνει εντελώς.`}
  intro={`Η μείωση φόρου του άρθρου 16 ΚΦΕ είναι το ποσό που αφαιρείται από τον φόρο της κλίμακας κάθε μισθωτού και συνταξιούχου: ${F.credit[0]} χωρίς παιδιά.`}
  resume={`Η μείωση φόρου μισθωτών του άρθρου 16 ΚΦΕ είναι ${F.credit[0]} για φορολογούμενο χωρίς εξαρτώμενα τέκνα, ${F.credit[1]} με ένα, ${F.credit[2]} με δύο, ${F.credit[3]} με τρία, ${F.credit[4]} με τέσσερα και ${F.credit[5]} με πέντε, συν ${F.creditStep} για κάθε επιπλέον παιδί. Αφαιρείται από τον φόρο που βγάζει η κλίμακα, αλλά ποτέ δεν τον ξεπερνά: όταν ο φόρος είναι μικρότερος, η μείωση περιορίζεται σε αυτόν. Όταν το φορολογητέο εισόδημα από μισθούς και συντάξεις ξεπερνά τις ${F.creditThreshold}, η μείωση χάνει ${F.creditTaper} για κάθε 1.000 €. Χωρίς παιδιά σβήνει εντελώς στα ${$(z0)} φορολογητέο, με δύο παιδιά στα ${$(z2)}, ενώ από πέντε παιδιά δεν μειώνεται ποτέ. Στην πράξη η μείωση λειτουργεί ως αφορολόγητο: χωρίς παιδιά δεν πληρώνετε φόρο έως περίπου ${$(free0)} φορολογητέο. Με ${$(20000)} φορολογητέο χωρίς παιδιά, μένουν ${$(c20)} μείωσης. Το εργαλείο παρακάτω δείχνει πόση σας αναλογεί.`}
  faqs={faqs}
  related={[{ href: route('home', lang), name: label('home', lang), description: 'Καθαρά από τον μικτό, με τη μείωση φόρου ενσωματωμένη.' }, { href: route('brackets', lang), name: label('brackets', lang), description: 'Η κλίμακα από την οποία αφαιρείται η μείωση.' }, { href: route('children', lang), name: label('children', lang), description: 'Πώς τα παιδιά αλλάζουν και τους συντελεστές.' }]}
  sources={[src('tax_credit', lang), src('tax_scale', lang), ART29_SOURCE.el, src('min_wage', lang)]}>
  <div data-chrome><MiniSim client:load kind="credit" lang={lang} href={route('home', lang)} /></div>

  <h2>Η μείωση ανά αριθμό παιδιών</h2>
  <ContentTable headers={['Τέκνα', 'Πλήρης μείωση', 'Μηδενικός φόρος έως', 'Η μείωση σβήνει στα', `Μείωση με ${$(ref)}`]} align={['l', 'r', 'r', 'r', 'r']} rows={rows} highlightRow={0} />
  <p>Όλα τα ποσά αφορούν φορολογητέο εισόδημα από μισθούς ή συντάξεις, δηλαδή μετά την αφαίρεση των εισφορών, και φορολογούμενο άνω των 30 ετών. Η τρίτη στήλη δείχνει μέχρι ποιο εισόδημα ο φόρος της κλίμακας είναι μικρότερος από τη μείωση, άρα ο τελικός φόρος είναι μηδέν. Η τέταρτη δείχνει πού η σταδιακή περικοπή φτάνει στο μηδέν. Η τελευταία στήλη είναι η μείωση που μένει σε ένα μεσαίο εισόδημα {$(ref)}.</p>

  <h2>Πώς σβήνει: {F.creditTaper} ανά 1.000 €</h2>
  <p>Ο κανόνας είναι απλός στη διατύπωση. Για κάθε 1.000 € φορολογητέου πάνω από τις {F.creditThreshold}, η μείωση χάνει {F.creditTaper}, μέχρι να εξαντληθεί. Ένας υπάλληλος χωρίς παιδιά με {$(20000)} φορολογητέο είναι {$(20000 - T.credit_taper_threshold)} πάνω από το όριο, άρα χάνει {$((20000 - T.credit_taper_threshold) / 1000 * T.credit_taper_per_1000)} και κρατά {$(c20)}. Στα {$(z0)} η περικοπή φτάνει τα {F.credit[0]} και η μείωση μηδενίζεται.</p>
  <p>Το σημείο αυτό απέχει πολύ για όσους έχουν παιδιά, επειδή η αρχική μείωση είναι μεγαλύτερη ενώ ο ρυθμός περικοπής μένει ίδιος. Με δύο παιδιά χρειάζονται {$(z2 - T.credit_taper_threshold)} πάνω από το όριο για να σβήσουν τα {F.credit[2]}. Με πέντε ή περισσότερα παιδιά ο νόμος εξαιρεί ρητά την περικοπή, οπότε η μείωση μένει ολόκληρη σε κάθε εισόδημα.</p>

  <h2>Ο κρυφός συντελεστής της ζώνης περικοπής</h2>
  <p>Όσο η μείωση συρρικνώνεται, κάθε επιπλέον ευρώ φορολογείται λίγο βαρύτερα από όσο λέει η κλίμακα. Η απώλεια {F.creditTaper} ανά 1.000 € ισοδυναμεί με {p(taperRate)} επιπλέον φόρο. Για έναν μισθωτό χωρίς παιδιά στο τρίτο κλιμάκιο, ο πραγματικός οριακός συντελεστής δεν είναι {F.r[2]} αλλά {p(eff3)}. Μόλις η μείωση εξαντληθεί, ο οριακός επιστρέφει στον ονομαστικό συντελεστή της κλίμακας.</p>
  <p>Η διαφορά είναι μικρή αλλά εξηγεί γιατί μια αύξηση αποδίδει καθαρά λίγο λιγότερα από όσα υπολογίζει κανείς με το μάτι. Τον ακριβή λογαριασμό κάνει ο <a href={route('home', lang)}>υπολογισμός μισθού</a>, που εφαρμόζει τη μείωση με τον ίδιο τρόπο που την εφαρμόζει η μισθοδοσία.</p>

  <div data-chrome><MiniSim client:load kind="creditfade" lang={lang} href={route('home', lang)} /></div>

  <h2>Τρεις παρανοήσεις για τη μείωση</h2>
  <p>Η πρώτη είναι ότι η μείωση αφαιρείται από το εισόδημα. Δεν αφαιρείται από το εισόδημα αλλά από τον φόρο, γι' αυτό {F.credit[0]} μείωσης αξίζουν ακριβώς {F.credit[0]}, όποιο κι αν είναι το κλιμάκιό σας. Η δεύτερη είναι ότι η περικοπή ξεκινά από το μικτό των {F.creditThreshold}. Μετρά το φορολογητέο, μετά τις εισφορές, και μαζί με δώρα και επίδομα αδείας. Η τρίτη είναι ότι τα παιδιά απλώς αυξάνουν το ποσό: στην πράξη μεταθέτουν και το σημείο όπου η μείωση σβήνει, από τα {$(z0)} χωρίς παιδιά στα {$(creditZeroAt(4) as number)} με τέσσερα.</p>

  <h2>Όταν ο φόρος είναι μικρότερος από τη μείωση</h2>
  <p>Η μείωση δεν είναι επιστροφή χρημάτων. Αν ο φόρος της κλίμακας είναι μικρότερος, η μείωση περιορίζεται σε αυτόν και το υπόλοιπο χάνεται. Ένας γονιός με δύο παιδιά και τον κατώτατο μισθό των {F.minWage} έχει φορολογητέο {$(minS.taxableAnnual)}. Ο φόρος της κλίμακας είναι {$(minS.creditAnnual)}, ενώ η μείωση που δικαιούται είναι {$(minFull)}. Χρησιμοποιεί μόνο όσο χρειάζεται για να μηδενίσει τον φόρο· τα {$(unused)} που περισσεύουν δεν πληρώνονται σε κανέναν.</p>
  <p>Το ίδιο ισχύει για τους νέους έως 25 ετών, που δεν έχουν φόρο στα πρώτα {F.youthLimit}: η μείωση δεν έχει τι να μειώσει μέχρι να ξεπεραστεί το όριο. Περισσότερα στον οδηγό για τον <a href={route('youth', lang)}>φόρο των νέων</a>.</p>

  <h2>Η μείωση μέσα στη μισθοδοσία</h2>
  <p>Ο εργοδότης δεν περιμένει τη δήλωση για να εφαρμόσει τη μείωση. Την αφαιρεί από τον ετήσιο φόρο πριν τον μοιράσει στις καταβολές, όπως ορίζει το άρθρο 60 ΚΦΕ για την παρακράτηση. Σε μισθό {$(1500)} μικτά, η μείωση που αντιστοιχεί είναι {$(pay.creditAnnual)} τον χρόνο, δηλαδή {$(perPay)} σε κάθε μία από τις 14 καταβολές. Χωρίς αυτήν, η παρακράτηση θα ήταν {$(pay.scaleAnnual / 14)} ανά καταβολή αντί για {$(pay.tax)}.</p>
  <p>Η ίδια μείωση, με τα ίδια ποσά και την ίδια περικοπή, ισχύει για τους συνταξιούχους. Το όριο των {F.creditThreshold} μετρά το άθροισμα του φορολογητέου από μισθούς και συντάξεις, οπότε όποιος παίρνει σύνταξη και ταυτόχρονα εργάζεται έχει μία μείωση για το σύνολο, όχι δύο. Το ίδιο ισχύει για όποιον έχει δύο εργοδότες: κάθε μισθοδοσία αφαιρεί ολόκληρη τη μείωση, αλλά στη δήλωση μετρά μία φορά.</p>

  <h2>Πέντε παιδιά και άνω</h2>
  <p>Οι πολύτεκνες οικογένειες με πέντε ή περισσότερα παιδιά έχουν δύο πλεονεκτήματα στη μείωση φόρου. Το ποσό είναι μεγαλύτερο ({F.credit[5]}, και {F.creditStep} ακόμη για κάθε παιδί μετά το πέμπτο), και δεν περικόπτεται ποτέ. Με μικτά {$(big)} τον μήνα, ένας γονιός τεσσάρων παιδιών έχει φορολογητέο {$(b4.taxableAnnual)} και κρατά {$(c4)} μείωση· ο γονιός πέντε παιδιών με τον ίδιο μισθό κρατά {$(c5)}. Μαζί με τον χαμηλότερο συντελεστή του τρίτου κλιμακίου, ο ετήσιος φόρος του πέφτει από {$(b4.taxAnnual)} σε {$(b5.taxAnnual)}.</p>
  <p>Για να εφαρμοστεί η μείωση σωστά στη μισθοδοσία, ο εργοδότης πρέπει να γνωρίζει τον αριθμό των εξαρτώμενων τέκνων. Αν δεν τον γνωρίζει, η <a href={route('withholding', lang)}>παρακράτηση φόρου</a> γίνεται με τη μείωση των {F.credit[0]} και η διαφορά επιστρέφεται με την εκκαθάριση της δήλωσης. Όσοι γράφουν στην αναζήτηση «μειωση φορου μισθωτων» ή «αφορολογητο 2026» ψάχνουν στην ουσία αυτόν τον μηχανισμό.</p>
</GuideLayout>
