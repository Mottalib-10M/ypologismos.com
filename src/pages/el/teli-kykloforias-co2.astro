---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { roadTax, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $2 = (x: number) => formatMoney(x, 2, lang);
const n = F.num;
const R = P.road_tax;
type T = 'co2_nedc' | 'co2_wltp';
const tax = (t: T, g: number) => roadTax({ category: t, co2: g }).amount;
const cliffs = (t: T, name: string) => R[t].filter((r) => r.upTo !== null).map((r) => {
  const g = r.upTo as number;
  return [name, `${n(g)} → ${n(g + 1)}`, $2(tax(t, g)), $2(tax(t, g + 1)), `+${$2(tax(t, g + 1) - tax(t, g))}`];
});
const cliffRows = [...cliffs('co2_nedc', 'NEDC'), ...cliffs('co2_wltp', 'WLTP')];
const nedcFree = R.co2_nedc[0].upTo as number, wltpFree = R.co2_wltp[0].upTo as number;
const nTop = R.co2_nedc[R.co2_nedc.length - 1], wTop = R.co2_wltp[R.co2_wltp.length - 1];
const same = [130, 150, 180, 220].map((g) => [`${n(g)} g/km`, $2(tax('co2_nedc', g)), $2(tax('co2_wltp', g))]);
const j160 = { a: tax('co2_nedc', 160), b: tax('co2_nedc', 161) };
const j208 = { a: tax('co2_wltp', 208), b: tax('co2_wltp', 209) };
const j140 = { a: tax('co2_nedc', 140), b: tax('co2_nedc', 141) };
const w166 = { a: tax('co2_wltp', 166), b: tax('co2_wltp', 167) };
const j250 = { a: tax('co2_nedc', 250), b: tax('co2_nedc', 251) };
const w122 = tax('co2_wltp', 123);
const faqs = [
  { q: 'Γιατί ένα γραμμάριο CO₂ παραπάνω ανεβάζει τόσο πολύ τα τέλη;', a: `Επειδή ο συντελεστής του κλιμακίου εφαρμόζεται σε όλα τα γραμμάρια του αυτοκινήτου, όχι μόνο σε όσα περνούν το όριο. Στον πίνακα NEDC, τα ${n(160)} g/km πληρώνουν ${$2(j160.a)} και τα ${n(161)} g/km ${$2(j160.b)}, διαφορά ${$2(j160.b - j160.a)}. Στον πίνακα WLTP το μεγαλύτερο άλμα είναι στα ${n(208)} g/km: από ${$2(j208.a)} σε ${$2(j208.b)}.` },
  { q: 'Το αυτοκίνητό μου ταξινομήθηκε τον Δεκέμβριο του 2020. NEDC ή WLTP;', a: `NEDC. Ο πίνακας NEDC ισχύει για επιβατικά με πρώτη ταξινόμηση στην ΕΕ από 1.11.2010 έως και 31.12.2020, και ο πίνακας WLTP από την 1.1.2021. Μετρά η ημερομηνία του πεδίου B της άδειας, όχι η χρονιά του μοντέλου ούτε ο κύκλος με τον οποίο μετρήθηκαν οι εκπομπές στο πιστοποιητικό. Ένα αυτοκίνητο με ${n(150)} g/km πληρώνει έτσι ${$2(tax('co2_nedc', 150))}.` },
  { q: 'Μπορώ να ζητήσω να υπολογιστούν τα τέλη μου με τον φθηνότερο πίνακα WLTP;', a: `Όχι. Ο νόμος συνδέει κάθε πίνακα με την περίοδο πρώτης ταξινόμησης και δεν δίνει δικαίωμα επιλογής. Με τα ίδια γραμμάρια ο πίνακας WLTP βγάζει συχνά μικρότερο ποσό, π.χ. ${n(180)} g/km κοστίζουν ${$2(tax('co2_wltp', 180))} κατά WLTP και ${$2(tax('co2_nedc', 180))} κατά NEDC, αλλά οι δύο αριθμοί προέρχονται από διαφορετικές δοκιμές και δεν είναι εναλλάξιμοι.` },
  { q: 'Μέχρι πόσα γραμμάρια CO₂ ένα αυτοκίνητο δεν πληρώνει καθόλου τέλη;', a: `Έως ${n(nedcFree)} g/km για αυτοκίνητα του πίνακα NEDC (ταξινόμηση 1.11.2010-31.12.2020) και έως ${n(wltpFree)} g/km για αυτοκίνητα του πίνακα WLTP (από το 2021). Στο πρώτο κλιμάκιο ο συντελεστής είναι μηδέν, άρα και τα τέλη. Ένα γραμμάριο πάνω από το όριο και το αυτοκίνητο πληρώνει αμέσως ${$2(tax('co2_wltp', wltpFree + 1))} κατά WLTP.` },
  { q: 'Πόσα πληρώνει ένα αυτοκίνητο με πάνω από 250 g/km;', a: `Κατά NEDC, από ${n((R.co2_nedc[R.co2_nedc.length - 2].upTo as number) + 1)} g/km και πάνω ο συντελεστής είναι ${$2(nTop.rate)} ανά γραμμάριο, οπότε ${n(260)} g/km κοστίζουν ${$2(tax('co2_nedc', 260))}. Κατά WLTP, το τελευταίο κλιμάκιο αρχίζει στα ${n((R.co2_wltp[R.co2_wltp.length - 2].upTo as number) + 1)} g/km με ${$2(wTop.rate)}, και τα ${n(290)} g/km πληρώνουν ${$2(tax('co2_wltp', 290))}. Δεν υπάρχει ανώτατο όριο.` },
];
---
<GuideLayout lang={lang} id="roadco2" breadcrumbLabel={label('roadco2', lang)}
  title={`Τέλη κυκλοφορίας CO₂ ${F.year}: κλιμάκια NEDC, WLTP και άλματα`}
  h1={`Τέλη κυκλοφορίας με CO₂: τα κλιμάκια NEDC και WLTP το ${F.year}`}
  description={`Τέλη κυκλοφορίας CO₂ ${F.year}: κλιμάκια NEDC (2010-2020) και WLTP (από 2021), ευρώ ανά γραμμάριο, μηδέν έως ${n(wltpFree)} g/km WLTP, πόσο κοστίζει ένα γραμμάριο στα όρια.`}
  intro={`Για τα αυτοκίνητα που ταξινομήθηκαν από την 1η Νοεμβρίου 2010, τα τέλη κυκλοφορίας είναι γραμμάρια CO₂ επί ευρώ ανά γραμμάριο, με δύο διαφορετικούς πίνακες.`}
  resume={`Τα τέλη κυκλοφορίας με βάση το CO₂ υπολογίζονται το ${F.year} με δύο πίνακες του άρθρου 20 του ν. 2948/2001. Ο πίνακας NEDC ισχύει για αυτοκίνητα με πρώτη ταξινόμηση από 1.11.2010 έως 31.12.2020 και έχει εννέα κλιμάκια, από μηδέν έως ${n(nedcFree)} g/km μέχρι ${$2(nTop.rate)} ανά γραμμάριο πάνω από ${n((R.co2_nedc[R.co2_nedc.length - 2].upTo as number))}. Ο πίνακας WLTP ισχύει από την 1.1.2021, με μηδέν έως ${n(wltpFree)} g/km και χαμηλότερους συντελεστές, έως ${$2(wTop.rate)}. Το κρίσιμο σημείο είναι ότι ο συντελεστής εφαρμόζεται σε όλα τα γραμμάρια, οπότε στο όριο κάθε κλιμακίου τα τέλη κάνουν άλμα: κατά WLTP, ένα αυτοκίνητο με ${n(208)} g/km πληρώνει ${$2(j208.a)}, ενώ με ${n(209)} g/km ${$2(j208.b)}. Ο πίνακας δεν επιλέγεται: τον ορίζει η ημερομηνία στο πεδίο B της άδειας. Η τιμή CO₂ είναι αυτή του πεδίου V.7, εφόσον συμφωνεί με το πιστοποιητικό συμμόρφωσης. Ο μίνι υπολογιστής δείχνει σε ποιο κλιμάκιο βρίσκεστε και πόσα θα πληρώνατε ένα κλιμάκιο χαμηλότερα.`}
  faqs={faqs}
  related={[{ href: route('road', lang), name: label('road', lang), description: 'Υπολογιστής για κάθε αυτοκίνητο, με κυβικά ή CO₂.' }, { href: route('roadcc', lang), name: label('roadcc', lang), description: 'Οι πίνακες για ταξινόμηση έως τον Οκτώβριο 2010.' }, { href: route('roadev', lang), name: label('roadev', lang), description: 'Μηδέν γραμμάρια, μηδέν τέλη.' }]}
  sources={[src('road_tax', lang), src('road_tax_idle', lang), { name: 'Οδηγία 1999/37/ΕΚ, παράρτημα Ι: κωδικοί της άδειας κυκλοφορίας (B, V.7)', url: 'https://www.legislation.gov.uk/eudr/1999/37/annex/I' }]}>
  <div data-chrome><MiniSim client:load kind="roadco2" lang={lang} href={route('road', lang)} /></div>

  <h2>Δύο κύκλοι μέτρησης, δύο πίνακες</h2>
  <p>Ο NEDC (New European Driving Cycle) ήταν η εργαστηριακή δοκιμή με την οποία μετρήθηκαν οι εκπομπές των αυτοκινήτων για πολλά χρόνια. Ο WLTP (Worldwide Harmonised Light Vehicles Test Procedure) είναι η νεότερη διαδικασία. Ο νομοθέτης δεν προσπάθησε να μετατρέψει τη μία τιμή στην άλλη: έγραψε έναν ξεχωριστό πίνακα για κάθε κύκλο και τον συνέδεσε με μια περίοδο ταξινόμησης. Ό,τι ταξινομήθηκε για πρώτη φορά σε κράτος της ΕΕ ή του ΕΟΧ από 1.11.2010 έως 31.12.2020 πάει στον NEDC, ό,τι από 1.1.2021 και μετά στον WLTP.</p>
  <p>Η τιμή που χρησιμοποιείται γράφεται στην άδεια κυκλοφορίας, στο πεδίο V.7, αλλά ο νόμος βάζει μια δικλίδα: η τιμή της άδειας μετρά μόνο αν συμφωνεί με το πιστοποιητικό συμμόρφωσης ή το έγγραφο που κατατέθηκε στο τελωνείο για τα τέλη ταξινόμησης. Αν δεν συμφωνεί, λαμβάνεται υπόψη η τιμή του πιστοποιητικού. Για ένα αυτοκίνητο που βρίσκεται ένα ή δύο γραμμάρια πάνω από ένα όριο, ο έλεγχος αυτός μπορεί να αλλάξει σημαντικά το ποσό.</p>

  <h2>Οι συντελεστές ανά γραμμάριο</h2>
  <p>Στον πίνακα NEDC οι συντελεστές ανεβαίνουν από {$2(R.co2_nedc[1].rate)} ανά γραμμάριο στο δεύτερο κλιμάκιο σε {$2(nTop.rate)} στο τελευταίο. Στον πίνακα WLTP ξεκινούν από {$2(R.co2_wltp[1].rate)} και φτάνουν τα {$2(wTop.rate)}. Το μηδενικό κλιμάκιο είναι επίσης πλατύτερο στον WLTP ({n(wltpFree)} g/km έναντι {n(nedcFree)}). Οι πλήρεις πίνακες, με τα ποσά στην αρχή και στο τέλος κάθε κλιμακίου, βρίσκονται στη σελίδα του <a href={route('road', lang)}>υπολογιστή τελών κυκλοφορίας</a>. Εδώ μας ενδιαφέρει κάτι άλλο: τι γίνεται στα όρια.</p>

  <h2>Το άλμα σε κάθε όριο, υπολογισμένο</h2>
  <ContentTable headers={['Πίνακας', 'Από g/km σε g/km', 'Τέλη στο όριο', 'Ένα γραμμάριο πάνω', 'Διαφορά']} align={['l', 'l', 'r', 'r', 'r']} rows={cliffRows} />
  <p>Ο πίνακας απαντά στην ερώτηση «πόσο κοστίζει ένα γραμμάριο». Στη μέση ενός κλιμακίου, ένα γραμμάριο κοστίζει όσο ο συντελεστής, δηλαδή λίγα λεπτά ή ένα με δύο ευρώ. Στο όριο κοστίζει όλη τη διαφορά ανάμεσα στους δύο συντελεστές, πολλαπλασιασμένη με όλα τα γραμμάρια. Στον NEDC, στη ζώνη όπου βρίσκονται τα περισσότερα οικογενειακά, τα όρια των {n(140)} g/km ({$2(j140.a)} → {$2(j140.b)}) και των {n(160)} g/km ({$2(j160.a)} → {$2(j160.b)}) είναι τα πιο ακριβά, ενώ το μεγαλύτερο άλμα όλου του πίνακα είναι στα {n(250)} g/km ({$2(j250.a)} → {$2(j250.b)}). Στον WLTP, το πρώτο γραμμάριο πάνω από τη μηδενική ζώνη κοστίζει αμέσως {$2(w122)}, τα {n(166)} → {n(167)} ανεβάζουν το ποσό από {$2(w166.a)} σε {$2(w166.b)}, και τα {n(208)} → {n(209)} το υπερδιπλασιάζουν.</p>
  <p>Για όποιον αγοράζει, αυτό σημαίνει ότι η σύγκριση εκδόσεων αξίζει κόπο. Δύο εκδόσεις του ίδιου μοντέλου μπορεί να έχουν διαφορετική τιμή CO₂ στο πιστοποιητικό, και αν η μία πέφτει κάτω από όριο, η διαφορά στα τέλη επαναλαμβάνεται κάθε χρόνο για όσο κρατήσετε το αυτοκίνητο. Το μίνι εργαλείο στην αρχή της σελίδας δείχνει το ποσό του κλιμακίου ακριβώς από κάτω.</p>

  <h2>Ίδια γραμμάρια, διαφορετικός πίνακας</h2>
  <ContentTable headers={['CO₂', 'Αν ισχύει NEDC', 'Αν ισχύει WLTP']} align={['l', 'r', 'r']} rows={same} />
  <p>Με τον ίδιο αριθμό γραμμαρίων ο πίνακας WLTP δίνει μικρότερο ποσό, συχνά πολύ μικρότερο. Αυτό δεν σημαίνει ότι ένα αυτοκίνητο του 2021 είναι πάντα φθηνότερο από ένα του 2019: οι δύο δοκιμές δεν δίνουν κατ' ανάγκη τον ίδιο αριθμό γραμμαρίων για το ίδιο αυτοκίνητο, και ο νόμος δεν ζητά καμία αναγωγή. Η σύγκριση έχει νόημα μόνο με την πραγματική τιμή του πεδίου V.7 κάθε αυτοκινήτου.</p>

  <h2>Μεταχειρισμένα εισαγωγής και η ημερομηνία που καθορίζει τον πίνακα</h2>
  <p>Η ημερομηνία που αποφασίζει τον πίνακα είναι η πρώτη ταξινόμηση σε οποιοδήποτε κράτος της ΕΕ ή του ΕΟΧ. Ένα μεταχειρισμένο που κυκλοφόρησε πρώτη φορά στην Ολλανδία τον Σεπτέμβριο 2020 και ήρθε στην Ελλάδα το {F.year} πληρώνει κατά NEDC, με όποια τιμή γράφει η άδεια, εφόσον συμφωνεί με το πιστοποιητικό. Ένα αντίστοιχο με πρώτη ταξινόμηση τον Ιανουάριο 2021 πληρώνει κατά WLTP. Δύο μήνες διαφορά στην ταξινόμηση αλλάζουν πίνακα, και το ποσό μπορεί να αλλάξει αισθητά.</p>
  <p>Για αυτοκίνητα που ταξινομήθηκαν πριν από την 1.11.2010 το CO₂ δεν παίζει κανέναν ρόλο: μετρά μόνο ο κυβισμός, όπως εξηγεί ο οδηγός για τα <a href={route('roadcc', lang)}>τέλη με κυβικά</a>. Το ίδιο ισχύει για μεταχειρισμένα με πρώτο έτος στη διεθνή αγορά πριν από το 2002, όποτε κι αν μπήκαν στην ΕΕ, γιατί τότε η μέτρηση CO₂ δεν ήταν υποχρεωτική.</p>

  <div data-chrome><MiniSim client:load kind="roadev" lang={lang} href={route('roadev', lang)} /></div>

  <h2>Πού σταματούν οι πίνακες CO₂</h2>
  <p>Οι δύο πίνακες αφορούν ιδιωτικά επιβατικά. Τα ταξί και τα άλλα επιβατικά δημόσιας χρήσης έχουν δικούς τους, απλούστερους πίνακες CO₂ στο ίδιο άρθρο, και τα φορτηγά πληρώνουν με βάση το βάρος. Τα αυτοκινούμενα τροχόσπιτα και τα θωρακισμένα επιβατικά εξαιρούνται από τη μέτρηση CO₂ και πληρώνουν με κυβισμό. Τα ηλεκτρικά, με μηδέν γραμμάρια, δεν πληρώνουν τέλη, όπως εξηγεί ο οδηγός για τα <a href={route('roadev', lang)}>ηλεκτρικά αυτοκίνητα</a>. Και όποιο κι αν είναι το κλιμάκιο, το ποσό οφείλεται ολόκληρο για τη χρονιά, όπως εξηγούμε στα <a href={route('roadmonth', lang)}>τέλη κυκλοφορίας με το μήνα</a>. Για να δείτε πόσο βαραίνει αυτό το ετήσιο έξοδο στον μισθό σας, ο <a href={route('home', lang)}>υπολογισμός μισθού</a> δίνει τα καθαρά σας.</p>
</GuideLayout>
