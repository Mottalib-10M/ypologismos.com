---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { salary, christmasBonus, easterBonus, leaveAllowance, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney, formatDecimal } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const B = P.bonuses;
const g0 = 1500;
const x0 = christmasBonus({ pay: g0 }).amount, e0 = easterBonus({ pay: g0 }).amount, a0 = leaveAllowance({ pay: g0 }).amount;
const months = 12 + (x0 + e0 + a0) / g0;
const s0 = salary({ gross: g0 }), s0b = salary({ gross: g0 * 14 / 12, payments: 12 });
const offer = 28000, o14 = salary({ gross: offer / 14 }), o12wrong = offer / 12;
const rows = [1000, 1200, 1500, 1800, 2200, 2700, 3500].map((g) => {
  const x = christmasBonus({ pay: g }).amount, e = easterBonus({ pay: g }).amount, a = leaveAllowance({ pay: g }).amount, s = salary({ gross: g });
  return [$(g), $(x), $(e), $(a), $(g * 12 + x + e + a), $(s.net), $(s.netPer12)];
});
const conv = [15000, 20000, 24000, 30000, 36000, 45000].map((y) => { const s = salary({ gross: y / 14 }); return [$(y), $(y / 14), $(y / 12), $(s.net), $(s.netPer12)]; });
const faqs = [
  { q: `Μου πρόσφεραν ${formatMoney(offer, 0, lang)} μικτά τον χρόνο. Πόσος είναι ο μηνιαίος μισθός μου;`, a: `Στον ιδιωτικό τομέα το ετήσιο ποσό διαιρείται με το 14, όχι με το 12: ${$(offer / 14)} μικτά τον μήνα, που πληρώνονται δώδεκα φορές ως μισθός και περίπου δύο φορές ακόμη ως δώρα και επίδομα αδείας. Σε καθαρά αυτό δίνει ${$(o14.net)} ανά καταβολή για εργαζόμενο άνω των 30 χωρίς παιδιά. Αν διαιρέσετε με το 12 θα περιμένετε ${$(o12wrong)} μικτά, ποσό που δεν θα δείτε ποτέ στη μισθοδοσία.` },
  { q: 'Πληρώνω περισσότερο φόρο επειδή ο μισθός μου μοιράζεται σε 14 δόσεις;', a: `Όχι. Ο φόρος μισθωτών υπολογίζεται στο ετήσιο εισόδημα: ο εργοδότης ανάγει τις αποδοχές σε ετήσιες, εφαρμόζει την κλίμακα και τη μείωση φόρου και μοιράζει τον φόρο στις καταβολές. Για ${$(g0 * 14)} τον χρόνο, τα ετήσια καθαρά είναι ${$(s0.netAnnual)} είτε πληρωθούν σε 14 δόσεις των ${$(g0)} είτε σε 12 των ${$(g0 * 14 / 12)}.` },
  { q: 'Γιατί το ετήσιο μικτό μου βγαίνει λίγο πάνω από 14 μισθούς;', a: `Επειδή τα δύο δώρα εορτών περιλαμβάνουν και την αναλογία του επιδόματος αδείας, ${F.leaveShare} επάνω στο ποσό τους. Με μισθό ${$(g0)} το δώρο Χριστουγέννων είναι ${$(x0)} και του Πάσχα ${$(e0)}, οπότε η χρονιά αντιστοιχεί σε περίπου ${formatDecimal(months, 2, lang)} μισθούς και όχι σε ακριβώς 14.` },
  { q: 'Πόσα είναι τα καθαρά μου «τον μήνα» αν μετρήσω και τα δώρα;', a: `Διαιρέστε τα ετήσια καθαρά με το 12. Για μικτό ${$(g0)} τα καθαρά είναι ${$(s0.net)} σε κάθε μία από τις 14 καταβολές, δηλαδή ${$(s0.netAnnual)} τον χρόνο, που αντιστοιχούν σε ${$(s0.netPer12)} τον μήνα σε 12μηνη βάση. Αυτό είναι το ποσό που έχει νόημα για ενοίκιο, δόσεις ή σύγκριση με μισθό στο εξωτερικό.` },
  { q: 'Αν φύγω από τη δουλειά τον Σεπτέμβριο, χάνω τους δύο επιπλέον μισθούς;', a: `Όχι, τους παίρνετε αναλογικά. Το δώρο Χριστουγέννων αντιστοιχεί στην περίοδο 1/5 έως 31/12 και πληρώνεται κατά τη λύση της σύμβασης για όσες ημέρες δουλέψατε, το δώρο Πάσχα στην περίοδο 1/1 έως 30/4, και η άδεια που δεν πήρατε πληρώνεται με την αποχώρηση. Τον ακριβή λογαριασμό κάνουν οι υπολογιστές για κάθε δώρο.` },
];
---
<GuideLayout lang={lang} id="fourteen" breadcrumbLabel={label('fourteen', lang)}
  title={`14 μισθοί ${F.year}: ετήσιος σε μηνιαίο μισθό και ανάποδα`}
  h1={`Οι 14 μισθοί του ${F.year}: πώς μοιράζεται ο ετήσιος μισθός`}
  description={`14 μισθοί ${F.year}: 12 μηνιάτικα, δώρο Χριστουγέννων, δώρο Πάσχα, επίδομα αδείας. Μετατροπή ετήσιου σε μηνιαίο μισθό, καθαρά ανά καταβολή και σε 12μηνη βάση.`}
  intro={`Στον ιδιωτικό τομέα ο μισθός πληρώνεται 14 φορές τον χρόνο: 12 μηνιάτικα, δύο δώρα εορτών και το επίδομα αδείας.`}
  resume={`Ένας μισθωτός του ιδιωτικού τομέα με πλήρη χρονιά παίρνει 14 καταβολές: δώδεκα μηνιάτικα, το δώρο Χριστουγέννων (ένας μισθός), το δώρο Πάσχα (μισός μισθός) και το επίδομα αδείας (έως μισός μισθός). Γι' αυτό μια ετήσια προσφορά διαιρείται με το 14 για να βρεθεί ο μηνιαίος μικτός: ${$(offer)} τον χρόνο σημαίνουν ${$(offer / 14)} τον μήνα, όχι ${$(o12wrong)}. Τα δώρα περιέχουν επιπλέον την αναλογία του επιδόματος αδείας (${F.leaveShare}), οπότε με μισθό ${$(g0)} η χρονιά φτάνει τα ${$(g0 * 12 + x0 + e0 + a0)} μικτά, λίγο πάνω από 14 μισθούς. Ο φόρος δεν αλλάζει με τον αριθμό των δόσεων, γιατί υπολογίζεται στο ετήσιο εισόδημα: από ${$(g0)} μικτά μένουν ${$(s0.net)} σε κάθε καταβολή και ${$(s0.netAnnual)} τον χρόνο, δηλαδή ${$(s0.netPer12)} τον μήνα αν τα μοιράσουμε σε 12. Ο υπολογιστής δείχνει τη σύγκριση για το δικό σας ετήσιο ποσό.`}
  faqs={faqs}
  related={[{ href: route('christmas', lang), name: label('christmas', lang), description: 'Ο ένας από τους δύο «έξτρα» μισθούς, με αναλογία.' }, { href: route('leave', lang), name: label('leave', lang), description: 'Το μισό μηνιάτικο που συνοδεύει την άδεια.' }, { href: route('nettogross', lang), name: label('nettogross', lang), description: 'Από τα καθαρά που θέλετε στο μικτό που θα ζητήσετε.' }]}
  sources={[src('hli_christmas', lang), src('hli_easter', lang), src('hli_bonuses', lang), src('tax_scale', lang)]}>
  <div data-chrome><MiniSim client:load kind="fourteen" lang={lang} href={route('home', lang)} /></div>

  <h2>Η χρονιά σε 14 καταβολές, ανά επίπεδο μισθού</h2>
  <ContentTable headers={['Μηνιάτικο', 'Δώρο Χριστουγέννων', 'Δώρο Πάσχα', 'Επίδομα αδείας', 'Μικτά έτους', 'Καθαρά ανά καταβολή', 'Καθαρά σε 12μηνη βάση']} align={['r', 'r', 'r', 'r', 'r', 'r', 'r']} rows={rows} highlightRow={2} />
  <p>Ο πίνακας αφορά υπάλληλο με μηνιαίο μισθό που δούλεψε όλο το έτος στον ίδιο εργοδότη, άνω των 30 ετών και χωρίς παιδιά. Τα δύο δώρα εμφανίζονται ήδη προσαυξημένα με την αναλογία του επιδόματος αδείας, γι' αυτό το δώρο Χριστουγέννων είναι λίγο μεγαλύτερο από το μηνιάτικο. Η στήλη «καθαρά ανά καταβολή» προκύπτει από τον υπολογισμό με 14 ίσες καταβολές, όπως κάνουν όλοι οι υπολογιστές μισθού και η ίδια η παρακράτηση φόρου.</p>

  <h2>Γιατί 14 και όχι 12</h2>
  <p>Τα δύο δώρα εορτών και το επίδομα αδείας δεν είναι παροχή καλής θέλησης· είναι υποχρεωτικές αποδοχές για όλους τους μισθωτούς του ιδιωτικού τομέα, με κανόνες που παρακολουθεί η Επιθεώρηση Εργασίας. Το δώρο Χριστουγέννων πληρώνεται έως τις 21 Δεκεμβρίου, το δώρο Πάσχα έως τη Μεγάλη Τετάρτη, και το επίδομα αδείας μαζί με την έναρξη της κανονικής άδειας. Στην πράξη λοιπόν ο Δεκέμβριος φέρνει περίπου διπλό μισθό, ο Απρίλιος ή ο Μάιος, ανάλογα με το πότε πέφτει το Πάσχα, μιάμιση φορά τον μισθό, και ο μήνας της καλοκαιρινής άδειας άλλη μία ενίσχυση.</p>
  <p>Αυτή η κατανομή έχει πρακτική σημασία για τον οικογενειακό προϋπολογισμό. Όποιος βασίζει τα πάγια έξοδά του στο μηνιάτικο και αφήνει τα δώρα για ετήσιες υποχρεώσεις, όπως τα <a href={route('road', lang)}>τέλη κυκλοφορίας</a>, την ασφάλεια του αυτοκινήτου ή τον ΕΝΦΙΑ, έχει πιο ήρεμη χρονιά από εκείνον που υπολογίζει «τον μήνα» με τα ετήσια καθαρά διά 12. Οι κανόνες κάθε δώρου, η περίοδος αναφοράς και η αναλογία για όσους δεν δούλεψαν όλο το διάστημα βρίσκονται στις σελίδες για το <a href={route('christmas', lang)}>δώρο Χριστουγέννων</a>, το <a href={route('easter', lang)}>δώρο Πάσχα</a> και το <a href={route('leave', lang)}>επίδομα αδείας</a>.</p>

  <h2>Από ετήσια προσφορά σε μηνιαίο μισθό</h2>
  <ContentTable headers={['Ετήσια μικτά', 'Μηνιάτικο (÷14)', 'Λάθος μηνιάτικο (÷12)', 'Καθαρά ανά καταβολή', 'Καθαρά σε 12μηνη βάση']} align={['r', 'r', 'r', 'r', 'r']} rows={conv} />
  <p>Οι πολυεθνικές και οι αγγελίες στο εξωτερικό μιλούν συχνά για ετήσιο πακέτο, ενώ η ελληνική σύμβαση γράφει μηνιαίο μισθό. Η σωστή μετατροπή είναι η διαίρεση με το 14, και η τρίτη στήλη δείχνει πόσο παραπλανητική είναι η διαίρεση με το 12: σε {$(36000)} η διαφορά ξεπερνά τα {$(36000 / 12 - 36000 / 14)} μικτά τον μήνα. Όταν διαπραγματεύεστε, ρωτήστε ευθέως αν το ποσό που ακούτε είναι «επί 14» ή «επί 12», και αν περιλαμβάνει bonus που δεν είναι εγγυημένο.</p>
  <p>Η αντίστροφη πορεία ισχύει όταν κάποιος έρχεται από χώρα με 12 μισθούς. Ένα μηνιάτικο {$(g0 * 14 / 12)} σε 12 δόσεις αντιστοιχεί σε {$(g0)} σε 14 δόσεις. Τα ετήσια καθαρά είναι ίδια, {$(s0.netAnnual)}, όπως δείχνει και ο υπολογιστής παραπάνω· αλλάζει μόνο το πότε φτάνουν τα χρήματα στον λογαριασμό.</p>

  <div data-chrome><MiniSim client:load kind="fourteensplit" lang={lang} href={route('home', lang)} /></div>

  <h2>Ο φόρος δεν «τιμωρεί» τις 14 δόσεις</h2>
  <p>Μια παλιά παρανόηση λέει ότι τον Δεκέμβριο «κόβεται περισσότερος φόρος» λόγω δώρου. Σύμφωνα με το άρθρο 60 ΚΦΕ, ο εργοδότης ανάγει τις αποδοχές σε ετήσιες, εφαρμόζει την κλίμακα και τη μείωση φόρου και επιμερίζει τον ετήσιο φόρο στις καταβολές. Ο φόρος κάθε καταβολής είναι επομένως αναλογικός με το ποσό της: το δώρο Χριστουγέννων, που είναι λίγο μεγαλύτερο από το μηνιάτικο, έχει και λίγο μεγαλύτερη παρακράτηση, όχι υψηλότερο συντελεστή. Ο <a href={route('withholding', lang)}>οδηγός για την παρακράτηση φόρου</a> εξηγεί τον μηχανισμό αναλυτικά.</p>
  <p>Το ίδιο ισχύει για τις εισφορές e-ΕΦΚΑ: {F.efkaEe} σε κάθε καταβολή, δώρα και επίδομα αδείας συμπεριλαμβάνονται. Άρα, για να βρείτε τα καθαρά ενός δώρου, αρκεί να εφαρμόσετε τον ίδιο μέσο συντελεστή κρατήσεων με τον μισθό σας.</p>

  <h2>Ημερομίσθιοι, μερική απασχόληση και πρώτη χρονιά</h2>
  <p>Όσοι αμείβονται με ημερομίσθιο δεν μετρούν σε μηνιάτικα αλλά σε ημέρες: το δώρο Χριστουγέννων είναι {F.xmasDaily} ημερομίσθια, του Πάσχα {F.easterDaily} και το επίδομα αδείας έως {F.leaveDaily}. Ο <a href={route('daily', lang)}>οδηγός για το ημερομίσθιο</a> τα μετατρέπει σε ευρώ. Στη <a href={route('parttime', lang)}>μερική απασχόληση</a> οι αποδοχές, και μαζί τους η άδεια και το επίδομα αδείας, υπολογίζονται αναλογικά με τις ώρες που συμφωνήθηκαν.</p>
  <p>Στην πρώτη χρονιά σε νέα δουλειά, οι «14 μισθοί» σπάνια είναι ακριβώς 14. Αν ξεκινήσατε τον Ιούνιο, το δώρο Πάσχα της χρονιάς δεν σας αφορά και το δώρο Χριστουγέννων θα είναι αναλογικό για τις ημέρες από την πρόσληψη. Γι' αυτό, όταν συγκρίνετε δύο προσφορές με διαφορετική ημερομηνία έναρξης, μετρήστε τις πλήρεις χρονιές και όχι το πρώτο ημερολογιακό έτος. Για όλα τα υπόλοιπα, ο κύριος <a href={route('home', lang)}>υπολογισμός μισθού</a> δίνει τα καθαρά ανά καταβολή και σε 12μηνη βάση με ηλικία και παιδιά.</p>
</GuideLayout>
