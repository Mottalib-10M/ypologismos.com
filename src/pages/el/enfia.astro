---
import ToolCalc from '../../components/calc/ToolCalc';
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { enfia, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const $2 = (x: number) => formatMoney(x, 2, lang);
const d = (x: number) => F.dec(x, 2);
const E = P.enfia;
const Y = P.year;
// Παράδειγμα = προεπιλογές του υπολογιστή: 85 m², τιμή ζώνης 1.600 €, άδεια 1995, 2ος-3ος όροφος, μία πρόσοψη.
const ex = { sqm: 85, zone: 1600, year: 1995 };
const r = enfia({ sqm: ex.sqm, zonePrice: ex.zone, buildYear: ex.year, floor: 'f2_3', facades: 1 });
const rIns = enfia({ sqm: ex.sqm, zonePrice: ex.zone, buildYear: ex.year, floor: 'f2_3', facades: 1, insured: true });
const rAux = enfia({ sqm: ex.sqm, zonePrice: ex.zone, buildYear: ex.year, floor: 'f2_3', facades: 1, auxSqm: 12 });
const rHalf = enfia({ sqm: ex.sqm, zonePrice: ex.zone, buildYear: ex.year, floor: 'f2_3', facades: 1, share: 0.5 });
const rNew = enfia({ sqm: ex.sqm, zonePrice: ex.zone, buildYear: Y - 3, floor: 'f2_3', facades: 1 });
// Μεγάλη περιουσία: 160 m² σε ζώνη 4.200 €, άδεια 2012, 4ος όροφος, δύο προσόψεις.
const big = enfia({ sqm: 160, zonePrice: 4200, buildYear: 2012, floor: 'f4_5', facades: 2 });
const zoneRows = E.zone_bands.map((b, i) => {
  const from = i === 0 ? 0 : (E.zone_bands[i - 1].upTo as number) + 1;
  const probe = b.upTo ?? from;
  const m = enfia({ sqm: 80, zonePrice: probe, buildYear: 1990, floor: 'ground_1', facades: 0 });
  return [String(i + 1), b.upTo === null ? `από ${$(from)}` : `${$(from)} έως ${$(b.upTo)}`, $2(b.rate), $(m.mainBuilding)];
});
const ageRows: string[][] = [];
E.age_factors.forEach((a, i) => { const lo = i === 0 ? 0 : (E.age_factors[i - 1].maxYears as number) + 1; ageRows.push([a.maxYears === null ? `${lo} έτη και άνω` : lo === 0 ? `έως ${a.maxYears} έτη` : `${lo} έως ${a.maxYears} έτη`, d(a.factor)]); });
ageRows.push(['Κτίριο προ του 1930', d(E.age_factor_pre_1930)], ['Παλαιότητα άνω των 100 ετών', d(E.age_factor_over_100)]);
const FL = E.floor_factors;
const posRows = [['Υπόγειο', d(FL.basement)], ['Ισόγειο ή 1ος', d(FL.ground_1)], ['2ος ή 3ος', d(FL.f2_3)], ['4ος ή 5ος', d(FL.f4_5)], ['6ος και πάνω', d(FL.f6_up)], ['Μονοκατοικία (αντί ορόφου)', d(E.detached_factor)]];
const red = E.value_reductions;
const faqs = [
  { q: 'Πώς βγαίνει ο ΕΝΦΙΑ ενός διαμερίσματος 85 τετραγωνικών;', a: `Με τιμή ζώνης ${$(ex.zone)}, άδεια του ${ex.year} και 2ο όροφο με μία πρόσοψη: ${ex.sqm} m² × ${$2(r.basicRate)} βασικός φόρος × ${d(r.ageFactor)} παλαιότητα × ${d(r.positionFactor)} όροφος × ${d(r.facadeFactor)} πρόσοψη = ${$2(r.mainBuilding)} κύριος φόρος. Η αξία ${$(r.valueUsed)} δίνει μείωση ${F.pct(r.valueReductionRate)}, άρα ο ΕΝΦΙΑ πέφτει στα ${$(r.total)} τον χρόνο, αν δεν υπάρχει άλλο ακίνητο.` },
  { q: 'Η αποθήκη και η θέση στάθμευσης πληρώνουν ΕΝΦΙΑ;', a: `Ναι, ως βοηθητικοί χώροι, αλλά με συντελεστή ${d(E.auxiliary_factor)}, δηλαδή στο ένα δέκατο του φόρου ενός κύριου χώρου, και χωρίς συντελεστή πρόσοψης. Στο παράδειγμα των ${ex.sqm} m², μια αποθήκη 12 m² προσθέτει μόλις ${$2(rAux.auxiliary)} στον κύριο φόρο. Στο Ε9 οι βοηθητικοί χώροι δηλώνονται χωριστά από τους κύριους, και έτσι πρέπει να τους βάλετε και στον υπολογιστή.` },
  { q: 'Έχω το μισό σπίτι με τον αδερφό μου. Πληρώνω τον μισό φόρο;', a: `Για τον φόρο του κτίσματος ναι: ο κύριος φόρος πολλαπλασιάζεται με το ποσοστό συνιδιοκτησίας, οπότε στο παράδειγμα των ${ex.sqm} m² ο καθένας χρεώνεται ${$2(rHalf.mainBuilding)} πριν από τις εκπτώσεις. Οι μειώσεις όμως κρίνονται από τη συνολική αξία της περιουσίας του καθενός, άρα αν ο ένας έχει κι άλλα ακίνητα, το τελικό ποσό των δύο θα διαφέρει.` },
  { q: 'Γιατί ο υπολογιστής δεν βγάζει ακριβώς το ποσό του εκκαθαριστικού;', a: `Επειδή υπολογίζει ένα μόνο κτίσμα και, αν δεν δώσετε συνολική αξία, την εκτιμά ως εμβαδόν × τιμή ζώνης. Η φορολογητέα αξία της ΑΑΔΕ ακολουθεί περισσότερους συντελεστές, προσθέτει τα οικόπεδα και όλα τα ακίνητα του Ε9. Η αξία αυτή καθορίζει το ποσοστό μείωσης (από ${F.pct(red[0].rate)} έως ${F.pct(red[red.length - 1].rate)}), οπότε μια διαφορά στην αξία αλλάζει το αποτέλεσμα.` },
  { q: 'Από πόση περιουσία και πάνω προστίθεται φόρος επί της αξίας;', a: `Ο φόρος της Ενότητας Γ του άρθρου 11 εφαρμόζεται όταν η συνολική αξία ξεπερνά τις ${$(E.right_tax_from_value)}, αλλά το πρώτο κλιμάκιο έως ${$(E.right_tax_bands[0].upTo ?? 0)} έχει συντελεστή μηδέν. Πάνω από εκεί ο συντελεστής ξεκινά από ${F.pct(E.right_tax_bands[1].rate)} και φτάνει ${F.pct(E.right_tax_bands[E.right_tax_bands.length - 1].rate)}. Πάνω από ${$(E.surcharge_from_value)} μπαίνει και προσαύξηση από ${F.pct(E.value_surcharges[0].rate)} έως ${F.pct(E.value_surcharges[E.value_surcharges.length - 1].rate)}.` },
  { q: 'Μια ανακαίνιση με νέα οικοδομική άδεια ανεβάζει τον ΕΝΦΙΑ;', a: `Μπορεί. Η παλαιότητα μετριέται από την πιο πρόσφατη οικοδομική άδεια, όχι από το έτος που χτίστηκε αρχικά το κτίριο. Αν το ίδιο διαμέρισμα των ${ex.sqm} m² είχε άδεια του ${Y - 3}, ο συντελεστής θα ήταν ${d(rNew.ageFactor)} αντί για ${d(r.ageFactor)} και ο ΕΝΦΙΑ ${$(rNew.total)} αντί για ${$(r.total)}. Μικρές εργασίες χωρίς νέα άδεια δεν αλλάζουν τον συντελεστή.` },
];
---
<GuideLayout lang={lang} id="enfia" breadcrumbLabel={label('enfia', lang)}
  title={`ΕΝΦΙΑ ${Y}: υπολογισμός με τιμή ζώνης, όροφο και εκπτώσεις`}
  h1={`ΕΝΦΙΑ ${Y}: υπολογισμός του φόρου ακινήτου βήμα βήμα`}
  description={`ΕΝΦΙΑ ${Y}: υπολογίστε τον φόρο του ακινήτου σας από τετραγωνικά, τιμή ζώνης, παλαιότητα και όροφο, με τις μειώσεις έως ${F.pct(red[0].rate)}, την ασφάλιση και τα χωριά.`}
  intro={`Ο ΕΝΦΙΑ ενός κτίσματος προκύπτει από πέντε στοιχεία του Ε9 και τρεις πιθανές μειώσεις, όλα ορισμένα στον Κώδικα Φορολογίας Περιουσίας.`}
  resume={`Ο ΕΝΦΙΑ ${Y} ενός διαμερίσματος ${ex.sqm} τετραγωνικών σε τιμή ζώνης ${$(ex.zone)}, με οικοδομική άδεια του ${ex.year}, στον 2ο όροφο και με μία πρόσοψη, είναι ${$(r.total)} τον χρόνο, αν ο ιδιοκτήτης δεν έχει άλλο ακίνητο. Ο λογαριασμός ξεκινά από τον βασικό φόρο της φορολογικής ζώνης, ${$2(r.basicRate)} ανά τετραγωνικό για τιμές ζώνης ${$(E.zone_bands[1].upTo as number + 1)} έως ${$(E.zone_bands[2].upTo as number)}, που πολλαπλασιάζεται με τα τετραγωνικά και τους συντελεστές παλαιότητας, ορόφου και πρόσοψης: ${$2(r.mainBuilding)} κύριος φόρος. Επειδή η συνολική αξία, ${$(r.valueUsed)}, μένει κάτω από τις ${$(red[1].upTo)}, ο φόρος μειώνεται κατά ${F.pct(r.valueReductionRate)}. Αν το σπίτι ήταν ασφαλισμένο πέρυσι για σεισμό, πυρκαγιά και πλημμύρα, η επιπλέον μείωση ${F.insurance} το κατεβάζει στα ${$(rIns.total)}, και για κύρια κατοικία σε μικρό οικισμό το ${Y} κόβεται ακόμη στο μισό. Πάνω από ${$(E.right_tax_from_value)} συνολικής αξίας προστίθεται φόρος επί της αξίας και πάνω από ${$(E.surcharge_from_value)} προσαύξηση. Ο υπολογιστής κάνει όλα αυτά τα βήματα για το δικό σας ακίνητο.`}
  faqs={faqs}
  related={[{ href: route('enfiadisc', lang), name: label('enfiadisc', lang), description: `Μειώσεις από ${F.pct(red[red.length - 1].rate)} έως ${F.pct(red[0].rate)} και οι απαλλαγές χαμηλού εισοδήματος.` }, { href: route('zone', lang), name: label('zone', lang), description: 'Οι εννέα φορολογικές ζώνες και πού βρίσκετε την τιμή σας.' }, { href: route('home', lang), name: label('home', lang), description: 'Καθαρός μισθός, για να δείτε πόσο βαραίνει ο φόρος τον προϋπολογισμό.' }]}
  sources={[src('enfia', lang), { name: 'Κώδικας Φορολογίας Περιουσίας (ν. 5219/2025), άρθρο 8: αντικείμενο του ΕΝΦΙΑ και δικαιώματα της 1ης Ιανουαρίου', url: 'https://www.taxheaven.gr/law/5219/2025/article/8/view' }, src('enfia_reductions', lang), src('enfia_exemptions', lang), src('enfia_2026', lang)]}>
  <div data-outil><ToolCalc client:load kind="enfia" lang={lang} methodHref={route('method', lang)} /></div>

  <h2>Ο τύπος του άρθρου 11, με το παράδειγμα του υπολογιστή</h2>
  <p>Το άρθρο 11 του Κώδικα Φορολογίας Περιουσίας (ν. 5219/2025) ορίζει τον κύριο φόρο ενός κτίσματος ως γινόμενο: επιφάνεια × βασικός φόρος × συντελεστής παλαιότητας × συντελεστής ορόφου ή μονοκατοικίας × συντελεστής πρόσοψης, και για τους βοηθητικούς χώρους επιπλέον × {d(E.auxiliary_factor)}. Δεν υπάρχει πρόσθεση πουθενά: κάθε παράγοντας μεγαλώνει ή μικραίνει το προηγούμενο αποτέλεσμα.</p>
  <p>Με τα στοιχεία που φορτώνει ο υπολογιστής όταν ανοίγει, τα βήματα είναι αυτά. Πρώτα η τιμή ζώνης των {$(ex.zone)} κατατάσσει το ακίνητο στην 3η φορολογική ζώνη, με βασικό φόρο {$2(r.basicRate)} ανά τετραγωνικό. Τα {ex.sqm} τετραγωνικά δίνουν {$2(ex.sqm * r.basicRate)}. Η άδεια του {ex.year} σημαίνει παλαιότητα {r.ageYears} ετών το {Y}, άρα συντελεστής {d(r.ageFactor)}, χωρίς αλλαγή. Ο 2ος όροφος προσθέτει {F.pct(r.positionFactor - 1)} (συντελεστής {d(r.positionFactor)}) και η μία πρόσοψη άλλο {F.pct(r.facadeFactor - 1)}. Αποτέλεσμα: {$2(r.mainBuilding)} κύριος φόρος.</p>
  <p>Στο ποσό αυτό εφαρμόζονται μετά οι μεταβολές λόγω αξίας. Η εκτιμώμενη αξία, {ex.sqm} m² × {$(ex.zone)} = {$(r.estimatedValue)}, πέφτει στο κλιμάκιο έως {$(red[1].upTo)}, οπότε ο φόρος μειώνεται κατά {F.pct(r.valueReductionRate)} και γίνεται {$2(r.total)}. Αυτό είναι το ετήσιο ποσό. Ο υπολογιστής δεν δίνει ημερομηνίες έκδοσης ή πληρωμής, γιατί αυτές ορίζονται κάθε χρόνο από τη Φορολογική Διοίκηση και δεν τις έχουμε επιβεβαιώσει σε επίσημη πηγή.</p>

  <h2>Οι εννέα φορολογικές ζώνες</h2>
  <ContentTable headers={['Ζώνη', 'Τιμή ζώνης (€/m²)', 'Βασικός φόρος ανά m²', 'Κύριος φόρος 80 m² στο ανώτατο της ζώνης']} align={['l', 'l', 'r', 'r']} rows={zoneRows} highlightRow={2} />
  <p>Η τελευταία στήλη αφορά ισόγειο ή 1ο όροφο χωρίς πρόσοψη, παλαιότερο των 25 ετών, πριν από οποιαδήποτε μείωση, για να φαίνεται μόνο η επίδραση της ζώνης. Το άλμα που προσέχουν λίγοι βρίσκεται ανάμεσα στην 4η και την 5η ζώνη: ο βασικός φόρος ανεβαίνει από {$2(E.zone_bands[3].rate)} σε {$2(E.zone_bands[4].rate)}, δηλαδή σχεδόν διπλασιάζεται για ένα ευρώ διαφορά στην τιμή ζώνης. Γι' αυτό δύο γειτονικά διαμερίσματα, σε δρόμους με διαφορετική τιμή, μπορεί να πληρώνουν πολύ διαφορετικό ΕΝΦΙΑ. Για το τι είναι η τιμή ζώνης και πού την βρίσκετε, δείτε τον <a href={route('zone', lang)}>οδηγό για την τιμή ζώνης</a>.</p>

  <h2>Παλαιότητα, όροφος και προσόψεις</h2>
  <ContentTable headers={['Παλαιότητα κτίσματος', 'Συντελεστής']} align={['l', 'r']} rows={ageRows} />
  <p>Η παλαιότητα είναι η διαφορά ανάμεσα στο έτος φορολογίας και το έτος της νεότερης οικοδομικής άδειας. Αν άδεια δεν υπάρχει, λαμβάνεται το έτος κατασκευής από δημόσιο έγγραφο, και αν λείπει κι αυτό, το έτος που το κτίσμα δηλώθηκε στο Ε9. Ένα καινούργιο σπίτι φορολογείται έως {F.pct(E.age_factors[0].factor - 1)} ακριβότερα από ένα που έχει περάσει τα 25 χρόνια, ενώ τα πολύ παλιά κτίρια κερδίζουν έκπτωση.</p>
  <ContentTable headers={['Θέση', 'Συντελεστής']} align={['l', 'r']} rows={posRows} />
  <p>Αν ένα διαμέρισμα απλώνεται σε περισσότερους ορόφους, μετράει ο ψηλότερος. Η μονοκατοικία δεν παίρνει συντελεστή ορόφου αλλά τον δικό της, {d(E.detached_factor)}. Οι προσόψεις προσθέτουν {d(E.facade_factors[1])} για μία και {d(E.facade_factors[2])} για δύο ή περισσότερες, όχι όμως στους βοηθητικούς χώρους. Στον υπολογιστή, η επιλογή «Μονοκατοικία» αντικαθιστά τον όροφο.</p>

  <h2>Μειώσεις, προσαύξηση και φόρος επί της αξίας</h2>
  <p>Η μείωση λόγω συνολικής αξίας του άρθρου 13 είναι κλιμακωτή: {F.pct(red[0].rate)} έως {$(red[0].upTo)}, {F.pct(red[1].rate)} έως {$(red[1].upTo)}, {F.pct(red[2].rate)} έως {$(red[2].upTo)}, {F.pct(red[3].rate)} έως {$(red[3].upTo)} και {F.pct(red[4].rate)} έως {$(red[4].upTo)}. Το ποσοστό ισχύει για όλο τον φόρο, όχι μόνο για το κομμάτι της αξίας μέσα σε κάθε κλιμάκιο, οπότε ένα ευρώ πάνω από ένα όριο μπορεί να κοστίσει δεκάδες ευρώ φόρου. Οι λεπτομέρειες, μαζί με τις εκπτώσεις 50 % και 100 % για χαμηλά εισοδήματα, βρίσκονται στον οδηγό για την <a href={route('enfiadisc', lang)}>έκπτωση ΕΝΦΙΑ</a>.</p>
  <p>Δύο ακόμη μειώσεις αφορούν συγκεκριμένα ακίνητα. Η κατοικία που ήταν ασφαλισμένη το προηγούμενο έτος για σεισμό, πυρκαγιά και πλημμύρα παίρνει {F.insurance} αν η αξία της δεν ξεπερνά τις {$(E.insurance_value_limit)} και {F.insuranceHigh} πάνω από αυτό (άρθρο 10 παρ. 5). Για το {Y}, η κύρια κατοικία σε οικισμό έως {F.villagePop} κατοίκων εκτός ηπειρωτικής Αττικής, με αξία έως {F.villageValue}, πληρώνει {F.village} λιγότερο (άρθρο 17 παρ. 3), ενώ για ορισμένες παραμεθόριες περιοχές το όριο είναι {F.villagePopBorder} κάτοικοι.</p>
  <p>Στις μεγάλες περιουσίες ο φόρος βαραίνει από δύο πλευρές. Όταν η συνολική αξία ξεπερνά τις {$(E.right_tax_from_value)}, υπολογίζεται και φόρος επί της αξίας κάθε δικαιώματος, με μηδενικό συντελεστή έως {$(E.right_tax_bands[0].upTo ?? 0)} και κλιμάκια από {F.pct(E.right_tax_bands[1].rate)} έως {F.pct(E.right_tax_bands[E.right_tax_bands.length - 1].rate)}. Πάνω από {$(E.surcharge_from_value)} ο συνολικός φόρος προσαυξάνεται κατά {F.pct(E.value_surcharges[0].rate)} έως {F.pct(E.value_surcharges[E.value_surcharges.length - 1].rate)}. Ένα διαμέρισμα 160 m² σε ζώνη {$(4200)}, με άδεια του 2012, στον 4ο όροφο και με δύο προσόψεις, έχει εκτιμώμενη αξία {$(big.valueUsed)}: {$(big.mainBuilding)} φόρος κτίσματος, {$(big.rightTax)} φόρος επί της αξίας, προσαύξηση {F.pct(big.surchargeRate)}, σύνολο {$(big.total)}.</p>

  <div data-chrome><MiniSim client:load kind="enfiavalue" lang={lang} href={route('enfia', lang)} /></div>

  <h2>Τρία λάθη που αλλάζουν το αποτέλεσμα</h2>
  <p>Το πιο συχνό είναι να γράψει κανείς στον υπολογιστή τα «τετραγωνικά του συμβολαίου», ενώ ο φόρος μετρά την επιφάνεια κύριων χώρων όπως δηλώθηκε στο Ε9, χωριστά από τους βοηθητικούς· τα δύο νούμερα δεν συμπίπτουν πάντα. Στο παράδειγμά μας, δέκα τετραγωνικά παραπάνω ανεβάζουν τον κύριο φόρο κατά {$2(10 * r.basicRate * r.ageFactor * r.positionFactor * r.facadeFactor)}, πριν από τη μείωση.</p>
  <p>Το δεύτερο αφορά την τιμή ζώνης. Ο νόμος παίρνει την τιμή που ισχύει την 1η Ιανουαρίου του έτους φορολογίας· μια αναπροσαρμογή που δημοσιεύεται αργότερα μέσα στη χρονιά επηρεάζει τον ΕΝΦΙΑ της επόμενης. Και ένα κτίσμα σε περιοχή χωρίς τιμή ζώνης δεν φορολογείται με μηδέν: εντάσσεται στη χαμηλότερη τιμή ζώνης της δημοτικής του ενότητας, κι αν δεν υπάρχει ούτε εκεί, του δήμου ή της περιφερειακής ενότητας.</p>
  <p>Το τρίτο είναι να ξεχάσει κανείς ότι οι μειώσεις λόγω αξίας κοιτάζουν όλη την περιουσία. Ένα μικρό διαμέρισμα στην πόλη μπορεί να μείνει χωρίς τη μείωση των {F.pct(red[0].rate)}, επειδή ο ιδιοκτήτης έχει και ένα εξοχικό που σπρώχνει τη συνολική αξία πάνω από τις {$(red[0].upTo)}. Αν δεν θυμάστε την αξία όλων των ακινήτων σας, βάλτε μια συντηρητική εκτίμηση στο πεδίο «Συνολική αξία ακινήτων» και δείτε πώς αλλάζει το ποσοστό μείωσης στο αποτέλεσμα.</p>

  <h2>Τι προσεγγίζει ο υπολογιστής, και τι όχι</h2>
  <p>Ο υπολογιστής εφαρμόζει πιστά τους συντελεστές του άρθρου 11 και τα ποσοστά των άρθρων 10, 13 και 17, όπως ισχύουν το {Y}. Υπάρχουν όμως τέσσερα σημεία όπου το αποτέλεσμα είναι εκτίμηση και όχι αντίγραφο του εκκαθαριστικού.</p>
  <p>Πρώτο, υπολογίζει ένα κτίσμα τη φορά. Αν έχετε δύο διαμερίσματα, πρέπει να τα περάσετε χωριστά και να βάλετε και στα δύο τη συνολική αξία όλης της περιουσίας, γιατί από αυτή κρίνονται η μείωση και η προσαύξηση. Δεύτερο, όταν δεν συμπληρώνετε αξία, την εκτιμά ως τετραγωνικά × τιμή ζώνης. Η πραγματική φορολογητέα αξία ακολουθεί το σύστημα των αντικειμενικών αξιών, με δικούς του συντελεστές για όροφο, παλαιότητα και πρόσοψη, οπότε μπορεί να είναι μεγαλύτερη ή μικρότερη· αν είστε κοντά σε όριο μείωσης, η διαφορά μετράει. Τρίτο, δεν υπολογίζει οικόπεδα και γήπεδα, που έχουν δική τους κλίμακα (Ενότητα Β του άρθρου 11), ούτε ημιτελή ή ειδικά κτίρια. Τέταρτο, δεν ελέγχει ούτε τις εκπτώσεις χαμηλού εισοδήματος ούτε τις απαλλαγές λόγω σεισμών ή πυρκαγιών σε συγκεκριμένες περιοχές.</p>
  <p>Όποιος ψάχνει «ενφια υπολογισμος» ή «enfia ypologismos» συνήθως θέλει να ξέρει αν το ποσό που του ήρθε είναι λογικό. Γι' αυτή τη χρήση ο υπολογιστής αρκεί: αν η εκτίμησή του απέχει πολύ από το εκκαθαριστικό, ελέγξτε πρώτα στο Ε9 τα τετραγωνικά, το έτος άδειας και τον όροφο, γιατί εκεί γίνονται τα περισσότερα λάθη δήλωσης. Αν σας απασχολεί η ασφάλιση, ο οδηγός για την <a href={route('enfiains', lang)}>ασφάλιση κατοικίας και τον ΕΝΦΙΑ</a> δείχνει πώς υπολογίζεται η αναλογική μείωση.</p>
