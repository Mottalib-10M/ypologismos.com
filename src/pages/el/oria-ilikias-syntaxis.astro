---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { pension, nationalPension, PARAMS as P } from '../../lib/engine/gr';
import { REDUCED_NATIONAL_PER_MONTH } from '../../lib/mini-extra-f';
import { formatMoney, formatNumber, pct } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const $2 = (x: number) => formatMoney(x, 2, lang);
const p = (x: number) => pct(x, lang);
const Q = P.pension;
const full = Q.full_age, red = Q.reduced_age, a40 = Q.full_age_40_years, minY = Q.min_years;
const days40 = 12000, perYear = days40 / 40; // Υπουργείο Εργασίας : « 40 ετών ασφάλισης (12.000) ημερών » (pension_ministry, lu le 2026-10-03)
const routes = [[`${full}`, `${minY} έτη (${formatNumber(minY * perYear, 0, lang)} ημέρες)`, 'Πλήρης'], [`${a40}`, `40 έτη (${formatNumber(days40, 0, lang)} ημέρες)`, 'Πλήρης'], [`${red}`, `${minY} έτη και πρόσφατος ασφαλιστικός δεσμός`, 'Μειωμένη']];
const natFull = nationalPension(Q.national_years_full);
const maxM = (full - red) * 12;
const early = [0, 6, 12, 24, 36, 48, maxM].map((m) => { const c = m * REDUCED_NATIONAL_PER_MONTH; return [m === 0 ? `στα ${full}` : `${m} μήνες νωρίτερα`, p(c), $2(natFull * (1 - c)), m === 0 ? '–' : `−${$2(natFull * c)}`]; });
const avg = 1400;
const more = [30, 32, 34, 36, 38, 40, 42].map((y) => { const a = pension({ years: y, avgEarnings: avg }), b = pension({ years: y + 1, avgEarnings: avg }); return [`${y}`, $(a.total), `+${$(b.total - a.total)}`]; });
const p40 = pension({ years: 40, avgEarnings: avg }), p35 = pension({ years: 35, avgEarnings: avg });
const faqs = [
  { q: `Είμαι ${red} ετών με 40 χρόνια ένσημα. Παίρνω πλήρη σύνταξη ή μειωμένη;`, a: `Πλήρη. Το Υπουργείο Εργασίας αναφέρει ως γενική προϋπόθεση τη συμπλήρωση 40 ετών ασφάλισης, δηλαδή ${formatNumber(days40, 0, lang)} ημερών, και του ${a40}ου έτους της ηλικίας. Σε αυτή την περίπτωση δεν εφαρμόζεται η μείωση της μειωμένης σύνταξης. Με μέσο μισθό ${$(avg)}, 40 έτη δίνουν περίπου ${$(p40.total)} μικτά τον μήνα με τους κανόνες των άρθρων 7 και 8.` },
  { q: `Αν φύγω στα ${red} με 25 χρόνια ασφάλισης, πόσα χάνω;`, a: `Θα πάρετε μειωμένη σύνταξη, ${maxM} μήνες πριν από τα ${full}. Στην εθνική σύνταξη η περικοπή είναι 1/200 ανά μήνα, δηλαδή ${p(maxM * REDUCED_NATIONAL_PER_MONTH)}: από ${$2(natFull)} σε ${$2(natFull * (1 - maxM * REDUCED_NATIONAL_PER_MONTH))} με βάση το ποσό του 2025. Για το ανταποδοτικό μέρος της μειωμένης σύνταξης ισχύουν άλλες διατάξεις, που δεν υπολογίζουμε εδώ.` },
  { q: 'Πόσες ημέρες ασφάλισης είναι ένα έτος για τη σύνταξη;', a: `Τριακόσιες. Το Υπουργείο γράφει «40 ετών ασφάλισης (${formatNumber(days40, 0, lang)}) ημερών» και, για τη σύνταξη αναπηρίας, «15 έτη (ή ${formatNumber(minY * perYear, 0, lang)} ημέρες)». Άρα τα ${minY} έτη που χρειάζονται για σύνταξη στα ${full} αντιστοιχούν σε ${formatNumber(minY * perYear, 0, lang)} ημέρες ένσημα. Ο λογαριασμός χρειάζεται όταν συγκρίνετε το ασφαλιστικό σας βιογραφικό, που δείχνει ημέρες, με τα όρια της σύνταξης, που διατυπώνονται σε έτη.` },
  { q: `Τι σημαίνει «πρόσφατος ασφαλιστικός δεσμός» για τη μειωμένη στα ${red};`, a: `Είναι πρόσθετη προϋπόθεση που αναφέρει το Υπουργείο Εργασίας για τη μειωμένη σύνταξη στα ${red}, και αφορά μισθωτούς του ιδιωτικού τομέα, των ΔΕΚΟ και των τραπεζών. Το ακριβές περιεχόμενό της, δηλαδή πόσες ημέρες και σε ποια χρόνια, δεν το έχουμε επαληθεύσει· ζητήστε το από τον e-ΕΦΚΑ πριν σταματήσετε να εργάζεστε.` },
  { q: 'Αξίζει να δουλέψω δύο χρόνια ακόμη μετά τα 35 έτη ασφάλισης;', a: `Με μέσο μισθό ${$(avg)}, η σύνταξη ανεβαίνει από ${$(p35.total)} στα 35 έτη σε ${$(pension({ years: 37, avgEarnings: avg }).total)} στα 37, δηλαδή ${$(pension({ years: 37, avgEarnings: avg }).total - p35.total)} τον μήνα για όλη τη ζωή. Τα έτη από το 34ο ως το 40ό είναι τα πιο ακριβά του πίνακα αναπλήρωσης. Μετά τα 40 η αύξηση πέφτει απότομα, και η εθνική σύνταξη δεν αλλάζει.` },
];
---
<GuideLayout lang={lang} id="retireage" breadcrumbLabel={label('retireage', lang)}
  title={`Όρια ηλικίας σύνταξης ${F.year}: ${full}, ${red} ή ${a40} με 40 έτη ένσημα`}
  h1={`Όρια ηλικίας σύνταξης ${F.year}: πλήρης στα ${full}, μειωμένη στα ${red}, πλήρης στα ${a40} με 40 έτη`}
  description={`Όρια ηλικίας σύνταξης ${F.year}: ${full} με ${minY} έτη ασφάλισης, ${a40} με 40 έτη (${formatNumber(days40, 0, lang)} ημέρες), μειωμένη στα ${red} με −1/200 της εθνικής ανά μήνα. Πίνακες και κόστος σε ευρώ.`}
  intro={`Οι γενικές προϋποθέσεις σύνταξης γήρατος του e-ΕΦΚΑ και το κόστος της πρόωρης εξόδου.`}
  resume={`Τα γενικά όρια ηλικίας για σύνταξη γήρατος, όπως τα δημοσιεύει το Υπουργείο Εργασίας για τον ιδιωτικό και τον δημόσιο τομέα, είναι τρία. Πλήρης σύνταξη στα ${full} με τουλάχιστον ${minY} έτη ασφάλισης. Πλήρης σύνταξη στα ${a40} με 40 έτη ασφάλισης, δηλαδή ${formatNumber(days40, 0, lang)} ημέρες. Μειωμένη σύνταξη στα ${red} με ${minY} έτη, όπου για τους μισθωτούς του ιδιωτικού τομέα, των ΔΕΚΟ και των τραπεζών απαιτείται και πρόσφατος ασφαλιστικός δεσμός. Στη μειωμένη, η εθνική σύνταξη κόβεται κατά 1/200 για κάθε μήνα που λείπει ως τα ${full}: με ${maxM} μήνες νωρίτερα η μείωση είναι ${p(maxM * REDUCED_NATIONAL_PER_MONTH)} και η πλήρης εθνική σύνταξη των ${F.nationalFull} πέφτει στα ${$2(natFull * (1 - maxM * REDUCED_NATIONAL_PER_MONTH))}. Για τα βαρέα και ανθυγιεινά επαγγέλματα και για όσους ασφαλίστηκαν πριν από το 1993 ισχύουν ειδικές προϋποθέσεις, ενώ οι ένστολοι ακολουθούν τη νομοθεσία του Δημοσίου. Με μέσο μισθό ${$(avg)}, κάθε έτος μεταξύ 34 και 40 προσθέτει γύρω στα ${$(pension({ years: 38, avgEarnings: avg }).total - pension({ years: 37, avgEarnings: avg }).total)} τον μήνα.`}
  faqs={faqs}
  related={[{ href: route('pension', lang), name: label('pension', lang), description: 'Πόση σύνταξη δίνουν τα έτη σας.' }, { href: route('national', lang), name: label('national', lang), description: 'Η εθνική σύνταξη και οι μειώσεις της.' }, { href: route('sevold', lang), name: label('sevold', lang), description: 'Η αποζημίωση όταν φεύγετε για σύνταξη.' }]}
  sources={[src('pension_ministry', lang), src('pension_national', lang), src('pension', lang)]}>
  <div data-chrome><MiniSim client:load kind="retireage" lang={lang} href={route('pension', lang)} /></div>

  <h2>Οι τρεις δρόμοι προς τη σύνταξη γήρατος</h2>
  <ContentTable headers={['Ηλικία', 'Ασφάλιση', 'Σύνταξη']} align={['l', 'l', 'l']} rows={routes} />
  <p>Αυτές είναι οι «γενικές προϋποθέσεις συνταξιοδότησης» που παρουσιάζει το Υπουργείο Εργασίας, κάτω από τον τίτλο «για όλους τους ασφαλισμένους του ιδιωτικού και του δημόσιου τομέα». Η πρώτη γραμμή είναι ο κανόνας. Η δεύτερη ανταμείβει τη μεγάλη καριέρα: όποιος έχει 40 έτη μπορεί να πάρει πλήρη σύνταξη {full - a40} χρόνια νωρίτερα. Η τρίτη είναι η μόνη που οδηγεί σε μειωμένη σύνταξη, με μόνιμη περικοπή.</p>
  <p>Τα έτη μετρώνται σε ημέρες ασφάλισης, με 300 ημέρες για κάθε έτος: τα 40 έτη είναι {formatNumber(days40, 0, lang)} ημέρες και τα {minY} έτη {formatNumber(minY * perYear, 0, lang)}. Για να δείτε πού βρίσκεστε, μετρήστε τις ημέρες στο ασφαλιστικό σας βιογραφικό και όχι τα ημερολογιακά χρόνια από την πρώτη πρόσληψη.</p>

  <h2>Τι κοστίζει η μειωμένη σύνταξη στην εθνική</h2>
  <ContentTable headers={['Έξοδος', 'Μείωση εθνικής', 'Εθνική σύνταξη', 'Διαφορά τον μήνα']} align={['l', 'r', 'r', 'r']} rows={early} />
  <p>Το άρθρο 7 παράγραφος 3 του ν. 4387/2016 ορίζει ότι η εθνική σύνταξη όσων παίρνουν μειωμένη σύνταξη εξ ιδίου δικαιώματος μειώνεται κατά 1/200 για κάθε μήνα που υπολείπεται για τη συμπλήρωση του ορίου ηλικίας της πλήρους. Ο πίνακας εφαρμόζει τον κανόνα στο πλήρες ποσό του 2025, για {Q.national_years_full} έτη ασφάλισης και πλήρη διαμονή. Η μείωση είναι μόνιμη: δεν επανέρχεται όταν ο συνταξιούχος φτάσει τα {full}.</p>
  <p>Ο πίνακας δεν δείχνει τη μείωση του ανταποδοτικού μέρους, που ακολουθεί άλλες διατάξεις τις οποίες δεν έχουμε επαληθεύσει. Το πραγματικό κόστος της πρόωρης εξόδου είναι επομένως μεγαλύτερο από την τελευταία στήλη.</p>

  <div data-chrome><MiniSim client:load kind="earlyret" lang={lang} href={route('national', lang)} /></div>

  <h2>Ένα έτος ακόμη: πόσο αλλάζει η σύνταξη</h2>
  <ContentTable headers={['Έτη ασφάλισης', `Σύνταξη (μέσος μισθός ${$(avg)})`, 'Με ένα έτος ακόμη']} align={['l', 'r', 'r']} rows={more} highlightRow={2} />
  <p>Η απόφαση «φεύγω τώρα ή σε έναν χρόνο» κρίνεται συχνά σε αυτόν τον πίνακα. Μεταξύ 34 και 40 ετών ασφάλισης κάθε έτος προσθέτει το μεγαλύτερο ποσοστό του πίνακα αναπλήρωσης. Μετά τα 40 η αύξηση γίνεται μικρή, γιατί κάθε επιπλέον έτος μετράει μόνο {p(Q.replacement_rates[Q.replacement_rates.length - 1].rate)}. Ένα έτος ακόμη μπορεί επίσης να σας περάσει από τη μειωμένη στην πλήρη σύνταξη, αν συμπληρώνει τα 40 έτη στα {a40} ή φέρνει την ηλικία πιο κοντά στα {full}.</p>

  <h2>Ειδικές κατηγορίες που δεν καλύπτουμε</h2>
  <p>Για όσους υπάγονται στον Κανονισμό Βαρέων και Ανθυγιεινών Επαγγελμάτων, το Υπουργείο αναφέρει πλήρη σύνταξη στα {a40} με ειδικές προϋποθέσεις ημερών ασφάλισης στα βαρέα και ασφαλιστικό δεσμό ανάλογα με τον φορέα, και για τους παλαιούς ασφαλισμένους δυνατότητα μειωμένης νωρίτερα. Για όσους ασφαλίστηκαν μέχρι τις 31.12.1992 ισχύουν επιπλέον ειδικότερες προϋποθέσεις που διαφέρουν ανά φορέα ή για το Δημόσιο. Οι ένστολοι κρατούν τα όρια ηλικίας της συνταξιοδοτικής νομοθεσίας του Δημοσίου, όπως εξηγεί η σελίδα για τη <a href={route('uniformed', lang)}>σύνταξη ενστόλων</a>. Σε όλες αυτές τις περιπτώσεις τα όρια της σελίδας δεν αρκούν· χρειάζεται βεβαίωση από τον e-ΕΦΚΑ.</p>

  <h2>Πριν υποβάλετε αίτηση</h2>
  <p>Ελέγξτε τρία πράγματα: τις ημέρες ασφάλισης στο βιογραφικό σας, την ημερομηνία που συμπληρώνετε την ηλικία, και αν ανήκετε σε κάποια ειδική κατηγορία. Αν είστε μισθωτός και σκέφτεστε αποχώρηση, θυμηθείτε ότι η έξοδος λόγω θεμελίωσης πλήρους σύνταξης δίνει μέρος της αποζημίωσης, όπως εξηγεί ο οδηγός για την <a href={route('sevold', lang)}>αποζημίωση παλαιών υπαλλήλων</a>. Το ποσό της σύνταξης με τα δικά σας στοιχεία βγαίνει από τον <a href={route('pension', lang)}>υπολογισμό σύνταξης</a>, και οι εισφορές που μετράνε στα έτη σας φαίνονται στον <a href={route('home', lang)}>υπολογισμό μισθού</a>.</p>
</GuideLayout>
