---
import ToolCalc from '../../components/calc/ToolCalc';
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { salary, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const $2 = (x: number) => formatMoney(x, 2, lang);
const Y = P.year;
const C = P.efka.ceiling_monthly;
const G = 1500;
const s = salary({ gross: G });
const mw = salary({ gross: P.minimum_wage.monthly });
const grosses = [P.minimum_wage.monthly, 1200, 1500, 2000, 3000, 5000, C, 10000];
const rows = grosses.map((g) => { const x = salary({ gross: g }); return [g === C ? `${$2(g)} (πλαφόν)` : $(g), $2(x.employer), $(x.cost), $(x.costAnnual), $(x.net), $2(x.cost / x.net)]; });
const maxEr = C * P.efka.employer_rate;
const big = salary({ gross: 10000 });
const s12 = salary({ gross: G * 14 / 12, payments: 12 });
const BUD = 2000; const bg = BUD / (1 + P.efka.employer_rate); const bs = salary({ gross: bg });
const faqs = [
  { q: `Πόσο κοστίζει στον εργοδότη ένας υπάλληλος με ${$(G)} μικτά;`, a: `Πάνω από τα ${$(G)} μικτά ο εργοδότης πληρώνει ${$2(s.employer)} εισφορές (${F.efkaEr}), άρα ${$(s.cost)} ανά καταβολή. Με 14 καταβολές το ετήσιο κόστος φτάνει ${$(s.costAnnual)}. Ο εργαζόμενος από αυτά κρατά ${$(s.net)} καθαρά ανά καταβολή, αν είναι άνω των 30 χωρίς παιδιά, δηλαδή ${F.pct(s.net / s.cost)} του κόστους.` },
  { q: `Τι περιλαμβάνει η εργοδοτική εισφορά ${F.efkaEr};`, a: `Είναι το ποσοστό του εργοδότη στο γενικό πακέτο κάλυψης ΚΠΚ ${F.kpk} του e-ΕΦΚΑ, που αφορά τους περισσότερους μισθωτούς του ιδιωτικού τομέα. Καλύπτει κύρια και επικουρική σύνταξη, υγεία, όπου το μερίδιο του εργοδότη είναι ${F.efkaHealthEr}, και τους κλάδους της ΔΥΠΑ. Ισχύει από 1.1.2025, μετά τη μείωση κατά μισή μονάδα στην υγεία, και παραμένει ίδιο το ${Y}.` },
  { q: 'Πάνω από ποιο μισθό σταματούν να αυξάνονται οι εισφορές του εργοδότη;', a: `Πάνω από το πλαφόν των ${F.ceiling} τον μήνα, που ισχύει από 1.1.${Y} σύμφωνα με την εγκύκλιο 4/${Y} του e-ΕΦΚΑ. Η μέγιστη εργοδοτική εισφορά είναι ${$2(maxEr)} ανά καταβολή. Για μισθό ${$(10000)} μικτά, το κόστος είναι ${$(big.cost)} και όχι ${$(10000 * (1 + P.efka.employer_rate))}, γιατί το τμήμα πάνω από το πλαφόν δεν επιβαρύνεται.` },
  { q: 'Πληρώνει ο εργοδότης εισφορές και στα δώρα και στο επίδομα αδείας;', a: `Ναι. Το δώρο Χριστουγέννων, το δώρο Πάσχα και το επίδομα αδείας είναι αποδοχές και επιβαρύνονται με τις ίδιες εισφορές ${F.efkaEr}. Γι' αυτό ο υπολογιστής πολλαπλασιάζει το κόστος ανά καταβολή επί 14. Για μισθό ${$(G)}, οι τρεις επιπλέον καταβολές κοστίζουν στην επιχείρηση περίπου ${$(s.cost * 2)} τον χρόνο, αφού ισοδυναμούν με δύο μισθούς.` },
  { q: 'Πόσα πρέπει να πληρώσει η επιχείρηση για να πάρει ο εργαζόμενος 1 € καθαρό;', a: `Εξαρτάται από τον μισθό. Στον κατώτατο, ${F.minWage}, κάθε ευρώ καθαρό κοστίζει ${$2(mw.cost / mw.net)}. Στα ${$(G)} μικτά ανεβαίνει στα ${$2(s.cost / s.net)}, και στα ${$(10000)} φτάνει ${$2(big.cost / big.net)}, επειδή ο φόρος εισοδήματος γίνεται βαρύτερος όσο ανεβαίνει ο μισθός. Πάνω από το πλαφόν οι εισφορές σταματούν, αλλά ο φόρος συνεχίζει.` },
];
---
<GuideLayout lang={lang} id="employer" breadcrumbLabel={label('employer', lang)}
  title={`Κόστος εργοδότη ${Y}: εισφορές ${F.efkaEr} και 14 καταβολές`}
  h1={`Κόστος εργοδότη ${Y}: πόσο κοστίζει πραγματικά ένας μισθός`}
  description={`Κόστος εργοδότη ${Y}: για ${$(G)} μικτά η επιχείρηση πληρώνει ${$(s.cost)} ανά καταβολή και ${$(s.costAnnual)} τον χρόνο. Εισφορές ${F.efkaEr} (ΚΠΚ ${F.kpk}), πλαφόν ${F.ceiling}.`}
  intro={`Ο μικτός μισθός δεν είναι αυτό που πληρώνει η επιχείρηση: από πάνω μπαίνουν οι εργοδοτικές εισφορές, σε καθεμία από τις 14 καταβολές.`}
  resume={`Ένας υπάλληλος με ${$(G)} μικτά τον μήνα κοστίζει στον εργοδότη ${$(s.cost)} ανά καταβολή το ${Y}: στα μικτά προστίθενται ${$2(s.employer)} εργοδοτικές εισφορές e-ΕΦΚΑ, ${F.efkaEr} για το γενικό πακέτο κάλυψης ΚΠΚ ${F.kpk} του ιδιωτικού τομέα. Επειδή ο μισθός πληρώνεται 14 φορές, με δώρο Χριστουγέννων, δώρο Πάσχα και επίδομα αδείας, το ετήσιο κόστος φτάνει ${$(s.costAnnual)}. Από αυτό ο εργαζόμενος κρατά ${$(s.net)} καθαρά ανά καταβολή, αν είναι άνω των 30 χωρίς παιδιά, οπότε κάθε ευρώ που μπαίνει στην τσέπη του κοστίζει στην επιχείρηση ${$2(s.cost / s.net)}. Στον κατώτατο μισθό το κόστος είναι ${$(mw.cost)} ανά καταβολή και ${$(mw.costAnnual)} τον χρόνο. Οι εισφορές υπολογίζονται έως το πλαφόν των ${F.ceiling} μικτά τον μήνα, άρα η εργοδοτική εισφορά δεν ξεπερνά ποτέ τα ${$2(maxEr)} ανά καταβολή. Ο υπολογιστής δίνει το κόστος για οποιονδήποτε μισθό, σε 14 ή 12 καταβολές.`}
  faqs={faqs}
  related={[{ href: route('home', lang), name: label('home', lang), description: 'Τα καθαρά του εργαζομένου από τον ίδιο μικτό μισθό.' }, { href: route('nettogross', lang), name: label('nettogross', lang), description: 'Ποια μικτά δίνουν τα καθαρά που ζητά ένας υποψήφιος.' }, { href: route('efka', lang), name: label('efka', lang), description: `Οι εισφορές ${F.efkaEe} του εργαζομένου και ${F.efkaEr} του εργοδότη.` }]}
  sources={[src('efka_rates', lang), src('efka_ceiling', lang), src('min_wage', lang), src('tax_scale', lang)]}>
  <div data-outil><ToolCalc client:load kind="employer" lang={lang} methodHref={route('method', lang)} /></div>

  <h2>Το κόστος μισθοδοσίας από τον κατώτατο ως το πλαφόν</h2>
  <ContentTable headers={['Μικτά', 'Εργοδοτικές εισφορές', 'Κόστος ανά καταβολή', 'Κόστος τον χρόνο (14)', 'Καθαρά εργαζομένου', 'Κόστος ανά 1 € καθαρό']} align={['l', 'r', 'r', 'r', 'r', 'r']} rows={rows} highlightRow={2} />
  <p>Τα καθαρά αφορούν εργαζόμενο άνω των 30 ετών χωρίς εξαρτώμενα τέκνα. Η τελευταία στήλη είναι ίσως η πιο χρήσιμη για όποιον στήνει προϋπολογισμό προσωπικού: δείχνει πόσα ευρώ φεύγουν από την επιχείρηση για κάθε ευρώ που καταλήγει στον λογαριασμό του υπαλλήλου. Ανεβαίνει σταθερά με τον μισθό, κυρίως εξαιτίας του φόρου εισοδήματος, και αλλάζει ρυθμό μόλις ο μισθός περάσει το πλαφόν, όπου οι εισφορές σταματούν.</p>

  <h2>Τι κρύβεται πίσω από το {F.efkaEr}</h2>
  <p>Ο κωδικός πακέτου κάλυψης ΚΠΚ {F.kpk} είναι ο γενικός κωδικός για τους μισθωτούς του ιδιωτικού τομέα. Με την εγκύκλιο 38/2024 του e-ΕΦΚΑ, από την 1η Ιανουαρίου 2025 οι εισφορές μειώθηκαν κατά μισή ποσοστιαία μονάδα για καθεμία πλευρά, στον κλάδο υγείας: ο εργοδότης πληρώνει {F.efkaHealthEr} για υγεία και {F.efkaEr} συνολικά, ο εργαζόμενος {F.efkaHealthEe} και {F.efkaEe}. Μαζί, κάθε μικτός μισθός επιβαρύνεται με {F.efkaTotal} εισφορές. Οι συντελεστές αυτοί δεν άλλαξαν για το {Y}.</p>
  <p>Η εργοδοτική εισφορά δεν αφαιρείται από τον μισθό του υπαλλήλου· πληρώνεται επιπλέον. Γι' αυτό δεν φαίνεται στα «καθαρά» της μισθοδοσίας, φαίνεται όμως στο κόστος της επιχείρησης. Ένας εργαζόμενος που θέλει να ξέρει πόσο «αξίζει» για την εταιρεία του πρέπει να προσθέσει στο μικτό του το {F.efkaEr}.</p>

  <h2>Το πλαφόν των {F.ceiling}</h2>
  <p>Από 1.1.{Y} το ανώτατο όριο ασφαλιστέων αποδοχών είναι {F.ceiling} τον μήνα, αυξημένο σύμφωνα με τον δείκτη τιμών, όπως ορίζει η εγκύκλιος 4/{Y}. Πάνω από αυτό το ποσό ούτε ο εργοδότης ούτε ο εργαζόμενος πληρώνουν εισφορές. Για τον εργοδότη η μέγιστη εισφορά είναι {$2(maxEr)} ανά καταβολή. Για ένα στέλεχος με {$(10000)} μικτά, το πραγματικό ποσοστό εργοδοτικών εισφορών πέφτει στο {F.pct(big.employer / 10000)} του μικτού.</p>

  <h2>14 ή 12 καταβολές: ίδιο ετήσιο κόστος;</h2>
  <p>Αν μια επιχείρηση συμφωνήσει τις ίδιες ετήσιες μικτές αποδοχές σε 12 καταβολές, για τα {$(G)} × 14 δηλαδή {$(G * 14 / 12)} τον μήνα, το ετήσιο κόστος της μένει ίδιο, {$(s12.costAnnual)}, όσο ο μισθός είναι κάτω από το πλαφόν. Η διαφορά εμφανίζεται μόνο σε υψηλούς μισθούς: σε 12 καταβολές ο μηνιαίος μισθός ξεπερνά νωρίτερα το πλαφόν, οπότε ένα μέρος του γλιτώνει εισφορές. Στον υπολογιστή αλλάζετε το πεδίο «καταβολές» για να το δείτε.</p>

  <h2>Από τον προϋπολογισμό στον μισθό της αγγελίας</h2>
  <p>Μια μικρή επιχείρηση συχνά ξεκινά ανάποδα: έχει ένα ποσό που αντέχει τον μήνα και ψάχνει τι μισθό να γράψει στην αγγελία. Αφού κάτω από το πλαφόν το κόστος είναι μικτά × {F.dec(1 + P.efka.employer_rate, 4)}, αρκεί μια διαίρεση. Με {$(BUD)} ανά καταβολή, ο μικτός μισθός μπορεί να φτάσει {$(bg)}, ο υπάλληλος θα πάρει περίπου {$(bs.net)} καθαρά, και το ετήσιο κόστος θα είναι {$(bs.costAnnual)}, γιατί οι καταβολές είναι 14 και όχι 12. Αυτό το τελευταίο ξεχνιέται εύκολα σε έναν προϋπολογισμό: ένας μισθός «{$(BUD)} τον μήνα» κοστίζει στην πράξη {$(BUD * 14)} τον χρόνο.</p>

  <div data-chrome><MiniSim client:load kind="hirebudget" lang={lang} href={route('employer', lang)} /></div>

  <h2>Τι δεν μετρά ο υπολογιστής</h2>
  <p>Το αποτέλεσμα είναι το κόστος μισθοδοσίας: μικτά συν εργοδοτικές εισφορές του ΚΠΚ {F.kpk}. Δεν περιλαμβάνει υπερωρίες, παροχές σε είδος, ομαδικά ασφαλιστήρια, εξοπλισμό ή κόστος πρόσληψης, ούτε πρόβλεψη για αποζημίωση απόλυσης. Κλάδοι με βαρέα και ανθυγιεινά ή ειδικά ταμεία έχουν άλλους συντελεστές. Για να δείτε τι μένει στον εργαζόμενο από τον ίδιο μισθό, χρησιμοποιήστε τον <a href={route('home', lang)}>υπολογισμό μισθού</a>· αν ξεκινάτε από τα καθαρά που ζητά ένας υποψήφιος, ο υπολογιστής <a href={route('nettogross', lang)}>καθαρά σε μικτά</a> βρίσκει το μικτό.</p>
</GuideLayout>
