---
import ToolCalc from '../../components/calc/ToolCalc';
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { src } from '../../lib/facts';
import { PARAMS as P } from '../../lib/engine/gr';
import { childBenefit, childBenefitLimits, equivalenceScale } from '../../lib/engine/epidomata';
import { formatMoney, formatDecimal } from '../../lib/format';
const lang = 'el';
const $ = (x: number) => formatMoney(x, 0, lang);
const d = (x: number) => formatDecimal(x, 2, lang);
const Y = P.year;
const C = P.child_benefit;
const K = C.categories;
// Παράδειγμα = προεπιλογές του υπολογιστή: δύο γονείς, δύο παιδιά, 18.000 €.
const ex = childBenefit({ income: 18000, parents: 2, children: 2 });
const lim22 = childBenefitLimits(2, 2);
const three = childBenefit({ income: 18000, parents: 2, children: 3 });
const single = childBenefit({ income: 18000, parents: 1, children: 2 });
const amountRows = K.map((k, i) => [['Α', 'Β', 'Γ'][i], i === 0 ? `έως ${$(k.upTo)}` : `${$(K[i - 1].upTo)} έως ${$(k.upTo)}`, $(k.first_two), $(k.first_two), $(k.third_plus)]);
const famRows = [[2, 1], [2, 2], [2, 3], [2, 4], [1, 1], [1, 2], [1, 3]].map(([p, c]) => { const l = childBenefitLimits(p, c); return [`${p === 2 ? 'Δύο γονείς' : 'Μονογονεϊκή'}, ${c} ${c === 1 ? 'παιδί' : 'παιδιά'}`, d(equivalenceScale(p, c)), $(l[0]), $(l[1]), $(l[2])]; });
const faqs = [
  { q: 'Πόσο είναι το επίδομα παιδιού για δύο παιδιά;', a: `Εξαρτάται από το ισοδύναμο εισόδημα. Στην κατηγορία Α είναι ${$(K[0].first_two * 2)} τον μήνα, στη Β ${$(K[1].first_two * 2)} και στη Γ ${$(K[2].first_two * 2)}. Για δύο γονείς με δύο παιδιά η κλίμακα ισοδυναμίας είναι 2, οπότε τα όρια του οικογενειακού εισοδήματος είναι ${$(lim22[0])}, ${$(lim22[1])} και ${$(lim22[2])}. Με ${$(18000)} η οικογένεια παίρνει ${$(ex.monthly)} τον μήνα.` },
  { q: 'Ποιο εισόδημα μετράει για το επίδομα παιδιού;', a: `Το συνολικό οικογενειακό φορολογητέο εισόδημα του εκκαθαριστικού, μαζί με τα ποσά που φορολογούνται αυτοτελώς. Στην αρχή του έτους η ΟΠΕΚΑ χρησιμοποιεί τη δήλωση του προηγούμενου έτους και, μόλις υποβληθεί η νέα δήλωση, επανυπολογίζει με τα πιο πρόσφατα εισοδήματα. Το ίδιο το επίδομα παιδιού δεν φορολογείται και δεν μετρά στο εισόδημα άλλων επιδομάτων.` },
  { q: 'Το τρίτο παιδί παίρνει περισσότερα;', a: `Ναι, το διπλάσιο. Το τρίτο και κάθε επόμενο παιδί παίρνει ${$(K[0].third_plus)} στην κατηγορία Α, ${$(K[1].third_plus)} στη Β και ${$(K[2].third_plus)} στη Γ. Επιπλέον, κάθε παιδί προσθέτει 1/4 στην κλίμακα ισοδυναμίας και ανεβάζει τα όρια. Με ${$(18000)} εισόδημα, τρία παιδιά δίνουν ${$(three.monthly)} τον μήνα αντί για ${$(ex.monthly)} με δύο.` },
  { q: 'Μέχρι ποια ηλικία δίνεται το επίδομα παιδιού;', a: `Μέχρι τα ${C.max_age}, ή τα ${C.max_age_secondary} όσο το παιδί φοιτά στη δευτεροβάθμια. Για φοιτητές ΑΕΙ, ΙΕΚ και το μεταλυκειακό έτος, το παιδί μετρά έως τα ${C.max_age_studies}, όπως και με αναπηρία 67 % και άνω. Παιδί 4 έως 16 ετών πρέπει να είναι εγγεγραμμένο στο σχολείο και να μην έχει μείνει στην ίδια τάξη λόγω απουσιών.` },
  { q: 'Είμαι μόνη μητέρα. Αλλάζει κάτι στον υπολογισμό;', a: `Ναι, προς όφελός σας. Στη μονογονεϊκή οικογένεια το πρώτο παιδί μετρά 1/2 στην κλίμακα ισοδυναμίας αντί για 1/4, άρα το ίδιο εισόδημα διαιρείται με μεγαλύτερο αριθμό. Με ${$(18000)} και δύο παιδιά, η μονογονεϊκή οικογένεια παίρνει ${$(single.monthly)} τον μήνα, ενώ μια οικογένεια δύο γονέων ${$(ex.monthly)}.` },
];
---
<GuideLayout lang={lang} id="childben" breadcrumbLabel={label('childben', lang)}
  title={`Επίδομα παιδιού ${Y}: υπολογισμός Α21 και κατηγορίες Α, Β, Γ`}
  h1={`Επίδομα παιδιού ${Y}: υπολογισμός του Α21 για την οικογένειά σας`}
  description={`Επίδομα παιδιού Α21 ${Y}: ${$(K[0].first_two)}, ${$(K[1].first_two)} ή ${$(K[2].first_two)} τον μήνα ανά παιδί, διπλάσιο από το τρίτο. Βρείτε κατηγορία, ισοδύναμο εισόδημα και δόση από το εισόδημά σας.`}
  intro={`Το επίδομα παιδιού της ΟΠΕΚΑ εξαρτάται από ένα μόνο νούμερο: το εισόδημα της οικογένειας διαιρεμένο με την κλίμακα ισοδυναμίας.`}
  resume={`Μια οικογένεια με δύο γονείς, δύο παιδιά και ${$(18000)} οικογενειακό εισόδημα παίρνει ${$(ex.monthly)} τον μήνα επίδομα παιδιού το ${Y}, δηλαδή ${$(ex.installment)} σε κάθε διμηνιαία δόση και ${$(ex.annual)} τον χρόνο. Ο λογαριασμός είναι αυτός του άρθρου 214 του ν. 4512/2018: το εισόδημα διαιρείται με την κλίμακα ισοδυναμίας, 1 για τον πρώτο γονέα, 1/2 για τον δεύτερο και 1/4 για κάθε παιδί, εδώ ${d(ex.scale)}. Το ισοδύναμο εισόδημα των ${$(ex.equivalent)} πέφτει στην κατηγορία Β, που δίνει ${$(K[1].first_two)} για καθένα από τα δύο πρώτα παιδιά. Τρεις κατηγορίες υπάρχουν: Α έως ${$(K[0].upTo)}, Β έως ${$(K[1].upTo)} και Γ έως ${$(K[2].upTo)} ισοδύναμου εισοδήματος· πάνω από εκεί δεν καταβάλλεται τίποτα. Από το τρίτο παιδί το ποσό διπλασιάζεται. Δεν υπάρχει κριτήριο περιουσίας, αλλά απαιτείται νόμιμη διαμονή πέντε ετών. Ο υπολογιστής δείχνει την κατηγορία, το ποσό ανά παιδί και το εισόδημα μέχρι το οποίο την κρατάτε.`}
  faqs={faqs}
  related={[{ href: route('childpay', lang), name: label('childpay', lang), description: 'Οι ημερομηνίες των διμηνιαίων δόσεων του 2026.' }, { href: route('children', lang), name: label('children', lang), description: 'Τα παιδιά μειώνουν και τον φόρο εισοδήματος.' }, { href: route('parental', lang), name: label('parental', lang), description: 'Το επίδομα της ΔΥΠΑ για τη γονική άδεια.' }]}
  sources={[src('child_benefit', lang), src('child_benefit_faq', lang), src('birth_allowance', lang), src('birth_allowance_limit', lang)]}>
  <div data-outil><ToolCalc client:load kind="childbenefit" lang={lang} methodHref={route('method', lang)} /></div>

  <h2>Τα ποσά ανά κατηγορία ισοδύναμου εισοδήματος</h2>
  <ContentTable headers={['Κατηγορία', 'Ισοδύναμο εισόδημα', '1ο παιδί', '2ο παιδί', '3ο και επόμενα']} align={['l', 'l', 'r', 'r', 'r']} rows={amountRows} />
  <p>Τα ποσά είναι μηνιαία και γραμμένα σε ευρώ μέσα στο ίδιο το άρθρο 214 του ν. 4512/2018. Δεν τιμαριθμοποιούνται: ο κατώτατος μισθός έφτασε τα {$(P.minimum_wage.monthly)}, αλλά τα όρια των {$(K[0].upTo)}, {$(K[1].upTo)} και {$(K[2].upTo)} έμειναν ίδια. Γι’ αυτό όλο και περισσότερες οικογένειες με δύο μισθούς βγαίνουν από την κατηγορία Γ, όπως φαίνεται στον υπολογιστή με λίγο υψηλότερο εισόδημα.</p>

  <h2>Πού σταματά κάθε κατηγορία για τη δική σας οικογένεια</h2>
  <ContentTable headers={['Οικογένεια', 'Κλίμακα', 'Κατηγορία Α έως', 'Β έως', 'Γ έως']} align={['l', 'r', 'r', 'r', 'r']} rows={famRows} />
  <p>Ο πίνακας μεταφράζει τα όρια του ισοδύναμου εισοδήματος σε πραγματικό οικογενειακό εισόδημα. Ένα ευρώ πάνω από το όριο αρκεί για να αλλάξει η κατηγορία για όλο το έτος, γι’ αυτό αξίζει να ξέρετε το περιθώριο πριν από μια αύξηση ή ένα έκτακτο εισόδημα που θα δηλωθεί.</p>
  <div data-chrome><MiniSim client:load kind="childnext" lang={lang} href={route('childben', lang)} /></div>

  <h2>Ποια παιδιά μετράνε και ποιοι δικαιούνται</h2>
  <p>Εξαρτώμενα είναι τα άγαμα παιδιά έως {C.max_age} ετών, έως {C.max_age_secondary} όσο φοιτούν στη δευτεροβάθμια, και έως {C.max_age_studies} όσο σπουδάζουν σε ΑΕΙ, ΙΕΚ ή στο μεταλυκειακό έτος μαθητείας. Ως ημέρα γέννησης θεωρείται η 31η Δεκεμβρίου του έτους γέννησης. Ένα παιδί που γεννιέται μέσα στη χρονιά μετρά από την πρώτη του επόμενου μήνα.</p>
  <p>Δικαιούχοι είναι οι Έλληνες, οι ομογενείς, οι πολίτες της ΕΕ, του ΕΟΧ και της Ελβετίας και οι αναγνωρισμένοι πρόσφυγες, με {C.residence_years} χρόνια νόμιμης και μόνιμης διαμονής στην Ελλάδα πριν από το έτος της αίτησης, αποδεικνυόμενης με εμπρόθεσμες φορολογικές δηλώσεις. Οι υπόλοιποι πολίτες τρίτων χωρών χρειάζονται {C.residence_years_third_country} χρόνια. Τα παιδιά πρέπει να ζουν στην Ελλάδα.</p>

  <h2>Η αίτηση Α21 και πώς πληρώνεται</h2>
  <p>Η αίτηση γίνεται κάθε χρόνο, ηλεκτρονικά, με τους κωδικούς Taxisnet, στην πλατφόρμα της ΗΔΙΚΑ ή μέσω της ΟΠΕΚΑ. Ανοίγει σε διαδοχικούς κύκλους και όποιος μπει αργότερα παίρνει αναδρομικά από τον Ιανουάριο, εφόσον πληρούσε τις προϋποθέσεις. Το επίδομα καταβάλλεται σε {C.installments_per_year} διμηνιαίες δόσεις, την τελευταία εργάσιμη του μήνα πληρωμής· οι ημερομηνίες του {Y} βρίσκονται στη σελίδα <a href={route('childpay', lang)}>πληρωμή επιδόματος παιδιού</a>. Είναι αφορολόγητο και ακατάσχετο, και δεν συμψηφίζεται με οφειλές προς το Δημόσιο.</p>

  <h2>Επίδομα γέννησης: το εφάπαξ ποσό για κάθε νέο παιδί</h2>
  <p>Ανεξάρτητα από το Α21, κάθε γέννηση δίνει επίδομα γέννησης του ν. 4659/2020: {$(P.birth_allowance.amounts[0])} για το πρώτο παιδί, {$(P.birth_allowance.amounts[1])} για το δεύτερο, {$(P.birth_allowance.amounts[2])} για το τρίτο και {$(P.birth_allowance.amounts[3])} από το τέταρτο, σε δύο ίσες δόσεις. Το όριο είναι πολύ υψηλότερο από του επιδόματος παιδιού, {$(P.birth_allowance.equivalent_income_limit)} ισοδύναμου εισοδήματος, με την ίδια λογική κλίμακας, και η αίτηση γίνεται μέσα σε {P.birth_allowance.apply_within_months} μήνες από τη γέννα.</p>
  <div data-chrome><MiniSim client:load kind="birth" lang={lang} href={route('childben', lang)} /></div>
</GuideLayout>
