---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { src } from '../../lib/facts';
import { PARAMS as P } from '../../lib/engine/gr';
import { childBenefit } from '../../lib/engine/epidomata';
import { formatMoney, formatNumber, displayDate } from '../../lib/format';
const lang = 'el';
const $ = (x: number) => formatMoney(x, 0, lang);
const day = (iso: string) => displayDate(iso, 'el-GR');
const Y = P.year;
const C = P.child_benefit;
const pays = C.payments_2026;
const K0 = C.categories[0].first_two;
const ex = childBenefit({ income: 14000, parents: 2, children: 2 });
const big = childBenefit({ income: 13000, parents: 2, children: 3 });
const payRows = pays.map((p, i) => [`${i + 1}η δόση`, day(p), formatNumber(C.recipients_2026[i], 0, lang), $(ex.installment)]);
payRows.push(['Έκτακτη συμπληρωματική πληρωμή', day(C.extra_payment_2026), '—', '—'], ['5η και 6η δόση', 'δεν έχουν ανακοινωθεί', '—', $(ex.installment)]);
const winRows = C.application_windows_2026.map(([a, b], i) => [`${i + 1}ος κύκλος`, day(a), day(b)]);
const faqs = [
  { q: 'Πότε πληρώνεται η 5η δόση του επιδόματος παιδιού;', a: `Η ΟΠΕΚΑ δεν έχει ανακοινώσει ακόμη την ημερομηνία. Οι τέσσερις πρώτες δόσεις του ${Y} πληρώθηκαν ${day(pays[0])}, ${day(pays[1])}, ${day(pays[2])} και ${day(pays[3])}, πάντα την τελευταία εργάσιμη του μήνα. Το ποσό της δόσης είναι δύο μηνιαία επιδόματα· για οικογένεια με δύο παιδιά στην κατηγορία Α, ${$(K0 * 4)}.` },
  { q: 'Γιατί δεν πήρα τη δόση ενώ πήραν οι άλλοι;', a: `Οι πιο συχνοί λόγοι είναι ότι η αίτηση Α21 υποβλήθηκε σε μεταγενέστερο κύκλο, ότι λείπουν στοιχεία φοίτησης για παιδί σχολικής ηλικίας ή ότι η φορολογική δήλωση άλλαξε την κατηγορία. Για τις αιτήσεις που είχαν μπλοκάρει λόγω στοιχείων φοίτησης, η ΟΠΕΚΑ όρισε έκτακτη πληρωμή ${day(C.extra_payment_2026)}. Όποιος μπαίνει σε επόμενο κύκλο παίρνει τα ποσά αναδρομικά.` },
  { q: 'Μέχρι πότε μπορώ να κάνω αίτηση Α21 για το 2026;', a: `Ο πέμπτος κύκλος της πλατφόρμας ανοίγει ${day(C.application_windows_2026[4][0])} και κλείνει ${day(C.application_windows_2026[4][1])}. Η αίτηση εγκρίνεται για όλο το έτος και τα ποσά των μηνών που πέρασαν καταβάλλονται αναδρομικά με την επόμενη πληρωμή, εφόσον πληρούσατε τις προϋποθέσεις από τον Ιανουάριο.` },
  { q: 'Σε ποιο λογαριασμό μπαίνει το επίδομα παιδιού;', a: `Από τον Μάιο του 2025 το επίδομα παιδιού πιστώνεται σε προπληρωμένη κάρτα και όχι στον τραπεζικό λογαριασμό του δικαιούχου. Τα ποσά παραμένουν ακατάσχετα και δεν συμψηφίζονται με χρέη προς το Δημόσιο. Το επίδομα στέγασης και τα υπόλοιπα επιδόματα της ΟΠΕΚΑ πληρώνονται την ίδια ημέρα, την τελευταία εργάσιμη του μήνα.` },
];
---
<GuideLayout lang={lang} id="childpay" breadcrumbLabel={label('childpay', lang)}
  title={`Πληρωμή επιδόματος παιδιού ${Y}: όλες οι δόσεις και τα ποσά`}
  h1={`Επίδομα παιδιού ${Y}: πότε πληρώνεται κάθε δόση`}
  description={`Πληρωμή επιδόματος παιδιού ${Y}: ημερομηνίες των δόσεων Α21 της ΟΠΕΚΑ, η έκτακτη πληρωμή ${day(C.extra_payment_2026)}, οι κύκλοι αιτήσεων και πόσα παίρνετε σε κάθε δόση.`}
  intro={`Το Α21 πληρώνεται ανά δίμηνο, την τελευταία εργάσιμη του μήνα πληρωμής. Εδώ βρίσκονται μόνο οι ημερομηνίες που έχει ανακοινώσει η ΟΠΕΚΑ.`}
  resume={`Η επόμενη πληρωμή του επιδόματος παιδιού είναι η έκτακτη συμπληρωματική της ${day(C.extra_payment_2026)}, για τις αιτήσεις που είχαν μείνει σε εκκρεμότητα. Οι τέσσερις πρώτες διμηνιαίες δόσεις του ${Y} πληρώθηκαν ${day(pays[0])}, ${day(pays[1])}, ${day(pays[2])} και ${day(pays[3])}, η τελευταία σε ${formatNumber(C.recipients_2026[3], 0, lang)} δικαιούχους του Α21. Οι ημερομηνίες της 5ης και της 6ης δόσης δεν έχουν ανακοινωθεί, και γι’ αυτό δεν τις γράφουμε: θα προστεθούν μόλις τις δημοσιεύσει η ΟΠΕΚΑ. Κάθε δόση αντιστοιχεί σε δύο μηνιαία επιδόματα. Για οικογένεια δύο γονέων με δύο παιδιά και ${$(14000)} εισόδημα, που ανήκει στην κατηγορία Β, η δόση είναι ${$(ex.installment)}· με τρία παιδιά και ${$(13000)}, στην κατηγορία Α, είναι ${$(big.installment)}. Παράλληλα, ο πέμπτος κύκλος αιτήσεων ανοίγει ${day(C.application_windows_2026[4][0])} και κλείνει ${day(C.application_windows_2026[4][1])}, για όσους δεν έχουν υποβάλει ακόμη αίτηση για φέτος. Ο μικρός υπολογιστής δείχνει τη δική σας δόση.`}
  faqs={faqs}
  related={[{ href: route('childben', lang), name: label('childben', lang), description: 'Ο πλήρης υπολογισμός της κατηγορίας και του ποσού.' }, { href: route('housing', lang), name: label('housing', lang), description: 'Πληρώνεται κάθε μήνα την ίδια ημέρα με το Α21.' }, { href: route('rentrefund', lang), name: label('rentrefund', lang), description: 'Το ενοίκιο που επιστρέφεται τον Νοέμβριο.' }]}
  sources={[src('child_benefit_mar', lang), src('child_benefit_may', lang), src('child_benefit_jul', lang), src('child_benefit_sept', lang), src('child_benefit_oct', lang), src('child_benefit_platform', lang), src('child_benefit', lang)]}>
  <div data-outil><MiniSim client:load kind="childinst" lang={lang} href={route('childben', lang)} /></div>

  <h2>Οι πληρωμές του {Y}</h2>
  <ContentTable headers={['Δόση', 'Ημερομηνία', 'Δικαιούχοι Α21', `Δόση για 2 παιδιά, ${$(14000)}`]} align={['l', 'l', 'r', 'r']} rows={payRows} />
  <p>Ο αριθμός των δικαιούχων αλλάζει από δόση σε δόση επειδή κάθε κύκλος αιτήσεων προσθέτει οικογένειες και επειδή η νέα φορολογική δήλωση επανεξετάζει την κατηγορία. Ανάμεσα στη 2η και στην 4η δόση οι δικαιούχοι μειώθηκαν κατά {formatNumber(C.recipients_2026[1] - C.recipients_2026[3], 0, lang)}, χωρίς να δίνει η ΟΠΕΚΑ ανάλυση της διαφοράς. Για μια συγκεκριμένη οικογένεια, η συνηθέστερη αιτία αλλαγής είναι η δήλωση του {Y} για τα εισοδήματα του {Y - 1}, που μπορεί να την ανεβάσει σε άλλη κατηγορία ή πάνω από το όριο της Γ· ο <a href={route('childben', lang)}>υπολογιστής του επιδόματος παιδιού</a> δείχνει την κατηγορία με το νέο εισόδημα.</p>

  <h2>Οι κύκλοι της πλατφόρμας Α21</h2>
  <ContentTable headers={['Κύκλος', 'Άνοιγμα', 'Κλείσιμο']} align={['l', 'l', 'l']} rows={winRows} />
  <p>Η πλατφόρμα δεν μένει ανοιχτή όλο τον χρόνο. Ανοίγει σε κύκλους, που το {Y} έκλειναν περίπου τρεις εβδομάδες πριν από κάθε πληρωμή, όσο διαρκεί η εκκαθάριση. Μια αίτηση του πέμπτου κύκλου δεν χάνει μήνες: οι δόσεις που προηγήθηκαν καταβάλλονται αναδρομικά. Χάνει μόνο χρόνο, γιατί τα χρήματα έρχονται μαζί αργότερα.</p>

  <h2>Τι πρέπει να ελέγξετε πριν από κάθε πληρωμή</h2>
  <p>Πρώτα την κατάσταση της αίτησης στην πλατφόρμα της ΗΔΙΚΑ: μια αίτηση που δεν έχει εγκριθεί πριν από το κλείσιμο του κύκλου περνά στην επόμενη πληρωμή. Έπειτα τη φορολογική δήλωση: αν την τροποποιήσατε, η ΟΠΕΚΑ επανυπολογίζει. Τέλος, τα παιδιά σχολικής ηλικίας από 4 έως 16 ετών: αν δεν υπάρχει εγγραφή στο σύστημα του Υπουργείου Παιδείας, το επίδομα για το παιδί αυτό σταματά μέχρι να διορθωθεί. Η έκτακτη πληρωμή της {day(C.extra_payment_2026)} δόθηκε ακριβώς για τέτοιες περιπτώσεις.</p>
</GuideLayout>
