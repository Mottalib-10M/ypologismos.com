---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { severance, severanceMonths, noticeMonths, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney, formatDecimal } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const d = (x: number) => formatDecimal(x, 2, lang);
const S = P.severance;
const up = 1 + S.holiday_uplift;
const TM = S.table_months, NM = S.notice_months;
const range = (rows: typeof TM, i: number) => { const a = rows[i].fromYears, b = rows[i + 1]?.fromYears; return b === undefined ? `${a} και άνω` : b - a === 1 ? `${a}` : `${a} έως ${b}`; };
const main = TM.map((r, i) => [range(TM, i), String(r.months), d(r.months * up), `${noticeMonths(r.fromYears)}`]);
const notice = NM.map((r, i) => [range(NM, i), String(r.months), d(severanceMonths(r.fromYears) * up / 2)]);
const pay = 1500;
const step = Array.from({ length: 18 }, (_, k) => k).slice(1).map((y) => { const a = severance({ pay, years: y }), b = severance({ pay, years: y - 1 }); return [`${y}`, String(a.months), $(a.total), a.total - b.total > 0 ? `+${$(a.total - b.total)}` : '–']; });
const firstM = TM[0].months, lastM = TM[TM.length - 1].months, lastFrom = TM[TM.length - 1].fromYears;
const y3 = severance({ pay, years: 3 }), y4 = severance({ pay, years: 4 }), y9 = severance({ pay, years: 9 }), y10 = severance({ pay, years: 10 }), y16 = severance({ pay, years: 16 }), y15 = severance({ pay, years: 15 });
const oneMonth = pay * up;
const faqs = [
  { q: 'Έχω 3 χρόνια και 11 μήνες στην εταιρεία. Σε ποια γραμμή του πίνακα ανήκω;', a: `Στην πρώτη, «1 έως 4 έτη», με ${firstM} μισθούς. Ο πίνακας μετράει μόνο συμπληρωμένα έτη, και ο ενδέκατος μήνας του τέταρτου έτους δεν αρκεί. Με μισθό ${$(pay)} οφείλονται ${$(y3.total)}. Αν η απόλυση γινόταν μετά την τέταρτη επέτειο της πρόσληψης, θα περνούσατε στη δεύτερη γραμμή και η αποζημίωση θα γινόταν ${$(y4.total)}, δηλαδή ${$(y4.total - y3.total)} περισσότερα.` },
  { q: 'Μετά τα 16 χρόνια η αποζημίωση σταματά να αυξάνεται;', a: `Ναι, για όσους δεν είχαν 17 χρόνια στον ίδιο εργοδότη στις 12.11.2012. Η τελευταία γραμμή του πίνακα είναι «${lastFrom} έτη και άνω» με ${lastM} μισθούς, άρα με 20 ή 30 χρόνια το ποσό είναι το ίδιο: ${$(y16.total)} με μισθό ${$(pay)}. Μόνο όσοι είχαν ήδη 17 χρόνια τότε παίρνουν επιπλέον μισθούς, παγωμένους στην ημερομηνία εκείνη.` },
  { q: `Γιατί ο πίνακας γράφει ${firstM} μισθούς αλλά ο υπολογιστής βγάζει περισσότερα;`, a: `Επειδή ο πίνακας του νόμου δίνει τους «γυμνούς» μηνιαίους μισθούς, ενώ το σύνολό τους προσαυξάνεται κατά 1/6 για την αναλογία δώρων και επιδόματος αδείας. Οι ${firstM} μισθοί γίνονται στην πράξη ${d(firstM * up)} μισθοί και οι ${lastM} γίνονται ${d(lastM * up)}. Με ${$(pay)} μισθό, η πρώτη γραμμή αξίζει ${$(y3.total)} και όχι ${$(pay * firstM)}.` },
  { q: 'Ο πίνακας της προειδοποίησης έχει άλλα όρια ετών από τον πίνακα της αποζημίωσης. Γιατί;', a: `Είναι δύο διαφορετικοί πίνακες του ν. 4093/2012. Η προειδοποίηση αλλάζει στα 2, 5 και 10 χρόνια, ενώ η αποζημίωση στα 4, 6, 8 και από τα 10 κάθε χρόνο. Έτσι, με 5 χρόνια ο εργαζόμενος έχει ήδη ${noticeMonths(5)} μήνες προειδοποίησης αλλά μένει στους ${severanceMonths(5)} μισθούς αποζημίωσης. Ο δεύτερος πίνακας αυτής της σελίδας δείχνει τη μισή αποζημίωση που αντιστοιχεί σε κάθε κλίμακα προειδοποίησης.` },
  { q: 'Μετράνε στα χρόνια του πίνακα οι προηγούμενες εταιρείες όπου δούλεψα;', a: `Όχι. Η πρώτη στήλη του πίνακα είναι ο «χρόνος υπηρεσίας στον ίδιο εργοδότη», όπως τον διατυπώνουν το Υπουργείο Εργασίας και η Επιθεώρηση Εργασίας. Η συνολική σας προϋπηρεσία μπορεί να μετράει για άλλα θέματα, όπως οι τριετίες του μισθού, αλλά για την αποζημίωση απόλυσης κοιτάμε μόνο τα έτη στον εργοδότη που σας απολύει.` },
];
---
<GuideLayout lang={lang} id="sevtable" breadcrumbLabel={label('sevtable', lang)}
  title={`Πίνακας αποζημίωσης απόλυσης ${F.year}: μισθοί ανά έτος`}
  h1={`Πίνακας αποζημίωσης απόλυσης ${F.year}: κάθε γραμμή και τι αξίζει ένα έτος ακόμη`}
  description={`Πίνακας αποζημίωσης ${F.year}: ${firstM} μισθοί από 1 έτος, ${lastM} από τα ${lastFrom}, συν το 1/6. Πίνακας προειδοποίησης ${NM[0].months} έως ${NM[NM.length - 1].months} μηνών και πόσα ευρώ προσθέτει κάθε νέα επέτειος.`}
  intro={`Οι δύο πίνακες του ν. 4093/2012, της αποζημίωσης και της προειδοποίησης, διαβασμένοι γραμμή προς γραμμή.`}
  resume={`Ο πίνακας αποζημίωσης απόλυσης του ν. 4093/2012 έχει έντεκα γραμμές. Από 1 έως 4 συμπληρωμένα έτη στον ίδιο εργοδότη αντιστοιχούν ${firstM} μισθοί, από 4 έως 6 έτη ${severanceMonths(4)}, από 6 έως 8 έτη ${severanceMonths(6)}, από 8 έως 10 έτη ${severanceMonths(8)}, και στη συνέχεια ένας μισθός ακόμη για κάθε έτος, από ${severanceMonths(10)} στα 10 χρόνια μέχρι ${lastM} στα ${lastFrom}, όπου η κλίμακα σταματά. Στο σύνολο προστίθεται 1/6, οπότε στην πράξη οι ${firstM} μισθοί αξίζουν ${d(firstM * up)} και οι ${lastM} αξίζουν ${d(lastM * up)}. Ο δεύτερος πίνακας ορίζει την έγγραφη προειδοποίηση: ${NM[0].months} μήνας από 12 μήνες ως 2 έτη, ${NM[1].months} μήνες ως 5 έτη, ${NM[2].months} ως 10 έτη και ${NM[3].months} μήνες από τα 10 έτη και πάνω· όταν δίνεται, η αποζημίωση πέφτει στο μισό. Με μισθό ${$(pay)}, η τέταρτη επέτειος προσθέτει ${$(y4.total - y3.total)} και η δέκατη ${$(y10.total - y9.total)}.`}
  faqs={faqs}
  related={[{ href: route('severance', lang), name: label('severance', lang), description: 'Υπολογισμός με τον δικό σας μισθό, ημερομίσθιο και όριο.' }, { href: route('notice', lang), name: label('notice', lang), description: 'Η προειδοποίηση σε ευρώ, και πότε ξεκινά η προθεσμία.' }, { href: route('sevold', lang), name: label('sevold', lang), description: 'Οι επιπλέον μισθοί όσων είχαν 17 χρόνια το 2012.' }]}
  sources={[src('severance_faq', lang), src('severance', lang), src('law_4808_64', lang)]}>
  <div data-chrome><MiniSim client:load kind="sevtable" lang={lang} href={route('severance', lang)} /></div>

  <h2>Ο πίνακας αποζημίωσης, όπως τον δημοσιεύει το Υπουργείο</h2>
  <ContentTable headers={['Συμπληρωμένα έτη', 'Μισθοί', 'Μισθοί με το 1/6', 'Μήνες προειδοποίησης']} align={['l', 'r', 'r', 'r']} rows={main} />
  <p>Η πρώτη στήλη διαβάζεται πάντα με τη λέξη «συμπληρωμένα». Η γραμμή «1 έως 4» καλύπτει όποιον έχει κλείσει τον πρώτο χρόνο αλλά όχι τον τέταρτο· η γραμμή «10» καλύπτει τα δέκα συμπληρωμένα χρόνια ως την παραμονή της ενδέκατης επετείου. Η δεύτερη στήλη είναι ο αριθμός μηνιαίων μισθών όπως τον γράφει ο νόμος για καταγγελία χωρίς προειδοποίηση. Η τρίτη τον πολλαπλασιάζει με 7/6, δηλαδή προσθέτει την αναλογία των δύο δώρων και του επιδόματος αδείας, και είναι ο αριθμός που πραγματικά πληρώνεται. Η τελευταία στήλη δείχνει τον χρόνο ειδοποίησης που αντιστοιχεί στην αρχή κάθε κλίμακας.</p>
  <p>Ο πίνακας ισχύει για συμβάσεις αορίστου χρόνου και, από το 2022, τόσο για υπαλλήλους όσο και για εργατοτεχνίτες, με τη διαφορά ότι ο μισθός των δεύτερων λογίζεται ως {F.sevDailyMonth} ημερομίσθια. Δίνει το ελάχιστο που οφείλεται: μια σύμβαση ή ένα έθιμο που προβλέπουν περισσότερα υπερισχύουν.</p>

  <h2>Γραμμή προς γραμμή: τρεις ζώνες</h2>
  <p>Η πρώτη ζώνη είναι τα πρώτα τέσσερα χρόνια. Εδώ ο πίνακας μένει ακίνητος για τρία ολόκληρα έτη: όποιος απολύεται με 1 χρόνο και όποιος απολύεται με 3 χρόνια και 11 μήνες παίρνουν το ίδιο, {firstM} μισθούς. Για τον εργοδότη αυτό σημαίνει ότι ο δεύτερος και ο τρίτος χρόνος δεν αυξάνουν το κόστος μιας απόλυσης.</p>
  <p>Η δεύτερη ζώνη, από 4 έως 10 χρόνια, ανεβαίνει ανά διετία. Η τέταρτη, η έκτη και η όγδοη επέτειος προσθέτουν από έναν μισθό, και τα ενδιάμεσα έτη δεν αλλάζουν τίποτα. Η τρίτη ζώνη, από 10 έως {lastFrom} χρόνια, είναι η πιο «πυκνή»: κάθε επέτειος δίνει έναν μισθό ακόμη. Μετά τα {lastFrom} χρόνια ο πίνακας κλείνει.</p>
  <p>Η ζώνη στην οποία βρίσκεστε καθορίζει πόσο σας ενδιαφέρει μια ημερομηνία. Στην τρίτη ζώνη κάθε επέτειος έχει αξία· στην πρώτη, μόνο η τέταρτη.</p>

  <h2>Πόσα ευρώ προσθέτει κάθε επέτειος</h2>
  <ContentTable headers={['Έτη', 'Μισθοί', `Αποζημίωση (${$(pay)})`, 'Διαφορά από το προηγούμενο έτος']} align={['l', 'r', 'r', 'r']} rows={step} highlightRow={9} />
  <p>Με μισθό {$(pay)}, ένας επιπλέον μισθός της κλίμακας αξίζει {$(oneMonth)}, γιατί η προσαύξηση 1/6 εφαρμόζεται και σε αυτόν. Η στήλη «διαφορά» δείχνει πού ακριβώς πέφτουν τα άλματα: στα χρόνια 4, 6, 8 και σε κάθε χρόνο από το 10 ως το {lastFrom}. Η παύλα σημαίνει ότι η επέτειος εκείνη δεν αλλάζει το ποσό. Το άθροισμα της στήλης ως τα {lastFrom} χρόνια είναι η απόσταση από τους {firstM} στους {lastM} μισθούς.</p>
  <p>Αυτός ο πίνακας εξηγεί και μια συχνή απορία: γιατί δύο συνάδελφοι με διαφορά λίγων εβδομάδων στην πρόσληψη μπορεί να πάρουν διαφορετικά ποσά. Αν η απόλυση πέσει ανάμεσα στις δύο επετείους, ο ένας έχει περάσει στην επόμενη γραμμή και ο άλλος όχι. Με {$(pay)} μισθό και 15 έναντι 16 χρόνων, η διαφορά είναι {$(y16.total - y15.total)}.</p>

  <h2>Ο πίνακας της προειδοποίησης</h2>
  <ContentTable headers={['Συμπληρωμένα έτη', 'Μήνες προειδοποίησης', 'Μισή αποζημίωση (μισθοί με 1/6)']} align={['l', 'r', 'r']} rows={notice} />
  <p>Ο δεύτερος πίνακας ξεκινά από τους 12 συμπληρωμένους μήνες και έχει μόνο τέσσερις γραμμές. Ορίζει πόσο νωρίτερα πρέπει ο εργοδότης να ειδοποιήσει γραπτώς τον εργαζόμενο αν θέλει να πληρώσει τη μισή αποζημίωση. Η τρίτη στήλη δείχνει τη μισή αποζημίωση της πρώτης χρονιάς κάθε κλίμακας, σε μισθούς με το 1/6. Επειδή τα όρια των δύο πινάκων δεν συμπίπτουν, μέσα στην ίδια κλίμακα προειδοποίησης η αποζημίωση μπορεί να ανέβει: από τα 5 ως τα 10 χρόνια η προειδοποίηση μένει {noticeMonths(5)} μήνες, ενώ οι μισθοί ανεβαίνουν από {severanceMonths(5)} σε {severanceMonths(9)}.</p>
  <p>Η προθεσμία μετράει από την επομένη της γνωστοποίησης. Τι σημαίνει αυτό στην πράξη και πώς συγκρίνονται οι δύο δρόμοι σε ευρώ εξηγεί ο οδηγός για την <a href={route('notice', lang)}>προειδοποίηση απόλυσης</a>.</p>

  <div data-chrome><MiniSim client:load kind="notice" lang={lang} href={route('notice', lang)} /></div>

  <h2>Τρία λάθη στην ανάγνωση του πίνακα</h2>
  <p>Το πρώτο είναι η στρογγυλοποίηση προς τα πάνω: «σχεδόν 6 χρόνια» δεν είναι 6. Το δεύτερο είναι η χρήση του συνολικού χρόνου εργασίας αντί για τα χρόνια στον συγκεκριμένο εργοδότη. Το τρίτο είναι να πολλαπλασιαστεί ο μισθός με τη δεύτερη στήλη και να ξεχαστεί η προσαύξηση· στην πρώτη γραμμή αυτό σημαίνει {$(y3.total - pay * firstM)} λιγότερα με μισθό {$(pay)}.</p>
  <p>Υπάρχει και ένα λάθος προς την άλλη πλευρά: η υπόθεση ότι η κλίμακα συνεχίζει μετά τα {lastFrom} χρόνια. Δεν συνεχίζει, εκτός για τους παλαιούς υπαλλήλους του 2012, που έχουν δικό τους πρόσθετο πίνακα στη σελίδα για την <a href={route('sevold', lang)}>αποζημίωση παλαιών υπαλλήλων</a>. Για το ποσό με τον δικό σας μισθό και το ανώτατο όριο, χρησιμοποιήστε τον <a href={route('severance', lang)}>υπολογιστή αποζημίωσης απόλυσης</a>· για τον τρέχοντα καθαρό μισθό, τον <a href={route('home', lang)}>υπολογισμό μισθού</a>.</p>
</GuideLayout>
