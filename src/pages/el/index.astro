---
import PageLayout from '../../layouts/PageLayout.astro';
import ToolCalc from '../../components/calc/ToolCalc';
import MiniSim from '../../components/calc/MiniSim';
import ContentTable from '../../components/ContentTable.astro';
import { route, AMOUNTS } from '../../i18n/routes';
import { amountLabel, label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { salary, grossForNet, christmasBonus, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney, pct, displayDate } from '../../lib/format';
import { webApplicationSchema, websiteSchema, organizationSchema, faqSchema } from '../../lib/seo';
import { LAST_UPDATED, LANG_TAGS } from '../../data/site-config';

const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const updated = displayDate(LAST_UPDATED, LANG_TAGS[lang]);

// Παράδειγμα αναφοράς : 1.500 € μικτά, άνω των 30, χωρίς παιδιά, 14 καταβολές.
const G = 1500;
const s = salary({ gross: G });
const s1 = salary({ gross: G, children: 1 }), s2 = salary({ gross: G, children: 2 }), s3 = salary({ gross: G, children: 3 });
const sY = salary({ gross: G, age: 'u25' }), sY2 = salary({ gross: G, age: '26_30' });
const s12 = salary({ gross: G * 14 / 12, payments: 12 });
const min = salary({ gross: P.minimum_wage.monthly });
const G3 = 3000, s3k = salary({ gross: G3 });
const net1500 = 1500, gfn = grossForNet(net1500);
const xmas = christmasBonus({ pay: G });

// Πίνακας παραδειγμάτων.
const exGross = [P.minimum_wage.monthly, 1200, 1500, 2000, 2500, 3000, 4000, 6000];
const exRows = exGross.map((g) => { const r = salary({ gross: g }); return [$(g), $(r.efka), $(r.tax), $(r.net), $(r.netPer12), $(r.cost)]; });

// Ηλικία × παιδιά : το «πλεονέκτημα δεδομένων» του υπολογιστή.
const matrixGross = 1800;
const ageLabel = { u25: 'έως 25', '26_30': '26-30', over30: '31+' } as const;
const matrix = (['u25', '26_30', 'over30'] as const).map((a) => [ageLabel[a], ...[0, 1, 2, 3, 4].map((k) => $(salary({ gross: matrixGross, age: a, children: k }).net))]);
const spread = salary({ gross: matrixGross, age: 'u25', children: 0 }).net - salary({ gross: matrixGross, children: 0 }).net;
const kidSpread = salary({ gross: matrixGross, children: 4 }).net - salary({ gross: matrixGross, children: 0 }).net;

const paramRows = [
  ['Κατώτατος μισθός (από 1.4.2026)', `${F.minWage} / ${F.minDaily} ημερομίσθιο`, 'Υπουργείο Εργασίας'],
  ['Εισφορές e-ΕΦΚΑ εργαζομένου (ΚΠΚ 101)', F.efkaEe, 'εγκύκλιος e-ΕΦΚΑ 38/2024'],
  ['Εισφορές e-ΕΦΚΑ εργοδότη (ΚΠΚ 101)', F.efkaEr, 'εγκύκλιος e-ΕΦΚΑ 38/2024'],
  ['Ανώτατο όριο ασφαλιστέων αποδοχών', `${F.ceiling} τον μήνα`, 'εγκύκλιος e-ΕΦΚΑ 4/2026'],
  ['Κλίμακα φόρου μισθωτών', F.r.join(' / '), 'ν. 5246/2025, άρθρο 3'],
  ['Όρια κλιμακίων', F.limits.filter(Boolean).join(' · '), 'άρθρο 15 ΚΦΕ'],
  ['2ο κλιμάκιο με 1 / 2 / 3 τέκνα', `${F.second[1]} / ${F.second[2]} / ${F.second[3]}`, 'άρθρο 15 παρ. 1β ΚΦΕ'],
  ['Νέοι: δύο πρώτα κλιμάκια (έως 25 / 26-30)', `${F.youthU25} / ${F.youth2630} έως ${F.youthLimit}`, 'άρθρο 15 παρ. 1ε ΚΦΕ'],
  ['Μείωση φόρου (0 έως 3 τέκνα)', F.credit.slice(0, 4).join(' / '), 'άρθρο 16 ΚΦΕ'],
  ['Περικοπή μείωσης άνω των 12.000 €', `${F.creditTaper} ανά 1.000 €`, 'άρθρο 16 παρ. 2 ΚΦΕ'],
  ['Καταβολές τον χρόνο', '14 (12 + δώρα + επίδομα αδείας)', 'Επιθεώρηση Εργασίας'],
];

const faqs = [
  { q: 'Πώς βγαίνουν τα καθαρά από τα μικτά στη μισθοδοσία;', a: `Από τα μικτά αφαιρούνται πρώτα οι εισφορές e-ΕΦΚΑ του εργαζομένου, ${F.efkaEe}. Το υπόλοιπο πολλαπλασιάζεται επί 14 για να βρεθεί το ετήσιο φορολογητέο, φορολογείται με την κλίμακα ${F.year} και μειώνεται κατά την έκπτωση του άρθρου 16, και ο ετήσιος φόρος μοιράζεται στις καταβολές. Με ${$(G)} μικτά μένουν ${$(s.net)} καθαρά.` },
  { q: 'Γιατί ο συνάδελφός μου με τον ίδιο μισθό παίρνει περισσότερα;', a: `Από το ${F.year} ο φόρος εξαρτάται από την ηλικία και τα παιδιά. Με ${$(G)} μικτά, κάποιος έως 25 ετών παίρνει ${$(sY.net)}, κάποιος 26-30 ετών ${$(sY2.net)}, ενώ ένας γονέας δύο παιδιών ${$(s2.net)}, έναντι ${$(s.net)} για άτομο άνω των 30 χωρίς παιδιά. Οι εισφορές είναι ίδιες· διαφέρει μόνο ο φόρος.` },
  { q: 'Ο υπολογιστής μετράει το δώρο Χριστουγέννων και το επίδομα αδείας;', a: `Ναι, αν επιλέξετε 14 καταβολές. Τα δώρα φορολογούνται μαζί με τον μισθό και ο φόρος του έτους μοιράζεται ισόποσα. Για ${$(G)} μικτά, το δώρο Χριστουγέννων είναι ${$(xmas.amount)} μικτά, γιατί περιλαμβάνει και την αναλογία του επιδόματος αδείας. Τα καθαρά σε 12μηνη βάση είναι ${$(s.netPer12)} τον μήνα.` },
  { q: 'Ξέρω μόνο τα καθαρά της προσφοράς. Πώς βρίσκω τα μικτά;', a: `Χρησιμοποιήστε τον αντίστροφο υπολογισμό από καθαρά σε μικτά, που λύνει την ίδια εξίσωση ανάποδα. Για ${$(net1500)} καθαρά ανά καταβολή, άνω των 30 χωρίς παιδιά, χρειάζονται περίπου ${$(gfn)} μικτά. Ρωτήστε πάντα τον εργοδότη για τα μικτά και για το αν μιλά για 12 ή 14 καταβολές.` },
  { q: 'Τι γίνεται με τις εισφορές σε πολύ υψηλούς μισθούς;', a: `Οι εισφορές υπολογίζονται μέχρι το ανώτατο όριο ασφαλιστέων αποδοχών, ${F.ceiling} τον μήνα από 1.1.${F.year}. Πάνω από αυτό το ποσό δεν πληρώνονται ούτε εισφορές εργαζομένου ούτε εργοδότη, οπότε η μέγιστη εισφορά του εργαζομένου είναι ${$(P.efka.ceiling_monthly * P.efka.employee_rate)} τον μήνα. Ο υπολογιστής εφαρμόζει το όριο αυτόματα.` },
  { q: 'Ισχύει ο υπολογισμός για δημόσιους υπαλλήλους ή ελεύθερους επαγγελματίες;', a: `Ο υπολογιστής αφορά μισθωτούς του ιδιωτικού τομέα με τις κοινές εισφορές του ΚΠΚ ${F.kpk}, δηλαδή ${F.efkaEe} για τον εργαζόμενο. Η κλίμακα φόρου και η μείωση του άρθρου 16 είναι ίδιες για όλους τους μισθωτούς και συνταξιούχους, όμως οι εισφορές του Δημοσίου, των βαρέων επαγγελμάτων και των ελεύθερων επαγγελματιών διαφέρουν, οπότε τα καθαρά τους δεν βγαίνουν σωστά εδώ.` },
  { q: 'Πόσο κοστίζει στον εργοδότη ένας μισθός 1.500 € μικτά;', a: `Ο εργοδότης πληρώνει επιπλέον εισφορές ${F.efkaEr}, δηλαδή ${$(s.employer)} ανά καταβολή, άρα το συνολικό κόστος είναι ${$(s.cost)} και ${$(s.costAnnual)} τον χρόνο με 14 καταβολές. Από αυτό ο εργαζόμενος κρατά ${$(s.net)} καθαρά, περίπου ${pct(s.net / s.cost, lang)} του κόστους.` },
];

const related = [
  { href: route('nettogross', lang), name: label('nettogross', lang), description: 'Πόσα μικτά χρειάζονται για τα καθαρά που θέλετε.' },
  { href: route('christmas', lang), name: label('christmas', lang), description: 'Ολόκληρο ή αναλογικό, μικτό και καθαρό.' },
  { href: route('severance', lang), name: label('severance', lang), description: 'Με ή χωρίς προειδοποίηση, με τα έτη στον εργοδότη.' },
];
const sources = [src('min_wage', lang), src('efka_rates', lang), src('efka_ceiling', lang), src('tax_scale', lang), src('tax_credit', lang), src('hli_bonuses', lang)];
const title = `Υπολογισμός μισθού ${F.year}: καθαρά από μικτά με ΕΦΚΑ και φόρο`;
const description = `Υπολογισμός μισθού ${F.year}: ${F.minWage} μικτά δίνουν ${F.minNet} καθαρά. Εισφορές ΕΦΚΑ ${F.efkaEe}, νέα κλίμακα φόρου, ηλικία, παιδιά και 14 μισθοί. Δωρεάν, χωρίς εγγραφή.`;
const path = route('home', lang);
const jsonLd = [webApplicationSchema({ name: `Υπολογισμός μισθού ${F.year}`, description, path, lang }), websiteSchema(lang), organizationSchema(lang), faqSchema(faqs, lang)];
---
<PageLayout title={title} description={description} lang={lang} jsonLd={jsonLd} faqs={faqs} related={related} sources={sources}>
  <article>
    <header class="mb-6">
      <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Υπολογισμός μισθού {F.year}: από μικτά σε καθαρά</h1>
      <p class="mt-3 text-lg text-navy-600">Καθαρός μισθός με τις εισφορές e-ΕΦΚΑ, τη νέα κλίμακα φόρου και τις μειώσεις για νέους και παιδιά, όπως τον υπολογίζει η μισθοδοσία.</p>
      <p class="mt-2 text-sm text-navy-500">Συντελεστές {F.year} · ενημέρωση {updated}</p>
    </header>
    <ToolCalc client:load kind="salary" lang={lang} methodHref={route('method', lang)} />

    <p class="mt-8 text-navy-700">Με μικτό μισθό {$(G)} τον μήνα, ένας μισθωτός του ιδιωτικού τομέα άνω των 30 ετών χωρίς παιδιά παίρνει το {F.year} {$(s.net)} καθαρά σε καθεμία από τις 14 καταβολές του έτους, δηλαδή {$(s.netAnnual)} καθαρά τον χρόνο. Από τα μικτά αφαιρούνται οι εισφορές e-ΕΦΚΑ του εργαζομένου, {F.efkaEe} ή {$(s.efka)}, και η παρακράτηση φόρου, περίπου {$(s.tax)}, που προκύπτει από τη νέα κλίμακα του ν. 5246/2025 και τη μείωση φόρου του άρθρου 16. Ο ίδιος μισθός δίνει {$(s1.net)} με ένα παιδί, {$(s2.net)} με δύο και {$(sY.net)} σε όποιον είναι έως 25 ετών, γιατί από φέτος ο φόρος εξαρτάται από την ηλικία και την οικογένεια. Με τον κατώτατο μισθό των {F.minWage} τα καθαρά είναι {F.minNet}. Ο υπολογιστής παραπάνω κάνει τον υπολογισμό μισθού για οποιοδήποτε ποσό, με 12 ή 14 καταβολές, και δείχνει και το κόστος του εργοδότη.</p>

    <div class="prose prose-slate max-w-none">
      <h2>Πώς υπολογίζεται ο καθαρός μισθός</h2>
      <p>Ο καθαρός μισθός είναι ό,τι μένει στον λογαριασμό σας αφού ο εργοδότης παρακρατήσει και αποδώσει δύο ποσά: τις ασφαλιστικές εισφορές του εργαζομένου στον e-ΕΦΚΑ και τον φόρο μισθωτών υπηρεσιών (ΦΜΥ) στην ΑΑΔΕ. Η σειρά έχει σημασία, γιατί ο φόρος υπολογίζεται πάνω σε ό,τι μένει μετά τις εισφορές. Ο υπολογιστής ακολουθεί τα ίδια βήματα με ένα πρόγραμμα μισθοδοσίας.</p>
      <ol>
        <li><strong>Εισφορές e-ΕΦΚΑ.</strong> Για τους περισσότερους μισθωτούς του ιδιωτικού τομέα (ΚΠΚ {F.kpk}) ο εργαζόμενος πληρώνει {F.efkaEe} των μικτών, από τα οποία {F.efkaHealthEe} πηγαίνουν στην υγειονομική περίθαλψη. Με {$(G)} μικτά, {$(s.efka)} τον μήνα. Οι εισφορές σταματούν πάνω από το πλαφόν των {F.ceiling}.</li>
        <li><strong>Ετήσιο φορολογητέο.</strong> Τα μικτά μείον τις εισφορές, επί τον αριθμό καταβολών. Με 14 καταβολές και {$(G)} μικτά προκύπτουν {$(s.taxableAnnual)} φορολογητέα τον χρόνο. Το άρθρο 60 ΚΦΕ ορίζει ακριβώς αυτή την «αναγωγή σε ετήσιο» για την παρακράτηση.</li>
        <li><strong>Φόρος κλίμακας.</strong> {F.r[0]} έως 10.000 €, {F.r[1]} έως 20.000 €, {F.r[2]} έως 30.000 €, {F.r[3]} έως 40.000 €, {F.r[4]} έως 60.000 € και {F.r[5]} πάνω από εκεί, με χαμηλότερους συντελεστές για γονείς και νέους. Στο παράδειγμα ο φόρος κλίμακας είναι {$(s.scaleAnnual)}.</li>
        <li><strong>Μείωση φόρου.</strong> Αφαιρούνται {F.credit[0]} χωρίς παιδιά ή περισσότερα με παιδιά, ποσό που μειώνεται κατά {F.creditTaper} για κάθε 1.000 € φορολογητέου πάνω από τα {F.creditThreshold}. Εδώ η μείωση είναι {$(s.creditAnnual)}.</li>
        <li><strong>Κατανομή.</strong> Ο ετήσιος φόρος, {$(s.taxAnnual)}, μοιράζεται ισόποσα στις καταβολές: {$(s.tax)} σε κάθε μισθό και σε κάθε δώρο.</li>
      </ol>
      <p>Καθαρά = μικτά μείον εισφορές μείον φόρος. Με {$(G)} μικτά προκύπτουν {$(s.net)}, ενώ ο εργοδότης πληρώνει συνολικά {$(s.cost)}, γιατί προσθέτει τις δικές του εισφορές {F.efkaEr}. Τον πλήρη τρόπο υπολογισμού, τις στρογγυλοποιήσεις και τα όρια του εργαλείου θα τα βρείτε στη <a href={route('method', lang)}>μεθοδολογία</a>.</p>
      <p>Πολλοί αναζητούν «υπολογισμος μισθου» ή «ypologismos misthou» και βρίσκουν υπολογιστές που αγνοούν τις αλλαγές του {F.year}. Η μεγαλύτερη είναι ότι δύο άνθρωποι με το ίδιο μικτό δεν έχουν πια τα ίδια καθαρά: η ηλικία και τα εξαρτώμενα τέκνα αλλάζουν τους συντελεστές των πρώτων κλιμακίων. Γι' αυτό ο υπολογιστής ζητά και τα δύο στοιχεία πριν δώσει αποτέλεσμα.</p>

      <h2>Γιατί η ηλικία και τα παιδιά αλλάζουν τα καθαρά το {F.year}</h2>
      <p>Μέχρι πέρυσι, ένας υπολογισμός καθαρού μισθού χρειαζόταν ουσιαστικά μόνο τα μικτά και τον αριθμό των παιδιών για τη μείωση φόρου. Από τον Ιανουάριο του {F.year}, το άρθρο 15 ΚΦΕ, όπως το αντικατέστησε ο ν. 5246/2025, δίνει διαφορετικούς συντελεστές ανάλογα με δύο διαστάσεις: την ηλικία του φορολογούμενου και τον αριθμό των εξαρτώμενων τέκνων. Ο πίνακας δείχνει τα καθαρά ανά καταβολή για {$(matrixGross)} μικτά σε όλους τους συνδυασμούς.</p>
    </div>
    <ContentTable headers={['Ηλικία \\ τέκνα', '0', '1', '2', '3', '4']} align={['l', 'r', 'r', 'r', 'r', 'r']} rows={matrix} highlightRow={2} />
    <div class="prose prose-slate mt-6 max-w-none">
      <p>Η απόσταση ανάμεσα στο ακριβότερο και στο φθηνότερο κελί του πίνακα δεν είναι λεπτομέρεια. Ένας 24χρονος παίρνει {$(spread)} περισσότερα ανά καταβολή από έναν 35χρονο χωρίς παιδιά, με τον ίδιο ακριβώς μισθό, και ένας γονέας τεσσάρων παιδιών {$(kidSpread)} περισσότερα. Ένας υπολογιστής που αγνοεί την ηλικία ή μετρά τα παιδιά μόνο στη μείωση φόρου βγάζει λάθος καθαρά για τους νέους και τους γονείς· ο δικός μας εφαρμόζει τους συντελεστές του νόμου σε κάθε συνδυασμό.</p>
      <h3>Νέοι έως 30 ετών</h3>
      <p>Για φορολογούμενους έως 25 ετών τα δύο πρώτα κλιμάκια, μέχρι {F.youthLimit} φορολογητέο, έχουν συντελεστή {F.youthU25}. Από 26 έως 30 ετών ο συντελεστής των ίδιων κλιμακίων είναι {F.youth2630}. Πάνω από τις 20.000 € εφαρμόζεται η κανονική κλίμακα, άρα το όφελος έχει ανώτατο όριο. Αναλυτικά παραδείγματα στον οδηγό για τον <a href={route('youth', lang)}>φόρο των νέων</a>.</p>
      <h3>Γονείς</h3>
      <p>Με ένα παιδί το δεύτερο κλιμάκιο φορολογείται με {F.second[1]} αντί για {F.r[1]}, με δύο με {F.second[2]}, με τρία με {F.second[3]}, και από τέσσερα παιδιά τα δύο πρώτα κλιμάκια μηδενίζονται. Μειώνεται επίσης το τρίτο κλιμάκιο ({F.third[1]} με ένα παιδί έως {F.third[4]} με τέσσερα) και αυξάνεται η μείωση φόρου του άρθρου 16. Τον υπολογισμό ανά αριθμό παιδιών δείχνει ο οδηγός για τη <a href={route('children', lang)}>μείωση φόρου για παιδιά</a>.</p>
      <p>Ο εργοδότης εφαρμόζει τη μείωση στην παρακράτηση μόνο αν γνωρίζει την ηλικία σας και τα εξαρτώμενα τέκνα. Αν κάποιο από τα δύο λείπει από τη μισθοδοσία, η διαφορά επιστρέφει με την εκκαθάριση της φορολογικής δήλωσης, όχι όμως στον μισθό του μήνα.</p>

      <h2>Συντελεστές και παράμετροι {F.year}</h2>
      <p>Όλες οι τιμές του πίνακα προέρχονται από το αρχείο παραμέτρων που χρησιμοποιεί ο μηχανισμός υπολογισμού, οπότε δεν μπορούν να διαφέρουν από το αποτέλεσμα του υπολογιστή. Τις ελέγξαμε στις πηγές στις {updated}.</p>
    </div>
    <ContentTable headers={['Παράμετρος', `Τιμή ${F.year}`, 'Πηγή']} align={['l', 'r', 'l']} rows={paramRows} />

    <div class="prose prose-slate mt-8 max-w-none">
      <h2>Παραδείγματα καθαρών αποδοχών {F.year}</h2>
      <p>Ο πίνακας αφορά μισθωτό άνω των 30 ετών χωρίς εξαρτώμενα τέκνα, με 14 καταβολές. Η στήλη «12μηνη βάση» μοιράζει τα δώρα και το επίδομα αδείας στους δώδεκα μήνες, όπως όταν συγκρίνετε μια προσφορά με μισθό άλλης χώρας ή συμπληρώνετε αίτηση δανείου.</p>
    </div>
    <ContentTable headers={['Μικτά', 'ΕΦΚΑ', 'Φόρος', 'Καθαρά (×14)', 'Καθαρά 12μηνη βάση', 'Κόστος εργοδότη']} align={['r', 'r', 'r', 'r', 'r', 'r']} rows={exRows} highlightRow={2} />

    <div class="prose prose-slate mt-8 max-w-none">
      <p>Το ποσοστό των καθαρών στα μικτά μειώνεται όσο ανεβαίνει ο μισθός, αλλά πιο αργά απ' όσο νομίζουν πολλοί: στον κατώτατο μισθό μένει το {pct(min.net / P.minimum_wage.monthly, lang)}, στα {$(G3)} μικτά το {pct(s3k.net / G3, lang)}. Οι εισφορές είναι σταθερό ποσοστό, ενώ ο φόρος ανεβαίνει κλιμακωτά και η μείωση του άρθρου 16 σβήνει σταδιακά πάνω από τις 12.000 € φορολογητέου.</p>
      <div data-chrome><MiniSim client:load kind="amount" lang={lang} href={route('home', lang)} /></div>

      <h2>14 ή 12 καταβολές: τι σημαίνει για τον υπολογισμό</h2>
      <p>Στον ιδιωτικό τομέα ο μισθός πληρώνεται 14 φορές τον χρόνο: δώδεκα μηνιαίοι μισθοί, το δώρο Χριστουγέννων, το δώρο Πάσχα και το επίδομα αδείας. Γι' αυτό μια σύμβαση με {$(G)} μικτά τον μήνα αντιστοιχεί σε {$(G * 14)} μικτά τον χρόνο. Αν η σύμβαση ή η προσφορά δίνει ετήσιο ποσό σε δώδεκα δόσεις, επιλέξτε 12 καταβολές: για το ίδιο ετήσιο μικτό, τα καθαρά τον χρόνο είναι ίδια ({$(s12.netAnnual)}), απλώς μοιράζονται διαφορετικά. Ο οδηγός για τους <a href={route('fourteen', lang)}>14 μισθούς</a> δείχνει τις μετατροπές.</p>
      <p>Τα δώρα δεν είναι «αφορολόγητα»: υπόκεινται σε εισφορές και φόρο όπως ο μισθός. Το δώρο Χριστουγέννων ισούται με έναν μισθό συν την αναλογία του επιδόματος αδείας και πληρώνεται έως τις 21 Δεκεμβρίου, το δώρο Πάσχα με μισό μισθό έως τη Μεγάλη Τετάρτη. Για εργασία μικρότερη της περιόδου τα δώρα είναι αναλογικά, και τα υπολογίζουν οι σελίδες για το <a href={route('christmas', lang)}>δώρο Χριστουγέννων</a>, το <a href={route('easter', lang)}>δώρο Πάσχα</a> και το <a href={route('leave', lang)}>επίδομα αδείας</a>.</p>

      <h2>Μικτά, καθαρά και κόστος εργοδότη: τρία ποσά για έναν μισθό</h2>
      <p>Σε μια συνέντευξη εργασίας ακούγονται συχνά τρία διαφορετικά νούμερα. Τα μικτά είναι το ποσό της σύμβασης και η βάση για όλους τους υπολογισμούς: εισφορές, φόρο, δώρα, αποζημίωση απόλυσης. Τα καθαρά είναι η μεταφορά στον λογαριασμό, που εξαρτάται και από προσωπικά στοιχεία όπως η ηλικία και τα παιδιά. Το κόστος εργοδότη είναι τα μικτά συν τις εργοδοτικές εισφορές {F.efkaEr}: με {$(G)} μικτά, {$(s.cost)} ανά καταβολή.</p>
      <p>Γι' αυτό μια προσφορά «{$(s.net)} καθαρά» και μια προσφορά «{$(G)} μικτά» μπορεί να είναι ακριβώς το ίδιο πράγμα για έναν άνθρωπο και διαφορετικό για τον διπλανό του, που έχει άλλη ηλικία ή παιδιά. Όταν συγκρίνετε προσφορές, ζητήστε πάντα τα μικτά και τον αριθμό των καταβολών, και κάντε τον υπολογισμό με τα δικά σας στοιχεία. Αν ξέρετε μόνο το καθαρό ποσό, ο <a href={route('nettogross', lang)}>υπολογισμός από καθαρά σε μικτά</a> το μετατρέπει. Αν είστε εργοδότης, ο υπολογιστής <a href={route('employer', lang)}>κόστους εργοδότη</a> δίνει το ετήσιο κόστος.</p>

      <h2>Πώς να ελέγξετε τη μισθοδοσία σας</h2>
      <p>Η εκκαθάριση μισθοδοσίας που δίνει το λογιστήριο περιέχει τα ίδια ποσά με τον υπολογιστή, με άλλα ονόματα. Ξεκινήστε από τις «μικτές αποδοχές» και βεβαιωθείτε ότι περιλαμβάνουν όλα τα σταθερά στοιχεία: βασικό μισθό, τριετίες, επιδόματα της σύμβασης. Μετά ελέγξτε τις «κρατήσεις ΕΦΚΑ»: πρέπει να είναι {F.efkaEe} των μικτών, εκτός αν ο μισθός ξεπερνά το πλαφόν ή ανήκετε σε άλλο ασφαλιστικό πακέτο, όπως τα βαρέα και ανθυγιεινά.</p>
      <p>Τελευταίος έλεγχος είναι ο ΦΜΥ. Αν η παρακράτηση είναι μεγαλύτερη από τον υπολογιστή, συνήθως ο εργοδότης δεν έχει καταχωρίσει τα εξαρτώμενα τέκνα ή την ηλικία σας, ή υπάρχει δεύτερη πηγή εισοδήματος. Οι τυχόν διαφορές διορθώνονται στην ετήσια φορολογική δήλωση, όπου ο φόρος υπολογίζεται στο σύνολο των εισοδημάτων. Λεπτομέρειες στον οδηγό για την <a href={route('withholding', lang)}>παρακράτηση φόρου</a>.</p>
      <p>Υπάρχουν και κρατήσεις που ο υπολογιστής δεν γνωρίζει: συνδικαλιστικές συνδρομές, ομαδικά ασφαλιστήρια, δόσεις δανείων ή κατασχέσεις. Δεν αλλάζουν τον φόρο, αλλά μειώνουν το ποσό της μεταφοράς. Αν μετά την αφαίρεσή τους η διαφορά παραμένει, ζητήστε από το λογιστήριο ανάλυση της συγκεκριμένης γραμμής.</p>

      <h2>Δημοφιλείς υπολογισμοί: πόσα καθαρά από συγκεκριμένα μικτά</h2>
      <p>Κάθε σελίδα αναλύει ένα ποσό μικτών με τα δικά του όρια: πότε αλλάζει κλιμάκιο, πότε σβήνει η μείωση φόρου, τι κερδίζει ένας γονέας ή ένας νέος.</p>
      <ul>
        {AMOUNTS.map((a) => <li><a href={route(`amount-${a}`, lang)}>{amountLabel(a, lang)} σε καθαρά</a>: {$(salary({ gross: a }).net)} ανά καταβολή χωρίς παιδιά</li>)}
      </ul>

      <h2>Νόμιμοι τρόποι για περισσότερα καθαρά</h2>
      <p>Οι εισφορές δεν αποφεύγονται, όμως μερικά στοιχεία αλλάζουν πραγματικά το ποσό που φτάνει στον λογαριασμό. Μπορείτε να ελέγξετε το καθένα αλλάζοντας την αντίστοιχη επιλογή στον υπολογιστή.</p>
      <ol>
        <li><strong>Δηλώστε τα εξαρτώμενα τέκνα στον εργοδότη.</strong> Με δύο παιδιά και {$(G)} μικτά τα καθαρά ανεβαίνουν από {$(s.net)} σε {$(s2.net)} ανά καταβολή. Χωρίς δήλωση, η διαφορά έρχεται μόνο με την εκκαθάριση.</li>
        <li><strong>Ελέγξτε ότι εφαρμόζεται η μείωση για νέους.</strong> Έως 25 ετών, ο ίδιος μισθός δίνει {$(sY.net)}. Η ηλικία προκύπτει από τα στοιχεία σας, αλλά ένα λάθος στη μισθοδοσία κοστίζει κάθε μήνα.</li>
        <li><strong>Μετρήστε τις τριετίες.</strong> Αν αμείβεστε με τον κατώτατο, κάθε τριετία προϋπηρεσίας προσθέτει {F.triennium} στον μισθό. Ο οδηγός για τις <a href={route('trienniums', lang)}>τριετίες</a> δείχνει τι σημαίνει σε καθαρά.</li>
        <li><strong>Συγκρίνετε ετήσια, όχι μηνιαία.</strong> Μια προσφορά σε 12 καταβολές μοιάζει μεγαλύτερη από μια σε 14 με το ίδιο ετήσιο ποσό. Φέρτε και τις δύο στα ίδια καθαρά τον χρόνο.</li>
        <li><strong>Ελέγξτε την αποζημίωση πριν από μια αποχώρηση.</strong> Τα έτη στον ίδιο εργοδότη αξίζουν μισθούς αποζημίωσης· ο υπολογισμός της <a href={route('severance', lang)}>αποζημίωσης απόλυσης</a> δείχνει πόσους.</li>
      </ol>
      <p>Ο υπολογιστής αφορά έναν εργοδότη και ένα έτος. Αν έχετε και άλλα εισοδήματα, ενοίκια ή δεύτερη απασχόληση, ο τελικός φόρος προκύπτει από τη φορολογική δήλωση στο σύνολο των εισοδημάτων. Αν εργάζεστε στην Ελλάδα και προτιμάτε τα αγγλικά, η ίδια σελίδα υπάρχει στην <a href={route('home', 'en')} hreflang="en">αγγλική έκδοση</a>, με τους ίδιους υπολογισμούς.</p>
    </div>
