---
import PageLayout from '../../layouts/PageLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import MiniSim from '../../components/calc/MiniSim';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { t } from '../../i18n/ui';
import { facts, src } from '../../lib/facts';
import { salary, christmasBonus, easterBonus, leaveAllowance, severance, roadTax, enfia, pension, nationalPension, grossForNet, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney, formatDecimal, pct, displayDate } from '../../lib/format';
import { webPageSchema, breadcrumbSchema } from '../../lib/seo';
import { LANG_TAGS } from '../../data/site-config';

const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const $2 = (x: number) => formatMoney(x, 2, lang);
const checked = displayDate(F.retrieved, LANG_TAGS[lang]);
const M = P.minimum_wage;

// Παράδειγμα βήμα προς βήμα
const G = 1500;
const s = salary({ gross: G });
const inv = grossForNet(Math.round(s.net));

// Επαλήθευση με τα 12 παραδείγματα του Υπουργείου Εργασίας
const checks = M.official_examples.map((e) => { const r = salary({ gross: e.gross, children: e.children }); return { ...e, engine: r.net, diff: r.net - e.net }; });
const maxDiff = Math.max(...checks.map((c) => Math.abs(c.diff)));
const sign = (x: number) => `${x > 0.005 ? '+' : x < -0.005 ? '−' : ''}${$2(Math.abs(x))}`;
const checkRows = checks.map((c) => [$(c.gross), String(c.children), $(c.net), $2(c.engine), sign(c.diff)]);
const nTests = 50;

// Δώρα, αποζημίωση, τέλη, ΕΝΦΙΑ, σύνταξη
const xm = christmasBonus({ pay: G }), xmPart = christmasBonus({ pay: G, days: 95 }), ea = easterBonus({ pay: G }), lv = leaveAllowance({ pay: G }), lvPart = leaveAllowance({ pay: G, months: 7 });
const sev = severance({ pay: G, years: 8 }), sevN = severance({ pay: G, years: 8, notice: true });
const wltp = roadTax({ category: 'co2_wltp', co2: 130 }), cc = roadTax({ category: 'cc_from_2006', cc: 1600 });
const en = enfia({ sqm: 80, zonePrice: 1400, buildYear: 1995, floor: 'f2_3' });
const pen = pension({ years: 30, avgEarnings: 1400 });
const R = P.road_tax, E = P.enfia, Q = P.pension, S = P.severance;
const lim = P.tax.brackets.map((b, i) => `${i === 0 ? '0' : $(P.tax.brackets[i - 1].upTo as number)}–${b.upTo === null ? '…' : $(b.upTo)}: ${pct(b.rate, lang)}`).join(' · ');
const L = (k: keyof typeof P.sources) => P.sources[k].label[lang];
const paramRows = [
  ['Κατώτατος μισθός και ημερομίσθιο (από 1/4)', `${F.minWage} · ${F.minDaily}`, L('min_wage')],
  ['Προσαύξηση τριετίας στον κατώτατο', `${F.triennium}, έως ${F.trienniumMax} τριετίες`, L('min_wage')],
  ['Εισφορές ΚΠΚ 101, εργαζόμενος και εργοδότης', `${F.efkaEe} · ${F.efkaEr}`, L('efka_rates')],
  ['Από αυτές για υγεία', `${F.efkaHealthEe} · ${F.efkaHealthEr}`, L('efka_rates')],
  ['Ανώτατο όριο ασφαλιστέων αποδοχών', `${F.ceiling} τον μήνα`, L('efka_ceiling')],
  ['Φορολογική κλίμακα', lim, L('tax_scale')],
  ['2ο κλιμάκιο με 1, 2, 3 τέκνα', F.second.slice(1).join(' · '), L('tax_scale')],
  ['3ο κλιμάκιο με 1 έως 4 τέκνα', `${F.third.slice(1).join(' · ')}, −${F.thirdStep} ανά επιπλέον τέκνο`, L('tax_scale')],
  ['Νέοι, δύο πρώτα κλιμάκια', `${F.youthU25} έως 25 ετών · ${F.youth2630} από 26 έως 30, έως ${F.youthLimit}`, L('tax_scale')],
  ['Μείωση φόρου άρθρου 16 (0 έως 5 τέκνα)', `${F.credit.join(' · ')}, +${F.creditStep} ανά επιπλέον τέκνο`, L('tax_credit')],
  ['Μείωση της έκπτωσης', `${F.creditTaper} ανά ${$(1000)} πάνω από ${F.creditThreshold}`, L('tax_credit')],
  ['Δώρο Χριστουγέννων / Πάσχα', `1 μισθός ή ${F.xmasDaily} ημερομίσθια · ½ μισθός ή ${F.easterDaily}, + ${F.leaveShare}`, L('hli_christmas')],
  ['Επίδομα αδείας', `έως ½ μισθός ή ${F.leaveDaily} ημερομίσθια`, L('hli_bonuses')],
  ['Αποζημίωση απόλυσης', `${S.table_months[0].months} έως ${S.table_months[S.table_months.length - 1].months} μισθοί, όριο ${F.sevCap}, + 1/6`, L('severance')],
  ['Τέλη κυκλοφορίας, πίνακες κυβισμού', `${$(Math.min(...R.cc_from_2006))} έως ${$(Math.max(...R.cc_from_2006))}`, L('road_tax')],
  ['Τέλη κυκλοφορίας WLTP ανά γραμμάριο', `${$2(0)} έως ${$2(R.co2_wltp[R.co2_wltp.length - 1].rate)}`, L('road_tax')],
  ['ΕΝΦΙΑ, βασικός φόρος ανά m²', `${$2(E.zone_bands[0].rate)} έως ${$2(E.zone_bands[E.zone_bands.length - 1].rate)} σε ${E.zone_bands.length} ζώνες`, L('enfia')],
  ['ΕΝΦΙΑ, εκπτώσεις', `έως ${pct(E.value_reductions[0].rate, lang)} με την αξία · ${F.insurance} ασφάλιση · ${F.village} οικισμοί`, L('enfia_reductions')],
  ['Εθνική σύνταξη (ποσό 2025)', F.nationalFull, L('pension_national')],
  ['Ποσοστά αναπλήρωσης', `${pct(Q.replacement_rates[0].rate, lang)} έως ${pct(Math.max(...Q.replacement_rates.map((r) => r.rate)), lang)} ανά έτος`, L('pension')],
];
const sources = (Object.keys(P.sources) as Array<keyof typeof P.sources>).map((k) => src(k, lang));

const title = `Καθαρός μισθός ${F.year}: μεθοδολογία, τύποι και επίσημες πηγές`;
const description = `Από τα μικτά στα καθαρά ${F.year}: ×14, ΕΦΚΑ ${F.efkaEe} έως το πλαφόν, κλίμακα με τέκνα, μείωση άρθρου 16. Επαληθευμένο στα 12 παραδείγματα του Υπουργείου Εργασίας.`;
const path = route('method', lang);
const h1 = `Πώς υπολογίζουμε: η μεθοδολογία του ${F.year}`;
const jsonLd = [webPageSchema({ name: h1, description, path, lang }), breadcrumbSchema([{ name: t(lang).breadcrumbHome, path: route('home', lang) }, { name: label('method', lang), path }])];
---
<PageLayout title={title} description={description} lang={lang} jsonLd={jsonLd} sources={sources} breadcrumbs={[{ label: label('method', lang) }]}
  related={[{ href: route('home', lang), name: label('home', lang), description: 'Ο βασικός υπολογιστής καθαρών, με ηλικία, τέκνα και καταβολές.' }, { href: route('faq', lang), name: label('faq', lang), description: 'Δεδομένα, ενημερώσεις και διαφορές με το εκκαθαριστικό.' }, { href: route('withholding', lang), name: label('withholding', lang), description: 'Πώς ο εργοδότης παρακρατά τον φόρο κάθε μήνα.' }]}>
  <article>
    <header class="mb-6">
      <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">{h1}</h1>
      <p class="mt-3 text-lg text-navy-600">Οι τύποι, η σειρά των πράξεων, οι στρογγυλοποιήσεις, τα όρια του μοντέλου και η πηγή κάθε συντελεστή.</p>
    </header>
    <p class="mb-6 text-navy-700">Όλοι οι υπολογιστές του ιστότοπου τρέχουν μέσα στον browser σας, με καθαρές συναρτήσεις που δεν επικοινωνούν με κανέναν διακομιστή. Κανένας συντελεστής δεν είναι γραμμένος μέσα στον κώδικα: κλίμακα, εισφορές, πλαφόν, δώρα, πίνακες αποζημίωσης, τέλη κυκλοφορίας, ΕΝΦΙΑ και σύνταξη διαβάζονται από ένα μοναδικό αρχείο παραμέτρων του {F.year}, όπου δίπλα σε κάθε ομάδα τιμών σημειώνεται η επίσημη πηγή. Ο τελευταίος πλήρης έλεγχος των τιμών έγινε στις {checked}. Από το ίδιο αρχείο παράγονται και οι πίνακες των οδηγών, οπότε κείμενο, πίνακας και αποτέλεσμα δεν μπορούν να διαφωνούν. Ο μισθός υπολογίζεται σε ετήσια βάση, όπως κάνει το λογιστήριο για την παρακράτηση: μικτά επί 14, εισφορές e-ΕΦΚΑ έως το ανώτατο όριο, φόρος με την κλίμακα του ν. 5246/2025 ανάλογα με τα τέκνα και την ηλικία, μείωση του άρθρου 16 ΚΦΕ και ισόποση κατανομή του φόρου στις καταβολές. Τα αποτελέσματα του μηχανισμού διαφέρουν από τα δώδεκα επίσημα παραδείγματα του Υπουργείου Εργασίας το πολύ κατά {$2(maxDiff)}.</p>

    <div data-chrome><MiniSim client:load kind="methodsteps" lang={lang} href={route('home', lang)} /></div>

    <div class="prose prose-slate max-w-none">
      <h2>Ο μισθός σε οκτώ βήματα</h2>
      <p>Ο μηχανισμός ακολουθεί τη λογική του άρθρου 60 ΚΦΕ: οι αποδοχές μιας καταβολής αναγάγονται σε ετήσιες, υπολογίζεται ο φόρος του έτους και μοιράζεται. Για μικτό {$(G)} τον μήνα, εργαζόμενο άνω των 30 χωρίς τέκνα, οι αριθμοί είναι οι εξής.</p>
      <ol>
        <li><strong>Ετήσιο μικτό</strong> = μηνιαίο μικτό × 14 (ή × 12, αν η σύμβαση ενσωματώνει δώρα και επίδομα στον μισθό). Εδώ {$(s.annualGross)}.</li>
        <li><strong>Ασφαλιστέες αποδοχές</strong> = το μικρότερο από το μικτό και το πλαφόν των {F.ceiling}. Πάνω από αυτό δεν πληρώνεται εισφορά, ούτε από τον εργαζόμενο ούτε από τον εργοδότη.</li>
        <li><strong>Εισφορά εργαζομένου</strong> = ασφαλιστέες αποδοχές × {F.efkaEe} (ΚΠΚ {F.kpk}). Ανά καταβολή {$2(s.efka)}, τον χρόνο {$2(s.efkaAnnual)}.</li>
        <li><strong>Φορολογητέο εισόδημα</strong> = ετήσιο μικτό − ετήσιες εισφορές = {$2(s.taxableAnnual)}.</li>
        <li><strong>Φόρος κλίμακας</strong>: κάθε τμήμα του εισοδήματος φορολογείται με τον συντελεστή του κλιμακίου του. Τα τέκνα αλλάζουν τον συντελεστή του 2ου κλιμακίου ({F.second.slice(1).join(', ')} με ένα έως τρία) και του 3ου ({F.third.slice(1).join(', ')} με ένα έως τέσσερα), ενώ με τέσσερα τέκνα τα δύο πρώτα κλιμάκια μηδενίζονται. Για ηλικία έως 25 ετών τα δύο πρώτα κλιμάκια έχουν {F.youthU25}, από 26 έως 30 ετών {F.youth2630}, και ισχύει ο ευνοϊκότερος συντελεστής όταν συντρέχουν τέκνα και ηλικία. Εδώ {$2(s.scaleAnnual)}.</li>
        <li><strong>Μείωση φόρου άρθρου 16</strong> = {F.credit[0]} χωρίς τέκνα (έως {F.credit[5]} με πέντε), μειωμένη κατά {F.creditTaper} ανά {$(1000)} φορολογητέου πάνω από {F.creditThreshold}, χωρίς μείωση από πέντε τέκνα και πάνω, και ποτέ μεγαλύτερη από τον φόρο κλίμακας. Εδώ {$2(s.creditAnnual)}.</li>
        <li><strong>Φόρος έτους και ΦΜΥ</strong> = φόρος κλίμακας − μείωση = {$2(s.taxAnnual)}, και ανά καταβολή {$2(s.tax)}.</li>
        <li><strong>Καθαρά</strong> = (ετήσιο μικτό − εισφορές − φόρος) ÷ 14 = {$2(s.net)}. Το «καθαρό σε 12μηνη βάση» διαιρεί το ίδιο ποσό με 12: {$2(s.netPer12)}.</li>
      </ol>
      <p>Το κόστος του εργοδότη προσθέτει στο μικτό την εισφορά του, {F.efkaEr} των ασφαλιστέων αποδοχών: {$2(s.cost)} ανά καταβολή. Ο υπολογιστής «από καθαρά σε μικτά» δεν έχει δικό του τύπο: αναζητά με διχοτόμηση το μικτό που δίνει το ζητούμενο καθαρό, με ακρίβεια λεπτού. Για καθαρά {$(Math.round(s.net))} βρίσκει {$2(inv)} μικτά, άρα ο ευθύς και ο αντίστροφος υπολογισμός δεν μπορούν να αποκλίνουν.</p>
      <p>Οι πράξεις γίνονται με λεπτά και τα ποσά εμφανίζονται σε ακέραια ευρώ. Τα προγράμματα μισθοδοσίας στρογγυλοποιούν συνήθως κάθε γραμμή χωριστά, γι' αυτό μια διαφορά ενός ευρώ σε σχέση με το εκκαθαριστικό είναι αναμενόμενη.</p>

      <h2>Επαλήθευση: τα 12 επίσημα παραδείγματα και {nTests} αυτόματοι έλεγχοι</h2>
      <p>Με την ανακοίνωση του νέου κατώτατου μισθού, το Υπουργείο Εργασίας δημοσίευσε δώδεκα καθαρά ποσά: μισθός {F.minWage} χωρίς τριετία και με μία έως τρεις τριετίες, για εργαζόμενο χωρίς τέκνα, με ένα και με δύο. Ο μηχανισμός τα αναπαράγει όλα, με μέγιστη απόκλιση {$2(maxDiff)}. Ο πίνακας υπολογίζεται κατά την κατασκευή της σελίδας, άρα αν αλλάξει ένας συντελεστής, αλλάζει και η στήλη της απόκλισης.</p>
    </div>
    <ContentTable headers={['Μικτά', 'Τέκνα', 'Υπουργείο', 'Μηχανισμός', 'Απόκλιση']} align={['r', 'r', 'r', 'r', 'r']} rows={checkRows} />
    <div class="prose prose-slate max-w-none">
      <p>Πριν από κάθε δημοσίευση τρέχουν {nTests} αυτόματοι έλεγχοι στον μηχανισμό: τα δώδεκα παραδείγματα, η κλίμακα με τέκνα και για νέους, η μείωση του άρθρου 16 (π.χ. {F.credit[0]} στις {F.creditThreshold} και {$(P.tax.credit_by_children[0] - 10 * P.tax.credit_taper_per_1000)} στις {$(P.tax.credit_taper_threshold + 10000)}), το πλαφόν, η ισοδυναμία 12 και 14 καταβολών, τα δώρα και οι αναλογίες τους, ο πίνακας αποζημίωσης με και χωρίς προειδοποίηση, τα τέλη WLTP, NEDC και κυβισμού, ο ΕΝΦΙΑ με τις εκπτώσεις του και η σύνταξη. Αν ένας έλεγχος αποτύχει, η νέα έκδοση δεν ανεβαίνει.</p>

      <h2>Δώρα και επίδομα αδείας</h2>
      <p>Το δώρο Χριστουγέννων είναι ένας μισθός (ή {F.xmasDaily} ημερομίσθια) για όποιον εργάστηκε όλη την περίοδο 1 Μαΐου έως 31 Δεκεμβρίου, δηλαδή {F.xmasDays} ημέρες. Για μικρότερη διάρκεια, ο μηχανισμός δίνει 2/25 του μισθού ανά 19 ημέρες (2 ημερομίσθια για τους ημερομίσθιους), αναλογικά και για το υπόλοιπο. Το δώρο Πάσχα είναι μισός μισθός ή {F.easterDaily} ημερομίσθια για την περίοδο 1 Ιανουαρίου έως 30 Απριλίου ({F.easterDays} ημέρες), με αναλογία 1/15 του μισού μισθού ανά 8 ημέρες. Και στα δύο προστίθεται η αναλογία του επιδόματος αδείας, {F.leaveShare}. Με {$(G)} μισθό, το δώρο Χριστουγέννων είναι {$2(xm.amount)} μικτά και με 95 ημέρες απασχόλησης {$2(xmPart.amount)}· το δώρο Πάσχα {$2(ea.amount)}.</p>
      <p>Το επίδομα αδείας ισούται με τις αποδοχές αδείας, με ανώτατο μισό μισθό ή {F.leaveDaily} ημερομίσθια: {$2(lv.amount)} για ολόκληρο έτος. Όταν το δικαίωμα είναι μερικό, ο μηχανισμός το επιμερίζει ανά μήνα εργασίας (με επτά μήνες {$2(lvPart.amount)}), μια απλοποίηση που αναφέρουμε και στα όρια παρακάτω. Τα καθαρά των δώρων υπολογίζονται με τις εισφορές της καταβολής και τον μέσο φορολογικό συντελεστή του έτους του εργαζομένου.</p>

      <h2>Αποζημίωση απόλυσης</h2>
      <p>Βάση είναι οι τακτικές αποδοχές του τελευταίου μήνα πλήρους απασχόλησης· για τον εργατοτεχνίτη ο μήνας λογίζεται {F.sevDailyMonth} ημερομίσθια. Η βάση περιορίζεται στο όριο του άρθρου 5 του ν. 3198/1955, {S.cap_daily_multiple} φορές το ημερομίσθιο του ανειδίκευτου επί {S.cap_days}, σήμερα {F.sevCap}. Οι μήνες προκύπτουν από τον πίνακα του ν. 4093/2012: μηδέν πριν από τον πρώτο χρόνο, {S.table_months[0].months} από ένα έτος, έως {S.table_months[S.table_months.length - 1].months} από {S.table_months[S.table_months.length - 1].fromYears} έτη. Με έγγραφη προειδοποίηση το ποσό διαιρείται διά δύο. Για όσους είχαν τουλάχιστον {S.extra_2012_from_years} έτη στον ίδιο εργοδότη στις 12-11-2012 προστίθενται έως {S.extra_2012_max_months} μήνες, με μισθό έως {F.sevExtraCap}. Στο τέλος προστίθεται 1/6 για την αναλογία των δώρων και του επιδόματος αδείας. Παράδειγμα: {$(G)} με 8 έτη δίνουν {sev.months} μισθούς και {$2(sev.total)}, ή {$2(sevN.total)} με προειδοποίηση.</p>

      <h2>Τέλη κυκλοφορίας</h2>
      <p>Η κατηγορία βγαίνει από την ημερομηνία πρώτης ταξινόμησης στην ΕΕ/ΕΟΧ. Έως 31-10-2010 το τέλος είναι σταθερό ποσό ανά κλιμάκιο κυβισμού, από τρεις πίνακες (έως 2000, 2001-2005, από 2006). Από 1-11-2010 έως 31-12-2020 ισχύει η κλίμακα CO₂ κατά NEDC και από 1-1-2021 η κλίμακα WLTP: όλα τα γραμμάρια πολλαπλασιάζονται με τον συντελεστή του κλιμακίου στο οποίο πέφτει το όχημα. Έτσι 130 g/km WLTP δίνουν {$2(wltp.amount)} ({$2(wltp.rate)} ανά γραμμάριο), ενώ ένα 1.600άρι του 2008 πληρώνει {$(cc.amount)}. Ηλεκτρικά και υδρογόνου έχουν μηδέν. Το τέλος των επιβατικών είναι ενιαίο και αδιαίρετο για όλο το έτος, οπότε ο μηχανισμός δεν το επιμερίζει σε μήνες.</p>

      <h2>ΕΝΦΙΑ</h2>
      <p>Ο κύριος φόρος ενός κτιρίου = τετραγωνικά × βασικός φόρος της ζώνης (από {$2(E.zone_bands[0].rate)} έως {$2(E.zone_bands[E.zone_bands.length - 1].rate)} ανά m² σε {E.zone_bands.length} ζώνες τιμών) × συντελεστής παλαιότητας (από {formatDecimal(E.age_factors[0].factor, 2, lang)} για νεόδμητα έως {formatDecimal(E.age_factor_over_100, 2, lang)} για κτίρια άνω των 100 ετών) × συντελεστής ορόφου ή μονοκατοικίας × προσόψεων × ποσοστό συνιδιοκτησίας. Οι βοηθητικοί χώροι φορολογούνται με συντελεστή {formatDecimal(E.auxiliary_factor, 2, lang)}. Πάνω από {$(E.right_tax_from_value)} συνολικής αξίας προστίθεται φόρος επί της αξίας, πάνω από {$(E.surcharge_from_value)} προσαύξηση, και στο τέλος εφαρμόζονται οι εκπτώσεις: με βάση τη συνολική αξία, για ασφαλισμένη κατοικία ({F.insurance} ή {F.insuranceHigh}) και, το {F.year}, {F.village} για κύρια κατοικία σε οικισμό έως {F.villagePop} κατοίκων. Διαμέρισμα 80 m² στη ζώνη των {$(1400)}, άδεια 1995, 3ος όροφος: {$2(en.total)}.</p>

      <h2>Σύνταξη</h2>
      <p>Η εκτίμηση ακολουθεί τα άρθρα 7 και 8 του ν. 4387/2016. Ανταποδοτικό μέρος = μέσες συντάξιμες αποδοχές × άθροισμα των ποσοστών αναπλήρωσης ανά έτος ασφάλισης, με ανώτατο τις ίδιες τις αποδοχές. Εθνική σύνταξη = {F.nationalFull} με {Q.national_years_full} έτη ασφάλισης και {Q.residence_years_full} έτη διαμονής, μείον {pct(Q.national_reduction_per_year, lang)} για κάθε έτος κάτω από τα {Q.national_years_full} (κατώτατο {F.minYears} έτη, {F.national15}) και επί τον λόγο ετών διαμονής προς {Q.residence_years_full}. Με 30 έτη και μέσο μισθό {$(1400)}: ποσοστό {pct(pen.rate, lang)}, ανταποδοτικό {$2(pen.contributory)}, εθνική {$2(pen.national)}, σύνολο {$2(pen.total)} μικτά.</p>

      <h2>Τι δεν υπολογίζουμε</h2>
      <p>Προτιμάμε να γράψουμε καθαρά πού σταματά το μοντέλο. Τα αποτελέσματα μπορεί να διαφέρουν από την πραγματικότητα στις εξής περιπτώσεις:</p>
      <ul>
        <li>Εισφορές: μόνο ο ΚΠΚ {F.kpk} του ιδιωτικού τομέα. Άλλοι κωδικοί πακέτου κάλυψης, τα βαρέα και ανθυγιεινά, οι δημόσιοι υπάλληλοι και οι ελεύθεροι επαγγελματίες δεν μοντελοποιούνται.</li>
        <li>Ηλικία νέων: ο νόμος μιλά για φορολογούμενους «έως 25 ετών» και «από 26 έως 30 ετών»· δεν εφαρμόζουμε κανόνα έτους γέννησης, εσείς επιλέγετε την κατηγορία.</li>
        <li>Επίδομα αδείας: επιμερισμός ανά μήνα εργασίας, όχι ανά ημέρα άδειας που δικαιούστε.</li>
        <li>ΕΝΦΙΑ: ένα κτίριο τη φορά, χωρίς οικόπεδα και χωρίς τις εκπτώσεις χαμηλού εισοδήματος· αν δεν δώσετε συνολική αξία περιουσίας, εκτιμάται ως m² × τιμή ζώνης × ποσοστό.</li>
        <li>Σύνταξη: η εθνική σύνταξη είναι το τελευταίο ποσό που δημοσίευσε το Υπουργείο ({F.nationalFull}, από 1-1-2025) και αναπροσαρμόζεται κάθε χρόνο· δεν εφαρμόζουμε τη μείωση 1/200 ανά μήνα για μειωμένη σύνταξη ούτε ειδικούς κανόνες ενστόλων.</li>
        <li>Αποζημίωση απόλυσης: υπολογίζεται μικτή, χωρίς τον φόρο που μπορεί να την αφορά.</li>
        <li>Τέλη κυκλοφορίας: χωρίς πρόστιμα ή προσαυξήσεις εκπρόθεσμης πληρωμής.</li>
        <li>Μισθός: κρατήσεις εκτός φορολογίας (συνδικαλιστικές, δάνεια, κατασχέσεις) και άλλα εισοδήματα του φορολογούμενου δεν είναι γνωστά στον μηχανισμό.</li>
      </ul>
      <p>Αν βρείτε περίπτωση όπου ο μηχανισμός διαφωνεί με τη μισθοδοσία σας πέρα από στρογγυλοποίηση, <a href={route('contact', lang)}>γράψτε μας</a>: κάθε επιβεβαιωμένο λάθος γίνεται νέος έλεγχος. Οι κανόνες επιλογής πηγών περιγράφονται στη <a href={route('editorial', lang)}>συντακτική πολιτική</a> και οι όροι στο <a href={route('glossary', lang)}>γλωσσάρι</a>.</p>

      <h2>Παράμετροι και πηγές</h2>
      <p>Ο πίνακας παράγεται από το αρχείο παραμέτρων. Οι πλήρεις τίτλοι με συνδέσμους βρίσκονται στις πηγές στο τέλος της σελίδας.</p>
