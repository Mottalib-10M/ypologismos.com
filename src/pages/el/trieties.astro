---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { salary, minimumWage, christmasBonus, easterBonus, leaveAllowance, severance, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const M = P.minimum_wage;
const tw = (n: number) => (n === 0 ? 'Καμία' : n === 1 ? '1 τριετία' : `${n} τριετίες`);
const s = [0, 1, 2, 3].map((n) => salary({ gross: minimumWage(n) }));
const step = minimumWage(1) - minimumWage(0);
const official = M.official_examples;
const cmp = official.filter((o) => o.gross !== M.monthly).map((o) => {
  const n = Math.round((o.gross / M.monthly - 1) / M.triennium_rate);
  const ours = salary({ gross: minimumWage(n), children: o.children });
  return [tw(n), String(o.children), $(minimumWage(n)), $(o.net), $(ours.net)];
});
const extra = [0, 3].map((n) => { const g = minimumWage(n); return { g, x: christmasBonus({ pay: g }).amount, e: easterBonus({ pay: g }).amount, a: leaveAllowance({ pay: g }).amount, sev: severance({ pay: g, years: 10 }).total }; });
const rows = [0, 1, 2, 3].map((n) => [tw(n), `${n * 3}+`, $(minimumWage(n)), $(s[n].net), $(s[n].netAnnual - s[0].netAnnual), $(s[n].cost)]);
const faqs = [
  { q: 'Πόσο είναι η τριετία στον κατώτατο μισθό το 2026;', a: `Κάθε τριετία προϋπηρεσίας προσθέτει ${F.triennium} στον κατώτατο μισθό των ${F.minWage}, δηλαδή ${$(step)} μικτά τον μήνα. Με μία τριετία ο κατώτατος γίνεται ${F.minWithT(1)}, με δύο ${F.minWithT(2)} και με τρεις ${F.minWithT(3)}. Σε καθαρά, για εργαζόμενο άνω των 30 χωρίς παιδιά, αυτό σημαίνει ${$(s[1].net)}, ${$(s[2].net)} και ${$(s[3].net)} ανά καταβολή.` },
  { q: 'Δουλεύω 12 χρόνια. Γιατί δεν παίρνω τέταρτη τριετία;', a: `Επειδή για τον νόμιμο κατώτατο μισθό οι τριετίες είναι το πολύ ${F.trienniumMax}. Μετά τα εννέα χρόνια προϋπηρεσίας η προσαύξηση σταματά στο ${F.minWithT(3)}, όσα χρόνια κι αν προστεθούν. Περισσότερα κλιμάκια ωρίμανσης μπορεί να προβλέπει η συλλογική σύμβαση του κλάδου σας, την οποία αυτός ο υπολογιστής δεν καλύπτει.` },
  { q: 'Οι τριετίες μετράνε στο δώρο Χριστουγέννων και στην αποζημίωση;', a: `Ναι, γιατί και τα δύο υπολογίζονται στις τακτικές αποδοχές, που περιλαμβάνουν την προσαύξηση. Με τρεις τριετίες το δώρο Χριστουγέννων είναι ${$(extra[1].x)} αντί για ${$(extra[0].x)}, και μια αποζημίωση απόλυσης για δέκα χρόνια χωρίς προειδοποίηση φτάνει τα ${$(extra[1].sev)} αντί για ${$(extra[0].sev)}.` },
  { q: 'Οι τριετίες της κλαδικής σύμβασης είναι ίδιες με του κατώτατου;', a: `Όχι απαραίτητα. Οι ${F.trienniumMax} τριετίες των ${F.triennium} αφορούν τον νόμιμο κατώτατο μισθό. Μια κλαδική ή επιχειρησιακή συλλογική σύμβαση μπορεί να ορίζει δικά της επιδόματα προϋπηρεσίας, με άλλο ποσοστό ή περισσότερα κλιμάκια. Ο υπολογιστής αυτής της σελίδας δεν τα γνωρίζει· για αυτά συμβουλευτείτε το κείμενο της σύμβασης που σας αφορά.` },
  { q: 'Πόσο κοστίζει στον εργοδότη κάθε τριετία;', a: `Η μικτή αύξηση των ${$(step)} επιβαρύνεται με την εργοδοτική εισφορά ${F.efkaEr}, άρα κάθε τριετία κοστίζει περίπου ${$(s[1].cost - s[0].cost)} ανά καταβολή, ${$((s[1].cost - s[0].cost) * 14)} τον χρόνο. Ένας εργαζόμενος με τρεις τριετίες στον κατώτατο κοστίζει ${$(s[3].cost)} ανά καταβολή, μαζί με τις εισφορές, και η προσαύξηση περνά και στα δώρα.` },
];
---
<GuideLayout lang={lang} id="trienniums" breadcrumbLabel={label('trienniums', lang)}
  title={`Τριετίες ${F.year}: ${F.triennium} η καθεμία στον κατώτατο, έως ${F.trienniumMax}`}
  h1={`Τριετίες ${F.year}: πόσο ανεβάζουν τον κατώτατο μισθό`}
  description={`Τριετίες ${F.year}: κάθε τριετία προϋπηρεσίας προσθέτει ${F.triennium} στον κατώτατο μισθό, έως ${F.trienniumMax}. Μικτά ${F.minWithT(1)} έως ${F.minWithT(3)}, καθαρά ανά καταβολή, δώρα, κόστος εργοδότη.`}
  intro={`Κάθε τριετία προϋπηρεσίας ανεβάζει τον κατώτατο μισθό κατά ${F.triennium}, το πολύ τρεις φορές.`}
  resume={`Οι τριετίες είναι η προσαύξηση του νόμιμου κατώτατου μισθού λόγω προϋπηρεσίας: ${F.triennium} για κάθε συμπληρωμένη τριετία, το πολύ ${F.trienniumMax}. Με τον κατώτατο των ${F.minWage} που ισχύει από 1/4/${F.year}, κάθε τριετία αξίζει ${$(step)} μικτά τον μήνα, οπότε ο κατώτατος γίνεται ${F.minWithT(1)} με μία, ${F.minWithT(2)} με δύο και ${F.minWithT(3)} με τρεις. Σε καθαρά, για εργαζόμενο άνω των 30 χωρίς παιδιά, οι τρεις τριετίες ανεβάζουν την καταβολή από ${$(s[0].net)} σε ${$(s[3].net)}, δηλαδή ${$(s[3].netAnnual - s[0].netAnnual)} περισσότερα τον χρόνο με τις 14 πληρωμές. Η προσαύξηση περνά και στα δώρα, στο επίδομα αδείας και στην αποζημίωση απόλυσης, γιατί όλα υπολογίζονται στις τακτικές αποδοχές. Μετά τα εννέα χρόνια δεν υπάρχει τέταρτη τριετία για τον κατώτατο, ενώ τα επιδόματα προϋπηρεσίας των συλλογικών συμβάσεων είναι άλλη υπόθεση, που ο υπολογιστής δεν καλύπτει.`}
  faqs={faqs}
  related={[{ href: route('minimum', lang), name: label('minimum', lang), description: `${F.minWage} μικτά και τι μένει καθαρά.` }, { href: route('christmas', lang), name: label('christmas', lang), description: 'Το δώρο στις αποδοχές με τις τριετίες.' }, { href: route('severance', lang), name: label('severance', lang), description: 'Η αποζημίωση στον μισθό με την προσαύξηση.' }]}
  sources={[src('min_wage', lang), { name: 'Υπουργείο Εργασίας (2024): «τριετίες που ξεπάγωσαν στην αρχή του έτους», δηλώσεις για τον κατώτατο μισθό', url: 'https://ypergasias.gov.gr/domna-michailidou-afximeno-sta-415-evro-to-doro-tou-pascha-paranomoi-osoi-den-to-katavaloun/' }, src('hli_christmas', lang), src('severance', lang)]}>
  <div data-chrome><MiniSim client:load kind="trienniums" lang={lang} href={route('home', lang)} /></div>

  <h2>Μικτά, καθαρά και κόστος ανά τριετία</h2>
  <ContentTable headers={['Τριετίες', 'Έτη προϋπηρεσίας', 'Μικτά', 'Καθαρά ανά καταβολή', 'Επιπλέον καθαρά τον χρόνο', 'Κόστος εργοδότη']} align={['l', 'l', 'r', 'r', 'r', 'r']} rows={rows} highlightRow={3} />
  <p>Η τελευταία γραμμή είναι το ταβάνι: τρεις τριετίες, δηλαδή τουλάχιστον εννέα χρόνια προϋπηρεσίας, και κατώτατος {F.minWithT(3)}. Η στήλη «επιπλέον καθαρά» μετρά τη διαφορά από τον κατώτατο χωρίς τριετίες σε όλη τη χρονιά, με 14 καταβολές. Κάθε τριετία προσθέτει σχεδόν τα ίδια καθαρά, γύρω στα {$(s[1].net - s[0].net)} ανά καταβολή: από τα {$(step)} της μικτής αύξησης φεύγουν {F.efkaEe} σε εισφορές και φόρος με τον συντελεστή του δεύτερου κλιμακίου, ενώ η μείωση φόρου του άρθρου 16 ΚΦΕ αρχίζει να περικόπτεται λίγο πάνω από τα {F.creditThreshold} φορολογητέου εισοδήματος.</p>

  <h2>Πώς λειτουργεί η προσαύξηση</h2>
  <p>Η τριετία δεν είναι ξεχωριστό επίδομα που μπαίνει σε άλλη γραμμή της μισθοδοσίας με δικούς του κανόνες· είναι ποσοστό επάνω στον κατώτατο μισθό. Γι' αυτό ακολουθεί αυτόματα κάθε αύξηση του κατώτατου. Όταν ο κατώτατος ανέβηκε από {F.minWage2025} σε {F.minWage} την 1η Απριλίου, ο εργαζόμενος με δύο τριετίες πέρασε από {$(minimumWage(2) * M.monthly_2025 / M.monthly)} σε {F.minWithT(2)} χωρίς καμία νέα συμφωνία. Το Υπουργείο Εργασίας το επισημαίνει στην ανακοίνωση για τον νέο κατώτατο, όπου οι τριετίες αναφέρονται ρητά ανάμεσα σε όσα επηρεάζονται από την αύξηση.</p>
  <p>Το ποσό των τριετιών αφορά το κατώτατο όριο αμοιβής. Ο πίνακας δείχνει το ελάχιστο που πρέπει να εμφανίζει η μισθοδοσία ενός υπαλλήλου πλήρους απασχόλησης με την αντίστοιχη προϋπηρεσία. Αν ο μισθός σας είναι ήδη μεγαλύτερος, ο υπολογιστής στην αρχή της σελίδας δέχεται οποιονδήποτε βασικό μισθό και δείχνει τι θα σήμαινε μια προσαύξηση {F.triennium} ανά τριετία επάνω του, για παράδειγμα όταν το προβλέπει η σύμβασή σας.</p>

  <h2>Το «ξεπάγωμα» του 2024</h2>
  <p>Η λέξη που συνοδεύει συχνά τις τριετίες στις συζητήσεις είναι «ξεπάγωμα». Η επίσημη αναφορά είναι του 2024: όταν αυξήθηκε τότε ο κατώτατος μισθός, το Υπουργείο Εργασίας απαρίθμησε ανάμεσα σε όσους ωφελούνταν και «όσοι δικαιούνται τις τριετίες που ξεπάγωσαν στην αρχή του έτους». Σήμερα η προσαύξηση ισχύει και εμφανίζεται στα επίσημα παραδείγματα του Υπουργείου για τον κατώτατο του {F.year}, που συγκρίνουμε παρακάτω με τον δικό μας υπολογισμό.</p>

  <h2>Τα επίσημα παραδείγματα, γραμμή προς γραμμή</h2>
  <ContentTable headers={['Τριετίες', 'Παιδιά', 'Μικτά', 'Καθαρά κατά το Υπουργείο', 'Καθαρά κατά τον υπολογισμό μας']} align={['l', 'l', 'r', 'r', 'r']} rows={cmp} />
  <p>Το Υπουργείο Εργασίας δημοσίευσε εννέα παραδείγματα με τριετίες για εργαζόμενους άνω των 30, χωρίς παιδιά, με ένα και με δύο. Ο μηχανισμός μας, ο ίδιος που τροφοδοτεί όλους τους υπολογιστές του ιστότοπου, πέφτει πάνω στα επίσημα ποσά με απόκλιση το πολύ ενός ευρώ, που οφείλεται σε στρογγυλοποίηση. Αν η δική σας μισθοδοσία διαφέρει περισσότερο για τα ίδια στοιχεία, αξίζει να ρωτήσετε το λογιστήριο ποια παράμετρος αλλάζει: συνήθως είναι ο αριθμός των παιδιών που δηλώθηκε ή μια επιπλέον αμοιβή στον ίδιο μήνα.</p>

  <div data-chrome><MiniSim client:load kind="minimum" lang={lang} href={route('minimum', lang)} /></div>

  <h2>Πού αλλού φαίνονται οι τριετίες</h2>
  <p>Τα δώρα εορτών και το επίδομα αδείας υπολογίζονται στις τακτικές αποδοχές, άρα και στην προσαύξηση. Με τρεις τριετίες, το δώρο Χριστουγέννων ανεβαίνει από {$(extra[0].x)} σε {$(extra[1].x)}, το δώρο Πάσχα από {$(extra[0].e)} σε {$(extra[1].e)} και το επίδομα αδείας από {$(extra[0].a)} σε {$(extra[1].a)}. Η μεγαλύτερη διαφορά φαίνεται στην αποζημίωση απόλυσης, που βασίζεται στις τακτικές αποδοχές του τελευταίου μήνα: για δέκα χρόνια στον ίδιο εργοδότη, χωρίς προειδοποίηση και με την προσαύξηση του 1/6, είναι {$(extra[0].sev)} στον σκέτο κατώτατο και {$(extra[1].sev)} με τρεις τριετίες. Ο <a href={route('severance', lang)}>υπολογιστής αποζημίωσης</a> κάνει τον λογαριασμό για κάθε μισθό και κάθε διάρκεια.</p>

  <h2>Τι δεν καλύπτει ο υπολογισμός</h2>
  <p>Δύο περιπτώσεις μένουν εκτός. Η πρώτη είναι οι τριετίες ή τα επιδόματα προϋπηρεσίας που ορίζουν οι συλλογικές συμβάσεις εργασίας: μπορεί να έχουν άλλο ποσοστό, περισσότερα κλιμάκια ή διαφορετική βάση, και ο υπολογιστής δεν τα γνωρίζει. Η δεύτερη είναι η απόδειξη της προϋπηρεσίας, δηλαδή ποια χρόνια μετρούν και με ποια έγγραφα, ζήτημα που κρίνεται με τα στοιχεία του καθενός και όχι με έναν υπολογιστή. Ο υπολογιστής παίρνει τον αριθμό των τριετιών ως δεδομένο και εφαρμόζει τον κανόνα των {F.triennium} έως {F.trienniumMax}.</p>
  <p>Για τον τελικό λογαριασμό, με ηλικία και παιδιά, ο βασικός <a href={route('home', lang)}>υπολογισμός μισθού</a> δέχεται το μικτό με τις τριετίες. Αν δουλεύετε λιγότερες ώρες, η <a href={route('parttime', lang)}>μερική απασχόληση</a> εξηγεί πώς υπολογίζεται αναλογικά ο μισθός.</p>
</GuideLayout>
