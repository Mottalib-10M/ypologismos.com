---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { severance, noticeMonths, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney, formatDecimal } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const d = (x: number) => formatDecimal(x, 1, lang);
const S = P.severance;
const NM = S.notice_months;
const nFirst = NM[0].months, nLast = NM[NM.length - 1].months;
const pay = 1600;
const mo = (n: number) => `${n} ${n === 1 ? 'μήνας' : 'μήνες'}`;
const cmp = [1, 3, 6, 9, 12, 16].map((y) => { const a = severance({ pay, years: y }), b = severance({ pay, years: y, notice: true }); const n = noticeMonths(y); return [`${y}`, mo(n), $(a.total), $(b.total), $(pay * n), $(b.total + pay * n)]; });
const own = NM.map((r, i) => { const b = NM[i + 1]?.fromYears; return [b === undefined ? `${r.fromYears} έτη και άνω` : `${r.fromYears === 1 ? '12 μήνες' : `${r.fromYears} έτη`} έως ${b} έτη`, mo(r.months), `${d(r.months / 2)} ${r.months / 2 > 1 ? 'μήνες' : 'μήνας'}`]; });
const e6 = severance({ pay, years: 6 }), e6n = severance({ pay, years: 6, notice: true }), n6 = noticeMonths(6);
const e12 = severance({ pay, years: 12 }), e12n = severance({ pay, years: 12, notice: true }), n12 = noticeMonths(12);
const vol = { name: 'Επιθεώρηση Εργασίας: καταγγελία σύμβασης από τον μισθωτό, οικειοθελής αποχώρηση', url: 'https://www.hli.gov.gr/ergasiakes-scheseis/nomothesia-ergasiakes-scheseis/atomikes-symvaseis/symvasi-aoristou-chronou/katangelia-symvasis-apo-ton-misthoto-oikeiothelis-apochorisi/' };
const faqs = [
  { q: 'Πήρα την έγγραφη προειδοποίηση στις 15 του μήνα. Από ποια μέρα μετράει;', a: `Από τις 16. Το Υπουργείο Εργασίας, με την ερμηνευτική εγκύκλιο 26352/839/2012, ορίζει ότι ο χρόνος προειδοποίησης ξεκινά την επομένη της γνωστοποίησης στον εργαζόμενο, κατά το άρθρο 241 του Αστικού Κώδικα, και λήγει με τη λήξη της προθεσμίας, οπότε λύεται η σύμβαση. Η ημέρα που παραλάβατε το έγγραφο δεν μετράει στους μήνες της προειδοποίησης.` },
  { q: `Δουλεύω 6 χρόνια με ${$(pay)}. Τι παίρνω με προειδοποίηση και τι χωρίς;`, a: `Χωρίς προειδοποίηση παίρνετε αμέσως ${$(e6.total)} και η σχέση λήγει την ίδια μέρα. Με έγγραφη προειδοποίηση ${n6} μηνών δουλεύετε κανονικά ως το τέλος της, εισπράττετε ${$(pay * n6)} σε μισθούς και στο τέλος ${$(e6n.total)}, τη μισή αποζημίωση. Το σύνολο των δύο είναι ${$(e6n.total + pay * n6)}, αλλά απαιτεί ${n6} μήνες εργασίας.` },
  { q: 'Σε πόσες ημέρες πρέπει ο εργοδότης να αναγγείλει την απόλυση με προειδοποίηση;', a: `Σε οκτώ ημέρες. Η προθεσμία του άρθρου 9 παράγραφος 1 του ν. 3198/1955 για την αναγγελία της καταγγελίας στον ΟΑΕΔ, σήμερα ΔΥΠΑ, αρχίζει από την επομένη της γνωστοποίησης της έγγραφης προειδοποίησης και όχι από τη λήξη της. Αυτό το διευκρινίζει η ίδια εγκύκλιος του 2012. Η αναγγελία δεν μεταθέτει το τέλος της σχέσης· αυτό καθορίζεται από τους μήνες της προειδοποίησης.` },
  { q: 'Θέλω να παραιτηθώ. Οφείλω κι εγώ προειδοποίηση στον εργοδότη;', a: `Αν είστε υπάλληλος, ναι. Κατά το άρθρο 4 του ν. 2112/1920, όπως το παρουσιάζει η Επιθεώρηση Εργασίας, ο εργαζόμενος καταγγέλλει τη σύμβαση αορίστου χρόνου με προειδοποίηση ίση με το μισό εκείνης που οφείλει ο εργοδότης, ποτέ πάνω από τρεις μήνες. Με 6 χρόνια, αυτό σημαίνει ${d(n6 / 2)} μήνα. Η αποζημίωση για παράβαση της υποχρέωσης αυτής δεν μπορεί επίσης να ξεπεράσει τους τρεις μισθούς.` },
  { q: 'Ο εργοδότης δεν δήλωσε στο ΕΡΓΑΝΗ την παραίτησή μου. Τι συνέπεια έχει;', a: `Η οικειοθελής αποχώρηση πρέπει να αναγγελθεί ηλεκτρονικά στο ΕΡΓΑΝΗ το αργότερο σε τέσσερις εργάσιμες ημέρες, με υπογεγραμμένο έντυπο ή εξώδικη δήλωση. Αν ο εργοδότης δεν το κάνει εμπρόθεσμα, η σύμβαση θεωρείται ότι λύθηκε με άτακτη καταγγελία του εργοδότη (άρθρο 38 ν. 4488/2017), δηλαδή σαν απόλυση χωρίς προειδοποίηση, με όσα αυτή συνεπάγεται για την αποζημίωση.` },
  { q: 'Πότε πληρώνεται η μισή αποζημίωση όταν υπάρχει προειδοποίηση;', a: `Στη λήξη του χρόνου προειδοποίησης, όχι την ημέρα που δίνεται το χαρτί. Η Επιθεώρηση Εργασίας ξεχωρίζει την τακτική καταγγελία, όπου η αποζημίωση καταβάλλεται στο τέλος της προειδοποίησης, από την άτακτη, όπου καταβάλλεται μαζί με την απόλυση. Με ${$(pay)} και 12 χρόνια, τα ${$(e12n.total)} οφείλονται στο τέλος των ${n12} μηνών, σε λογαριασμό πληρωμών.` },
];
---
<GuideLayout lang={lang} id="notice" breadcrumbLabel={label('notice', lang)}
  title={`Προειδοποίηση απόλυσης ${F.year}: ${nFirst} έως ${nLast} μήνες, μισή αποζημίωση`}
  h1={`Προειδοποίηση απόλυσης ${F.year}: πόσοι μήνες, πότε ξεκινά και τι κοστίζει`}
  description={`Προειδοποίηση απόλυσης ${F.year}: ${nFirst} έως ${nLast} μήνες ανάλογα με τα έτη, μισή αποζημίωση στο τέλος, έναρξη την επομένη. Σύγκριση σε ευρώ, αναγγελία σε 8 ημέρες, παραίτηση.`}
  intro={`Η έγγραφη προειδοποίηση του ν. 4093/2012 και τι αλλάζει για εργαζόμενο και εργοδότη σε σχέση με την απόλυση χωρίς προειδοποίηση.`}
  resume={`Ο εργοδότης που θέλει να απολύσει εργαζόμενο αορίστου χρόνου με πάνω από 12 μήνες υπηρεσίας μπορεί να τον ειδοποιήσει γραπτώς ${nFirst} μήνα πριν όταν έχει από 12 μήνες έως 2 έτη, ${NM[1].months} μήνες από 2 έως 5 έτη, ${NM[2].months} μήνες από 5 έως 10 έτη και ${nLast} μήνες από τα 10 έτη και πάνω. Η προθεσμία ξεκινά την επομένη της γνωστοποίησης, ο εργαζόμενος δουλεύει και πληρώνεται κανονικά, και στη λήξη παίρνει τη μισή αποζημίωση του πίνακα. Αν ο εργοδότης δεν δώσει έγγραφη προειδοποίηση, πληρώνει ολόκληρη την αποζημίωση αμέσως. Με μισθό ${$(pay)} και 6 χρόνια, η απόλυση χωρίς προειδοποίηση δίνει ${$(e6.total)}, ενώ με προειδοποίηση ${n6} μηνών ο εργαζόμενος εισπράττει ${$(pay * n6)} σε μισθούς και ${$(e6n.total)} στο τέλος. Ο εργοδότης έχει οκτώ ημέρες από την επομένη της προειδοποίησης για να αναγγείλει την καταγγελία.`}
  faqs={faqs}
  related={[{ href: route('severance', lang), name: label('severance', lang), description: 'Ολόκληρη ή μισή αποζημίωση με τον δικό σας μισθό.' }, { href: route('sevtable', lang), name: label('sevtable', lang), description: 'Οι δύο πίνακες, αποζημίωσης και προειδοποίησης.' }, { href: route('home', lang), name: label('home', lang), description: 'Τα καθαρά των μισθών που πληρώνονται στο διάστημα της προειδοποίησης.' }]}
  sources={[src('severance_faq', lang), src('severance', lang), vol]}>
  <div data-chrome><MiniSim client:load kind="notice" lang={lang} href={route('severance', lang)} /></div>

  <h2>Οι δύο δρόμοι σε ευρώ</h2>
  <ContentTable headers={['Έτη', 'Προειδοποίηση', 'Αποζημίωση χωρίς', 'Μισή αποζημίωση', 'Μισθοί προειδοποίησης', 'Σύνολο με προειδοποίηση']} align={['l', 'r', 'r', 'r', 'r', 'r']} rows={cmp} highlightRow={2} />
  <p>Ο πίνακας αφορά μισθό {$(pay)}. Οι δύο πρώτες στήλες ποσών δείχνουν τι πληρώνεται ως αποζημίωση στον κάθε δρόμο. Η πέμπτη στήλη είναι ο μικτός μισθός που ο εργαζόμενος συνεχίζει να εισπράττει όσο διαρκεί η προειδοποίηση, χωρίς τα δώρα που μπορεί να πέσουν μέσα σε αυτό το διάστημα. Η τελευταία αθροίζει τα δύο. Το σύνολο με προειδοποίηση είναι συχνά μεγαλύτερο από την ολόκληρη αποζημίωση, αλλά δεν είναι «δωρεάν»: αντιστοιχεί σε μήνες εργασίας.</p>
  <p>Για τον εργοδότη η σύγκριση είναι αντίστροφη. Με προειδοποίηση πληρώνει λιγότερη αποζημίωση αλλά κρατά τον εργαζόμενο στη μισθοδοσία, με τις εργοδοτικές εισφορές. Χωρίς προειδοποίηση κλείνει τη σχέση την ίδια μέρα με μεγαλύτερο ποσό. Ποιο από τα δύο συμφέρει εξαρτάται από το αν η θέση χρειάζεται ακόμη εργασία τους επόμενους μήνες.</p>

  <h2>Πότε ξεκινά και πότε τελειώνει η προθεσμία</h2>
  <p>Η ερμηνευτική εγκύκλιος 26352/839 του Νοεμβρίου 2012 είναι σαφής: ο χρόνος προειδοποίησης αρχίζει από την επομένη της ημέρας που η προειδοποίηση γνωστοποιείται στον εργαζόμενο και λήγει με το τέλος της προθεσμίας, οπότε επέρχεται και η λύση της σύμβασης. Η ημέρα παράδοσης δεν μετράει. Ένα χαρτί που παραδίδεται την Παρασκευή αρχίζει να «τρέχει» το Σάββατο.</p>
  <p>Η ημερομηνία παράδοσης έχει σημασία και για άλλο λόγο: ο αριθμός των μηνών εξαρτάται από τα συμπληρωμένα έτη. Ένας υπάλληλος που ειδοποιείται λίγες ημέρες πριν από την πέμπτη επέτειο της πρόσληψης έχει ακόμη δικαίωμα σε {noticeMonths(4)} μήνες και όχι σε {noticeMonths(5)}. Ο νόμος συνδέει τη μισή αποζημίωση με εργοδότη που προειδοποιεί «κατά τα ανωτέρω», δηλαδή με τη διάρκεια του πίνακα· γι' αυτό η ημερομηνία πρόσληψης αξίζει έναν δεύτερο έλεγχο πριν υπογράψετε την παραλαβή.</p>

  <h2>Η αναγγελία των οκτώ ημερών</h2>
  <p>Ο εργοδότης οφείλει να αναγγείλει την καταγγελία μέσα σε οκτώ ημέρες, κατά το άρθρο 9 παράγραφος 1 του ν. 3198/1955. Όταν υπάρχει προειδοποίηση, οι οκτώ ημέρες μετρούν από την επομένη της γνωστοποίησής της, όχι από το τέλος των μηνών. Ο νόμος μιλά για αναγγελία στον ΟΑΕΔ, που σήμερα λέγεται ΔΥΠΑ.</p>

  <h2>Η πληρωμή της μισής αποζημίωσης</h2>
  <p>Στην απόλυση χωρίς προειδοποίηση η αποζημίωση οφείλεται μαζί με την καταγγελία. Στην τακτική καταγγελία, δηλαδή με προειδοποίηση, οφείλεται στη λήξη του χρόνου προειδοποίησης. Με {$(pay)} και 12 χρόνια, ο εργαζόμενος δουλεύει {n12} μήνες και εισπράττει στο τέλος {$(e12n.total)} αντί για τα {$(e12.total)} που θα έπαιρνε την πρώτη μέρα χωρίς προειδοποίηση. Η πληρωμή γίνεται σε λογαριασμό πληρωμών και, όταν ξεπερνά τις αποδοχές δύο μηνών, μπορεί να μοιραστεί σε δόσεις κατά τους κανόνες της Επιθεώρησης Εργασίας.</p>

  <div data-chrome><MiniSim client:load kind="sevtable" lang={lang} href={route('sevtable', lang)} /></div>

  <h2>Όταν φεύγει ο εργαζόμενος: η δική του προειδοποίηση</h2>
  <ContentTable headers={['Υπηρεσία', 'Προειδοποίηση εργοδότη', 'Προειδοποίηση υπαλλήλου που παραιτείται']} align={['l', 'r', 'r']} rows={own} />
  <p>Η υποχρέωση ισχύει και αντίστροφα. Ο υπάλληλος που καταγγέλλει ο ίδιος σύμβαση αορίστου χρόνου πρέπει να προειδοποιήσει τον εργοδότη με χρόνο ίσο με το μισό εκείνου που θα όφειλε ο εργοδότης, ποτέ πάνω από τρεις μήνες, κατά το άρθρο 4 του ν. 2112/1920. Αν δεν το κάνει, η αποζημίωση που μπορεί να του ζητηθεί δεν ξεπερνά τους τρεις μισθούς.</p>
  <p>Η αποχώρηση πρέπει επίσης να αναγγελθεί από τον εργοδότη στο ΕΡΓΑΝΗ το αργότερο σε τέσσερις εργάσιμες ημέρες, συνοδευόμενη από έντυπο υπογεγραμμένο και από τους δύο ή από εξώδικη δήλωση του εργοδότη. Αν η προθεσμία χαθεί, ο ν. 4488/2017 θεωρεί ότι η σύμβαση λύθηκε με άτακτη καταγγελία του εργοδότη. Για τον εργαζόμενο που παραιτήθηκε αυτό σημαίνει ότι η σχέση αντιμετωπίζεται σαν απόλυση χωρίς προειδοποίηση.</p>

  <h2>Τρία πρακτικά σημεία</h2>
  <p>Ζητήστε την προειδοποίηση σε έγγραφο με ημερομηνία παράδοσης· χωρίς έγγραφο δεν υπάρχει προειδοποίηση κατά τον νόμο. Σημειώστε την ημερομηνία πρόσληψης, γιατί αυτή καθορίζει πόσους μήνες δικαιούστε. Και υπολογίστε τα καθαρά των μισθών της περιόδου με τον <a href={route('home', lang)}>υπολογισμό μισθού</a>, για να συγκρίνετε σωστά με την ολόκληρη αποζημίωση του <a href={route('severance', lang)}>υπολογιστή αποζημίωσης</a>.</p>
</GuideLayout>
