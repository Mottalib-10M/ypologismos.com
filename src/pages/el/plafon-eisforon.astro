---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { salary, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney, pct } from '../../lib/format';
import { CEILING_BASE_2016, CEILING_INDEX_2026 } from '../../lib/mini-extra-c';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const $2 = (x: number) => formatMoney(x, 2, lang);
const E = P.efka;
const C = E.ceiling_monthly;
const maxEe = C * E.employee_rate, maxEr = C * E.employer_rate;
const atCap = salary({ gross: C });
const s9 = salary({ gross: 9000 }), s12 = salary({ gross: 12000 }), s6 = salary({ gross: 6000 });
const saved9 = 9000 * E.employee_rate - s9.efka;
const saved12 = 12000 * E.employee_rate - s12.efka, savedEr12 = 12000 * E.employer_rate - s12.employer;
const top = P.tax.brackets[P.tax.brackets.length - 1].rate;
const keepBelow = (1 - E.employee_rate) * (1 - top), keepAbove = 1 - top;
const plus1000 = salary({ gross: 10000 }).net - salary({ gross: 9000 }).net;
const plus1000b = salary({ gross: 6000 }).net - salary({ gross: 5000 }).net;
const cap25 = C / (1 + CEILING_INDEX_2026);
const capYear = C * 14;
const rows = [5000, 6000, 7000, C, 8000, 9000, 10000, 12000, 15000, 20000].map((g) => {
  const s = salary({ gross: g });
  return [$2(g), $(g * E.employee_rate), $(s.efka), $(s.employer), $(s.tax), $(s.net), pct(Math.round(s.efka / g * 1000) / 1000, lang)];
});
const faqs = [
  { q: `Ο μισθός μου είναι ${$(9000)} μικτά. Γιατί οι κρατήσεις ΕΦΚΑ δεν είναι ${F.efkaEe} του μικτού;`, a: `Επειδή οι εισφορές υπολογίζονται μόνο έως το ανώτατο όριο ασφαλιστέων αποδοχών, ${F.ceiling} τον μήνα το ${F.year}. Από ${$(9000)} μικτά κρατούνται ${$2(s9.efka)} αντί για ${$2(9000 * E.employee_rate)}, δηλαδή ${$(saved9)} λιγότερα σε κάθε καταβολή. Το τμήμα πάνω από το όριο δεν είναι ασφαλιστέο και φορολογείται κατευθείαν, με τον συντελεστή του κλιμακίου σας.` },
  { q: 'Πόσο ανέβηκε το πλαφόν το 2026 και ποια εγκύκλιος το ορίζει;', a: `Η εγκύκλιος 4/2026 του e-ΕΦΚΑ ορίζει από 1/1/${F.year} ανώτατο όριο ${F.ceiling} μηνιαίως, ${pct(CEILING_INDEX_2026, lang)} πάνω από το προηγούμενο, όσο ήταν η μέση μεταβολή του δείκτη τιμών καταναλωτή το 2025. Η αναπροσαρμογή με βάση τις τιμές παρατάθηκε έως 31/12/${F.year}· από 1/1/2027 το όριο θα ακολουθεί τον δείκτη μεταβολής μισθών, όπως προβλέπει το άρθρο 38 του ν. 4387/2016.` },
  { q: 'Ποια είναι η μέγιστη εισφορά που μπορεί να μου κρατηθεί τον μήνα;', a: `Με εισφορά εργαζομένου ${F.efkaEe} για τον ΚΠΚ ${F.kpk}, η μέγιστη μηνιαία κράτηση είναι ${$2(maxEe)}, όσο κι αν είναι ο μισθός. Ο εργοδότης πληρώνει το πολύ ${$2(maxEr)} (${F.efkaEr}). Μαζί, το ανώτατο ποσό που φτάνει στον e-ΕΦΚΑ για έναν μισθωτό είναι ${$2(maxEe + maxEr)} ανά καταβολή.` },
  { q: `Μια αύξηση ${$(1000)} πάνω από το πλαφόν πόσα καθαρά μου αφήνει;`, a: `Πάνω από ${F.ceiling} δεν κρατείται εισφορά, οπότε από κάθε επιπλέον ευρώ φεύγει μόνο ο φόρος του ανώτατου κλιμακίου (${pct(top, lang)}). Από ${$(9000)} σε ${$(10000)} μικτά τα καθαρά ανεβαίνουν κατά ${$(plus1000)} ανά καταβολή. Η ίδια αύξηση από ${$(5000)} σε ${$(6000)}, κάτω από το όριο, αφήνει ${$(plus1000b)}, γιατί κρατούνται και εισφορές.` },
  { q: 'Ισχύει το ανώτατο όριο και για τις εργοδοτικές εισφορές;', a: `Ναι. Το άρθρο 38 παρ. 2 του ν. 4387/2016 ορίζει το όριο «για τον υπολογισμό της μηνιαίας ασφαλιστικής εισφοράς των μισθωτών και των εργοδοτών». Για μισθό ${$(12000)} η επιχείρηση πληρώνει ${$(s12.employer)} αντί για ${$(12000 * E.employer_rate)}, δηλαδή γλιτώνει ${$(savedEr12)} σε κάθε καταβολή, ενώ ο εργαζόμενος γλιτώνει ${$(saved12)}.` },
];
---
<GuideLayout lang={lang} id="ceiling" breadcrumbLabel={label('ceiling', lang)}
  title={`Πλαφόν εισφορών ${F.year}: ${F.ceiling} τον μήνα, ποιους αφορά`}
  h1={`Πλαφόν εισφορών ΕΦΚΑ ${F.year}: το ανώτατο όριο των ${F.ceiling}`}
  description={`Πλαφόν εισφορών ${F.year}: ${F.ceiling} τον μήνα από 1/1 (εγκύκλιος 4/2026 e-ΕΦΚΑ). Μέγιστη κράτηση ${$2(maxEe)}, κόστος εργοδότη και καθαρά για υψηλούς μισθούς.`}
  intro={`Από την 1η Ιανουαρίου ${F.year} οι εισφορές e-ΕΦΚΑ υπολογίζονται το πολύ σε ${F.ceiling} μικτές αποδοχές τον μήνα.`}
  resume={`Το ανώτατο όριο ασφαλιστέων αποδοχών, το γνωστό πλαφόν, είναι ${F.ceiling} τον μήνα από 1/1/${F.year}, σύμφωνα με την εγκύκλιο 4/2026 του e-ΕΦΚΑ, ${pct(CEILING_INDEX_2026, lang)} πάνω από το ${F.year - 1} λόγω πληθωρισμού. Αφορά μόνο όσους έχουν μικτό μηνιαίο μισθό πάνω από αυτό το ποσό: σε εκείνους οι εισφορές σταματούν να αυξάνονται. Ο εργαζόμενος του ΚΠΚ ${F.kpk} πληρώνει το πολύ ${$2(maxEe)} (${F.efkaEe} επί του ορίου) και ο εργοδότης το πολύ ${$2(maxEr)} (${F.efkaEr}). Για μισθό ${$(9000)} αυτό σημαίνει κράτηση ${$2(s9.efka)} αντί για ${$2(9000 * E.employee_rate)} και καθαρά ${$(s9.net)} ανά καταβολή. Κάθε ευρώ πάνω από το όριο φορολογείται κατευθείαν με ${pct(top, lang)}, οπότε μένουν ${pct(keepAbove, lang)} καθαρά, ενώ λίγο κάτω από το όριο μένουν περίπου ${pct(Math.round(keepBelow * 1000) / 1000, lang)}. Ο υπολογιστής παρακάτω δείχνει πόσες εισφορές δεν πληρώνετε με τον δικό σας μισθό.`}
  faqs={faqs}
  related={[{ href: route('efka', lang), name: label('efka', lang), description: `Τα ποσοστά ${F.efkaEe} και ${F.efkaEr} κλάδο προς κλάδο.` }, { href: route('employer', lang), name: label('employer', lang), description: 'Συνολικό κόστος μισθοδοσίας για κάθε μισθό.' }, { href: route('brackets', lang), name: label('brackets', lang), description: `Πότε ξεκινά ο συντελεστής ${pct(top, lang)}.` }]}
  sources={[src('efka_ceiling', lang), { name: 'Ν. 4387/2016, άρθρο 38: ανώτατο όριο ασφαλιστέων αποδοχών και αναπροσαρμογή του', url: 'https://www.taxheaven.gr/law/4387/2016/arthro/38' }, src('efka_rates', lang), src('tax_scale', lang)]}>
  <div data-chrome><MiniSim client:load kind="ceiling" lang={lang} href={route('home', lang)} /></div>

  <h2>Υψηλοί μισθοί: κρατήσεις με και χωρίς το όριο</h2>
  <ContentTable headers={['Μικτά τον μήνα', 'ΕΦΚΑ χωρίς όριο', 'ΕΦΚΑ με όριο', 'Εργοδότης', 'Φόρος', 'Καθαρά', 'Πραγματικό ποσοστό ΕΦΚΑ']} align={['r', 'r', 'r', 'r', 'r', 'r', 'r']} rows={rows} highlightRow={3} />
  <p>Η επισημασμένη γραμμή είναι ακριβώς το πλαφόν. Μέχρι εκεί, η δεύτερη και η τρίτη στήλη συμπίπτουν: κάθε ευρώ μισθού επιβαρύνεται με {F.efkaEe}. Από εκεί και πέρα η κράτηση παγώνει στα {$2(maxEe)}, και το πραγματικό ποσοστό της τελευταίας στήλης πέφτει όσο μεγαλώνει ο μισθός, ώσπου σε {$(20000)} μικτά οι εισφορές δεν φτάνουν ούτε το ένα δέκατο του μικτού. Οι υπολογισμοί αφορούν εργαζόμενο άνω των 30 ετών χωρίς παιδιά, με 14 καταβολές· σε αυτά τα εισοδήματα τα παιδιά επηρεάζουν ελάχιστα, γιατί η μείωση φόρου του άρθρου 16 έχει ήδη εξαφανιστεί.</p>

  <h2>Από πού βγαίνουν τα {F.ceiling}</h2>
  <p>Το όριο το προβλέπει το άρθρο 38 παρ. 2 του ν. 4387/2016. Ο νόμος το όρισε αρχικά σε {$(CEILING_BASE_2016)} τον μήνα και πρόβλεψε ότι από 1/1/2023 έως 31/12/{F.year} αναπροσαρμόζεται κάθε χρόνο, με διαπιστωτική πράξη του Υπουργού Εργασίας, κατά τη μέση ετήσια μεταβολή του γενικού δείκτη τιμών καταναλωτή του προηγούμενου έτους. Αν ο δείκτης βγει αρνητικός, το όριο μένει όπου ήταν· δεν μειώνεται ποτέ.</p>
  <p>Για το {F.year} η μεταβολή των τιμών του 2025 ήταν {pct(CEILING_INDEX_2026, lang)}. Η απόφαση του Υπουργού δημοσιεύθηκε στο ΦΕΚ 318/Β΄/29.1.2026 και ο e-ΕΦΚΑ την έκανε εγκύκλιο (4/2026), ανεβάζοντας το όριο στα {F.ceiling}, από περίπου {$2(cap25)} πέρυσι. Η ίδια εγκύκλιος σημειώνει ότι η σύνδεση με τον πληθωρισμό παρατάθηκε μέχρι το τέλος του {F.year} και ότι από 1/1/2027 το όριο θα αυξάνεται με τον δείκτη μεταβολής μισθών. Αν οι μισθοί συνεχίσουν να ανεβαίνουν ταχύτερα από τις τιμές, το πλαφόν του 2027 θα κάνει μεγαλύτερο άλμα.</p>
  <p>Ένα πρακτικό συμπέρασμα: όταν ο λογιστής σας λέει «είστε στο πλαφόν», εννοεί ότι η μηνιαία κράτησή σας ΕΦΚΑ είναι σταθερή και δεν θα αλλάξει με καμία αύξηση μέσα στη χρονιά. Θα αλλάξει μόνο τον Ιανουάριο του επόμενου έτους, όταν αναπροσαρμοστεί το ίδιο το όριο.</p>

  <h2>Ποιους αφορά στην πράξη</h2>
  <p>Ο μέσος μισθός του 2025 στο ΕΡΓΑΝΗ ήταν {F.avgWage}, δηλαδή το πλαφόν βρίσκεται σε πάνω από πενταπλάσιο επίπεδο. Το συναντούν κυρίως ανώτερα στελέχη, διευθυντές, εξειδικευμένοι μηχανικοί λογισμικού, γιατροί του ιδιωτικού τομέα με μισθωτή σχέση και όσοι παίρνουν μεγάλα μπόνους. Για όλους τους υπόλοιπους η κράτηση ΕΦΚΑ είναι απλώς {F.efkaEe} του μικτού, χωρίς εξαίρεση.</p>
  <p>Το όριο είναι μηνιαίο. Αυτό σημαίνει ότι ένας εργαζόμενος με {$(6000)} τον μήνα δεν το αγγίζει ποτέ στους κανονικούς μισθούς του, έστω κι αν το ετήσιο εισόδημά του ξεπερνά τις {$(capYear)}, δηλαδή δεκατέσσερις φορές το όριο. Στον υπολογισμό μας το όριο εφαρμόζεται χωριστά σε καθεμία από τις 14 καταβολές, όπως στη μηνιαία μισθοδοσία. Για τον ακριβή χειρισμό ενός δώρου, μιας έκτακτης αμοιβής ή μιας αναδρομικής πληρωμής τον μήνα που ο μισθός περνά το όριο, η αναλυτική περιοδική δήλωση (ΑΠΔ) του εργοδότη είναι αυτή που μετράει, και αξίζει να την ελέγξετε με το λογιστήριο.</p>

  <h2>Τι κερδίζει ο εργαζόμενος και τι ο εργοδότης</h2>
  <p>Ο εργαζόμενος κερδίζει σε κάθε ευρώ πάνω από το όριο τη διαφορά ανάμεσα σε {pct(Math.round(keepBelow * 1000) / 1000, lang)} και {pct(keepAbove, lang)}. Κάτω από το όριο, ένα ευρώ αύξησης χάνει πρώτα {F.efkaEe} σε εισφορές και μετά {pct(top, lang)} φόρο στο υπόλοιπο. Πάνω από το όριο χάνει μόνο τον φόρο. Γι' αυτό σε μισθό {$(12000)} ο εργαζόμενος κρατά {$(saved12)} περισσότερα κάθε φορά σε σχέση με έναν φανταστικό κόσμο χωρίς πλαφόν.</p>
  <p>Για την επιχείρηση το όφελος είναι μεγαλύτερο, επειδή το ποσοστό της είναι υψηλότερο. Με {$(12000)} μικτά η εργοδοτική εισφορά σταματά στα {$(s12.employer)}, ενώ χωρίς όριο θα ήταν {$(12000 * E.employer_rate)}. Το συνολικό κόστος μιας τέτοιας θέσης είναι {$(s12.cost)} ανά καταβολή, όχι {$(12000 * (1 + E.employer_rate))}. Όταν μια εταιρεία συγκρίνει την πρόσληψη ενός στελέχους στην Ελλάδα με άλλες χώρες, αυτό το ταβάνι κάνει το κόστος των υψηλών αμοιβών αισθητά πιο προβλέψιμο.</p>

  <div data-chrome><MiniSim client:load kind="ceilingcost" lang={lang} href={route('employer', lang)} /></div>

  <h2>Η άλλη όψη: αποδοχές που δεν είναι ασφαλιστέες</h2>
  <p>Ο νομικός όρος είναι «ανώτατο όριο ασφαλιστέων αποδοχών». Ό,τι υπερβαίνει τα {F.ceiling} δεν είναι ασφαλιστέα αποδοχή: δεν πληρώνεται εισφορά γι' αυτό και, κατά λογική συνέπεια, δεν καταγράφεται ως ασφαλισμένος μισθός. Όποιος παίρνει {$(15000)} τον μήνα ασφαλίζεται, όσον αφορά τον e-ΕΦΚΑ, όπως κάποιος που παίρνει {F.ceiling}. Για όσους σκέφτονται τη σύνταξή τους, αυτό είναι ένας λόγος να εξετάσουν και άλλες μορφές αποταμίευσης· ο <a href={route('pension', lang)}>υπολογιστής σύνταξης</a> δείχνει πώς ο μέσος ασφαλισμένος μισθός μεταφράζεται σε ανταποδοτικό ποσό.</p>
  <p>Το πλαφόν δεν επηρεάζει τον φόρο εισοδήματος. Η κλίμακα του ν. 5246/2025 εφαρμόζεται σε όλο το φορολογητέο εισόδημα, χωρίς ανώτατο όριο, και πάνω από {F.limits[4]} φορολογητέα τον χρόνο ο συντελεστής είναι {pct(top, lang)}. Ένα μικτό {$(6000)} τον μήνα βρίσκεται ήδη εκεί: φόρος {$(s6.tax)} ανά καταβολή, ενώ το πλαφόν δεν έχει ακόμα αγγιχτεί.</p>

  <h2>Τρία λάθη που βλέπουμε συχνά</h2>
  <p>Το πρώτο είναι να εφαρμόζεται το {F.efkaEe} σε όλο τον μισθό σε ένα πρόχειρο λογιστικό φύλλο. Σε μισθό {$(12000)} το λάθος υπερεκτιμά τις κρατήσεις κατά {$(saved12)} και υποεκτιμά τα καθαρά κατά λιγότερο, γιατί οι εισφορές αφαιρούνται από το φορολογητέο. Το δεύτερο είναι να χρησιμοποιείται το περσινό όριο τον Ιανουάριο: η αλλαγή ισχύει από την πρώτη μισθοδοσία του έτους, ακόμη κι αν η εγκύκλιος βγήκε μέσα στον μήνα. Το τρίτο είναι να υποτεθεί ότι το όριο είναι ετήσιο και ότι, «αφού το πιάσαμε», οι υπόλοιποι μήνες γλιτώνουν εισφορές· αυτό δεν ισχύει, ο έλεγχος γίνεται μήνα προς μήνα.</p>
  <p>Για να βρείτε τα καθαρά σας με όλες αυτές τις παραμέτρους, ο βασικός <a href={route('home', lang)}>υπολογισμός μισθού</a> εφαρμόζει αυτόματα το όριο του {F.year}. Αν θέλετε το αντίστροφο, δηλαδή πόσα μικτά να ζητήσετε για συγκεκριμένα καθαρά, χρησιμοποιήστε τον υπολογιστή <a href={route('nettogross', lang)}>καθαρά σε μικτά</a>, που επίσης ξέρει πού σταματούν οι εισφορές.</p>
</GuideLayout>
