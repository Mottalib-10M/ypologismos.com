---
import ToolCalc from '../../components/calc/ToolCalc';
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { src } from '../../lib/facts';
import { PARAMS as P } from '../../lib/engine/gr';
import { rentRefund, rentRefundIncomeLimit } from '../../lib/engine/epidomata';
import { formatMoney, displayDate } from '../../lib/format';
const lang = 'el';
const $ = (x: number) => formatMoney(x, 0, lang);
const Y = P.year;
const R = P.rent_refund;
const ex = rentRefund({ annualRent: 7200, household: 'couple', children: 1, income: 30000 });
const stud = rentRefund({ annualRent: 3000, student: true });
const exRows = R.official_examples.map((e) => [$(e.rent), String(e.children), $(e.rent / 12), $(e.refund)]);
const limRows = [['Άγαμος', 'single', 0], ['Έγγαμοι, χωρίς παιδιά', 'couple', 0], ['Έγγαμοι, 2 παιδιά', 'couple', 2], ['Μονογονεϊκή, 1 παιδί', 'singleParent', 1], ['Μονογονεϊκή, 3 παιδιά', 'singleParent', 3]].map(([t, h, k]) => [t as string, $(rentRefundIncomeLimit(h as 'single', k as number, 2025)), $(rentRefundIncomeLimit(h as 'single', k as number))]);
const faqs = [
  { q: 'Πότε πληρώνεται η επιστροφή ενοικίου το 2026;', a: `Ο νόμος ορίζει καταβολή εφάπαξ έως το τέλος Νοεμβρίου κάθε έτους, οπότε η φετινή επιστροφή, για τα ενοίκια του ${Y - 1}, θα πληρωθεί έως τις 30 Νοεμβρίου ${Y}. Η ακριβής ημερομηνία δεν έχει ανακοινωθεί ακόμη. Πέρσι τα χρήματα πιστώθηκαν ${displayDate(R.paid_2025, 'el-GR')} σε περίπου 887.000 δικαιούχους.` },
  { q: 'Χρειάζεται αίτηση για την επιστροφή ενοικίου;', a: `Όχι. Η ΑΑΔΕ υπολογίζει το ποσό αυτόματα από το ηλεκτρονικό μισθωτήριο και από τη φορολογική δήλωση, όπως έχει διαμορφωθεί την τελευταία εργάσιμη του Σεπτεμβρίου, και το πιστώνει στο IBAN που έχετε δηλώσει. Αυτό που πρέπει να κάνετε είναι να έχει δηλωθεί η μίσθωση έως ${R.lease_declared_by} και ο αριθμός της να γραφτεί στο Ε1.` },
  { q: 'Ποια είναι τα νέα εισοδηματικά όρια για την επιστροφή ενοικίου;', a: `Από την πληρωμή του ${Y}: ${$(R.income_single)} για άγαμο, ${$(R.income_couple)} για έγγαμους συν ${$(R.income_per_child)} ανά παιδί, και ${$(R.income_single_parent)} για μονογονεϊκή οικογένεια συν ${$(R.income_per_child)} για κάθε παιδί μετά το πρώτο. Πέρσι τα όρια ήταν ${$(R.income_single_2025)}, ${$(R.income_couple_2025)} και ${$(R.income_single_parent_2025)}. Για την κύρια κατοικία ελέγχεται και η ακίνητη περιουσία.` },
  { q: 'Παίρνω επιστροφή για το φοιτητικό σπίτι του παιδιού μου;', a: `Ναι, ένα δωδέκατο του ετήσιου ενοικίου, έως ${$(R.student_cap)} για κάθε φοιτητή, και εδώ μετρά μόνο το εισόδημα, όχι η περιουσία. Αν δύο παιδιά μένουν στο ίδιο σπίτι, η επιστροφή δίνεται μία φορά. Για ενοίκιο ${$(250)} τον μήνα στο ακαδημαϊκό έτος, δηλαδή ${$(3000)} τον χρόνο, η επιστροφή είναι ${$(stud.amount)}.` },
];
---
<GuideLayout lang={lang} id="rentrefund" breadcrumbLabel={label('rentrefund', lang)}
  title={`Επιστροφή ενοικίου ${Y}: πόσα παίρνετε τον Νοέμβριο`}
  h1={`Επιστροφή ενοικίου ${Y}: υπολογισμός του ποσού και των κριτηρίων`}
  description={`Επιστροφή ενοικίου ${Y}: ένα δωδέκατο του ενοικίου του ${Y - 1}, έως ${$(R.cap)} συν ${$(R.per_child)} ανά παιδί, με τα νέα όρια. Υπολογίστε το ποσό που θα πάρετε τον Νοέμβριο.`}
  intro={`Μία φορά τον χρόνο, χωρίς αίτηση, η ΑΑΔΕ επιστρέφει στους ενοικιαστές το ενοίκιο ενός μήνα. Το ποσό βγαίνει από το μισθωτήριο και τη δήλωση.`}
  resume={`Μια οικογένεια με ένα παιδί που πλήρωσε ${$(600)} τον μήνα ενοίκιο το ${Y - 1}, δηλαδή ${$(7200)} τον χρόνο, θα πάρει επιστροφή ενοικίου ${$(ex.amount)} έως το τέλος Νοεμβρίου ${Y}. Το μέτρο του άρθρου 70 του ν. 5217/2025 επιστρέφει ένα δωδέκατο του ετήσιου ενοικίου της κύριας κατοικίας, με ανώτατο όριο ${$(R.cap)} συν ${$(R.per_child)} για κάθε εξαρτώμενο παιδί, και ξεχωριστά έως ${$(R.student_cap)} για κάθε φοιτητική κατοικία. Από φέτος τα εισοδηματικά όρια είναι υψηλότερα: ${$(R.income_single)} για άγαμο, ${$(R.income_couple)} για ζευγάρι συν ${$(R.income_per_child)} ανά παιδί, ${$(R.income_single_parent)} για μονογονεϊκή οικογένεια. Για την κύρια κατοικία ελέγχεται και η ακίνητη περιουσία, έως ${$(R.property_base)} συν ${$(R.property_per_member)} για κάθε μέλος. Δεν χρειάζεται αίτηση, αλλά η μίσθωση πρέπει να έχει δηλωθεί στην ΑΑΔΕ έως ${R.lease_declared_by} και να αναφέρεται στο Ε1. Ο υπολογιστής δίνει το ποσό από το ενοίκιο που πληρώσατε.`}
  faqs={faqs}
  related={[{ href: route('housing', lang), name: label('housing', lang), description: 'Το μηνιαίο επίδομα της ΟΠΕΚΑ για τα χαμηλά εισοδήματα.' }, { href: route('taxreturn', lang), name: label('taxreturn', lang), description: 'Το Ε1 από το οποίο υπολογίζεται η επιστροφή.' }, { href: route('student', lang), name: label('student', lang), description: 'Το στεγαστικό επίδομα για τους φοιτητές.' }]}
  sources={[src('rent_refund', lang), src('rent_refund_2026', lang), src('rent_refund_kya', lang), src('rent_refund_paid', lang)]}>
  <div data-outil><ToolCalc client:load kind="rentrefund" lang={lang} methodHref={route('method', lang)} /></div>

  <h2>Τα παραδείγματα της ΑΑΔΕ, στον υπολογιστή</h2>
  <ContentTable headers={['Ετήσιο ενοίκιο', 'Παιδιά', 'Ένα δωδέκατο', 'Επιστροφή']} align={['r', 'r', 'r', 'r']} rows={exRows} />
  <p>Ο πίνακας αναπαράγει τα αριθμητικά παραδείγματα των συχνών ερωτήσεων της ΑΑΔΕ και ο υπολογιστής βγάζει τα ίδια ποσά. Η λογική είναι πάντα η μικρότερη από δύο τιμές: το ένα δωδέκατο του ενοικίου που πληρώσατε ή το όριο της οικογένειάς σας. Με διαδοχικά μισθωτήρια μέσα στη χρονιά, τα ενοίκια αθροίζονται. Αν ο ιδιοκτήτης δήλωσε ανείσπρακτα ενοίκια, μετρά μόνο το ποσό που δήλωσε στο Ε2.</p>
  <div data-chrome><MiniSim client:load kind="rentcap" lang={lang} href={route('rentrefund', lang)} /></div>

  <h2>Τα εισοδηματικά όρια, πριν και τώρα</h2>
  <ContentTable headers={['Νοικοκυριό', 'Πληρωμή 2025', `Πληρωμή ${Y}`]} align={['l', 'r', 'r']} rows={limRows} />
  <p>Το άρθρο 3 του ν. 5313/2026 ανέβασε τα όρια για τις επιστροφές από το {Y} και μετά, δηλαδή για τα ενοίκια που πληρώθηκαν από το {Y - 1}. Το εισόδημα είναι το συνολικό οικογενειακό, φορολογητέο και αφορολόγητο, πραγματικό ή τεκμαρτό. Η περιουσία ελέγχεται με την αξία της ΕΝΦΙΑ του έτους πληρωμής, μόνο για την κύρια κατοικία.</p>
  <div data-chrome><MiniSim client:load kind="rentlimit" lang={lang} href={route('rentrefund', lang)} /></div>

  <h2>Τρία λάθη που χάνουν την επιστροφή</h2>
  <p>Το πρώτο είναι μια μίσθωση που δεν δηλώθηκε ποτέ στην πλατφόρμα της ΑΑΔΕ ή δηλώθηκε μετά τις {R.lease_declared_by}. Το δεύτερο, ο αριθμός του μισθωτηρίου που λείπει από τον πίνακα 6 του Ε1: χωρίς αυτόν, η ΑΑΔΕ δεν συνδέει το ενοίκιο με εσάς. Το τρίτο, ένας λάθος ή παλιός IBAN. Τα δύο πρώτα διορθώνονται με τροποποιητική δήλωση μέχρι την τελευταία εργάσιμη του Σεπτεμβρίου. Όποιος δηλώσει ανακριβή στοιχεία επιστρέφει τα χρήματα με τόκους και αποκλείεται για τρία χρόνια.</p>
  <p>Ξεχωριστά, εκπαιδευτικοί, γιατροί και νοσηλευτές που υπηρετούν εκτός Αττικής και Θεσσαλονίκης παίρνουν δύο ενοίκια αντί για ένα, με κοινό ανώτατο όριο {$(R.art70a_cap)} συν {$(R.art70a_per_child)} ανά παιδί (άρθρο 70Α).</p>
</GuideLayout>
