---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { roadTax, salary, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $2 = (x: number) => formatMoney(x, 2, lang);
const n = F.num;
const R = P.road_tax;
const w = (g: number) => roadTax({ category: 'co2_wltp', co2: g }).amount;
const nd = (g: number) => roadTax({ category: 'co2_nedc', co2: g }).amount;
const cc = (c: number) => roadTax({ category: 'cc_from_2006', cc: c }).amount;
const cases: Array<[string, number]> = [
  [`Μικρό πόλης 2023, ${n(118)} g/km WLTP`, w(118)],
  [`Οικογενειακό 2022, ${n(145)} g/km WLTP`, w(145)],
  [`SUV 2024, ${n(175)} g/km WLTP`, w(175)],
  [`SUV 2021, ${n(215)} g/km WLTP`, w(215)],
  [`Μεταχειρισμένο 2015, ${n(132)} g/km NEDC`, nd(132)],
  [`Μεταχειρισμένο 2018, ${n(165)} g/km NEDC`, nd(165)],
  [`Βενζινοκίνητο 2008, ${n(1390)} κ.εκ.`, cc(1390)],
  [`Βενζινοκίνητο 2007, ${n(1998)} κ.εκ.`, cc(1998)],
];
const rows = cases.map(([k, a]) => [k, $2(a), $2(a / 12), $2(a / 4), $2(a / 3)]);
const fam = w(145), summer = w(175);
const minYear = salary({ gross: P.minimum_wage.monthly }).netAnnual;
const faqs = [
  { q: 'Το αυτοκίνητο κάθεται από τον Μάρτιο. Παίρνω πίσω τα τέλη των υπόλοιπων μηνών;', a: `Όχι. Τα τέλη ιδιωτικού επιβατικού είναι αδιαίρετα και οφείλονται για ολόκληρο το έτος, όσους μήνες κι αν κυκλοφόρησε. Ακινησία που δηλώνεται αφού έχει αρχίσει η χρονιά δεν λαμβάνεται υπόψη για τα τέλη αυτού του έτους. Ένα οικογενειακό με ${n(145)} g/km κατά WLTP χρωστά λοιπόν ολόκληρα τα ${$2(fam)}, ακόμη κι αν μείνει στο γκαράζ από τον Μάρτιο.` },
  { q: 'Αν δηλώσω ακινησία στα τέλη Δεκεμβρίου, γλιτώνω τα τέλη της επόμενης χρονιάς;', a: `Ναι, εφόσον η δήλωση υποβληθεί στο gov.gr πριν από την 1η Ιανουαρίου και το αυτοκίνητο μείνει ακινητοποιημένο όλο το έτος. Αφαιρείτε τις πινακίδες, τις φυλάτε και το όχημα μένει στη διεύθυνση που δηλώσατε. Η ακινησία ισχύει μέχρι να ζητήσετε άρση. Αν το αυτοκίνητο εντοπιστεί να κυκλοφορεί, η ακινησία αίρεται και επιβάλλεται πρόστιμο δέκα χιλιάδων ευρώ.` },
  { q: 'Θέλω να ξαναβγάλω το αυτοκίνητο στον δρόμο τον Ιούλιο. Πόσα τέλη πληρώνω;', a: `Ολόκληρα τα τέλη της χρονιάς. Η άρση της ακινησίας γίνεται ηλεκτρονικά μόνο εφόσον πληρωθούν τα τέλη κυκλοφορίας του έτους της άρσης, και ο νόμος δεν προβλέπει μείωση για τους μήνες που προηγήθηκαν. Ένα SUV με ${n(175)} g/km κατά WLTP πληρώνει ${$2(summer)} είτε βγει τον Ιανουάριο είτε τον Νοέμβριο.` },
  { q: 'Πόσα να βάζω στην άκρη κάθε μήνα για να μη με πιάσουν απροετοίμαστο τα τέλη;', a: `Διαιρέστε το ετήσιο ποσό με το δώδεκα. Για αυτοκίνητο με ${n(145)} g/km κατά WLTP, τα ${$2(fam)} αντιστοιχούν σε ${$2(fam / 12)} τον μήνα. Η μηνιαία αποταμίευση είναι δική σας επιλογή προϋπολογισμού: η φορολογική διοίκηση ζητά ολόκληρο το ποσό μαζί. Ο μίνι υπολογιστής της σελίδας κάνει τη διαίρεση για οποιοδήποτε αυτοκίνητο.` },
  { q: 'Υπάρχουν οχήματα για τα οποία τα τέλη μετράνε ανά μήνα ή εξάμηνο;', a: `Ναι, αλλά όχι τα ιδιωτικά επιβατικά. Για τις άλλες κατηγορίες οχημάτων, όπως τα φορτηγά, το άρθρο 20 μειώνει τα τέλη στο μισό όταν το όχημα δεν κυκλοφόρησε ολόκληρο ημερολογιακό εξάμηνο. Για επιβατικά σε καθεστώς προσωρινής εισαγωγής, πέρα από την περίοδο απαλλαγής, οφείλεται το 1/12 των τελών για κάθε μήνα ή τμήμα μήνα.` },
];
---
<GuideLayout lang={lang} id="roadmonth" breadcrumbLabel={label('roadmonth', lang)}
  title={`Τέλη κυκλοφορίας με το μήνα ${F.year}: τι ισχύει στην πράξη`}
  h1={`Τέλη κυκλοφορίας με το μήνα: γιατί το ${F.year} πληρώνετε όλο το έτος`}
  description={`Τέλη κυκλοφορίας με το μήνα ${F.year}: για ιδιωτικά επιβατικά δεν υπάρχουν, τα τέλη είναι αδιαίρετα. Ακινησία πριν από τον Ιανουάριο, άρση, μηνιαία αποταμίευση.`}
  intro={`Για τα ιδιωτικά επιβατικά, τα τέλη κυκλοφορίας δεν πληρώνονται με το μήνα: ο νόμος τα ορίζει αδιαίρετα και οφειλόμενα για ολόκληρο το έτος.`}
  resume={`Τέλη κυκλοφορίας με το μήνα, με την έννοια «πληρώνω μόνο τους μήνες που οδηγώ», δεν υπάρχουν για τα ιδιωτικά επιβατικά το ${F.year}. Η παράγραφος 2α του άρθρου 20 του ν. 2948/2001 ορίζει ότι τα τέλη επιβατικών, μοτοσικλετών και τροχόσπιτων ιδιωτικής χρήσης είναι αδιαίρετα και οφείλονται για ολόκληρο το έτος, ανεξάρτητα από το διάστημα που κυκλοφόρησε το όχημα. Η μόνη εξαίρεση είναι η ακινησία για όλο το έτος, που πρέπει να δηλωθεί στο gov.gr πριν από την 1η Ιανουαρίου. Όποιος ξαναβγάζει το αυτοκίνητο στον δρόμο μέσα στη χρονιά πρέπει πρώτα να πληρώσει τα τέλη ολόκληρου του έτους. Αυτό που μπορείτε να κάνετε με το μήνα είναι να αποταμιεύετε: για ένα οικογενειακό με ${n(145)} g/km κατά WLTP, τα ${$2(fam)} του έτους αντιστοιχούν σε ${$2(fam / 12)} τον μήνα. Μηνιαία ή εξαμηνιαία λογική υπάρχει μόνο για άλλες κατηγορίες, όπως τα φορτηγά ή τα αυτοκίνητα σε προσωρινή εισαγωγή. Ο υπολογιστής κάτω δίνει το ετήσιο ποσό, τη μηνιαία δόση αποταμίευσης και το πραγματικό κόστος ανά μήνα χρήσης.`}
  faqs={faqs}
  related={[{ href: route('road', lang), name: label('road', lang), description: 'Το ακριβές ποσό από την άδεια κυκλοφορίας.' }, { href: route('roadev', lang), name: label('roadev', lang), description: 'Το μόνο αυτοκίνητο που δεν χρειάζεται κουμπαρά για τέλη.' }, { href: route('home', lang), name: label('home', lang), description: 'Τα μηνιαία καθαρά σας, για να χωρέσει το ετήσιο έξοδο.' }]}
  sources={[src('road_tax', lang), src('road_tax_idle', lang), src('min_wage', lang)]}>
  <div data-chrome><MiniSim client:load kind="roadmonth" lang={lang} href={route('road', lang)} /></div>

  <h2>Τι λέει ακριβώς ο νόμος για τους μήνες</h2>
  <p>Η φράση που κλείνει τη συζήτηση βρίσκεται στην παράγραφο 2α του άρθρου 20: τα τέλη «είναι αδιαίρετα και οφείλονται για ολόκληρο το έτος ανεξάρτητα από το χρονικό διάστημα που κυκλοφόρησαν εντός του έτους». Η ίδια διάταξη προσθέτει ότι τα οχήματα αυτά θεωρείται ότι κυκλοφόρησαν όλη τη χρονιά, εκτός αν τεθούν σε ακινησία για ολόκληρο το έτος. Δεν υπάρχει λοιπόν ενδιάμεση λύση τύπου «έξι μήνες κίνηση, έξι μήνες στάση, μισά τέλη».</p>
  <p>Η διάταξη καλύπτει τρεις κατηγορίες ιδιωτικής χρήσης: επιβατικά, δίκυκλες και τρίκυκλες μοτοσικλέτες, και ρυμουλκούμενα τροχόσπιτα. Για όλες τις άλλες κατηγορίες ο νόμος σκέφτεται διαφορετικά, και εκεί βρίσκεται η πηγή της παρεξήγησης: όποιος έχει ακούσει για «μισά τέλη» ή «δωδέκατα» συνήθως μιλάει για επαγγελματικό όχημα ή για αυτοκίνητο με ξένες πινακίδες.</p>

  <h2>Πού υπάρχουν πράγματι μισά τέλη ή δωδέκατα</h2>
  <p>Η παράγραφος 2β του ίδιου άρθρου προβλέπει, για τα υπόλοιπα οχήματα, μείωση των ετήσιων τελών κατά το ήμισυ όταν το όχημα δεν κυκλοφόρησε για ολόκληρο ημερολογιακό εξάμηνο: επειδή διαγράφηκε μέσα στο πρώτο εξάμηνο, επειδή μπήκε σε κυκλοφορία στο δεύτερο, ή επειδή τέθηκε σε ακινησία για ένα ολόκληρο εξάμηνο. Είναι ο κανόνας που ακούει κανείς από επαγγελματίες με φορτηγά.</p>
  <p>Τα δωδέκατα εμφανίζονται σε μια ακόμη στενότερη περίπτωση: επιβατικά ιδιωτικής χρήσης σε ανασταλτικό τελωνειακό καθεστώς προσωρινής εισαγωγής. Για κάθε μήνα ή τμήμα μήνα πέρα από την περίοδο απαλλαγής, ο κάτοχος καταβάλλει το 1/12 των τελών. Ένα ελληνικό αυτοκίνητο με ελληνικές πινακίδες δεν εμπίπτει σε καμία από τις δύο περιπτώσεις.</p>

  <h2>Η ακινησία, βήμα βήμα, και οι ημερομηνίες που μετράνε</h2>
  <p>Το άρθρο 22 του ν. 2367/1953 περιγράφει τη διαδικασία. Η δήλωση γίνεται ηλεκτρονικά στο gov.gr από τον ιδιοκτήτη ή τον κάτοχο, με την ακριβή διεύθυνση όπου θα μείνει το όχημα. Αμέσως μετά βγάζετε τις πινακίδες και τις κρατάτε εσείς, δεν τις παραδίδετε πια στην εφορία. Για να μετρήσει στα τέλη, η ακινησία δηλώνεται πριν αρχίσει η χρονιά που αφορά και ισχύει μέχρι να ζητήσετε άρση. Δήλωση στις 3 Ιανουαρίου δεν σας γλιτώνει από τα τέλη του τρέχοντος έτους, μόνο από του επόμενου.</p>
  <p>Η άρση ακολουθεί τον αντίστροφο δρόμο: αίτηση στο gov.gr, η οποία προχωρά εφόσον πληρωθούν τα τέλη του έτους της άρσης. Αυτό είναι το σημείο που ακυρώνει κάθε ιδέα για «μηνιαίο» σύστημα. Αν βάλετε το αυτοκίνητο σε ακινησία από την 1η Ιανουαρίου και το ξαναβγάλετε την 1η Ιουνίου, πληρώνετε τα τέλη όλου του έτους τη μέρα της άρσης.</p>
  <p>Μέσα στο διάστημα της ακινησίας το αυτοκίνητο απαγορεύεται να κινηθεί για οποιονδήποτε λόγο, με λίγες εξαιρέσεις προσωρινής άδειας για ΚΤΕΟ, επισκευή, αλλαγή χώρου φύλαξης ή παράδοση για ανακύκλωση. Οι έλεγχοι γίνονται και με διασταυρώσεις στοιχείων από τους αυτοκινητοδρόμους και με σάρωση πινακίδων. Αν το όχημα βρεθεί να κυκλοφορεί ή σταθμευμένο αλλού, η ακινησία αίρεται αυτοδικαίως και επιβάλλεται πρόστιμο δέκα χιλιάδων ευρώ, πέρα από τα τέλη. Σε υποτροπή μέσα σε πέντε χρόνια, το πρόστιμο τριπλασιάζεται και ο ιδιοκτήτης χάνει το δίπλωμα για τρία χρόνια.</p>

  <h2>Το ετήσιο ποσό σε μηνιαία, τριμηνιαία και «καλοκαιρινή» βάση</h2>
  <ContentTable headers={['Αυτοκίνητο', 'Ετήσια τέλη', 'Αποταμίευση / μήνα', 'Κόστος ανά μήνα με 4 μήνες χρήσης', 'Με 3 μήνες χρήσης']} align={['l', 'r', 'r', 'r', 'r']} rows={rows} highlightRow={1} />
  <p>Η δεύτερη στήλη είναι αυτό που θα ζητήσει η φορολογική διοίκηση, ολόκληρο. Η τρίτη είναι το ποσό που αρκεί να μεταφέρετε κάθε μήνα σε έναν λογαριασμό αποταμίευσης για να μη σας αιφνιδιάσει ο λογαριασμός. Οι δύο τελευταίες στήλες απαντούν σε άλλη ερώτηση: πόσο σας κοστίζει πραγματικά κάθε μήνας οδήγησης αν το αυτοκίνητο κινείται μόνο το καλοκαίρι. Για ένα SUV του 2024 με {n(175)} g/km, τρεις μήνες χρήσης σημαίνουν {$2(summer / 3)} ανά μήνα οδήγησης, γιατί τα {$2(summer)} πληρώνονται έτσι κι αλλιώς.</p>
  <p>Ο πίνακας χρησιμοποιεί τους πίνακες WLTP, NEDC και τον τρίτο πίνακα κυβισμού του άρθρου 20, όπως και ο <a href={route('road', lang)}>υπολογιστής τελών κυκλοφορίας</a>. Τα αυτοκίνητα κάτω από τα {n(R.co2_wltp[0].upTo as number)} g/km κατά WLTP έχουν μηδενικά τέλη, οπότε το ερώτημα του μήνα δεν τίθεται καν.</p>

  <h2>Τρεις περιπτώσεις που βάζουν το ερώτημα</h2>
  <p><strong>Το εξοχικό αυτοκίνητο.</strong> Ένα δεύτερο αυτοκίνητο που μένει σε νησί και κινείται Ιούνιο με Σεπτέμβριο κοστίζει τα πλήρη τέλη κάθε χρόνο. Η εναλλακτική είναι να μείνει σε ακινησία όλα τα χρόνια που δεν το χρειάζεστε, δηλωμένη πριν από τον Ιανουάριο. Μισή λύση, ακινησία τον χειμώνα και κίνηση το καλοκαίρι, δεν υπάρχει.</p>
  <p><strong>Ο εργαζόμενος που φεύγει στο εξωτερικό.</strong> Αν μάθετε τον Οκτώβριο ότι θα δουλέψετε έναν χρόνο εκτός Ελλάδας, προλαβαίνετε να δηλώσετε ακινησία για την επόμενη χρονιά. Αν το μάθετε τον Φεβρουάριο, τα τέλη της τρέχουσας χρονιάς οφείλονται ολόκληρα, και η ακινησία θα μετρήσει από την επόμενη.</p>
  <p><strong>Το παλιό αυτοκίνητο που περιμένει πώληση.</strong> Ένα βενζινοκίνητο του 2007 με {n(1998)} κ.εκ. χρωστά {$2(cc(1998))} τον χρόνο, ποσό που σε παλιό όχημα μπορεί να πλησιάζει την αξία του. Αν η πώληση αργήσει, η ακινησία πριν από την αλλαγή της χρονιάς είναι ο μόνος τρόπος να μην προστεθεί ακόμη μία χρονιά τελών. Ο οδηγός για τα <a href={route('roadcc', lang)}>τέλη με κυβικά</a> δείχνει τι πληρώνει κάθε κατηγορία κινητήρα.</p>

  <div data-chrome><MiniSim client:load kind="road" lang={lang} href={route('road', lang)} /></div>

  <h2>Το έξοδο μέσα στον οικογενειακό προϋπολογισμό</h2>
  <p>Ένα ποσό που πληρώνεται μία φορά τον χρόνο φαίνεται πάντα μεγαλύτερο απ' ό,τι είναι, και γι' αυτό η μηνιαία αποταμίευση έχει νόημα. Με τον κατώτατο μισθό, δηλαδή {F.minNet} καθαρά σε καθεμία από τις 14 καταβολές, τα {$2(fam)} ενός οικογενειακού αυτοκινήτου αντιστοιχούν σε {F.pct(Math.round(fam / minYear * 1000) / 1000)} των ετήσιων καθαρών αποδοχών. Ο <a href={route('home', lang)}>υπολογισμός μισθού</a> δίνει τα δικά σας καθαρά για να κάνετε την ίδια σύγκριση.</p>
  <p>Μια πρακτική λύση είναι η πάγια εντολή στην τράπεζα για το ένα δωδέκατο κάθε μήνα, σε ξεχωριστό λογαριασμό. Η πληρωμή προς το Δημόσιο παραμένει εφάπαξ, αλλά το ποσό είναι ήδη εκεί. Για όποιον σκέφτεται αλλαγή αυτοκινήτου, ο οδηγός για τα <a href={route('roadev', lang)}>ηλεκτρικά αυτοκίνητα</a> δείχνει τη μόνη κατηγορία στην οποία αυτός ο λογαριασμός μένει άδειος.</p>
</GuideLayout>
