---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { enfia, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const E = P.enfia;
const Y = P.year;
// Πέτρινο σπίτι στο χωριό: μονοκατοικία 110 m², τιμή ζώνης 650 €, άδεια 1985, δύο προσόψεις (προεπιλογές του μίνι υπολογιστή).
const base = { sqm: 110, zonePrice: 650, buildYear: 1985, detached: true, facades: 2 } as const;
const a = enfia(base), b = enfia({ ...base, smallSettlement: true });
const cases = [[80, 500, 1970], [110, 650, 1985], [140, 900, 2005], [180, 1200, 2016], [220, 1600, 2021]] as const;
const rows = cases.map(([s, z, y]) => { const x = enfia({ sqm: s, zonePrice: z, buildYear: y, detached: true, facades: 2 }), v = enfia({ sqm: s, zonePrice: z, buildYear: y, detached: true, facades: 2, smallSettlement: true }); return [`${s} m², ${$(z)}/m², άδεια ${y}`, $(x.total), $(v.total), $(0)]; });
// Ζευγάρι με κύρια κατοικία στο χωριό και διαμέρισμα στην πόλη που νοικιάζει.
const tot = 110 * 650 + 70 * 2000;
const homeV = enfia({ ...base, totalValue: tot, smallSettlement: true });
const homeNo = enfia({ ...base, totalValue: tot });
const city = enfia({ sqm: 70, zonePrice: 2000, buildYear: 1999, floor: 'f2_3', facades: 1, totalValue: tot });
const twoYears = a.total - b.total + a.total;
const bIns = enfia({ ...base, smallSettlement: true, insured: true });
const half = enfia({ ...base, share: 0.5, smallSettlement: true }), halfNo = enfia({ ...base, share: 0.5 });
const faqs = [
  { q: `Ποιοι οικισμοί πιάνουν τη μείωση ${F.village} στον ΕΝΦΙΑ το ${Y};`, a: `Οικισμοί με πληθυσμό έως ${F.villagePop} κατοίκους σύμφωνα με την πιο πρόσφατη απογραφή, σε όλη τη χώρα εκτός από την ηπειρωτική Αττική· τα νησιά της Περιφερειακής Ενότητας Νήσων μένουν μέσα. Για τη Δυτική Μακεδονία, τον Έβρο και τους παραμεθόριους δήμους της Κεντρικής Μακεδονίας, της Ανατολικής Μακεδονίας και Θράκης και της Ηπείρου, το όριο είναι ${F.villagePopBorder} κάτοικοι. Μετράει ο οικισμός, όχι ολόκληρος ο δήμος.` },
  { q: 'Το εξοχικό μου στο χωριό παίρνει κι αυτό τη μείωση;', a: `Όχι. Η μείωση του άρθρου 17 παρ. 3 αφορά αποκλειστικά τα δικαιώματα στην κύρια κατοικία, όπως αυτή προκύπτει από τη δήλωση φορολογίας εισοδήματος. Ένα σπίτι που χρησιμοποιείτε τα καλοκαίρια, ενώ ζείτε στην Αθήνα ή στη Θεσσαλονίκη, πληρώνει κανονικό ΕΝΦΙΑ, με τις συνηθισμένες μειώσεις λόγω αξίας ή ασφάλισης. Το ίδιο ισχύει για τα υπόλοιπα ακίνητα του ιδιοκτήτη στον ίδιο οικισμό.` },
  { q: 'Μένω μόνιμα στην Αίγινα. Με αφορά η εξαίρεση της Αττικής;', a: `Όχι, γιατί ο νόμος εξαιρεί τους οικισμούς της Περιφέρειας Αττικής πλην της Περιφερειακής Ενότητας Νήσων, στην οποία ανήκει η Αίγινα. Αν ο οικισμός όπου βρίσκεται η κύρια κατοικία σας έχει έως ${F.villagePop} κατοίκους στην τελευταία απογραφή και η κατοικία αξίζει έως ${F.villageValue}, ο ΕΝΦΙΑ της για το ${Y} μειώνεται κατά ${F.village}. Το ίδιο ισχύει για την Ύδρα και τα άλλα νησιά της ενότητας.` },
  { q: 'Τι αλλάζει για τα χωριά από το 2027;', a: `Η μείωση ${F.village} γίνεται πλήρης απαλλαγή. Το άρθρο 10 παρ. 1 περ. ια του Κώδικα Φορολογίας Περιουσίας απαλλάσσει από το 2027 την κύρια κατοικία φορολογικών κατοίκων Ελλάδας σε οικισμούς έως ${F.villagePop} κατοίκων (${F.villagePopBorder} στα παραμεθόρια), εκτός ηπειρωτικής Αττικής, με αξία έως ${F.villageValue}. Για το σπίτι των ${base.sqm} m² του παραδείγματός μας, ο φόρος περνά από ${$(b.total)} σε μηδέν.` },
  { q: 'Μετακόμισα φέτος στο χωριό. Παίρνω τη μείωση από φέτος;', a: `Μάλλον όχι για το ${Y}. Η κύρια κατοικία κρίνεται από τη δήλωση φορολογίας εισοδήματος του προηγούμενου έτους, της οποίας η προθεσμία είχε λήξει όταν υπολογίστηκε ο φόρος. Αν σε εκείνη τη δήλωση η κύρια κατοικία σας ήταν ακόμη στην πόλη, το σπίτι του χωριού φορολογείται κανονικά. Δηλώστε σωστά τη νέα διεύθυνση στην επόμενη δήλωση, για να μετρήσει από τον επόμενο ΕΝΦΙΑ.` },
  { q: `Η αξία των ${F.villageValue} αφορά το σπίτι ή όλη μου την περιουσία;`, a: `Το σπίτι. Ο νόμος κοιτάζει τη συνολική αξία του 100 % της πλήρους κυριότητας της κατοικίας, όπως υπολογίζεται για τον φόρο, και την συγκρίνει με το όριο των ${F.villageValue}. Τα άλλα σας ακίνητα δεν μετράνε σε αυτό το όριο, αν και επηρεάζουν τη μείωση λόγω συνολικής αξίας. Αν έχετε το μισό σπίτι, μετράει η αξία ολόκληρου του σπιτιού, όχι του μεριδίου σας.` },
];
---
<GuideLayout lang={lang} id="enfiavillage" breadcrumbLabel={label('enfiavillage', lang)}
  title={`ΕΝΦΙΑ μικρών οικισμών ${Y}: μείωση ${F.village} και απαλλαγή 2027`}
  h1={`ΕΝΦΙΑ στους μικρούς οικισμούς: μισός φόρος το ${Y}, μηδέν από το 2027`}
  description={`ΕΝΦΙΑ μικρών οικισμών ${Y}: μείωση ${F.village} για την κύρια κατοικία σε χωριά έως ${F.villagePop} κατοίκων (${F.villagePopBorder} στα σύνορα), αξία έως ${F.villageValue}, απαλλαγή από το 2027.`}
  intro={`Για όσους ζουν μόνιμα σε χωριό, ο ΕΝΦΙΑ του σπιτιού τους πέφτει στο μισό φέτος και σβήνει από την επόμενη χρονιά.`}
  resume={`Το ${Y} ο ΕΝΦΙΑ της κύριας κατοικίας μειώνεται κατά ${F.village} για φορολογικούς κατοίκους Ελλάδας που μένουν σε οικισμό έως ${F.villagePop} κατοίκων, σύμφωνα με την τελευταία απογραφή, οπουδήποτε εκτός από την ηπειρωτική Αττική. Στη Δυτική Μακεδονία, στον Έβρο και στους δήμους της Κεντρικής Μακεδονίας, της Ανατολικής Μακεδονίας και Θράκης και της Ηπείρου που αγγίζουν τα σύνορα, το όριο ανεβαίνει στους ${F.villagePopBorder} κατοίκους. Η κατοικία πρέπει να αξίζει έως ${F.villageValue} και να είναι η κύρια κατοικία της δήλωσης φορολογίας εισοδήματος του προηγούμενου έτους. Μια πέτρινη μονοκατοικία ${base.sqm} m² με τιμή ζώνης ${$(base.zonePrice)} και άδεια του ${base.buildYear} πληρώνει ${$(b.total)} αντί για ${$(a.total)}. Από το 2027 η ίδια κατοικία απαλλάσσεται εντελώς, με τους ίδιους όρους, βάσει του άρθρου 10 του Κώδικα Φορολογίας Περιουσίας. Τα εξοχικά και τα υπόλοιπα ακίνητα δεν επωφελούνται.`}
  faqs={faqs}
  related={[{ href: route('enfia', lang), name: label('enfia', lang), description: `Υπολογίστε τον φόρο της κατοικίας με την επιλογή «οικισμός έως ${F.villagePop}».` }, { href: route('enfiadisc', lang), name: label('enfiadisc', lang), description: 'Οι υπόλοιπες μειώσεις: αξία, χαμηλό εισόδημα, ασφάλιση.' }, { href: route('zone', lang), name: label('zone', lang), description: 'Πώς η τιμή ζώνης του χωριού καθορίζει τον βασικό φόρο.' }]}
  sources={[src('enfia_2026', lang), src('enfia_exemptions', lang), src('enfia', lang), src('enfia_reductions', lang)]}>
  <div data-chrome><MiniSim client:load kind="enfiavillage" lang={lang} href={route('enfia', lang)} /></div>

  <h2>Πόσο γλιτώνει ένα σπίτι στο χωριό</h2>
  <ContentTable headers={['Μονοκατοικία', `ΕΝΦΙΑ χωρίς τη μείωση`, `ΕΝΦΙΑ ${Y}`, 'Από το 2027']} align={['l', 'r', 'r', 'r']} rows={rows} highlightRow={1} />
  <p>Ο πίνακας αφορά μονοκατοικίες με δύο προσόψεις, χωρίς άλλα ακίνητα στο όνομα του ιδιοκτήτη, οπότε ισχύει και η μείωση λόγω χαμηλής συνολικής αξίας. Με τιμές ζώνης σαν αυτές του πίνακα, ο φόρος μιας κατοικίας μένει σε λίγες εκατοντάδες ευρώ, άρα και η ωφέλεια μετριέται σε δεκάδες ή εκατοντάδες ευρώ τον χρόνο. Για το σπίτι των {base.sqm} m², τα δύο χρόνια μαζί, {Y} και 2027, σημαίνουν {$(twoYears)} λιγότερο φόρο σε σχέση με την πλήρη χρέωση.</p>

  <h2>Οικισμός, όχι δήμος: πώς μετράει ο πληθυσμός</h2>
  <p>Η διάταξη του άρθρου 17 παρ. 3 μιλά για «οικισμούς με πληθυσμό έως {F.villagePop} κατοίκους, σύμφωνα με την εκάστοτε πλέον πρόσφατη απογραφή». Η μονάδα είναι ο οικισμός, δηλαδή το χωριό ή ο συνοικισμός, όχι η δημοτική ενότητα ή ο δήμος. Ένα χωριό διακοσίων κατοίκων μέσα σε έναν μεγάλο δήμο της Κρήτης ή της Πελοποννήσου μπορεί λοιπόν να πιάνει τη μείωση, ενώ η έδρα του ίδιου δήμου όχι. Ο πληθυσμός που μετράει είναι εκείνος της πιο πρόσφατης απογραφής της ΕΛΣΤΑΤ, όχι οι εγγεγραμμένοι δημότες ή οι εκλογικοί κατάλογοι.</p>
  <p>Η ηπειρωτική Αττική εξαιρείται ολόκληρη, ακόμη και τα μικρά χωριά της. Η εξαίρεση όμως δεν αγγίζει την Περιφερειακή Ενότητα Νήσων: η Αίγινα, η Ύδρα και τα άλλα νησιά της ενότητας αντιμετωπίζονται όπως η υπόλοιπη χώρα.</p>

  <h2>Το όριο των {F.villagePopBorder} στις παραμεθόριες περιοχές</h2>
  <p>Για ορισμένες περιοχές κοντά στα σύνορα, ο νόμος ανεβάζει το όριο από {F.villagePop} σε {F.villagePopBorder} κατοίκους. Το υψηλότερο όριο ισχύει σε ολόκληρη την Περιφέρεια Δυτικής Μακεδονίας και σε ολόκληρη την Περιφερειακή Ενότητα Έβρου. Στην Κεντρική Μακεδονία, στην Ανατολική Μακεδονία και Θράκη και στην Ήπειρο ισχύει μόνο για τους δήμους που εφάπτονται με τα σύνορα της χώρας. Ένας οικισμός {F.num(1600)} κατοίκων στην Ήπειρο μπαίνει στη ρύθμιση αν ο δήμος του συνορεύει, και μένει εκτός αν βρίσκεται στο εσωτερικό.</p>

  <div data-chrome><MiniSim client:load kind="villagecheck" lang={lang} href={route('enfia', lang)} /></div>

  <h2>Ποια είναι η «κύρια κατοικία» για τον νόμο</h2>
  <p>Για το {Y}, η κύρια κατοικία προκύπτει από τη δήλωση φορολογίας εισοδήματος του προηγούμενου φορολογικού έτους, της οποίας η προθεσμία είχε λήξει τη στιγμή που υπολογίστηκε ο φόρος. Δεν αρκεί να μένετε στο χωριό· πρέπει η δήλωση να το γράφει. Όποιος δήλωνε ως κύρια κατοικία το διαμέρισμα στην πόλη, ενώ περνούσε τον περισσότερο χρόνο στο χωριό, δεν θα δει τη μείωση στο σπίτι του χωριού.</p>
  <p>Η μείωση πιάνει μόνο τα δικαιώματα στην κύρια κατοικία που βρίσκεται μέσα στον οικισμό. Ένα ζευγάρι που ζει μόνιμα σε μονοκατοικία {base.sqm} m² στο χωριό και νοικιάζει ένα διαμέρισμα 70 m² στην πόλη έχει συνολική αξία {$(tot)}. Για το σπίτι του χωριού πληρώνει {$(homeV.total)} αντί για {$(homeNo.total)}· για το διαμέρισμα πληρώνει κανονικά {$(city.total)}, με τη μείωση λόγω αξίας των {F.pct(city.valueReductionRate)} αλλά χωρίς τη μείωση του χωριού.</p>
  <p>Το όριο των {F.villageValue} αφορά την αξία της ίδιας της κατοικίας, υπολογισμένη για το 100 % της πλήρους κυριότητας. Δεν είναι όριο συνολικής περιουσίας. Στον υπολογιστή μας, όμως, ο έλεγχος γίνεται πάνω στην αξία που λαμβάνεται υπόψη για όλο τον υπολογισμό· αν έχετε κι άλλα ακίνητα που ανεβάζουν τη συνολική αξία πάνω από αυτό το ποσό, ελέγξτε το όριο με την αξία του σπιτιού μόνο.</p>

  <h2>Γονείς στο χωριό, παιδιά στην πόλη</h2>
  <p>Μια συνηθισμένη οικογενειακή διάταξη στην επαρχία είναι οι γονείς να κρατούν την επικαρπία του πατρικού και να έχουν δώσει την ψιλή κυριότητα στα παιδιά. Ο ΕΝΦΙΑ επιβάλλεται και στα δύο δικαιώματα. Η διάταξη όμως μιλά για «δικαιώματα επί της κύριας κατοικίας» των προσώπων που την έχουν κύρια κατοικία. Με αυτή τη διατύπωση, η μείωση αφορά το δικαίωμα των γονιών που ζουν στο σπίτι, όχι το δικαίωμα του παιδιού που μένει στην Αθήνα και έχει εκεί την κύρια κατοικία του.</p>
  <p>Το ίδιο σκεπτικό ισχύει στη συνιδιοκτησία. Αν δύο αδέρφια έχουν από μισό το σπίτι των {base.sqm} m² και μόνο ο ένας ζει εκεί μόνιμα, εκείνος πληρώνει για το μερίδιό του {$(half.total)} αντί για {$(halfNo.total)}, ενώ ο άλλος πληρώνει κανονικά. Το όριο αξίας των {F.villageValue} κρίνεται πάντα από ολόκληρο το σπίτι.</p>
  <p>Πριν φτάσει το εκκαθαριστικό, αξίζουν τρεις έλεγχοι. Ο πληθυσμός του οικισμού στην τελευταία απογραφή, που δημοσιεύει η ΕΛΣΤΑΤ ανά οικισμό. Η διεύθυνση κύριας κατοικίας στην τελευταία δήλωση φορολογίας εισοδήματος, γιατί αυτή διαβάζει η Φορολογική Διοίκηση. Και η αξία του σπιτιού, που για ένα χωριάτικο σπίτι συνήθως απέχει πολύ από το όριο, αλλά όχι πάντα για μια μεγάλη νεόδμητη βίλα σε τουριστικό νησί.</p>

  <h2>Μαζί με τις άλλες μειώσεις</h2>
  <p>Η μείωση του χωριού δεν αντικαθιστά τη μείωση λόγω συνολικής αξίας ούτε την έκπτωση για ασφαλισμένη κατοικία· εφαρμόζεται μαζί τους. Ο υπολογιστής μας εφαρμόζει πρώτα τη μείωση λόγω αξίας, μετά την ασφάλιση και στο τέλος το {F.village} του οικισμού, κάθε φορά πάνω στο ποσό που έχει απομείνει. Για το πέτρινο σπίτι του παραδείγματος, με ασφάλεια για σεισμό, πυρκαγιά και πλημμύρα όλο το προηγούμενο έτος, ο φόρος του {Y} πέφτει από {$(a.total)} σε {$(bIns.total)}. Από το 2027 η ερώτηση παύει να έχει σημασία, αφού η κατοικία δεν θα πληρώνει τίποτα.</p>

  <h2>Από το 2027: πλήρης απαλλαγή</h2>
  <p>Η μείωση του {Y} είναι μεταβατική. Από το 2027 ισχύει η περίπτωση ια της παρ. 1 του άρθρου 10, που απαλλάσσει από τον φόρο την κύρια κατοικία με τους ίδιους όρους: φορολογικός κάτοικος Ελλάδας, οικισμός έως {F.villagePop} κατοίκων ή {F.villagePopBorder} στα παραμεθόρια, εκτός ηπειρωτικής Αττικής, αξία κατοικίας έως {F.villageValue}. Η διάταξη προβλέπει ότι η κύρια κατοικία θα προκύπτει από το Μητρώο Ιδιοκτησίας και Διαχείρισης Ακινήτων (ΜΙΔΑ)· μέχρι να λειτουργήσει το μητρώο, το άρθρο 17 παρ. 5 κρατά ως κριτήριο τη δήλωση φορολογίας εισοδήματος του προηγούμενου έτους.</p>
  <p>Όσοι αναζητούν «ενφια χωρια» ή «enfia xoria» ρωτούν συχνά αν πρέπει να κάνουν αίτηση. Η ίδια η διάταξη δεν προβλέπει αίτηση· ορίζει ότι απόφαση του Διοικητή της ΑΑΔΕ μπορεί να ορίσει δικαιολογητικά και διαδικασία. Αυτό που μπορείτε να κάνετε από τώρα είναι να βεβαιωθείτε ότι η δήλωση φορολογίας γράφει σωστά την κύρια κατοικία σας. Για τον υπόλοιπο λογαριασμό του φόρου, ο <a href={route('enfia', lang)}>υπολογιστής ΕΝΦΙΑ</a> έχει την επιλογή «οικισμός έως {F.villagePop}», και ο οδηγός για την <a href={route('enfiadisc', lang)}>έκπτωση ΕΝΦΙΑ</a> δείχνει πώς η μείωση του χωριού συνδυάζεται με τις άλλες. Αν θέλετε να ελέγξετε και τα οικονομικά του νοικοκυριού, ο <a href={route('home', lang)}>υπολογισμός μισθού</a> δίνει τα καθαρά σας.</p>
</GuideLayout>
