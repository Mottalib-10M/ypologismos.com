---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { enfia, PARAMS as P } from '../../lib/engine/gr';
import { ENFIA_RECON_MIN_SQM as RM, ENFIA_INS_MIN_MONTHS as MIN_M } from '../../lib/mini-extra-e';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const E = P.enfia;
const Y = P.year;
// Διαμέρισμα 95 m² σε τιμή ζώνης 1.900 €, άδεια 2003, 3ος όροφος, μία πρόσοψη.
const flat = { sqm: 95, zonePrice: 1900, buildYear: 2003, floor: 'f2_3' as const, facades: 1 };
const r0 = enfia(flat), r1 = enfia({ ...flat, insured: true });
const monthsRows = [0, 2, MIN_M, 6, 9, 12].map((m) => { const rate = m < MIN_M ? 0 : E.insurance_reduction * m / 12; return [m === 0 ? 'Καθόλου' : `${m} μήνες`, F.pct(rate), $(r0.total * rate), $(r0.total * (1 - rate))]; });
const sizeRows = [50, 75, 95, 120, 150].map((s) => [`${s} m²`, $(s * RM), $(enfia({ ...flat, sqm: s }).total * E.insurance_reduction)]);
// Ακριβό ακίνητο πάνω από το όριο: 150 m², ζώνη 4.800 €, άδεια 2018.
const lux = { sqm: 150, zonePrice: 4800, buildYear: 2018, floor: 'f6_up' as const, facades: 2 };
const l0 = enfia(lux), l1 = enfia({ ...lux, insured: true });
const sept = E.insurance_reduction * 4 / 12;
const faqs = [
  { q: 'Πόσο μειώνει τον ΕΝΦΙΑ μια ασφάλεια σπιτιού;', a: `${F.insurance} του φόρου της κατοικίας, αν η φορολογητέα αξία της δεν ξεπερνά τις ${$(E.insurance_value_limit)}, και ${F.insuranceHigh} πάνω από εκεί. Για ένα διαμέρισμα ${flat.sqm} m² σε τιμή ζώνης ${$(flat.zonePrice)}, με άδεια του ${flat.buildYear}, ο ΕΝΦΙΑ πέφτει από ${$(r0.total)} σε ${$(r1.total)}, εφόσον το σπίτι ήταν ασφαλισμένο όλο το προηγούμενο έτος για σεισμό, πυρκαγιά και πλημμύρα.` },
  { q: 'Αρκεί ένα συμβόλαιο μόνο για πυρκαγιά;', a: `Όχι. Το άρθρο 10 παρ. 5 του Κώδικα Φορολογίας Περιουσίας ζητά ασφάλιση για σεισμό, πυρκαγιά και πλημμύρα, και οι τρεις κίνδυνοι μαζί. Ένα βασικό συμβόλαιο πυρός, ή ένα συμβόλαιο που καλύπτει σεισμό αλλά όχι πλημμύρα, δεν δίνει την έκπτωση των ${F.insurance}. Ζητήστε από τον ασφαλιστή να σας επιβεβαιώσει γραπτά ότι περιλαμβάνονται και οι τρεις.` },
  { q: 'Ασφάλισα το σπίτι τον Σεπτέμβριο. Παίρνω έκπτωση;', a: `Στον ΕΝΦΙΑ του επόμενου έτους, ναι, αναλογικά. Η ασφάλιση πρέπει να αφορά το προηγούμενο έτος και να διαρκεί τουλάχιστον ${MIN_M} μήνες· από τον Σεπτέμβριο ως τον Δεκέμβριο είναι τέσσερις. Η μείωση γίνεται ${F.pct(sept)} αντί για ${F.insurance}. Στο διαμέρισμα των ${flat.sqm} m² αυτό σημαίνει περίπου ${$(r0.total * sept)} λιγότερο φόρο.` },
  { q: 'Η ασφάλεια που ζήτησε η τράπεζα για το στεγαστικό μετράει;', a: `Μετράει, αν πληροί τους ίδιους όρους: σεισμός, πυρκαγιά και πλημμύρα, ασφαλιστική εγγεγραμμένη στο μητρώο της Τράπεζας της Ελλάδος και κεφάλαιο που καλύπτει όλη την αξία ανακατασκευής, τουλάχιστον ${$(RM)} ανά τετραγωνικό. Αν το συμβόλαιο του δανείου ασφαλίζει μικρότερο κεφάλαιο, για παράδειγμα μόνο το ποσό του δανείου, η έκπτωση δεν δικαιολογείται.` },
  { q: 'Πόσο κεφάλαιο πρέπει να γράφει το συμβόλαιο για 95 τετραγωνικά;', a: `Τουλάχιστον ${$(95 * RM)}, δηλαδή ${flat.sqm} m² × ${$(RM)}. Ο νόμος παίρνει ως αξία του ακινήτου την αξία ανακατασκευής του κτίσματος, χωρίς το οικόπεδο, και ορίζει ότι δεν μπορεί να είναι κάτω από ${$(RM)} το τετραγωνικό. Υπουργική απόφαση καθορίζει το κόστος ανακατασκευής και μπορεί να αναπροσαρμόσει αυτό το ελάχιστο ποσό.` },
  { q: 'Ισχύει η έκπτωση και για το εξοχικό;', a: `Η διάταξη μιλά για «κατοικίες φυσικών προσώπων» χωρίς να ζητά να είναι κύρια κατοικία, οπότε και ένα εξοχικό που ασφαλίζεται με τους ίδιους όρους μπορεί να πάρει ${F.insurance}. Κάθε κατοικία κρίνεται μόνη της: αν έχετε δύο σπίτια, χρειάζεστε κάλυψη για καθένα. Οι νομικές οντότητες και οι εταιρείες δεν καλύπτονται από αυτή την παράγραφο.` },
];
---
<GuideLayout lang={lang} id="enfiains" breadcrumbLabel={label('enfiains', lang)}
  title={`ΕΝΦΙΑ και ασφάλιση κατοικίας ${Y}: έκπτωση ${F.insurance} ή ${F.insuranceHigh}`}
  h1={`Ασφάλιση κατοικίας και ΕΝΦΙΑ: πότε κερδίζετε ${F.insurance} και πόσο`}
  description={`ΕΝΦΙΑ ${Y} με ασφάλιση κατοικίας: έκπτωση ${F.insurance} (${F.insuranceHigh} άνω των ${$(E.insurance_value_limit)}) για σεισμό, πυρκαγιά, πλημμύρα, κεφάλαιο από ${$(RM)}/m², αναλογικά από ${MIN_M} μήνες.`}
  intro={`Ένα συμβόλαιο που καλύπτει σωστά το σπίτι κόβει τον ΕΝΦΙΑ της επόμενης χρονιάς, αρκεί να πληροί τέσσερις όρους του νόμου.`}
  resume={`Η κατοικία που ήταν ασφαλισμένη το προηγούμενο έτος για σεισμό, πυρκαγιά και πλημμύρα πληρώνει ${F.insurance} λιγότερο ΕΝΦΙΑ, αν η φορολογητέα αξία της είναι έως ${$(E.insurance_value_limit)}, και ${F.insuranceHigh} λιγότερο πάνω από αυτό το ποσό, σύμφωνα με το άρθρο 10 παρ. 5 του Κώδικα Φορολογίας Περιουσίας. Το συμβόλαιο πρέπει να έχει γίνει σε ασφαλιστική εγγεγραμμένη στο μητρώο της Τράπεζας της Ελλάδος και να καλύπτει ολόκληρη την αξία ανακατασκευής του κτίσματος, χωρίς το οικόπεδο, η οποία δεν λογίζεται κάτω από ${$(RM)} ανά τετραγωνικό. Η κάλυψη πρέπει να έχει διαρκέσει τουλάχιστον ${MIN_M} μήνες μέσα στο προηγούμενο έτος· αν διήρκεσε λιγότερο από δώδεκα, η έκπτωση μειώνεται αναλογικά. Για ένα διαμέρισμα ${flat.sqm} m² σε τιμή ζώνης ${$(flat.zonePrice)}, ο φόρος πέφτει από ${$(r0.total)} σε ${$(r1.total)}, και το συμβόλαιο πρέπει να γράφει κεφάλαιο τουλάχιστον ${$(flat.sqm * RM)}. Οι δύο μίνι υπολογιστές ελέγχουν την έκπτωση και το κεφάλαιο.`}
  faqs={faqs}
  related={[{ href: route('enfia', lang), name: label('enfia', lang), description: 'Ο υπολογισμός του φόρου με την επιλογή «ασφαλισμένη κατοικία».' }, { href: route('enfiadisc', lang), name: label('enfiadisc', lang), description: 'Πώς η ασφάλιση συνδυάζεται με τη μείωση λόγω αξίας.' }, { href: route('enfiavillage', lang), name: label('enfiavillage', lang), description: `Η μείωση ${F.village} για κύρια κατοικία σε μικρό οικισμό.` }]}
  sources={[src('enfia_exemptions', lang), src('enfia', lang), src('enfia_reductions', lang)]}>
  <div data-chrome><MiniSim client:load kind="enfiains" lang={lang} href={route('enfia', lang)} /></div>

  <h2>Οι τέσσερις όροι του άρθρου 10 παρ. 5</h2>
  <p>Ο πρώτος όρος αφορά τους κινδύνους: σεισμός, πυρκαγιά και πλημμύρα, και οι τρεις. Ο δεύτερος την εταιρεία: πρέπει να είναι ασφαλιστική επιχείρηση εγγεγραμμένη στο μητρώο που τηρεί η Διεύθυνση Εποπτείας Ιδιωτικής Ασφάλισης της Τράπεζας της Ελλάδος. Ο τρίτος το κεφάλαιο: η ασφάλιση πρέπει να καλύπτει το σύνολο της αξίας του ακινήτου, και ως αξία λογίζεται η αξία ανακατασκευής του κτίσματος, όχι η εμπορική τιμή και όχι το οικόπεδο. Ο τέταρτος τον χρόνο: η κάλυψη αφορά το προηγούμενο έτος και διαρκεί τουλάχιστον {MIN_M} μήνες.</p>
  <p>Αν λείπει έστω ένας, η έκπτωση χάνεται ολόκληρη. Δεν υπάρχει ενδιάμεση λύση για ένα συμβόλαιο που καλύπτει το μισό κεφάλαιο ή μόνο δύο από τους τρεις κινδύνους. Γι' αυτό ο έλεγχος του συμβολαίου γίνεται καλύτερα πριν από την ανανέωση, όχι όταν έρθει το εκκαθαριστικό.</p>

  <h2>{F.insurance} ή {F.insuranceHigh}: το όριο των {$(E.insurance_value_limit)}</h2>
  <p>Το ποσοστό εξαρτάται από τη φορολογητέα αξία της ίδιας της κατοικίας για τον ΕΝΦΙΑ. Έως {$(E.insurance_value_limit)} η μείωση είναι {F.insurance}, πάνω από αυτό {F.insuranceHigh}. Στο διαμέρισμα των {flat.sqm} m² η αξία είναι περίπου {$(r0.valueUsed)}, άρα η έκπτωση κόβει {$(r0.total - r1.total)}. Ένα ρετιρέ 150 m² σε τιμή ζώνης {$(lux.zonePrice)}, με άδεια του 2018 και δύο προσόψεις, έχει εκτιμώμενη αξία {$(l0.valueUsed)}: παίρνει μόνο {F.pct(l1.insuranceRate)}, αλλά επειδή ο φόρος του είναι μεγάλος, γλιτώνει {$(l0.total - l1.total)}, από {$(l0.total)} σε {$(l1.total)}. Προσοχή σε ένα σημείο: ο νόμος κρίνει το όριο με την αξία της ίδιας της κατοικίας, ενώ ο υπολογιστής μας χρησιμοποιεί την αξία που λαμβάνει υπόψη για όλο τον λογαριασμό· αν έχετε συμπληρώσει τη συνολική αξία πολλών ακινήτων, ελέγξτε το όριο με την αξία του σπιτιού μόνο.</p>

  <h2>Λιγότερο από ένα έτος: η αναλογική έκπτωση</h2>
  <ContentTable headers={['Ασφάλιση στο προηγούμενο έτος', 'Έκπτωση', 'Λιγότερος φόρος', `ΕΝΦΙΑ ${Y}`]} align={['l', 'r', 'r', 'r']} rows={monthsRows} highlightRow={5} />
  <p>Ο πίνακας εφαρμόζει τον κανόνα στο διαμέρισμα των {flat.sqm} m². Κάτω από {MIN_M} μήνες η έκπτωση είναι μηδέν· από εκεί και πέρα, το {F.insurance} πολλαπλασιάζεται με τους μήνες κάλυψης διά δώδεκα. Ο νόμος γράφει ότι η μείωση «προσαρμόζεται αναλογικά» όταν η ασφάλιση είναι μικρότερη του έτους· η αναλογία ανά μήνα είναι ο τρόπος που την εφαρμόζει ο υπολογιστής μας, ενώ το άρθρο δεν ορίζει αν η διάρκεια μετριέται σε μήνες ή σε ημέρες.</p>
  <p>Ένα συχνό σενάριο: κάποιος αγοράζει σπίτι τον Ιούνιο και το ασφαλίζει την ίδια μέρα. Τον πρώτο χρόνο δεν οφείλει ΕΝΦΙΑ για αυτό, γιατί ο φόρος κοιτάζει ποιος είχε το ακίνητο την 1η Ιανουαρίου. Τον δεύτερο χρόνο ο ΕΝΦΙΑ έρχεται με έκπτωση για επτά μήνες ασφάλισης, και από τον τρίτο με ολόκληρο το {F.insurance}.</p>

  <h2>Πόσο κεφάλαιο χρειάζεται</h2>
  <ContentTable headers={['Εμβαδόν', `Ελάχιστο κεφάλαιο (${$(RM)}/m²)`, 'Έκπτωση ΕΝΦΙΑ ολόκληρου έτους']} align={['l', 'r', 'r']} rows={sizeRows} highlightRow={2} />
  <p>Ο νόμος ορίζει ελάχιστο {$(RM)} ανά τετραγωνικό για την αξία ανακατασκευής. Ένα συμβόλαιο με κεφάλαιο κάτω από τα τετραγωνικά × {$(RM)} θεωρείται ότι δεν καλύπτει όλη την αξία. Η τρίτη στήλη δείχνει τι κερδίζετε τον χρόνο για διαμερίσματα με τα ίδια χαρακτηριστικά με το παράδειγμα· συγκρίνετέ το με το ασφάλιστρο, για να δείτε πόσο από το κόστος της ασφάλειας επιστρέφει ο φόρος.</p>
  <p>Η ίδια παράγραφος επιτρέπει στον Υπουργό Εθνικής Οικονομίας και Οικονομικών, μετά από εισήγηση του Διοικητή της ΑΑΔΕ, να καθορίζει το κόστος ανακατασκευής και να αναπροσαρμόζει το ελάχιστο ποσό. Αν αλλάξει, ο υπολογιστής θα ακολουθήσει.</p>

  <div data-chrome><MiniSim client:load kind="insrecon" lang={lang} href={route('enfia', lang)} /></div>

  <h2>Τέσσερα σημεία να κοιτάξετε στο συμβόλαιο</h2>
  <p>Ανοίξτε το ασφαλιστήριο στη σελίδα των καλύψεων και ψάξτε πρώτα το κεφάλαιο του κτιρίου, χωριστά από το περιεχόμενο· αυτό συγκρίνεται με τα τετραγωνικά × {$(RM)}. Μετά τη λίστα κινδύνων: ο σεισμός μπορεί να είναι πρόσθετη κάλυψη με δικό της ασφάλιστρο, και η πλημμύρα μπορεί να εμφανίζεται με άλλη ονομασία, οπότε ζητήστε επιβεβαίωση. Τρίτο, τις ημερομηνίες έναρξης και λήξης, που καθορίζουν πόσοι μήνες του προηγούμενου έτους μετράνε. Τέταρτο, την επωνυμία της ασφαλιστικής, που πρέπει να είναι εγγεγραμμένη στο μητρώο της Τράπεζας της Ελλάδος· ένας πράκτορας ή μεσίτης δεν αρκεί αν η ίδια η εταιρεία δεν είναι εγγεγραμμένη. Αν κάποιο από τα τέσσερα δεν είναι σαφές, ένα γραπτό από τον ασφαλιστή σας γλιτώνει από αμφισβητήσεις.</p>

  <h2>Τι δεν μετράει για την έκπτωση</h2>
  <p>Η διάταξη μιλά για κατοικίες. Ένα κατάστημα, ένα γραφείο ή μια αποθήκη που ασφαλίζονται για τους ίδιους κινδύνους δεν μειώνουν τον ΕΝΦΙΑ τους με αυτή την παράγραφο, ούτε τα ακίνητα εταιρειών. Το ίδιο ισχύει για την ασφάλιση περιεχομένου: τα έπιπλα και οι συσκευές δεν είναι το κτίσμα, και το κεφάλαιο που μετρά είναι εκείνο του κτιρίου. Το οικόπεδο εξαιρείται ρητά από την αξία που πρέπει να καλύπτεται.</p>
  <p>Ένα παλιό πέτρινο σπίτι στο χωριό παρουσιάζει μια παγίδα. Η εμπορική του αξία μπορεί να είναι χαμηλή, αλλά το ελάχιστο κεφάλαιο ορίζεται ανά τετραγωνικό, όχι ανά ηλικία: για 120 m² χρειάζεται κάλυψη τουλάχιστον {$(120 * RM)}, όσο και για ένα καινούργιο σπίτι ίδιου μεγέθους. Αν ο ΕΝΦΙΑ του σπιτιού είναι μικρός, η έκπτωση των {F.insurance} μπορεί να είναι λίγα ευρώ, οπότε το συμβόλαιο αξίζει για την προστασία του σπιτιού και λιγότερο για τον φόρο.</p>
  <p>Στο αντίθετο άκρο, ένα συμβόλαιο για σεισμό, πυρκαγιά και πλημμύρα που ανανεώνεται χρόνια με το ίδιο κεφάλαιο μπορεί να χάσει την έκπτωση, αν το κεφάλαιο αυτό υπολείπεται των τετραγωνικών × {$(RM)}. Ένας έλεγχος στην επόμενη ανανέωση λύνει το πρόβλημα για την επόμενη χρονιά.</p>

  <h2>Πώς μπαίνει στον υπόλοιπο λογαριασμό</h2>
  <p>Η έκπτωση ασφάλισης δεν αντικαθιστά τη μείωση λόγω συνολικής αξίας του άρθρου 13· εφαρμόζεται πάνω στο ποσό που έχει μείνει μετά από αυτήν. Στο παράδειγμά μας, ο κύριος φόρος {$(r0.principal)} μειώνεται πρώτα κατά {F.pct(r0.valueReductionRate)} λόγω αξίας και μετά κατά {F.insurance} λόγω ασφάλισης. Έτσι η συνολική μείωση είναι {F.pct(1 - r1.total / r1.principal)}, όχι {F.pct(r0.valueReductionRate + E.insurance_reduction)}. Το ίδιο ισχύει αν προστεθεί και η μείωση των μικρών οικισμών, που εξηγεί ο οδηγός για τον <a href={route('enfiavillage', lang)}>ΕΝΦΙΑ στα χωριά</a>.</p>
  <p>Για τη συνολική εικόνα, περάστε το σπίτι στον <a href={route('enfia', lang)}>υπολογιστή ΕΝΦΙΑ</a> με την επιλογή «Ασφαλισμένη κατοικία». Όσοι συγκρίνουν το κόστος της ασφάλειας με τον μισθό τους μπορούν να δουν τα καθαρά τους στον <a href={route('home', lang)}>υπολογισμό μισθού</a>· και αν έχετε κι άλλα ακίνητα, ο οδηγός για την <a href={route('enfiadisc', lang)}>έκπτωση ΕΝΦΙΑ</a> δείχνει πώς κρίνεται η μείωση λόγω αξίας.</p>
</GuideLayout>
