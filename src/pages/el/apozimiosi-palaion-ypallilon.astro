---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { severance, extra2012Months, PARAMS as P } from '../../lib/engine/gr';
import { RETIRE_SHARE_AUX, RETIRE_SHARE_NO_AUX } from '../../lib/mini-extra-f';
import { formatMoney, formatDecimal } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const d = (x: number) => formatDecimal(x, 2, lang);
const S = P.severance;
const up = 1 + S.holiday_uplift;
const from = S.extra_2012_from_years, maxX = S.extra_2012_max_months, capX = S.extra_2012_salary_cap;
const topYears = from + maxX - 1;
const baseM = S.table_months[S.table_months.length - 1].months;
const rows = Array.from({ length: maxX }, (_, k) => from + k).map((y) => { const x = extra2012Months(y); return [y === topYears ? `${y} και άνω` : `${y}`, `+${x}`, d(x * up), $(capX * x * up)]; });
const pays = [1600, 2000, 2800, 4000];
const cmp = pays.map((g) => { const a = severance({ pay: g, years: 31, yearsAt2012: 18 }), b = severance({ pay: g, years: 31, yearsAt2012: 24 }); return [$(g), $(a.total), $(b.total), $(severance({ pay: g, years: 31 }).total)]; });
const ex = severance({ pay: 2800, years: 36, yearsAt2012: 22 });
const exBase = 2800 * baseM * up, exExtra = ex.extra * up;
const lowPay = severance({ pay: 1700, years: 33, yearsAt2012: 19 });
const max = severance({ pay: 3000, years: 40, yearsAt2012: 30 });
const retFull = 2800 * (baseM + extra2012Months(22)) * up;
const faqs = [
  { q: 'Προσλήφθηκα στην ίδια εταιρεία τον Μάρτιο του 1994. Δικαιούμαι τους επιπλέον μισθούς;', a: `Ναι. Στις 12 Νοεμβρίου 2012 είχατε συμπληρώσει 18 έτη στον ίδιο εργοδότη, άρα είστε πάνω από το όριο των ${from}. Ο πρόσθετος πίνακας δίνει ${extra2012Months(18)} επιπλέον μισθούς για 18 έτη, που προστίθενται στους ${baseM} του κανονικού πίνακα. Ο μισθός για τους επιπλέον μήνες μετράει έως ${$(capX)}, και στο σύνολο εφαρμόζεται η προσαύξηση 1/6.` },
  { q: `Ο μισθός μου είναι ${$(3500)}. Με ποιο ποσό υπολογίζονται οι επιπλέον μισθοί;`, a: `Με ${$(capX)}. Για την πρόσθετη αποζημίωση ο νόμος λαμβάνει υπόψη τις τακτικές αποδοχές του τελευταίου μήνα πλήρους απασχόλησης που δεν υπερβαίνουν τα ${$(capX)}. Οι ${baseM} μισθοί του κανονικού πίνακα υπολογίζονται όμως με τον πραγματικό σας μισθό, μέχρι το γενικό όριο των ${F.sevCap}. Έτσι, κάθε επιπλέον μήνας σάς αποδίδει ${$(capX * up)} με την προσαύξηση.` },
  { q: 'Από το 2012 έχω δουλέψει άλλα 13 χρόνια. Γιατί οι επιπλέον μισθοί δεν αυξήθηκαν;', a: `Γιατί η ρύθμιση τους «πάγωσε». Σύμφωνα με την ερμηνευτική εγκύκλιο 26352/839/2012, η υπηρεσία μετά τις 12 Νοεμβρίου 2012 δεν προσμετράται στην πρόσθετη αποζημίωση. Ο αριθμός μένει όσος ήταν εκείνη την ημέρα, οποτεδήποτε κι αν γίνει η απόλυση. Τα χρόνια μετά το 2012 μετράνε μόνο στον κανονικό πίνακα, που όμως έχει ήδη φτάσει στους ${baseM} μισθούς.` },
  { q: 'Αν αποχωρήσω για σύνταξη, κρατάω τους επιπλέον μισθούς;', a: `Ναι, μέσα στη μειωμένη αποζημίωση της συνταξιοδότησης. Όποιος φεύγει επειδή θεμελίωσε πλήρη σύνταξη γήρατος παίρνει ${F.pct(RETIRE_SHARE_AUX)} της πλήρους αποζημίωσης με επικουρική ασφάλιση ή ${F.pct(RETIRE_SHARE_NO_AUX)} χωρίς. Στην περίπτωση αυτή, κατά την Επιθεώρηση Εργασίας, το όριο των ${$(capX)} δεν εφαρμόζεται· μετράει μόνο ο χρόνος που είχατε στις 12.11.2012.` },
  { q: 'Ποιο είναι το μέγιστο που μπορεί να πάρει ένας παλαιός υπάλληλος;', a: `${baseM + maxX} μισθούς: ${baseM} από τον κανονικό πίνακα και ${maxX} από τον πρόσθετο, για όσους είχαν ${topYears} έτη και πάνω το 2012. Με μισθό ${$(3000)}, οι πρώτοι υπολογίζονται με ${$(3000)} και οι δεύτεροι με ${$(capX)}, οπότε μαζί με το 1/6 η αποζημίωση χωρίς προειδοποίηση φτάνει ${$(max.total)}.` },
];
---
<GuideLayout lang={lang} id="sevold" breadcrumbLabel={label('sevold', lang)}
  title={`Αποζημίωση παλαιών υπαλλήλων ${F.year}: 17ετία και όριο ${$(capX)}`}
  h1={`Αποζημίωση παλαιών υπαλλήλων ${F.year}: οι επιπλέον μισθοί όσων είχαν 17 χρόνια το 2012`}
  description={`Αποζημίωση παλαιών υπαλλήλων ${F.year}: +1 έως +${maxX} μισθοί για ${from} έως ${topYears} έτη στις 12.11.2012, μισθός έως ${$(capX)}, παγωμένοι. Πίνακας και αποχώρηση για σύνταξη.`}
  intro={`Η μεταβατική ρύθμιση του ν. 4093/2012 για όσους είχαν τουλάχιστον ${from} χρόνια στον ίδιο εργοδότη στις 12 Νοεμβρίου 2012.`}
  resume={`Όσοι στις 12 Νοεμβρίου 2012 είχαν συμπληρώσει τουλάχιστον ${from} έτη στον ίδιο εργοδότη παίρνουν, όποτε κι αν απολυθούν, επιπλέον αποζημίωση πάνω από τους ${baseM} μισθούς του κανονικού πίνακα: έναν μισθό στα ${from} έτη, δύο στα ${from + 1}, και έναν ακόμη για κάθε έτος ως τους ${maxX} μισθούς στα ${topYears} έτη και πάνω. Ο αριθμός έχει παγώσει σε εκείνη την ημερομηνία, άρα τα χρόνια μετά το 2012 δεν τον αυξάνουν. Για τους επιπλέον μήνες ο μισθός μετράει έως ${$(capX)}, ενώ οι ${baseM} κανονικοί μισθοί υπολογίζονται με τον πραγματικό μισθό ως το γενικό όριο των ${F.sevCap}. Στο σύνολο προστίθεται 1/6. Για παράδειγμα, με 22 έτη το 2012, 36 σήμερα και μισθό ${$(2800)}, η αποζημίωση χωρίς προειδοποίηση είναι ${$(ex.total)}: ${$(exBase)} από τον κανονικό πίνακα και ${$(exExtra)} από τους ${ex.extraMonths} επιπλέον μισθούς. Η ρύθμιση αφορά όσους είχαν προσληφθεί έως τις 12 Νοεμβρίου 1995 και δουλεύουν ακόμη στον ίδιο εργοδότη.`}
  faqs={faqs}
  related={[{ href: route('severance', lang), name: label('severance', lang), description: 'Ο υπολογιστής δέχεται τα έτη σας στις 12.11.2012.' }, { href: route('sevtable', lang), name: label('sevtable', lang), description: 'Ο κανονικός πίνακας ως τους 12 μισθούς.' }, { href: route('retireage', lang), name: label('retireage', lang), description: 'Πότε θεμελιώνεται σύνταξη, αν σκέφτεστε αποχώρηση.' }]}
  sources={[src('severance_faq', lang), src('severance', lang), src('law_3198_5', lang)]}>
  <div data-chrome><MiniSim client:load kind="sevold" lang={lang} href={route('severance', lang)} /></div>

  <h2>Ο πρόσθετος πίνακας της 12ης Νοεμβρίου 2012</h2>
  <ContentTable headers={['Έτη στις 12.11.2012', 'Επιπλέον μισθοί', 'Σε μισθούς με το 1/6', `Ποσό με μισθό ${$(capX)} και άνω`]} align={['l', 'r', 'r', 'r']} rows={rows} />
  <p>Ο πίνακας αυτός δεν αντικαθιστά τον κανονικό· προστίθεται σε αυτόν. Τον δημοσιεύει το Υπουργείο Εργασίας στις συχνές ερωτήσεις του, κάτω από τον τίτλο «επιπλέον αποζημίωση», και αφορά μόνο ιδιωτικούς υπαλλήλους με σύμβαση αορίστου χρόνου που την ημέρα δημοσίευσης του ν. 4093/2012 είχαν τον απαιτούμενο χρόνο στον ίδιο εργοδότη. Η τελευταία στήλη είναι το ανώτατο που μπορεί να δώσει κάθε γραμμή, αφού ο μισθός των επιπλέον μηνών σταματά στα {$(capX)}. Με χαμηλότερο μισθό το ποσό είναι αναλογικά μικρότερο.</p>

  <h2>Γιατί ο αριθμός «πάγωσε»</h2>
  <p>Ο ν. 4093/2012 έβαλε ως ανώτατο του πίνακα τους {baseM} μισθούς. Για όσους είχαν ήδη πολλά χρόνια πρόσθεσε μια μεταβατική ρύθμιση, που όμως «φωτογράφισε» την κατάσταση εκείνης της ημέρας. Η ερμηνευτική εγκύκλιος 26352/839 της 28ης Νοεμβρίου 2012 το λέει ρητά: η υπηρεσία που διανύεται μετά τις 12 Νοεμβρίου 2012 δεν προσμετράται για την πρόσθετη αποζημίωση.</p>
  <p>Στην πράξη αυτό δημιουργεί δύο μετρητές. Ο πρώτος, τα συνολικά έτη στον εργοδότη, συνεχίζει να τρέχει, αλλά για τους παλαιούς υπαλλήλους έχει ήδη φτάσει στο ταβάνι των {baseM} μισθών. Ο δεύτερος, τα έτη στις 12.11.2012, είναι σταθερός για πάντα. Όποιος είχε 16 χρόνια και 11 μήνες εκείνη την ημέρα δεν μπήκε ποτέ στη ρύθμιση, όσα χρόνια κι αν δουλέψει έκτοτε.</p>

  <h2>Πόσο αλλάζει το σύνολο ανάλογα με τον μισθό</h2>
  <ContentTable headers={['Μισθός', '18 έτη το 2012', '24 έτη το 2012', 'Χωρίς τη ρύθμιση']} align={['l', 'r', 'r', 'r']} rows={cmp} highlightRow={2} />
  <p>Ο πίνακας αφορά εργαζόμενο με 31 χρόνια σήμερα στον ίδιο εργοδότη, απόλυση χωρίς προειδοποίηση. Η τελευταία στήλη δείχνει τι θα έπαιρνε κάποιος με τα ίδια χρόνια που προσλήφθηκε αργότερα και δεν καλύπτεται. Μέχρι τα {$(capX)} η απόσταση ανάμεσα στις στήλες μεγαλώνει με τον μισθό· πάνω από αυτό, οι επιπλέον μισθοί μένουν σταθεροί σε ευρώ και μόνο οι {baseM} κανονικοί ακολουθούν τον μισθό. Με {$(1700)} μισθό, 19 χρόνια το 2012 και 33 σήμερα, το σύνολο είναι {$(lowPay.total)}.</p>

  <h2>Ένα πλήρες παράδειγμα</h2>
  <p>Μια λογίστρια προσλήφθηκε τον Σεπτέμβριο του 1990. Στις 12 Νοεμβρίου 2012 είχε 22 συμπληρωμένα χρόνια, άρα δικαιούται {extra2012Months(22)} επιπλέον μισθούς. Σήμερα έχει 36 χρόνια και μισθό {$(2800)}. Ο κανονικός πίνακας δίνει {baseM} μισθούς με τον πραγματικό μισθό, δηλαδή {$(2800 * baseM)}. Οι {ex.extraMonths} επιπλέον μισθοί υπολογίζονται με {$(capX)}, άρα {$(ex.extra)}. Το άθροισμα αυξάνεται κατά 1/6 και φτάνει {$(ex.total)}.</p>
  <p>Αν η ίδια εργαζόμενη αποφάσιζε να φύγει επειδή θεμελίωσε πλήρη σύνταξη, θα έπαιρνε {F.pct(RETIRE_SHARE_AUX)} ή {F.pct(RETIRE_SHARE_NO_AUX)} της αποζημίωσης, ανάλογα με το αν έχει επικουρική ασφάλιση. Εκεί όμως η Επιθεώρηση Εργασίας διευκρινίζει ότι το όριο των {$(capX)} δεν εφαρμόζεται, οπότε η βάση είναι {$(retFull)} και τα ποσά {$(retFull * RETIRE_SHARE_AUX)} ή {$(retFull * RETIRE_SHARE_NO_AUX)}.</p>

  <div data-chrome><MiniSim client:load kind="sevretire" lang={lang} href={route('severance', lang)} /></div>

  <h2>Αποχώρηση αντί για απόλυση</h2>
  <p>Για τους παλαιούς υπαλλήλους το ερώτημα συχνά δεν είναι η απόλυση αλλά η έξοδος προς τη σύνταξη. Ο μικρός υπολογιστής παραπάνω δείχνει τα δύο ποσοστά της αποχώρησης λόγω συνταξιοδότησης. Υπάρχει και τρίτος δρόμος, του άρθρου 8 του ν. 3198/1955: όποιος έχει 15 χρόνια στον ίδιο εργοδότη ή έχει φτάσει το όριο ηλικίας του ταμείου του, ή τα {F.fullAge} αν δεν υπάρχει όριο, μπορεί να αποχωρήσει με τη συγκατάθεση του εργοδότη και να πάρει το μισό της νόμιμης αποζημίωσης. Χωρίς τη συγκατάθεση αυτή δεν δικαιούται το ποσό. Πότε θεμελιώνεται σύνταξη εξηγεί η σελίδα για τα <a href={route('retireage', lang)}>όρια ηλικίας συνταξιοδότησης</a>.</p>

  <h2>Πώς να ελέγξετε το δικό σας ποσό</h2>
  <p>Χρειάζεστε τρία στοιχεία: την ημερομηνία πρόσληψης, τον μισθό του τελευταίου μήνα πλήρους απασχόλησης και το αν σας δόθηκε έγγραφη προειδοποίηση. Από την ημερομηνία πρόσληψης βγαίνουν τα έτη στις 12.11.2012· αν η πρόσληψη έγινε μετά τις 12 Νοεμβρίου 1995, η ρύθμιση δεν σας αφορά. Βάλτε τα στοιχεία στον <a href={route('severance', lang)}>υπολογιστή αποζημίωσης απόλυσης</a>, στο πεδίο «Έτη στον ίδιο εργοδότη στις 12.11.2012». Αν θέλετε να δείτε πώς στήνεται ο κανονικός πίνακας μέχρι τους {baseM} μισθούς, ο <a href={route('sevtable', lang)}>οδηγός του πίνακα αποζημίωσης</a> τον διαβάζει γραμμή προς γραμμή.</p>
</GuideLayout>
