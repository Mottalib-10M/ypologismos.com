---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { salary, christmasBonus, easterBonus, leaveAllowance, severance, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const $2 = (x: number) => formatMoney(x, 2, lang);
const d = P.minimum_wage.daily;
const B = P.bonuses;
const days = [16, 18, 20, 22, 24, 25, 26].map((n) => { const s = salary({ gross: d * n }); return [String(n), $(d * n), $(s.efka), $(s.tax), $(s.net), $2(s.net / n)]; });
const s25 = salary({ gross: d * 25 }), s22 = salary({ gross: d * 22 });
const xm = christmasBonus({ pay: d, daily: true }), ea = easterBonus({ pay: d, daily: true }), lv = leaveAllowance({ pay: d, daily: true });
const bon = [d, 45, 50, 60, 75].map((w) => [$2(w), $(christmasBonus({ pay: w, daily: true }).amount), $(easterBonus({ pay: w, daily: true }).amount), $(leaveAllowance({ pay: w, daily: true }).amount)]);
const part = christmasBonus({ pay: d, daily: true, days: 95 });
const sev5 = severance({ pay: d, daily: true, years: 5 }), sev12 = severance({ pay: 55, daily: true, years: 12 });
const yearGross = d * 25 * 12 + xm.amount + ea.amount + lv.amount;
const faqs = [
  { q: 'Πόσο είναι το κατώτατο ημερομίσθιο το 2026;', a: `Από την 1η Απριλίου ${F.year} το κατώτατο ημερομίσθιο είναι ${F.minDaily} μικτά, μαζί με την αύξηση του κατώτατου μισθού σε ${F.minWage}. Για 25 ημέρες εργασίας τον μήνα αυτό σημαίνει ${$(d * 25)} μικτά και ${$(s25.net)} καθαρά, για 22 ημέρες ${$(d * 22)} μικτά και ${$(s22.net)} καθαρά, για εργαζόμενο άνω των 30 χωρίς παιδιά.` },
  { q: 'Με ημερομίσθιο, πόσα ημερομίσθια είναι το δώρο Χριστουγέννων;', a: `Το δώρο Χριστουγέννων των ημερομισθίων είναι ${F.xmasDaily} ημερομίσθια για όλη την περίοδο 1/5 έως 31/12, και το δώρο Πάσχα ${F.easterDaily} ημερομίσθια για 1/1 έως 30/4. Με το κατώτατο ημερομίσθιο, και μαζί με την αναλογία επιδόματος αδείας, τα δύο δώρα φτάνουν ${$(xm.amount)} και ${$(ea.amount)} μικτά. Το επίδομα αδείας είναι έως ${F.leaveDaily} ημερομίσθια, ${$(lv.amount)}.` },
  { q: 'Γιατί στην αποζημίωση ο μήνας του εργατοτεχνίτη μετράει 22 ημερομίσθια;', a: `Επειδή έτσι ορίζει το ενιαίο καθεστώς που ισχύει από 1/1/2022, όταν ο ν. 4808/2021 κατάργησε τη διάκριση υπαλλήλων και εργατοτεχνιτών στην απόλυση. Η αποζημίωση υπολογίζεται σε μισθούς, όπως για τους υπαλλήλους, και ο μισθός του ημερομίσθιου λογίζεται ως ${F.sevDailyMonth} ημερομίσθια, προσαυξημένα με το 1/6 για δώρα και επίδομα αδείας.` },
  { q: 'Ξεκίνησα με ημερομίσθιο τον Σεπτέμβριο. Τι δώρο θα πάρω τα Χριστούγεννα;', a: `Αναλογία: 2 ημερομίσθια για κάθε 19 ημέρες σχέσης εργασίας από την πρόσληψη ως τις 31/12, και κλάσμα για το υπόλοιπο. Για 95 ημέρες με το κατώτατο ημερομίσθιο, η βάση είναι ${$(part.base)} και μαζί με την αναλογία επιδόματος αδείας ${$(part.amount)} μικτά. Δεν μετρούν οι αδικαιολόγητες απουσίες, η απεργία και η άδεια άνευ αποδοχών.` },
  { q: 'Πόσα βγάζω τον χρόνο με το κατώτατο ημερομίσθιο;', a: `Με 25 ημέρες τον μήνα για δώδεκα μήνες, τα δύο δώρα και το επίδομα αδείας, το σύνολο είναι περίπου ${$(yearGross)} μικτά, περισσότερα από τα ${$(P.minimum_wage.monthly * 14)} των 14 κατώτατων μισθών ενός υπαλλήλου. Η διαφορά υπάρχει επειδή 25 ημερομίσθια, ${$(d * 25)}, ξεπερνούν τον μηνιαίο κατώτατο των ${F.minWage}.` },
];
---
<GuideLayout lang={lang} id="daily" breadcrumbLabel={label('daily', lang)}
  title={`Ημερομίσθιο ${F.year}: κατώτατο ${F.minDaily}, μηνιαία καθαρά και δώρα`}
  h1={`Ημερομίσθιο ${F.year}: από τα ${F.minDaily} στα μηνιαία καθαρά`}
  description={`Ημερομίσθιο ${F.year}: κατώτατο ${F.minDaily} από 1/4. Μετατροπή σε μηνιαία καθαρά ανά ημέρες εργασίας, δώρο Χριστουγέννων ${F.xmasDaily}, Πάσχα ${F.easterDaily} και επίδομα αδείας ${F.leaveDaily} ημερομίσθια.`}
  intro={`Το κατώτατο ημερομίσθιο είναι ${F.minDaily} μικτά από την 1η Απριλίου ${F.year}, και σε αυτό μετρώνται και τα δώρα του εργατοτεχνίτη.`}
  resume={`Το κατώτατο ημερομίσθιο του ${F.year} είναι ${F.minDaily} μικτά για κάθε ημέρα εργασίας, από την 1η Απριλίου. Ο μηνιαίος μισθός ενός ημερομίσθιου εξαρτάται από τις ημέρες που δούλεψε: με 25 ημέρες βγαίνουν ${$(d * 25)} μικτά και ${$(s25.net)} καθαρά, με 22 ημέρες ${$(d * 22)} μικτά και ${$(s22.net)} καθαρά, για εργαζόμενο άνω των 30 χωρίς παιδιά. Τα δώρα δεν υπολογίζονται σε μηνιάτικα αλλά σε ημερομίσθια: ${F.xmasDaily} για το δώρο Χριστουγέννων, ${F.easterDaily} για το δώρο Πάσχα και έως ${F.leaveDaily} για το επίδομα αδείας. Με το κατώτατο, αυτό δίνει ${$(xm.amount)}, ${$(ea.amount)} και ${$(lv.amount)} μικτά, τα δύο δώρα μαζί με την αναλογία του επιδόματος αδείας. Στην αποζημίωση απόλυσης, από το 2022 ισχύει ο ίδιος πίνακας με τους υπαλλήλους και ο μήνας του ημερομίσθιου λογίζεται ως ${F.sevDailyMonth} ημερομίσθια. Ο υπολογιστής παρακάτω μετατρέπει οποιοδήποτε ημερομίσθιο σε μηνιαία καθαρά.`}
  faqs={faqs}
  related={[{ href: route('minimum', lang), name: label('minimum', lang), description: `Ο μηνιαίος κατώτατος ${F.minWage} για τους υπαλλήλους.` }, { href: route('sevworkers', lang), name: label('sevworkers', lang), description: 'Η αποζημίωση με βάση τα 22 ημερομίσθια.' }, { href: route('christmas', lang), name: label('christmas', lang), description: `Δώρο Χριστουγέννων και τα ${F.xmasDaily} ημερομίσθια.` }]}
  sources={[src('min_wage', lang), src('hli_christmas', lang), src('hli_easter', lang), src('hli_bonuses', lang), src('law_4808_64', lang)]}>
  <div data-chrome><MiniSim client:load kind="daily" lang={lang} href={route('home', lang)} /></div>

  <h2>Μηνιαία καθαρά ανάλογα με τις ημέρες εργασίας</h2>
  <ContentTable headers={['Ημέρες τον μήνα', 'Μικτά', 'ΕΦΚΑ', 'Φόρος', 'Καθαρά τον μήνα', 'Καθαρά ανά ημέρα']} align={['l', 'r', 'r', 'r', 'r', 'r']} rows={days} highlightRow={5} />
  <p>Ο πίνακας χρησιμοποιεί το κατώτατο ημερομίσθιο και τον ίδιο υπολογισμό με τη μισθοδοσία: μικτά του μήνα, κρατήσεις e-ΕΦΚΑ {F.efkaEe}, φόρος με την κλίμακα του {F.year} και τη μείωση του άρθρου 16 ΚΦΕ, θεωρώντας ότι ο μήνας επαναλαμβάνεται όλο τον χρόνο μαζί με τα δώρα. Τα «καθαρά ανά ημέρα» πέφτουν ελαφρά όσο αυξάνονται οι ημέρες, επειδή το υψηλότερο ετήσιο εισόδημα περνά σε κλιμάκιο με μεγαλύτερο συντελεστή, ενώ οι εισφορές μένουν σταθερό ποσοστό.</p>
  <p>Για όποιον δουλεύει σε εξαήμερη βάση, οι 25 ή 26 ημέρες είναι ο συνηθισμένος μήνας· σε πενθήμερη, οι 21 με 22. Ο υπολογιστής παραπάνω δέχεται τον δικό σας αριθμό ημερών, οπότε μπορείτε να βάλετε τις ημέρες που δείχνει το εκκαθαριστικό του προηγούμενου μήνα.</p>

  <h2>Ποιοι αμείβονται με ημερομίσθιο</h2>
  <p>Το ημερομίσθιο είναι ο παραδοσιακός τρόπος αμοιβής των εργατοτεχνιτών: εργαζόμενοι σε οικοδομές, αποθήκες, γεωργικές εργασίες, εστίαση, καθαριότητα, βιοτεχνίες. Οι υπάλληλοι γραφείου και καταστημάτων αμείβονται συνήθως με μηνιαίο μισθό. Η διάκριση έχει πια μικρότερη νομική σημασία απ' ό,τι παλιότερα, γιατί από το 2022 οι κανόνες της απόλυσης είναι ενιαίοι, παραμένει όμως καθοριστική για το πώς μετρώνται οι αποδοχές του μήνα και τα δώρα.</p>
  <p>Η βασική διαφορά για τον εργαζόμενο είναι ότι ο ημερομίσθιος πληρώνεται για τις ημέρες που δουλεύει. Ένας μήνας με αργίες ή λιγότερες βάρδιες φέρνει λιγότερα χρήματα, ενώ ο υπάλληλος με μηνιαίο μισθό παίρνει το ίδιο ποσό. Γι' αυτό ο προγραμματισμός ενός νοικοκυριού με ημερομίσθιο καλό είναι να γίνεται με τον πιο αδύναμο μήνα του χρόνου και όχι με τον μέσο όρο.</p>

  <h2>Δώρα και επίδομα αδείας σε ημερομίσθια</h2>
  <ContentTable headers={['Ημερομίσθιο', `Δώρο Χριστουγέννων (${F.xmasDaily})`, `Δώρο Πάσχα (${F.easterDaily})`, `Επίδομα αδείας (έως ${F.leaveDaily})`]} align={['r', 'r', 'r', 'r']} rows={bon} highlightRow={0} />
  <p>Τα ποσά των δύο δώρων περιλαμβάνουν την αναλογία του επιδόματος αδείας ({F.leaveShare}), όπως τα υπολογίζει η Επιθεώρηση Εργασίας. Σε εξαήμερη εργασία, {F.xmasDaily} ημερομίσθια είναι περίπου ένας μήνας και {F.leaveDaily} περίπου μισός, οπότε τα ποσά πλησιάζουν όσα παίρνει ο υπάλληλος σε μηνιάτικα.</p>
  <p>Αν η σχέση εργασίας δεν κάλυψε όλη την περίοδο, τα δώρα δίνονται αναλογικά: 2 ημερομίσθια για κάθε 19 ημέρες στο δώρο Χριστουγέννων, 1 ημερομίσθιο για κάθε 8 ημέρες στο δώρο Πάσχα, και κλάσμα για τις ημέρες που περισσεύουν. Για τις λεπτομέρειες, όπως ποιες απουσίες αφαιρούνται, δείτε τις σελίδες για το <a href={route('christmas', lang)}>δώρο Χριστουγέννων</a> και το <a href={route('easter', lang)}>δώρο Πάσχα</a>.</p>

  <div data-chrome><MiniSim client:load kind="dailybonus" lang={lang} href={route('christmas', lang)} /></div>

  <h2>Η αποζημίωση απόλυσης του ημερομίσθιου</h2>
  <p>Ο ν. 4808/2021 (άρθρο 64) ενοποίησε από 1/1/2022 το καθεστώς απόλυσης υπαλλήλων και εργατοτεχνιτών. Ο εργατοτεχνίτης παίρνει πλέον αποζημίωση σε μισθούς, με τον ίδιο πίνακα ετών υπηρεσίας, και ο μισθός του υπολογίζεται ως {F.sevDailyMonth} ημερομίσθια, συν 1/6 για τα δώρα και το επίδομα αδείας. Με το κατώτατο ημερομίσθιο και πέντε χρόνια στον ίδιο εργοδότη, χωρίς προειδοποίηση, η αποζημίωση είναι {$(sev5.total)}. Με ημερομίσθιο {$2(55)} και δώδεκα χρόνια φτάνει τα {$(sev12.total)}.</p>
  <p>Προσέξτε ότι το {F.sevDailyMonth} της αποζημίωσης διαφέρει από τα {F.xmasDaily} του δώρου Χριστουγέννων. Είναι δύο διαφορετικοί κανόνες για δύο διαφορετικές πληρωμές, και η σύγχυσή τους είναι από τα πιο συνηθισμένα λάθη στους πρόχειρους υπολογισμούς. Ο <a href={route('sevworkers', lang)}>οδηγός για την αποζημίωση των εργατοτεχνιτών</a> εξηγεί τον κανόνα αναλυτικά.</p>

  <div data-chrome><MiniSim client:load kind="sevworkers" lang={lang} href={route('severance', lang)} /></div>

  <h2>Το ημερομίσθιο στο εκκαθαριστικό</h2>
  <p>Στο εκκαθαριστικό ενός ημερομίσθιου εμφανίζονται οι ημέρες εργασίας, το ημερομίσθιο και το γινόμενό τους, και από κάτω οι κρατήσεις. Οι εισφορές e-ΕΦΚΑ είναι {F.efkaEe} του μικτού, όπως για όλους τους μισθωτούς του ΚΠΚ {F.kpk}, και ο φόρος υπολογίζεται με αναγωγή του μήνα σε ετήσιο. Ελέγξτε ότι οι ημέρες ταιριάζουν με όσες δουλέψατε και ότι το ημερομίσθιο δεν είναι κάτω από {F.minDaily}. Για τα καθαρά με ηλικία και παιδιά, βάλτε το μηνιαίο μικτό στον κύριο <a href={route('home', lang)}>υπολογισμό μισθού</a>.</p>
</GuideLayout>
