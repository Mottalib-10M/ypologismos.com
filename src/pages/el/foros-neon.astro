---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { salary, incomeTax, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const T = P.tax;
const M = P.minimum_wage;
// Μέγιστο όφελος ανά ηλικία (σε εισόδημα αρκετά πάνω από το όριο των νέων).
const far = T.brackets[3].upTo as number;
const plateau = (k: number) => ({ u25: incomeTax(far, k).tax - incomeTax(far, k, 'u25').tax, mid: incomeTax(far, k).tax - incomeTax(far, k, '26_30').tax });
const g0 = plateau(0), g1 = plateau(1), g2 = plateau(2);
// Μισθοί του πίνακα.
const grosses = [M.monthly, 1100, 1300, 1500, 1800, 2000, 2500, 3000];
const rows = grosses.map((g) => { const o = salary({ gross: g }), m = salary({ gross: g, age: '26_30' }), y = salary({ gross: g, age: 'u25' }); return [$(g), $(o.taxAnnual), $(m.taxAnnual), $(y.taxAnnual), $(o.taxAnnual - m.taxAnnual), $(o.taxAnnual - y.taxAnnual)]; });
// Παραδείγματα.
const s1300 = salary({ gross: 1300 }), y1300 = salary({ gross: 1300, age: 'u25' }), m1300 = salary({ gross: 1300, age: '26_30' });
const y2000 = salary({ gross: 2000, age: 'u25' });
const y2500 = salary({ gross: 2500, age: 'u25' });
const minY = salary({ gross: M.monthly, age: 'u25' }), minO = salary({ gross: M.monthly });
// Μηνιαίος μικτός που αντιστοιχεί περίπου στο όριο των 20.000 € φορολογητέου (14 καταβολές).
const edgeGross = T.youth_income_limit / (14 * (1 - P.efka.employee_rate));
const s1500 = salary({ gross: 1500 }), y1500 = salary({ gross: 1500, age: 'u25' }), m1500 = salary({ gross: 1500, age: '26_30' });
const yearsU25 = 4, years2630 = 5;
const path = yearsU25 * (s1500.taxAnnual - y1500.taxAnnual) + years2630 * (s1500.taxAnnual - m1500.taxAnnual);
const keepYoung = 100 * (1 - P.efka.employee_rate), keepOld = 100 * (1 - P.efka.employee_rate) * (1 - (s1500.marginal + T.credit_taper_per_1000 / 1000));
const m4 = salary({ gross: 1800, age: '26_30', children: 4 }), m3 = salary({ gross: 1800, age: '26_30', children: 3 });
const faqs = [
  { q: 'Γίνομαι 26 μέσα στη χρονιά. Χάνω αμέσως τον μηδενικό συντελεστή;', a: `Ο ν. 5246/2025 μιλά για φορολογούμενους «έως 25 ετών» και «από 26 έως 30 ετών», χωρίς να εξηγεί στο ίδιο σημείο αν μετρά η ημερομηνία ή το έτος γέννησης. Η διαφορά για όποιον αλλάζει ομάδα είναι ο συντελεστής ${F.youthU25} ή ${F.youth2630} στα πρώτα ${F.youthLimit}. Μέχρι να διευκρινιστεί, ζητήστε από το λογιστήριο να σας πει ποια ηλικία δήλωσε στη μισθοδοσία.` },
  { q: `Είμαι 24 με μικτά ${$(1300)} τον μήνα. Πόσα περισσότερα παίρνω;`, a: `Με 14 καταβολές το φορολογητέο σας είναι ${$(s1300.taxableAnnual)}, ολόκληρο μέσα στο όριο των ${F.youthLimit}. Ο φόρος μηδενίζεται και τα καθαρά ανεβαίνουν στα ${$(y1300.net)} ανά καταβολή, έναντι ${$(s1300.net)} για συνάδελφο άνω των 30. Η διαφορά είναι ${$(s1300.taxAnnual)} τον χρόνο, όσος θα ήταν ο φόρος σας χωρίς τη ρύθμιση.` },
  { q: `Η έκπτωση των νέων ισχύει για όλο το εισόδημα ή μόνο έως ${F.youthLimit};`, a: `Μόνο για τα δύο πρώτα κλιμάκια, δηλαδή έως ${F.youthLimit} φορολογητέο. Ό,τι υπερβαίνει το όριο φορολογείται κανονικά με ${F.r[2]}, ${F.r[3]} κ.ο.κ. Ένας 23χρονος με μικτά ${$(2500)} πληρώνει έτσι ${$(y2500.taxAnnual)} φόρο τον χρόνο: τίποτα για τα πρώτα ${F.youthLimit} και κανονικό φόρο για τα υπόλοιπα, από τον οποίο αφαιρείται και η μείωση του άρθρου 16.` },
  { q: 'Είμαι 28 με τέσσερα παιδιά. Ποιος συντελεστής υπερισχύει;', a: `Ο ευνοϊκότερος. Ο νόμος ορίζει ρητά ότι για ηλικίες 26 έως 30 ο συντελεστής ${F.youth2630} δεν εφαρμόζεται όταν ισχύει η διάταξη για τέσσερα παιδιά, οπότε τα δύο πρώτα κλιμάκια φορολογούνται με μηδέν. Με μικτά ${$(1800)} τον μήνα, ο ετήσιος φόρος σας είναι ${$(m4.taxAnnual)}, έναντι ${$(m3.taxAnnual)} αν είχατε τρία παιδιά.` },
  { q: 'Πρέπει να κάνω αίτηση για να πάρω τη μείωση των νέων;', a: `Ο εργοδότης γνωρίζει την ηλικία σας από τα στοιχεία της πρόσληψης και εφαρμόζει τον μειωμένο συντελεστή στην παρακράτηση κάθε μήνα. Αν για κάποιο λόγο δεν το έκανε, ο φόρος υπολογίζεται σωστά στην ετήσια δήλωση και το ποσό που παρακρατήθηκε επιπλέον επιστρέφεται με την εκκαθάριση. Ελέγξτε ότι ο φόρος στο εκκαθαριστικό μισθοδοσίας είναι μηδέν, αν είστε έως 25 με φορολογητέο κάτω από ${F.youthLimit}.` },
];
---
<GuideLayout lang={lang} id="youth" breadcrumbLabel={label('youth', lang)}
  title={`Φόρος εισοδήματος νέων ${F.year}: ${F.youthU25} έως 25, ${F.youth2630} έως 30 ετών`}
  h1={`Φόρος εισοδήματος για νέους έως 30 ετών το ${F.year}`}
  description={`Φόρος εισοδήματος ${F.year} για νέους: ${F.youthU25} έως 25 ετών και ${F.youth2630} από 26 έως 30, στα πρώτα ${F.youthLimit} φορολογητέο. Πόσα περισσότερα καθαρά μένουν ανά μισθό, με πίνακα.`}
  intro={`Από το ${F.year} οι φορολογούμενοι έως 25 ετών δεν πληρώνουν φόρο στα πρώτα ${F.youthLimit} του εισοδήματός τους, και όσοι είναι 26 έως 30 πληρώνουν ${F.youth2630}.`}
  resume={`Με τον ν. 5246/2025, οι νέοι έως 25 ετών φορολογούνται με ${F.youthU25} στα δύο πρώτα κλιμάκια της κλίμακας, δηλαδή στα πρώτα ${F.youthLimit} του φορολογητέου εισοδήματος, ενώ από 26 έως 30 ετών ο συντελεστής των ίδιων κλιμακίων είναι ${F.youth2630} αντί για ${F.r[0]} και ${F.r[1]}. Πάνω από ${F.youthLimit} ισχύει η κανονική κλίμακα. Στην πράξη, ένας 24χρονος με ${$(1300)} μικτά τον μήνα δεν πληρώνει καθόλου φόρο και κρατά ${$(y1300.net)} ανά καταβολή αντί για ${$(s1300.net)}, ενώ ένας 28χρονος με τον ίδιο μισθό πληρώνει ${$(m1300.taxAnnual)} τον χρόνο αντί για ${$(s1300.taxAnnual)}. Το μέγιστο ετήσιο όφελος χωρίς παιδιά είναι ${$(g0.u25)} έως 25 ετών και ${$(g0.mid)} από 26 έως 30, και το πιάνει όποιος έχει φορολογητέο αρκετά πάνω από το όριο. Με τέσσερα παιδιά τα δύο κλιμάκια μηδενίζονται σε κάθε ηλικία. Ο υπολογιστής δείχνει τι κερδίζετε στον δικό σας μισθό.`}
  faqs={faqs}
  related={[{ href: route('home', lang), name: label('home', lang), description: 'Καθαρά από τον μικτό, με την ηλικία σας.' }, { href: route('brackets', lang), name: label('brackets', lang), description: 'Όλα τα κλιμάκια και οι συντελεστές του ' + F.year + '.' }, { href: route('minimum', lang), name: label('minimum', lang), description: `Ο κατώτατος των ${F.minWage} χωρίς φόρο έως 25.` }]}
  sources={[src('tax_scale', lang), src('tax_credit', lang), src('efka_rates', lang), src('min_wage', lang)]}>
  <div data-chrome><MiniSim client:load kind="youth" lang={lang} href={route('home', lang)} /></div>

  <h2>Πόσος φόρος ανά μισθό και ηλικία</h2>
  <ContentTable headers={['Μικτά τον μήνα', 'Φόρος άνω των 30', 'Φόρος 26-30', 'Φόρος έως 25', 'Όφελος 26-30', 'Όφελος έως 25']} align={['l', 'r', 'r', 'r', 'r', 'r']} rows={rows} highlightRow={2} />
  <p>Οι φόροι είναι ετήσιοι, για 14 καταβολές και χωρίς εξαρτώμενα τέκνα. Η πρώτη γραμμή είναι ο κατώτατος μισθός των {F.minWage}: ένας εργαζόμενος έως 25 ετών δεν πληρώνει τίποτα και παίρνει {$(minY.net)} καθαρά, ενώ ένας 35χρονος στην ίδια θέση πληρώνει {$(minO.taxAnnual)} τον χρόνο. Όσο ανεβαίνει ο μισθός, το όφελος μεγαλώνει, μέχρι να ξεπεραστεί το όριο των {F.youthLimit} φορολογητέου, που αντιστοιχεί σε περίπου {$(edgeGross)} μικτά τον μήνα. Από εκεί και πάνω σταθεροποιείται.</p>

  <h2>Γιατί το όφελος έχει ταβάνι</h2>
  <p>Η ρύθμιση δεν είναι γενική απαλλαγή. Αφορά δύο συγκεκριμένα κλιμάκια, το πρώτο του {F.r[0]} και το δεύτερο του {F.r[1]}, που μαζί καλύπτουν τα πρώτα {F.youthLimit}. Για όποιον είναι έως 25, το μέγιστο που μπορεί να γλιτώσει είναι όσο θα πλήρωνε σε αυτά τα δύο κλιμάκια χωρίς τη ρύθμιση: {$(g0.u25)} τον χρόνο. Για τις ηλικίες 26 έως 30, ο συντελεστής του δεύτερου κλιμακίου πέφτει στο {F.youth2630} και το πρώτο μένει ίδιο, οπότε το ταβάνι είναι {$(g0.mid)}.</p>
  <p>Με παιδιά τα ποσά μικραίνουν, όχι επειδή ο νέος χάνει κάτι, αλλά επειδή ο γονιός άνω των 30 έχει ήδη χαμηλότερο συντελεστή στο δεύτερο κλιμάκιο. Με ένα παιδί, το ταβάνι είναι {$(g1.u25)} έως 25 και {$(g1.mid)} από 26 έως 30· με δύο παιδιά {$(g2.u25)} και {$(g2.mid)}. Η σύγκριση γίνεται πάντα με κάποιον της ίδιας οικογενειακής κατάστασης.</p>

  <h2>Τι γίνεται πάνω από το όριο</h2>
  <p>Ένας νέος μηχανικός 25 ετών με μικτά {$(2000)} τον μήνα έχει φορολογητέο {$(y2000.taxableAnnual)}, λίγο πάνω από το όριο. Τα πρώτα {F.youthLimit} δεν φορολογούνται· το υπόλοιπο φορολογείται με το {F.r[2]} του τρίτου κλιμακίου. Από τον φόρο που προκύπτει αφαιρείται κανονικά η μείωση του άρθρου 16, μειωμένη λόγω εισοδήματος, και ο τελικός φόρος είναι {$(y2000.taxAnnual)} τον χρόνο. Είναι ένα από τα σημεία όπου η μείωση φόρου μισθωτών ξαναγίνεται χρήσιμη για νέους, αφού κάτω από το όριο δεν έχει φόρο να μειώσει.</p>
  <p>Αυτό σημαίνει επίσης ότι η μείωση των {F.credit[0]} «χάνεται» για όποιον μένει ολόκληρος κάτω από το όριο: δεν επιστρέφεται, δεν μεταφέρεται, απλώς δεν χρειάζεται. Όποιος ενδιαφέρεται για τον μηχανισμό της βρίσκει τα ποσά και το σημείο όπου μηδενίζεται στον οδηγό για τη <a href={route('credit', lang)}>μείωση φόρου μισθωτών</a>.</p>

  <div data-chrome><MiniSim client:load kind="youthage" lang={lang} href={route('home', lang)} /></div>

  <h2>Πόσο αξίζει μέχρι τα 30</h2>
  <p>Το όφελος δεν είναι μόνο ετήσιο. Πάρτε μια απόφοιτη που ξεκινά στα 22 με {$(1500)} μικτά τον μήνα και, για την απλότητα του παραδείγματος, κρατά τον ίδιο μισθό. Για {yearsU25} χρόνια, έως τα 25, γλιτώνει {$(s1500.taxAnnual - y1500.taxAnnual)} τον χρόνο. Για τα επόμενα {years2630}, από 26 έως 30, γλιτώνει {$(s1500.taxAnnual - m1500.taxAnnual)}. Συνολικά, μέχρι τα 30 της, μένουν στην τσέπη της περίπου {$(path)} που αλλιώς θα πήγαιναν σε φόρο, με την προϋπόθεση ότι η ρύθμιση θα παραμείνει σε ισχύ όλα αυτά τα χρόνια.</p>
  <p>Υπάρχει και ένα λιγότερο προφανές αποτέλεσμα: κάθε αύξηση αποδίδει περισσότερα καθαρά. Για έναν νέο έως 25 ετών που μένει κάτω από το όριο, από κάθε {$(100)} μικτής αύξησης κρατά {$(keepYoung)}, αφού φεύγουν μόνο οι εισφορές. Ένας συνάδελφός του άνω των 30 με τον ίδιο μισθό κρατά περίπου {$(keepOld)}, γιατί πληρώνει και τον συντελεστή του κλιμακίου και χάνει μέρος της μείωσης φόρου. Για μια πρώτη διαπραγμάτευση μισθού, η διαφορά είναι αισθητή.</p>

  <h2>Νέοι με παιδιά</h2>
  <p>Η διάταξη για τους νέους συνδυάζεται με τις μειώσεις για τέκνα με τον τρόπο που ευνοεί τον φορολογούμενο. Ένας γονιός 27 ετών με τρία παιδιά έχει συντελεστή {F.second[3]} στο δεύτερο κλιμάκιο λόγω των παιδιών, όσο δηλαδή και ο συντελεστής των νέων· με τέσσερα παιδιά ο νόμος ορίζει ρητά ότι υπερισχύει ο μηδενικός συντελεστής. Ο γονιός έως 25 ετών έχει ούτως ή άλλως {F.youthU25} στα δύο πρώτα κλιμάκια, και τα παιδιά του μετρούν στο τρίτο κλιμάκιο ({F.third[1]} με ένα, {F.third[2]} με δύο) και στη μείωση του άρθρου 16. Λεπτομέρειες για τα τέκνα στη σελίδα για τη <a href={route('children', lang)}>μείωση φόρου για παιδιά</a>.</p>

  <h2>Τρία λάθη που βλέπουμε συχνά</h2>
  <p>Το πρώτο είναι να θεωρεί κανείς ότι η ρύθμιση αφορά τις εισφορές. Δεν τις αφορά: ο νέος πληρώνει κανονικά {F.efkaEe} στον e-ΕΦΚΑ, και γι' αυτό τα καθαρά του δεν είναι ίσα με το μικτό. Το δεύτερο είναι να συγχέεται το όριο των {F.youthLimit} με τον μικτό μισθό. Μετρά το φορολογητέο, δηλαδή οι ετήσιες αποδοχές μετά τις εισφορές, μαζί με δώρα και επίδομα αδείας. Ένας μισθός {$(1500)} επί 14 είναι {$(1500 * 14)} μικτά, αλλά λιγότερο φορολογητέο.</p>
  <p>Το τρίτο αφορά όσους δουλεύουν σε δύο θέσεις ή έχουν και άλλα εισοδήματα. Κάθε εργοδότης εφαρμόζει τον μηδενικό συντελεστή μόνο στον δικό του μισθό. Αν το σύνολο ξεπεράσει το όριο, η διαφορά εμφανίζεται στην ετήσια εκκαθάριση, όπως εξηγεί ο οδηγός για την <a href={route('withholding', lang)}>παρακράτηση φόρου</a>. Όσοι ψάχνουν «φορος νεων» ή «μηδενικός φόρος για νέους» θα βρουν εδώ τα ποσά για κάθε μισθό· για ένα συγκεκριμένο ποσό, ο <a href={route('home', lang)}>υπολογισμός μισθού</a> με επιλογή ηλικίας δίνει την πλήρη ανάλυση.</p>
</GuideLayout>
