---
import ToolCalc from '../../components/calc/ToolCalc';
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { salary, grossForNet, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const Y = P.year;
const N = 1200;
const g0 = grossForNet(N), s0 = salary({ gross: g0 });
const g2 = grossForNet(N, { children: 2 }), s2 = salary({ gross: g2, children: 2 });
const gY = grossForNet(N, { age: 'u25' });
const g26 = grossForNet(N, { age: '26_30' });
const g12 = grossForNet(N, { payments: 12 });
const naive = N / (1 - P.efka.employee_rate);
const nets = [900, 1000, 1200, 1500, 1800, 2000, 2500, 3000];
const rows = nets.map((n) => [$(n), ...[0, 1, 2, 3].map((k) => $(grossForNet(n, { children: k })))]);
// Διαπραγμάτευση: από 1.500 € μικτά, πόσα μικτά για 150 € καθαρά παραπάνω.
const cur = salary({ gross: 1500 }); const want = grossForNet(cur.net + 150); const wantS = salary({ gross: want });
const n2000 = grossForNet(2000), n2100 = grossForNet(2100);
const faqs = [
  { q: `Θέλω ${$(N)} καθαρά τον μήνα. Πόσα μικτά να ζητήσω;`, a: `Χωρίς παιδιά και άνω των 30, ${$(g0)} μικτά σε 14 καταβολές. Από αυτά παρακρατούνται ${$(s0.efka)} εισφορές e-ΕΦΚΑ (${F.efkaEe}) και περίπου ${$(s0.tax)} φόρος ανά καταβολή. Με δύο εξαρτώμενα παιδιά αρκούν ${$(g2)}, και για νέο έως 25 ετών ${$(gY)}, επειδή τα δύο πρώτα κλιμάκια φορολογούνται με ${F.youthU25}. Ο εργοδότης θα πληρώσει συνολικά ${$(s0.cost)} ανά καταβολή.` },
  { q: `Γιατί δεν αρκεί να διαιρέσω τα καθαρά με ${F.dec(1 - P.efka.employee_rate, 4)};`, a: `Γιατί έτσι αφαιρείτε μόνο τις εισφορές του ${F.efkaEe} και ξεχνάτε τον φόρο. Για ${$(N)} καθαρά η απλή διαίρεση δίνει ${$(naive)}, ενώ τα σωστά μικτά είναι ${$(g0)}. Η διαφορά είναι ο φόρος εισοδήματος, που αυξάνεται κλιμακωτά και δεν είναι σταθερό ποσοστό. Ο υπολογιστής ψάχνει τα μικτά που, μετά από εισφορές, κλίμακα και μείωση φόρου, δίνουν ακριβώς τα καθαρά που θέλετε.` },
  { q: `Για ${$(100)} καθαρά παραπάνω, γιατί χρειάζονται πολύ περισσότερα μικτά;`, a: `Επειδή στους μεσαίους μισθούς κάθε επιπλέον ευρώ πληρώνει εισφορές ${F.efkaEe} και φόρο με τον οριακό συντελεστή, που για μισθό γύρω στα ${$(n2000)} μικτά είναι ${F.pct(salary({ gross: n2000 }).marginal)}. Για να ανέβουν τα καθαρά από ${$(2000)} σε ${$(2100)}, τα μικτά πρέπει να πάνε από ${$(n2000)} σε ${$(n2100)}, δηλαδή ${$(n2100 - n2000)} περισσότερα.` },
  { q: 'Αν η σύμβαση γράφει 12 μισθούς αντί για 14, πόσα μικτά χρειάζομαι;', a: `Περισσότερα ανά μήνα, γιατί δεν υπάρχουν δώρα και επίδομα αδείας να συμπληρώσουν το έτος. Για ${$(N)} καθαρά σε 12 καταβολές χρειάζονται ${$(g12)} μικτά, αντί για ${$(g0)} σε 14. Στον υπολογιστή αλλάζετε το πεδίο «καταβολές». Συγκρίνετε πάντα το ετήσιο σύνολο, όχι μόνο το μηνιαίο ποσό, όταν διαλέγετε ανάμεσα σε δύο προσφορές.` },
  { q: 'Ο εργοδότης μου προτείνει «καθαρό» μισθό. Τι γράφει η σύμβαση;', a: `Οι εισφορές, ο φόρος, τα δώρα και η αποζημίωση απόλυσης υπολογίζονται όλα πάνω στα μικτά. Αν συμφωνήσετε καθαρό ποσό, ζητήστε να γραφτεί και το αντίστοιχο μικτό, για παράδειγμα ${$(g0)} για ${$(N)} καθαρά. Αλλιώς, αν αλλάξει ο φόρος ή οι εισφορές, δεν θα είναι σαφές ποιος επωμίζεται τη διαφορά.` },
];
---
<GuideLayout lang={lang} id="nettogross" breadcrumbLabel={label('nettogross', lang)}
  title={`Καθαρά σε μικτά ${Y}: πόσο μικτό μισθό να ζητήσετε`}
  h1={`Από καθαρά σε μικτά: ο μισθός που πρέπει να ζητήσετε το ${Y}`}
  description={`Καθαρά σε μικτά ${Y}: για ${$(N)} καθαρά χρειάζονται ${$(g0)} μικτά σε 14 καταβολές, ${$(g2)} με δύο παιδιά. Με εισφορές ${F.efkaEe}, νέα κλίμακα και μείωση φόρου.`}
  intro={`Ξέρετε πόσα θέλετε να μπαίνουν στον λογαριασμό σας· ο υπολογιστής βρίσκει τα μικτά που πρέπει να γράφει η σύμβαση.`}
  resume={`Για να μπαίνουν ${$(N)} καθαρά σε κάθε μία από τις 14 καταβολές του ${Y}, ένας μισθωτός άνω των 30 χωρίς παιδιά χρειάζεται ${$(g0)} μικτά τον μήνα. Η διαφορά των ${$(g0 - N)} πηγαίνει σε εισφορές e-ΕΦΚΑ, ${$(s0.efka)} (${F.efkaEe} του μικτού), και σε φόρο εισοδήματος, περίπου ${$(s0.tax)} ανά καταβολή μετά τη μείωση φόρου του άρθρου 16. Με δύο εξαρτώμενα παιδιά τα μικτά πέφτουν στα ${$(g2)}, γιατί το δεύτερο κλιμάκιο φορολογείται με ${F.second[2]} και η μείωση φόρου μεγαλώνει, ενώ για νέο έως 25 ετών αρκούν ${$(gY)}. Η απλή διαίρεση με τις εισφορές θα έδινε ${$(naive)}, δηλαδή λιγότερα από όσα χρειάζεστε, γιατί αγνοεί τον φόρο. Αν η σύμβαση προβλέπει 12 καταβολές αντί για 14, για τα ίδια καθαρά χρειάζονται ${$(g12)}. Ο εργοδότης θα πληρώνει συνολικά ${$(s0.cost)} ανά καταβολή, μαζί με τις δικές του εισφορές.`}
  faqs={faqs}
  related={[{ href: route('home', lang), name: label('home', lang), description: 'Η αντίστροφη πορεία: από τα μικτά στα καθαρά.' }, { href: route('employer', lang), name: label('employer', lang), description: `Τι κοστίζει ο ίδιος μισθός στην επιχείρηση, με εισφορές ${F.efkaEr}.` }, { href: route('fourteen', lang), name: label('fourteen', lang), description: 'Γιατί ο μισθός πληρώνεται 14 φορές και πώς συγκρίνετε προσφορές.' }]}
  sources={[src('tax_scale', lang), src('tax_credit', lang), src('efka_rates', lang), src('efka_ceiling', lang)]}>
  <div data-outil><ToolCalc client:load kind="nettogross" lang={lang} methodHref={route('method', lang)} /></div>

  <h2>Πώς βρίσκει ο υπολογιστής τα μικτά</h2>
  <p>Δεν υπάρχει αντίστροφος τύπος για τον μισθό. Τα καθαρά προκύπτουν από τα μικτά μέσα από τέσσερα βήματα: εισφορές {F.efkaEe} έως το πλαφόν των {F.ceiling} τον μήνα, ετήσιο φορολογητέο επί 14, φόρος με την κλίμακα του ν. 5246/2025 ({F.r[0]} έως {F.r[5]}), και μείωση φόρου του άρθρου 16 που μικραίνει πάνω από {F.creditThreshold} φορολογητέου. Το τελευταίο βήμα κάνει τη σχέση ακανόνιστη. Ο υπολογιστής δοκιμάζει λοιπόν μικτά ποσά με διαδοχικές προσεγγίσεις, έως ότου ο κανονικός υπολογισμός να δώσει ακριβώς τα καθαρά που ζητήσατε, με ακρίβεια λεπτού.</p>
  <p>Γι' αυτό το αποτέλεσμα συμφωνεί πάντα με τον βασικό <a href={route('home', lang)}>υπολογισμό μισθού</a>: αν βάλετε εκεί τα μικτά που βρήκατε εδώ, θα δείτε τα καθαρά σας.</p>

  <h2>Πίνακας καθαρά σε μικτά ανά οικογενειακή κατάσταση</h2>
  <ContentTable headers={['Καθαρά ανά καταβολή', 'Χωρίς παιδιά', '1 παιδί', '2 παιδιά', '3 παιδιά']} align={['l', 'r', 'r', 'r', 'r']} rows={rows} highlightRow={2} />
  <p>Όλα τα ποσά αφορούν μισθωτό άνω των 30 ετών, με 14 καταβολές και χωρίς άλλα εισοδήματα. Στα χαμηλά καθαρά οι στήλες σχεδόν ταυτίζονται, γιατί ο φόρος είναι ήδη πολύ μικρός και τα παιδιά δεν έχουν τι να μειώσουν. Η απόσταση ανοίγει στη μέση της κλίμακας, όπου ο συντελεστής του δεύτερου κλιμακίου πέφτει από {F.second[0]} σε {F.second[3]} με τρία παιδιά και ο τρίτος από {F.third[0]} σε {F.third[3]}.</p>

  <h2>Η ηλικία αλλάζει τα μικτά που χρειάζεστε</h2>
  <p>Από το {Y}, ο φόρος των νέων είναι μικρότερος στα δύο πρώτα κλιμάκια, έως {F.youthLimit} φορολογητέου: {F.youthU25} έως 25 ετών και {F.youth2630} από 26 έως 30. Για τα ίδια {$(N)} καθαρά, ένας εργαζόμενος 24 ετών χρειάζεται {$(gY)} μικτά, ένας 28 ετών {$(g26)} και ένας 35 ετών {$(g0)}. Αυτό σημαίνει ότι η ίδια θέση με τον ίδιο μικτό μισθό αφήνει διαφορετικά καθαρά σε δύο συναδέλφους. Αν συγκρίνετε προσφορές με φίλους ή ρωτάτε «πόσα παίρνει» κάποιος άλλος, ζητήστε πάντα το μικτό. Λεπτομέρειες στον οδηγό για τον <a href={route('youth', lang)}>φόρο των νέων</a>.</p>

  <h2>Όταν διαπραγματεύεστε μια προσφορά ή μια αύξηση</h2>
  <p>Η πιο συχνή παγίδα είναι να ζητήσει κανείς «200 ευρώ αύξηση» χωρίς να πει αν εννοεί μικτά ή καθαρά. Για κάποιον με {$(cur.gross)} μικτά, που παίρνει {$(cur.net)} καθαρά, μια καθαρή αύξηση {$(150)} απαιτεί νέο μικτό {$(want)}, δηλαδή {$(want - cur.gross)} μικτά παραπάνω. Για την επιχείρηση αυτό σημαίνει {$((wantS.cost - cur.cost) * 14)} επιπλέον κόστος τον χρόνο. Αν ξέρετε αυτούς τους τρεις αριθμούς πριν από τη συζήτηση, ξέρετε και πόσο απέχει το αίτημά σας από αυτό που εννοεί ο εργοδότης όταν μιλά για «μικτά».</p>
  <p>Σε μια νέα προσφορά, μετατρέψτε τα πάντα σε ετήσια καθαρά. Ένα ποσό σε 12 καταβολές δεν συγκρίνεται με ένα σε 14, και ένα «πακέτο» ετήσιων μικτών πρέπει να διαιρεθεί με 14 πριν μπει στον υπολογιστή. Ο οδηγός για τους <a href={route('fourteen', lang)}>14 μισθούς</a> εξηγεί αναλυτικά τη μετατροπή.</p>

  <div data-chrome><MiniSim client:load kind="raiseask" lang={lang} href={route('nettogross', lang)} /></div>

  <h2>Τι δεν λαμβάνει υπόψη</h2>
  <p>Ο υπολογισμός αφορά μισθωτούς του ιδιωτικού τομέα με το γενικό πακέτο κάλυψης ΚΠΚ {F.kpk} του e-ΕΦΚΑ. Δεν περιλαμβάνει άλλα εισοδήματα, που θα άλλαζαν τον φόρο της χρονιάς, ούτε παροχές σε είδος, βαρέα και ανθυγιεινά ή ειδικά ταμεία. Ο φόρος μοιράζεται ισόποσα στις καταβολές του έτους, όπως κάνει η μισθοδοσία με την παρακράτηση· η τελική εκκαθάριση της δήλωσης μπορεί να διαφέρει λίγο, αν το εισόδημα άλλαξε μέσα στη χρονιά. Πάνω από το πλαφόν των {F.ceiling} οι εισφορές σταματούν να αυξάνονται, και ο υπολογιστής το εφαρμόζει αυτόματα.</p>
</GuideLayout>
