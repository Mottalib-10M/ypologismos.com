---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { nationalPension, PARAMS as P } from '../../lib/engine/gr';
import { REDUCED_NATIONAL_PER_MONTH } from '../../lib/mini-extra-f';
import { formatMoney, pct } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $2 = (x: number) => formatMoney(x, 2, lang);
const p = (x: number) => pct(x, lang);
const Q = P.pension;
const full = Q.national_full, yFull = Q.national_years_full, yMin = Q.national_min_years, rFull = Q.residence_years_full;
const ins = Array.from({ length: yFull - yMin + 1 }, (_, k) => yMin + k).map((y) => [`${y}`, p(nationalPension(y) / full), $2(nationalPension(y)), $2(full - nationalPension(y))]);
const resList = [15, 20, 25, 30, 35, 40];
const res = resList.map((r) => [`${r}`, $2(nationalPension(yFull, r)), $2(nationalPension(17, r)), $2(nationalPension(yMin, r))]);
const r28 = nationalPension(yFull, 28), y17 = nationalPension(17);
const early24 = nationalPension(yFull) * (1 - 24 * REDUCED_NATIONAL_PER_MONTH);
const maxEarly = (Q.full_age - Q.reduced_age) * 12;
const earlyMax = nationalPension(yFull) * (1 - maxEarly * REDUCED_NATIONAL_PER_MONTH);
const faqs = [
  { q: 'Έχω 17 χρόνια ένσημα. Παίρνω ολόκληρη την εθνική σύνταξη;', a: `Όχι. Ολόκληρη δίνεται με ${yFull} έτη ασφάλισης. Για κάθε έτος που λείπει μειώνεται κατά ${p(Q.national_reduction_per_year)}, άρα με 17 έτη παίρνετε ${p(y17 / full)} του πλήρους ποσού, δηλαδή ${$2(y17)} τον μήνα με βάση το ποσό του 2025, αν έχετε και ${rFull} έτη διαμονής. Τρία επιπλέον χρόνια ασφάλισης θα πρόσθεταν ${$2(full - y17)} τον μήνα.` },
  { q: 'Έζησα 12 χρόνια στο εξωτερικό. Μειώνεται η εθνική μου σύνταξη;', a: `Ναι, αν τα χρόνια αυτά πέφτουν ανάμεσα στο 15ο έτος της ηλικίας σας και το όριο συνταξιοδότησης. Το άρθρο 7 μειώνει το ποσό κατά 1/40 για κάθε έτος που λείπει από τα ${rFull} έτη μόνιμης και νόμιμης διαμονής. Με 28 έτη διαμονής και ${yFull} ασφάλισης, η εθνική σύνταξη είναι ${$2(r28)} αντί για ${$2(full)}. Κάτω από 15 έτη διαμονής, η εθνική σύνταξη γήρατος δεν καταβάλλεται.` },
  { q: 'Παίρνω δύο συντάξεις από διαφορετικά ταμεία. Δικαιούμαι δύο εθνικές;', a: `Όχι, σε σώρευση συντάξεων δίνεται μία εθνική σύνταξη (άρθρο 7 παράγραφος 5). Αν η μία κύρια σύνταξη είναι πλήρης και η άλλη μειωμένη, η εθνική καταβάλλεται πλήρης. Αν είναι και οι δύο μειωμένες, καταβάλλεται το ποσοστό που αντιστοιχεί σε καθεμία, εφόσον το άθροισμα δεν ξεπερνά το πλήρες ποσό των ${F.nationalFull}.` },
  { q: 'Η εθνική σύνταξη πληρώνεται από τις εισφορές μου;', a: `Όχι. Σύμφωνα με το Υπουργείο Εργασίας, η εθνική σύνταξη δεν χρηματοδοτείται από ασφαλιστικές εισφορές αλλά απευθείας από τον κρατικό προϋπολογισμό. Γι' αυτό το ποσό της δεν εξαρτάται από τον μισθό σας, μόνο από τα έτη ασφάλισης και διαμονής. Οι εισφορές σας χρηματοδοτούν το ανταποδοτικό μέρος, που υπολογίζεται με τον μέσο μισθό και τα ποσοστά του άρθρου 8.` },
  { q: 'Αν βγω στη σύνταξη 2 χρόνια νωρίτερα, πόσο χάνω από την εθνική;', a: `Στη μειωμένη σύνταξη η εθνική σύνταξη κόβεται κατά 1/200 για κάθε μήνα που λείπει ως το όριο της πλήρους. Δύο χρόνια είναι 24 μήνες, δηλαδή μείωση ${p(24 * REDUCED_NATIONAL_PER_MONTH)}: από ${$2(nationalPension(yFull))} πέφτει στα ${$2(early24)}. Η περικοπή αυτή μένει για όλη τη διάρκεια της σύνταξης.` },
];
---
<GuideLayout lang={lang} id="national" breadcrumbLabel={label('national', lang)}
  title={`Εθνική σύνταξη ${F.year}: ${F.nationalFull} πλήρης, μειώσεις ανά έτος`}
  h1={`Εθνική σύνταξη ${F.year}: ποσό, έτη ασφάλισης, διαμονή και μειώσεις`}
  description={`Εθνική σύνταξη ${F.year}: ${F.nationalFull} πλήρης με ${yFull} έτη ασφάλισης και ${rFull} διαμονής, −${p(Q.national_reduction_per_year)} ανά έτος έως τα ${yMin}, −1/40 ανά έτος διαμονής. Πίνακες και δωρεάν υπολογισμός.`}
  intro={`Το σταθερό κομμάτι της κύριας σύνταξης, όπως το ορίζει το άρθρο 7 του ν. 4387/2016.`}
  resume={`Η εθνική σύνταξη είναι το σταθερό μέρος κάθε κύριας σύνταξης του e-ΕΦΚΑ, ανεξάρτητο από τον μισθό. Το πλήρες ποσό είναι ${F.nationalFull} τον μήνα από 1.1.2025, το τελευταίο που έχει δημοσιεύσει το Υπουργείο Εργασίας· αναπροσαρμόζεται κάθε χρόνο, οπότε το ποσό του ${F.year} μπορεί να είναι λίγο υψηλότερο. Καταβάλλεται ακέραιο με ${yFull} έτη ασφάλισης και ${rFull} έτη μόνιμης διαμονής στην Ελλάδα, μετρημένα από το 15ο έτος της ηλικίας ως το όριο συνταξιοδότησης. Για κάθε έτος ασφάλισης κάτω από τα ${yFull} χάνεται ${p(Q.national_reduction_per_year)}, ως τα ${yMin} έτη, όπου το ποσό είναι ${F.national15}. Για κάθε έτος διαμονής κάτω από τα ${rFull} χάνεται 1/40, και κάτω από 15 έτη διαμονής η εθνική σύνταξη γήρατος δεν δίνεται. Στη μειωμένη σύνταξη κόβεται επιπλέον 1/200 για κάθε μήνα πριν από το όριο της πλήρους: με ${maxEarly} μήνες νωρίτερα, η πλήρης εθνική πέφτει στα ${$2(earlyMax)}. Η εθνική σύνταξη χρηματοδοτείται από τον κρατικό προϋπολογισμό, όχι από εισφορές.`}
  faqs={faqs}
  related={[{ href: route('pension', lang), name: label('pension', lang), description: 'Εθνική και ανταποδοτική μαζί, με τον μέσο μισθό σας.' }, { href: route('retireage', lang), name: label('retireage', lang), description: 'Τα 67, τα 62 και η μειωμένη σύνταξη.' }, { href: route('uniformed', lang), name: label('uniformed', lang), description: 'Τι ισχύει για δημοσίους υπαλλήλους και στρατιωτικούς.' }]}
  sources={[src('pension_national', lang), src('pension_ministry', lang), src('pension', lang)]}>
  <div data-chrome><MiniSim client:load kind="national" lang={lang} href={route('pension', lang)} /></div>

  <h2>Από {yMin} έως {yFull} έτη ασφάλισης</h2>
  <ContentTable headers={['Έτη ασφάλισης', 'Ποσοστό του πλήρους', 'Εθνική σύνταξη', 'Λείπουν τον μήνα']} align={['l', 'r', 'r', 'r']} rows={ins} highlightRow={yFull - yMin} />
  <p>Ο πίνακας υποθέτει πλήρη διαμονή, δηλαδή {rFull} έτη. Η κλίμακα είναι γραμμική: κάθε έτος ασφάλισης ανάμεσα στα {yMin} και στα {yFull} αξίζει {$2(full * Q.national_reduction_per_year)} τον μήνα στο ποσό του 2025. Πάνω από τα {yFull} έτη η εθνική σύνταξη δεν ανεβαίνει άλλο· όλη η αύξηση από εκεί και πέρα έρχεται από το ανταποδοτικό μέρος.</p>
  <p>Ο νόμος προβλέπει και μια περίπτωση κάτω από τα {yMin} έτη. Όσοι θεμελιώνουν σύνταξη με λιγότερο χρόνο ασφάλισης, όπου αυτό επιτρέπεται, παίρνουν εθνική σύνταξη που δεν μπορεί να είναι μικρότερη από εκείνη των {yMin} ετών, δηλαδή {F.national15}. Η προϋπόθεση των {yMin} ετών δεν ισχύει γι' αυτούς, αλλά το κατώτατο ποσό ισχύει.</p>

  <h2>Η διαμονή μετράει όσο και τα ένσημα</h2>
  <ContentTable headers={['Έτη διαμονής', `${yFull} έτη ασφάλισης`, '17 έτη ασφάλισης', `${yMin} έτη ασφάλισης`]} align={['l', 'r', 'r', 'r']} rows={res} highlightRow={5} />
  <p>Η δεύτερη προϋπόθεση συχνά ξεχνιέται. Το άρθρο 7 ζητά μόνιμη και νόμιμη διαμονή στην Ελλάδα για τουλάχιστον 15 έτη, ανάμεσα στο 15ο έτος της ηλικίας και το έτος που συμπληρώνεται το όριο συνταξιοδότησης. Πάνω από αυτό το ελάχιστο, το ποσό μειώνεται κατά 1/40 για κάθε έτος που λείπει από τα {rFull}. Οι δύο μειώσεις πολλαπλασιάζονται: με 17 έτη ασφάλισης και 25 διαμονής το ποσό είναι {$2(nationalPension(17, 25))}.</p>
  <p>Ποιος θεωρείται μόνιμος κάτοικος; Ο νόμος εξομοιώνει με διαμονή στην Ελλάδα τη θητεία υπαλλήλου του ελληνικού Δημοσίου στο εξωτερικό, εφόσον μισθοδοτείται από το Δημόσιο και ασφαλίζεται στον e-ΕΦΚΑ. Για πολίτες χωρών εκτός Ευρωπαϊκής Ένωσης, η μόνιμη διαμονή αποδεικνύεται με τη διαδικασία της άδειας διαμονής. Για τα χρόνια που κάποιος ζούσε και εργαζόταν σε άλλη χώρα της Ένωσης, το Υπουργείο έχει εκδώσει ξεχωριστές οδηγίες για τον συνδυασμό με τους ευρωπαϊκούς κανονισμούς, που δεν εξετάζουμε εδώ.</p>

  <h2>Μια εξαίρεση για τους ομογενείς</h2>
  <p>Για ομογενείς με αλβανική ιθαγένεια και ομογενείς από την πρώην Σοβιετική Ένωση, το άρθρο 7 προβλέπει μεταβατικό κανόνα: η μείωση λόγω διαμονής υπολογίζεται με βάση τα τριάντα έτη και με αφετηρία το 1992, και το ποσοστό μείωσης αυξάνεται αναλογικά κάθε χρόνο ως το 2032, οπότε εφαρμόζονται οι γενικές προϋποθέσεις. Η ομογενειακή ιδιότητα προκύπτει από το Μητρώο Πολιτών ή από το Ειδικό Δελτίο Ταυτότητας Ομογενούς. Ο υπολογιστής μας εφαρμόζει τον γενικό κανόνα των {rFull} ετών.</p>

  <div data-chrome><MiniSim client:load kind="earlyret" lang={lang} href={route('retireage', lang)} /></div>

  <h2>Μειωμένη σύνταξη και σώρευση</h2>
  <p>Όποιος παίρνει μειωμένη σύνταξη εξ ιδίου δικαιώματος χάνει από την εθνική σύνταξη 1/200 για κάθε μήνα που λείπει ως το όριο ηλικίας της πλήρους. Με αποχώρηση {maxEarly} μήνες νωρίτερα η μείωση φτάνει {p(maxEarly * REDUCED_NATIONAL_PER_MONTH)}. Ο μικρός υπολογιστής παραπάνω δείχνει την περικοπή για κάθε αριθμό μηνών· το ανταποδοτικό μέρος της μειωμένης σύνταξης ακολουθεί άλλες διατάξεις και δεν υπολογίζεται εκεί.</p>
  <p>Σε όσους δικαιούνται περισσότερες από μία κύριες συντάξεις δίνεται μία εθνική σύνταξη. Αν η μία είναι πλήρης, η εθνική καταβάλλεται πλήρης· αν είναι δύο μειωμένες, καταβάλλεται το ποσοστό καθεμιάς, ως το πλήρες ποσό. Στις συντάξεις αναπηρίας το ποσό εξαρτάται από το ποσοστό ανικανότητας και είναι πλήρες για τα υψηλότερα ποσοστά.</p>

  <h2>Από πού προέρχεται το ποσό</h2>
  <p>Στην πρώτη εφαρμογή του νόμου, το 2016, ορίστηκε ένα αρχικό ποσό, χαμηλότερο από το σημερινό. Από τότε αναπροσαρμόζεται σύμφωνα με το άρθρο 14 του ίδιου νόμου, και το Υπουργείο Εργασίας δημοσιεύει το ποσό σε ισχύ: {F.nationalFull} από 1.1.2025, το τελευταίο που έχουμε επαληθεύσει. Γι' αυτό σε όλο τον ιστότοπο τα ποσά της εθνικής σύνταξης δίνονται με την ένδειξη του 2025. Για τη συνολική εικόνα, εθνική μαζί με ανταποδοτική, χρησιμοποιήστε τον <a href={route('pension', lang)}>υπολογισμό σύνταξης</a>· για τα χρόνια που χρειάζονται, τον οδηγό για τα <a href={route('retireage', lang)}>όρια ηλικίας</a>. Οι εισφορές που χτίζουν τα έτη ασφάλισης φαίνονται στον <a href={route('home', lang)}>υπολογισμό μισθού</a>.</p>
</GuideLayout>
