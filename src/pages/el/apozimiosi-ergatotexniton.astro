---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { severance, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const $2 = (x: number) => formatMoney(x, 2, lang);
const S = P.severance;
const dpm = S.daily_wages_per_month;
const minD = P.minimum_wage.daily;
const wages = [minD, 50, 65, 80];
const yrsList = [1, 4, 7, 10, 13, 16];
const grid = yrsList.map((y) => [`${y} ${y === 1 ? 'έτος' : 'έτη'}`, String(severance({ pay: 1, years: y }).months), ...wages.map((w) => $(severance({ pay: w, daily: true, years: y }).total))]);
const capDaily = severance({ pay: 1, years: 1 }).cap / dpm;
const ex = severance({ pay: 58, daily: true, years: 8 }), exN = severance({ pay: 58, daily: true, years: 8, notice: true });
const m22 = minD * dpm, m25 = minD * 25, m26 = minD * 26;
const exMin = severance({ pay: minD, daily: true, years: 5 });
const round13 = Math.floor(severance({ pay: 65, daily: true, years: 13 }).total / 1000) * 1000;
const monthlyPaid = severance({ pay: 1350, years: 9 });
const faqs = [
  { q: `Δουλεύω σε αποθήκη με ημερομίσθιο ${$(58)} και έχω 8 χρόνια. Πόση αποζημίωση δικαιούμαι;`, a: `Ο μήνας σας λογίζεται ${dpm} ημερομίσθια, δηλαδή ${$(ex.monthly)}. Οκτώ συμπληρωμένα έτη αντιστοιχούν σε ${ex.months} μισθούς, άρα ${$(ex.base)}, και με την προσαύξηση 1/6 το σύνολο φτάνει ${$(ex.total)} όταν η απόλυση γίνεται χωρίς προειδοποίηση. Ο υπολογιστής αποζημίωσης δέχεται απευθείας το ημερομίσθιο αν επιλέξετε «Ημερομίσθιο» στον τρόπο αμοιβής.` },
  { q: 'Δουλεύω 26 μέρες τον μήνα. Γιατί η αποζημίωση μετράει μόνο 22 ημερομίσθια;', a: `Επειδή έτσι ορίζει το άρθρο 64 του ν. 4808/2021: για τον υπολογισμό της αποζημίωσης ο μηνιαίος μισθός του εργατοτεχνίτη λογίζεται ως ${dpm} ημερομίσθια, όσες μέρες κι αν δουλεύει στην πράξη. Με το κατώτατο ημερομίσθιο, ${dpm} ημέρες δίνουν ${$(m22)} ενώ 26 ημέρες δίνουν ${$(m26)}. Η διαφορά δεν αφαιρείται από τον μισθό σας· αφορά μόνο τη βάση της αποζημίωσης.` },
  { q: 'Στο site του Υπουργείου βρήκα πίνακα αποζημίωσης εργατοτεχνιτών σε ημερομίσθια. Ισχύει ακόμη;', a: `Ο πίνακας αυτός εμφανίζεται ακόμη στις συχνές ερωτήσεις του Υπουργείου Εργασίας, με παραπομπή στο β.δ. του 1920 και στον ν. 3198/1955. Περιγράφει το παλιό καθεστώς των εργατοτεχνιτών. Από 1.1.2022, με το άρθρο 64 του ν. 4808/2021, υπάλληλοι και εργατοτεχνίτες έχουν ενιαίο πίνακα, και η Επιθεώρηση Εργασίας υπολογίζει τον μήνα του εργατοτεχνίτη ως ${dpm} ημερομίσθια. Μην τον χρησιμοποιείτε για μια σημερινή απόλυση.` },
  { q: 'Είμαι εργατοτεχνίτης αλλά πληρώνομαι με μηνιαίο μισθό. Τι ισχύει για μένα;', a: `Μετράει ο μηνιαίος μισθός σας, χωρίς μετατροπή. Ο κανόνας των ${dpm} ημερομισθίων εφαρμόζεται «εκτός εάν ήδη αμείβονται με μηνιαίο μισθό», όπως γράφει η Επιθεώρηση Εργασίας. Με ${$(1350)} μισθό και 9 χρόνια, η αποζημίωση είναι ${monthlyPaid.months} μισθοί συν 1/6, δηλαδή ${$(monthlyPaid.total)}, όπως για κάθε υπάλληλο.` },
  { q: 'Με ποιο ημερομίσθιο αρχίζει να ισχύει το ανώτατο όριο για τους εργατοτεχνίτες;', a: `Το όριο του άρθρου 5 του ν. 3198/1955 είναι ${F.sevCap} τον μήνα. Διαιρεμένο με ${dpm}, αντιστοιχεί σε ημερομίσθιο ${$2(capDaily)}. Μόνο πάνω από αυτό το ημερομίσθιο κόβεται η βάση της αποζημίωσης. Στην πράξη, για σχεδόν όλους τους εργατοτεχνίτες το όριο δεν παίζει ρόλο, και η αποζημίωση ακολουθεί πλήρως το ημερομίσθιο.` },
];
---
<GuideLayout lang={lang} id="sevworkers" breadcrumbLabel={label('sevworkers', lang)}
  title={`Αποζημίωση εργατοτεχνιτών ${F.year}: ${dpm} ημερομίσθια τον μήνα`}
  h1={`Αποζημίωση εργατοτεχνιτών ${F.year}: ο ενιαίος πίνακας με ${dpm} ημερομίσθια`}
  description={`Αποζημίωση εργατοτεχνιτών ${F.year}: ενιαίος πίνακας με υπαλλήλους από το 2022, μήνας ίσος με ${dpm} ημερομίσθια, συν 1/6. Ποσά ανά ημερομίσθιο και ο παλιός πίνακας.`}
  intro={`Πώς υπολογίζεται η αποζημίωση απόλυσης όσων αμείβονται με ημερομίσθιο μετά το άρθρο 64 του ν. 4808/2021.`}
  resume={`Από την 1η Ιανουαρίου 2022 οι εργατοτεχνίτες έχουν την ίδια αποζημίωση απόλυσης με τους υπαλλήλους: ${S.table_months[0].months} έως ${S.table_months[S.table_months.length - 1].months} μηνιαίους μισθούς ανάλογα με τα συμπληρωμένα έτη στον ίδιο εργοδότη, συν 1/6 για τα δώρα και το επίδομα αδείας. Η μόνη διαφορά είναι ο τρόπος που βρίσκουμε τον «μισθό». Για όσους πληρώνονται με ημερομίσθιο, το άρθρο 64 του ν. 4808/2021 ορίζει ότι ο μηνιαίος μισθός της αποζημίωσης λογίζεται ως ${dpm} ημερομίσθια, εκτός αν ήδη αμείβονται με μηνιαίο μισθό. Με το κατώτατο ημερομίσθιο των ${F.minDaily}, ο μήνας της αποζημίωσης είναι ${$(m22)} και πέντε χρόνια δίνουν ${$(exMin.total)}. Με ημερομίσθιο ${$(58)} και οκτώ χρόνια, η αποζημίωση φτάνει ${$(ex.total)}, ή ${$(exN.total)} αν δόθηκε έγγραφη προειδοποίηση. Ο παλιός πίνακας σε ημερομίσθια, που βρίσκεται ακόμη στις συχνές ερωτήσεις του Υπουργείου, περιγράφει το προηγούμενο καθεστώς.`}
  faqs={faqs}
  related={[{ href: route('severance', lang), name: label('severance', lang), description: 'Ο υπολογιστής δέχεται και ημερομίσθιο.' }, { href: route('daily', lang), name: label('daily', lang), description: 'Από το ημερομίσθιο στα μηνιαία καθαρά.' }, { href: route('sevtable', lang), name: label('sevtable', lang), description: 'Ο ενιαίος πίνακας γραμμή προς γραμμή.' }]}
  sources={[src('law_4808_64', lang), src('severance', lang), src('severance_faq', lang), src('min_wage', lang)]}>
  <div data-chrome><MiniSim client:load kind="sevworkers" lang={lang} href={route('severance', lang)} /></div>

  <h2>Αποζημίωση ανά ημερομίσθιο και χρόνια</h2>
  <ContentTable headers={['Υπηρεσία', 'Μισθοί', ...wages.map((w) => `${$2(w)}/ημέρα`)]} align={['l', 'r', 'r', 'r', 'r', 'r']} rows={grid} />
  <p>Τα ποσά είναι για απόλυση χωρίς προειδοποίηση και περιλαμβάνουν την προσαύξηση 1/6. Η πρώτη στήλη ποσών είναι το κατώτατο ημερομίσθιο που ισχύει από 1η Απριλίου {F.year}. Για να βρείτε τη δική σας γραμμή, μετρήστε τα συμπληρωμένα έτη στον εργοδότη που σας απολύει· τα χρόνια σε άλλους εργοδότες δεν προστίθενται. Αν η απόλυση έγινε με έγγραφη προειδοποίηση, διαιρέστε το ποσό με δύο.</p>
  <p>Ο πίνακας δείχνει και κάτι που συχνά ξαφνιάζει: η αποζημίωση ενός εργατοτεχνίτη δεν είναι πια ένας μικρός αριθμός ημερών. Με {$(65)} την ημέρα και 13 χρόνια, ξεπερνά τα {$(round13)}.</p>

  <h2>Τι άλλαξε το 2022</h2>
  <p>Μέχρι το 2021 υπάλληλοι και εργατοτεχνίτες είχαν διαφορετικούς κανόνες απόλυσης. Το άρθρο 64 του ν. 4808/2021 τους ενοποίησε: από 1.1.2022 ισχύει ένας πίνακας για όλους, ο πίνακας του ν. 4093/2012 που ως τότε αφορούσε τους υπαλλήλους. Για να εφαρμοστεί ένας πίνακας γραμμένος σε μηνιαίους μισθούς σε ανθρώπους που πληρώνονται με την ημέρα, ο νόμος έδωσε έναν συντελεστή μετατροπής: ο μήνας είναι {dpm} ημερομίσθια.</p>
  <p>Η Επιθεώρηση Εργασίας περιγράφει τον κανόνα με δύο προϋποθέσεις. Πρώτα, αφορά όσους αμείβονται πράγματι με ημερομίσθιο· όποιος εργάτης έχει συμφωνήσει μηνιαίο μισθό, υπολογίζεται με αυτόν. Έπειτα, το ανώτατο όριο του ν. 3198/1955 ισχύει και εδώ, αλλά σε ημερομίσθιο αντιστοιχεί σε {$2(capDaily)} την ημέρα, οπότε ελάχιστοι το φτάνουν.</p>

  <h2>Γιατί {dpm} και όχι 25 ή 26 ημέρες</h2>
  <p>Αν δουλεύετε 25 ή 26 ημέρες τον μήνα, ο πραγματικός σας μηνιαίος μικτός είναι μεγαλύτερος από τα {dpm} ημερομίσθια της αποζημίωσης. Με το κατώτατο ημερομίσθιο, 25 ημέρες δίνουν {$(m25)} και 26 δίνουν {$(m26)}, ενώ η αποζημίωση υπολογίζεται σε {$(m22)}. Ο νόμος δεν κάνει διάκριση ανάμεσα σε πενθήμερο και εξαήμερο: ο συντελεστής είναι ένας.</p>
  <p>Η διαφορά αυτή δεν πρέπει να μπερδεύεται με άλλους κανόνες που μετρούν ημερομίσθια. Το δώρο Χριστουγέννων ενός ημερομίσθιου είναι {F.xmasDaily} ημερομίσθια και το δώρο Πάσχα {F.easterDaily}, ενώ το επίδομα αδείας φτάνει τα {F.leaveDaily}. Η προσαύξηση 1/6 της αποζημίωσης είναι η αναλογία αυτών των παροχών που ο εργαζόμενος θα έπαιρνε αν συνέχιζε, και εφαρμόζεται στους εργατοτεχνίτες όπως και στους υπαλλήλους.</p>

  <div data-chrome><MiniSim client:load kind="daily" lang={lang} href={route('daily', lang)} /></div>

  <h2>Ο παλιός πίνακας των εργατοτεχνιτών</h2>
  <p>Στις συχνές ερωτήσεις του Υπουργείου Εργασίας για την ατομική σύμβαση εργασίας υπάρχει ακόμη ένας «πίνακας αποζημιώσεως εργατοτεχνιτών», με κλίμακες ανά πενταετία και ποσά σε ημερομίσθια, που παραπέμπει στο β.δ. της 16/18 Ιουλίου 1920 και στον ν. 3198/1955. Είναι το καθεστώς που ίσχυε πριν από την ενοποίηση. Δεν τον αναπαράγουμε εδώ, για να μη χρησιμοποιηθεί κατά λάθος σε σημερινή απόλυση· η ίδια η Επιθεώρηση Εργασίας, στη σελίδα της για την αποζημίωση, εφαρμόζει τον ενιαίο πίνακα και τα {dpm} ημερομίσθια.</p>
  <p>Αν κάποιος σας υπολογίσει αποζημίωση σε «ημερομίσθια του πίνακα», ρωτήστε με ποιον πίνακα. Μια απόλυση από το 2022 και μετά υπολογίζεται σε μηνιαίους μισθούς των {dpm} ημερομισθίων, όχι σε ημέρες της παλιάς κλίμακας.</p>

  <h2>Ένα παράδειγμα από την αρχή ως το τέλος</h2>
  <p>Ένας αποθηκάριος με ημερομίσθιο {$(58)} δουλεύει οκτώ χρόνια και τρεις μήνες στην ίδια επιχείρηση. Συμπληρωμένα έτη: οκτώ, άρα {ex.months} μισθοί. Μήνας αποζημίωσης: {$(58)} επί {dpm}, δηλαδή {$(ex.monthly)}. Βασική αποζημίωση: {$(ex.base)}. Προσαύξηση 1/6: {$(ex.uplift)}. Σύνολο: {$(ex.total)}. Αν ο εργοδότης τον είχε ειδοποιήσει γραπτώς με τον χρόνο που ορίζει ο νόμος, θα έπαιρνε {$(exN.total)} στο τέλος της προειδοποίησης. Τα ίδια βήματα κάνει ο <a href={route('severance', lang)}>υπολογιστής αποζημίωσης απόλυσης</a> με την επιλογή «Ημερομίσθιο». Για τα καθαρά του τρέχοντος ημερομισθίου δείτε τον οδηγό για το <a href={route('daily', lang)}>ημερομίσθιο</a> ή τον βασικό <a href={route('home', lang)}>υπολογισμό μισθού</a>.</p>
</GuideLayout>
