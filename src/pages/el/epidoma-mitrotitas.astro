---
import ToolCalc from '../../components/calc/ToolCalc';
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { src } from '../../lib/facts';
import { PARAMS as P, parentalBenefit } from '../../lib/engine/gr';
import { maternitySpecial } from '../../lib/engine/epidomata';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const $ = (x: number) => formatMoney(x, 0, lang);
const Y = P.year;
const M = P.maternity;
const full = maternitySpecial('full'), part = maternitySpecial('part'), self = maternitySpecial('self');
const par = parentalBenefit();
const plan = [
  ['Πριν από τον τοκετό', `${M.efka_days_before} ημέρες`, 'Επίδομα κυοφορίας e-ΕΦΚΑ'],
  ['Μετά τον τοκετό', `${M.efka_days_after} ημέρες`, 'Επίδομα λοχείας e-ΕΦΚΑ'],
  ['Στη συνέχεια', `έως ${M.special_months} μήνες`, `Ειδική παροχή ΔΥΠΑ, ${$(full.monthly)} τον μήνα`],
  ['Μέχρι το παιδί να γίνει 8', `${P.parental.leave_months} μήνες ανά γονέα`, `Γονική άδεια, οι ${P.parental.paid_months} πρώτοι με επίδομα ΔΥΠΑ`],
];
const statusRows = [['Μισθωτή, πλήρης απασχόληση', $(full.monthly), $(full.total)], ['Μισθωτή, μερική απασχόληση', $(part.monthly), $(part.total)], ['Αυτοαπασχολούμενη ή αγρότισσα', $(self.monthly), $(self.total)]];
const faqs = [
  { q: 'Πόσο είναι το επίδομα μητρότητας της ΔΥΠΑ;', a: `Η ειδική παροχή προστασίας της μητρότητας είναι ίση με τον κατώτατο μισθό, ${$(full.monthly)} τον μήνα μικτά για πλήρη απασχόληση, για έως ${M.special_months} μήνες, δηλαδή ${$(full.total)} συνολικά. Στις μισθωτές προστίθεται αναλογία δώρων και επιδόματος αδείας, και η ΔΥΠΑ καταβάλλει τις ασφαλιστικές εισφορές. Σε μερική απασχόληση το ποσό είναι το μισό, ${$(part.monthly)}.` },
  { q: 'Πόσες ημέρες είναι η άδεια μητρότητας;', a: `${M.efka_days} ημέρες, δηλαδή ${M.efka_days / 7} εβδομάδες: ${M.efka_days_before} πριν από την πιθανή ημερομηνία τοκετού και ${M.efka_days_after} μετά. Αν το παιδί γεννηθεί νωρίτερα, οι ημέρες που δεν χρησιμοποιήθηκαν πριν από τον τοκετό προστίθενται μετά. Για το επίδομα του e-ΕΦΚΑ χρειάζονται τουλάχιστον ${M.efka_min_work_days} ημέρες εργασίας στα δύο χρόνια πριν από τον τοκετό.` },
  { q: 'Μπορεί ο πατέρας να πάρει μέρος της παροχής μητρότητας;', a: `Ναι, έως ${M.special_transferable_to_father} από τους ${M.special_months} μήνες μπορούν να μεταφερθούν στον πατέρα. Για τις αυτοαπασχολούμενες, η μεταφορά γίνεται αφού η μητέρα πάρει πρώτα δύο μήνες. Η παροχή δεν φορολογείται και είναι ακατάσχετη. Η άδεια πατρότητας των 14 εργάσιμων ημερών με αποδοχές είναι ξεχωριστό δικαίωμα και δεν αφαιρείται από αυτούς τους μήνες.` },
  { q: 'Δικαιούνται επίδομα μητρότητας οι ελεύθερες επαγγελματίες;', a: `Ναι. Από τον ν. 5078/2023, οι αυτοαπασχολούμενες και οι αγρότισσες παίρνουν από τη ΔΥΠΑ ${M.self_employed_months} μήνες παροχή ίση με τον κατώτατο μισθό, ${$(self.monthly)} τον μήνα, για παιδιά που γεννήθηκαν από τις 24 Σεπτεμβρίου 2023, εφόσον είναι ενήμερες ασφαλιστικά. Χωριστά, ο e-ΕΦΚΑ δίνει μηνιαίο επίδομα τεσσάρων μηνών, του οποίου το ποσό δεν μπορέσαμε να επιβεβαιώσουμε σε επίσημη πηγή.` },
  { q: 'Μέσα σε πόσο καιρό κάνω αίτηση για την ειδική παροχή;', a: `Μέσα σε ${M.apply_within_days} ημέρες από την έναρξη της ειδικής άδειας, για τις μισθωτές, με εν ισχύ σύμβαση εργασίας κατά την έναρξη της άδειας μητρότητας. Η αίτηση για το επίδομα μητρότητας του e-ΕΦΚΑ γίνεται έως οκτώ μήνες μετά τον τοκετό. Και οι δύο υποβάλλονται ηλεκτρονικά.` },
];
---
<GuideLayout lang={lang} id="maternity" breadcrumbLabel={label('maternity', lang)}
  title={`Επίδομα μητρότητας ${Y}: άδεια ${M.efka_days} ημερών και ${M.special_months} μήνες ΔΥΠΑ`}
  h1={`Επίδομα μητρότητας ${Y}: τι πληρώνουν ο e-ΕΦΚΑ και η ΔΥΠΑ`}
  description={`Επίδομα μητρότητας ${Y}: ${M.efka_days} ημέρες άδειας με επίδομα e-ΕΦΚΑ και ${M.special_months} μήνες ειδική παροχή ΔΥΠΑ ${$(full.monthly)} τον μήνα. Μισθωτές, μερική απασχόληση, αυτοαπασχολούμενες.`}
  intro={`Γύρω από μια γέννηση πληρώνουν δύο φορείς σε σειρά: πρώτα ο e-ΕΦΚΑ για την άδεια μητρότητας, έπειτα η ΔΥΠΑ για εννέα μήνες.`}
  resume={`Μια μισθωτή με πλήρη απασχόληση παίρνει, μετά την άδεια μητρότητας, ειδική παροχή της ΔΥΠΑ ${$(full.monthly)} τον μήνα για ${M.special_months} μήνες, ${$(full.total)} συνολικά μικτά, συν αναλογία δώρων. Πριν από αυτήν, η άδεια μητρότητας διαρκεί ${M.efka_days} ημέρες, ${M.efka_days_before} πριν και ${M.efka_days_after} μετά τον τοκετό, και πληρώνεται από τον e-ΕΦΚΑ με το επίδομα κυοφορίας-λοχείας, που υπολογίζεται από την ασφαλιστική κλάση της εργαζόμενης. Η ειδική παροχή είναι ίση με τον κατώτατο μισθό, άρα αυξήθηκε αυτόματα όταν αυτός ανέβηκε τον Απρίλιο, και η ΔΥΠΑ πληρώνει και τις εισφορές. Σε μερική απασχόληση είναι το μισό, ${$(part.monthly)}. Από το 2023 τη δικαιούνται και οι αυτοαπασχολούμενες και οι αγρότισσες, ${M.self_employed_months} μήνες με ${$(self.monthly)}. Έως ${M.special_transferable_to_father} μήνες μπορούν να περάσουν στον πατέρα. Η παροχή δεν φορολογείται. Ο υπολογιστής δείχνει ποσό, μήνες και μοιρασιά ανάμεσα στους γονείς.`}
  faqs={faqs}
  related={[{ href: route('parental', lang), name: label('parental', lang), description: 'Οι δύο μήνες γονικής άδειας που πληρώνει η ΔΥΠΑ.' }, { href: route('childben', lang), name: label('childben', lang), description: 'Το μηνιαίο επίδομα παιδιού της ΟΠΕΚΑ.' }, { href: route('minimum', lang), name: label('minimum', lang), description: 'Ο κατώτατος μισθός πάνω στον οποίο υπολογίζεται η παροχή.' }]}
  sources={[src('maternity', lang), src('maternity_efka', lang), src('maternity_self', lang), src('maternity_law', lang), src('min_wage', lang)]}>
  <div data-outil><ToolCalc client:load kind="maternity" lang={lang} methodHref={route('method', lang)} /></div>

  <h2>Η σειρά των αδειών και ποιος πληρώνει</h2>
  <ContentTable headers={['Περίοδος', 'Διάρκεια', 'Τι πληρώνεται']} align={['l', 'l', 'l']} rows={plan} />
  <p>Οι δύο πρώτες γραμμές είναι η άδεια μητρότητας, {M.efka_days / 7} εβδομάδες συνολικά. Το επίδομα του e-ΕΦΚΑ για αυτό το διάστημα ισούται με το βασικό επίδομα ασθενείας της ασφαλιστικής κλάσης, δηλαδή το μισό του τεκμαρτού ημερομισθίου, με προσαύξηση {Math.round(M.efka_dependant_uplift * 100)} % για κάθε προστατευόμενο μέλος, και πληρώνεται και για τις μη εργάσιμες ημέρες. Η ΔΥΠΑ συμπληρώνει τη διαφορά ως τις κανονικές αποδοχές, εκτός από όσα βαρύνουν τον εργοδότη. Επειδή ο πίνακας των κλάσεων του {Y} δεν είναι δημοσιευμένος σε μορφή που μπορούμε να ελέγξουμε, ο υπολογιστής δεν βγάζει το ποσό αυτών των {M.efka_days} ημερών.</p>

  <h2>Η ειδική παροχή ανά κατηγορία</h2>
  <ContentTable headers={['Κατηγορία', 'Τον μήνα', `Σύνολο ${M.special_months} μηνών`]} align={['l', 'r', 'r']} rows={statusRows} />
  <p>Μερική απασχόληση, για τη ΔΥΠΑ, σημαίνει έως τέσσερις ώρες την ημέρα ή έως δεκατρείς ημέρες τον μήνα κατά μέσο όρο, στο εξάμηνο πριν από την άδεια κυοφορίας. Η παροχή ξεκινά την επόμενη της λήξης της άδειας μητρότητας ή των αδειών που την ακολουθούν, και απαιτεί σύμβαση εργασίας σε ισχύ.</p>
  <div data-chrome><MiniSim client:load kind="maternitytotal" lang={lang} href={route('maternity', lang)} /></div>

  <h2>Μετά τους εννέα μήνες</h2>
  <p>Κάθε γονέας έχει ακόμη {P.parental.leave_months} μήνες <a href={route('parental', lang)}>γονικής άδειας</a> μέχρι το παιδί να κλείσει τα 8, από τους οποίους οι {P.parental.paid_months} πρώτοι πληρώνονται από τη ΔΥΠΑ με {$(par.perMonth)} τον μήνα. Μαζί με την ειδική παροχή, μια μητέρα με πλήρη απασχόληση μπορεί να λάβει από τη ΔΥΠΑ {$(full.total + par.total)} μικτά μέσα στα πρώτα χρόνια του παιδιού, χωρίς να υπολογίζεται το επίδομα του e-ΕΦΚΑ. Για τη γέννηση υπάρχει επίσης το εφάπαξ <a href={route('childben', lang)}>επίδομα γέννησης</a>.</p>
</GuideLayout>
