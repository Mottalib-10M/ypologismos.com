---
import ToolCalc from '../../components/calc/ToolCalc';
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { src } from '../../lib/facts';
import { PARAMS as P } from '../../lib/engine/gr';
import { housingBenefit, rentRefund } from '../../lib/engine/epidomata';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const $ = (x: number) => formatMoney(x, 0, lang);
const Y = P.year;
const H = P.housing_benefit;
const ex = housingBenefit({ members: 3, rent: 400, income: 11000, deposits: 3000 });
const sp = housingBenefit({ members: 2, singleParent: true, rent: 350 });
const cheap = housingBenefit({ members: 4, rent: 150 });
const rr = rentRefund({ annualRent: 4800, household: 'couple', children: 1 });
const rows = [1, 2, 3, 4, 5].map((m) => { const h = housingBenefit({ members: m, rent: 100000 }); return [m === 5 ? '5 και άνω' : String(m), $(h.gross), $(h.incomeLimit), $(h.propertyLimit), $(h.depositsLimit)]; });
const faqs = [
  { q: 'Πόσα χρήματα είναι το επίδομα στέγασης;', a: `${$(H.base)} τον μήνα για ένα άτομο, συν ${$(H.per_member)} για κάθε επιπλέον μέλος του νοικοκυριού, με ανώτατο όριο ${$(H.max)} όσα μέλη κι αν έχει. Στη μονογονεϊκή οικογένεια το πρώτο ανήλικο παιδί μετρά ${$(H.per_member + H.single_parent_extra)}. Το επίδομα δεν ξεπερνά ποτέ το ενοίκιο: με ενοίκιο ${$(150)} μια τετραμελής οικογένεια παίρνει ${$(cheap.amount)}.` },
  { q: 'Ποιο είναι το εισοδηματικό όριο για το επίδομα στέγασης;', a: `${$(H.income_base)} τον χρόνο για ένα άτομο, συν ${$(H.income_per_member)} για κάθε επιπλέον μέλος, έως ${$(H.income_max)}. Μετράει το εισόδημα όλων των μελών από κάθε πηγή, πριν από τον φόρο, μαζί με τα επιδόματα, εκτός από το επίδομα παιδιού, τα προνοιακά αναπηρικά και το επίδομα αναδοχής. Γι’ αυτό το όριο είναι αυστηρό για ένα νοικοκυριό με έναν μισθό.` },
  { q: 'Μπορώ να πάρω επίδομα στέγασης αν νοικιάζω από τους γονείς μου;', a: `Όχι. Η ΚΥΑ αποκλείει μισθώσεις από συγγενή πρώτου βαθμού, από σύζυγο ή πρώην σύζυγο και από μέρος συμφώνου συμβίωσης, καθώς και την ενοικίαση τμήματος κατοικίας. Το μισθωτήριο πρέπει να είναι ηλεκτρονικό, για την κύρια κατοικία, και ο λογαριασμός ρεύματος να είναι στο όνομα κάποιου μέλους του νοικοκυριού.` },
  { q: 'Παίρνουν επίδομα στέγασης οι φοιτητές;', a: `Οι φοιτητές κάτω των 25 που μένουν μόνοι δεν το δικαιούνται: για αυτούς υπάρχει το φοιτητικό στεγαστικό επίδομα του Υπουργείου Παιδείας, ${$(P.student_housing.base)} έως ${$(P.student_housing.regional_shared)} τον χρόνο. Ένας φοιτητής που ζει με την οικογένειά του σε ενοικιαζόμενο σπίτι μετρά κανονικά ως μέλος του νοικοκυριού.` },
  { q: 'Μπορώ να έχω μαζί επίδομα στέγασης και επιστροφή ενοικίου;', a: `Ναι, είναι διαφορετικά μέτρα με διαφορετικά κριτήρια. Το επίδομα στέγασης της ΟΠΕΚΑ πληρώνεται κάθε μήνα, ενώ η επιστροφή ενοικίου της ΑΑΔΕ είναι εφάπαξ τον Νοέμβριο και δεν απαιτεί αίτηση. Για ενοίκιο ${$(400)} τον μήνα, μια οικογένεια με ένα παιδί παίρνει και επιστροφή ${$(rr.amount)}, αν πληροί τα όρια της ΑΑΔΕ.` },
];
---
<GuideLayout lang={lang} id="housing" breadcrumbLabel={label('housing', lang)}
  title={`Επίδομα στέγασης ${Y}: ποσό, όρια εισοδήματος και ενοίκιο`}
  h1={`Επίδομα στέγασης ${Y}: πόσα δίνει η ΟΠΕΚΑ και ποιοι το δικαιούνται`}
  description={`Επίδομα στέγασης ${Y}: ${$(H.base)} έως ${$(H.max)} τον μήνα από την ΟΠΕΚΑ. Δείτε ποσό, όρια εισοδήματος, ακινήτων και καταθέσεων για το νοικοκυριό σας και το ενοίκιο.`}
  intro={`Ένα μηνιαίο ποσό για όσους νοικιάζουν την κύρια κατοικία τους, με αυστηρά όρια εισοδήματος και περιουσίας.`}
  resume={`Ένα τριμελές νοικοκυριό που πληρώνει ${$(400)} ενοίκιο και έχει ${$(11000)} συνολικό εισόδημα παίρνει επίδομα στέγασης ${$(ex.amount)} τον μήνα, δηλαδή ${$(ex.annual)} τον χρόνο. Το ποσό ορίζεται από την ΚΥΑ του 2019 που εφαρμόζει το άρθρο 3 του ν. 4472/2017: ${$(H.base)} για τον αιτούντα και ${$(H.per_member)} για κάθε επιπλέον μέλος, με ανώτατο ${$(H.max)} τον μήνα και ποτέ περισσότερο από το ενοίκιο. Το εισοδηματικό όριο είναι ${$(H.income_base)} για ένα άτομο και ανεβαίνει κατά ${$(H.income_per_member)} για κάθε μέλος, έως ${$(H.income_max)}, και μετρά το εισόδημα όλων πριν από τον φόρο. Υπάρχουν και όρια για τα ακίνητα, έως ${$(H.property_max)}, και για τις καταθέσεις, έως ${$(H.deposits_max)}. Απαιτείται ηλεκτρονικό μισθωτήριο και ${H.residence_years} χρόνια νόμιμης διαμονής. Η ΟΠΕΚΑ πληρώνει την τελευταία εργάσιμη κάθε μήνα. Ο υπολογιστής ελέγχει τα τρία όρια και δίνει το ποσό για το δικό σας νοικοκυριό.`}
  faqs={faqs}
  related={[{ href: route('rentrefund', lang), name: label('rentrefund', lang), description: 'Ένα ενοίκιο πίσω κάθε Νοέμβριο, χωρίς αίτηση.' }, { href: route('student', lang), name: label('student', lang), description: 'Το επίδομα για φοιτητές που σπουδάζουν σε άλλη πόλη.' }, { href: route('childben', lang), name: label('childben', lang), description: 'Δεν μετρά στο εισόδημα του επιδόματος στέγασης.' }]}
  sources={[src('housing_benefit', lang), src('housing_benefit_law', lang), src('housing_benefit_kya', lang)]}>
  <div data-outil><ToolCalc client:load kind="housing" lang={lang} methodHref={route('method', lang)} /></div>

  <h2>Ποσά και όρια ανά μέγεθος νοικοκυριού</h2>
  <ContentTable headers={['Μέλη', 'Επίδομα τον μήνα', 'Όριο εισοδήματος', 'Όριο ακινήτων', 'Όριο καταθέσεων']} align={['l', 'r', 'r', 'r', 'r']} rows={rows} />
  <p>Το ανήλικο παιδί μετρά όπως ένας ενήλικας, τόσο στο ποσό όσο και στα όρια. Στη μονογονεϊκή οικογένεια το πρώτο ανήλικο φέρνει διπλή προσαύξηση και ανεβάζει και το εισοδηματικό όριο: ένας γονέας με ένα παιδί και ενοίκιο {$(350)} παίρνει {$(sp.amount)}, με όριο εισοδήματος {$(sp.incomeLimit)}. Το ίδιο ισχύει για κάθε ορφανό ή απροστάτευτο παιδί.</p>
  <div data-chrome><MiniSim client:load kind="housingtable" lang={lang} href={route('housing', lang)} /></div>

  <h2>Τι μετράει στο εισόδημα και στην περιουσία</h2>
  <p>Το εισόδημα είναι το πραγματικό ή τεκμαρτό εισόδημα από κάθε πηγή, πριν από τον φόρο και μετά τις εισφορές, όλων των μελών, όπως φαίνεται στις τελευταίες εκκαθαρισμένες δηλώσεις. Μετρούν και τα επιδόματα και τα αφορολόγητα ποσά, με τρεις εξαιρέσεις: το επίδομα παιδιού, τα προνοιακά αναπηρικά επιδόματα και το επίδομα αναδοχής. Η ακίνητη περιουσία είναι η φορολογητέα αξία της ΕΝΦΙΑ, στην Ελλάδα και στο εξωτερικό. Για τις καταθέσεις, η ΟΠΕΚΑ ελέγχει και τους τόκους που δηλώνονται στο Ε1.</p>
  <p>Αποκλείονται όσοι πληρώνουν φόρο πολυτελούς διαβίωσης, όσοι δηλώνουν δαπάνες πληρώματος σκάφους, δίδακτρα ιδιωτικού σχολείου πάνω από {$(H.private_school_fees_max)} ή οικιακό προσωπικό. Δεν δίνεται επίδομα αν κάποιο μέλος παίρνει ήδη άλλη στεγαστική συνδρομή ή αν το σπίτι δεν έχει ρεύμα.</p>

  <h2>Αίτηση, έγκριση και πληρωμή</h2>
  <p>Η αίτηση υποβάλλεται ηλεκτρονικά στην πλατφόρμα του επιδόματος στέγασης με τους κωδικούς Taxisnet. Το δικαίωμα αρχίζει την πρώτη του επόμενου μήνα από την αίτηση και το επίδομα πιστώνεται την τελευταία εργάσιμη κάθε μήνα, μαζί με τα υπόλοιπα επιδόματα της ΟΠΕΚΑ. Οι επίσημες πηγές δεν συμφωνούν για τη διάρκεια ισχύος της αίτησης: η ΚΥΑ και οι συχνές ερωτήσεις μιλούν για δώδεκα μήνες με αυτόματη ανανέωση, ενώ η σελίδα της ΟΠΕΚΑ γράφει ότι κάθε αίτηση ισχύει έξι μήνες. Για ασφάλεια, ελέγχετε την ημερομηνία λήξης στην πλατφόρμα.</p>
</GuideLayout>
