---
import ToolCalc from '../../components/calc/ToolCalc';
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { src } from '../../lib/facts';
import { PARAMS as P } from '../../lib/engine/gr';
import { studentHousing, rentRefund } from '../../lib/engine/epidomata';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const $ = (x: number) => formatMoney(x, 0, lang);
const S = P.student_housing;
const ex = studentHousing({ regional: true, shared: false, income: 24000, children: 2 });
const rr = rentRefund({ annualRent: 3600, student: true });
const amtRows = [['Αττική ή Περιφερειακή Ενότητα Θεσσαλονίκης', $(S.base), $(S.shared)], ['Οποιαδήποτε άλλη πόλη', $(S.regional), $(S.regional_shared)]];
const limRows = [1, 2, 3, 4].map((k) => [String(k), $(studentHousing({ regional: false, shared: false, children: k }).limit)]);
const faqs = [
  { q: 'Πόσο είναι το φοιτητικό στεγαστικό επίδομα για το 2025-2026;', a: `${$(S.base)} τον χρόνο για φοιτητή σε ΑΕΙ της Αττικής ή της Θεσσαλονίκης, ${$(S.regional)} για ίδρυμα σε οποιαδήποτε άλλη πόλη. Αν ο φοιτητής συγκατοικεί με άλλον φοιτητή στο ίδιο μισθωμένο σπίτι, το ποσό γίνεται ${$(S.shared)} σε Αττική και Θεσσαλονίκη και ${$(S.regional_shared)} στις υπόλοιπες πόλεις. Δεν υπάρχει ξεχωριστή προσαύξηση για τα νησιά.` },
  { q: 'Ποιο είναι το εισοδηματικό όριο για το στεγαστικό επίδομα φοιτητών;', a: `${$(S.income_limit)} οικογενειακό εισόδημα του προηγούμενου φορολογικού έτους, προσαυξημένο κατά ${$(S.income_per_child_after_first)} για κάθε εξαρτώμενο παιδί μετά το πρώτο. Μια οικογένεια με τρία παιδιά έχει όριο ${$(studentHousing({ regional: false, shared: false, children: 3 }).limit)}. Για το ακαδημαϊκό έτος 2025-2026 μετρά το εισόδημα του φορολογικού έτους 2025.` },
  { q: 'Μένω στη φοιτητική εστία. Παίρνω στεγαστικό επίδομα;', a: `Μόνο αν μείνατε στην εστία έως ένα εξάμηνο και για το υπόλοιπο νοικιάσατε σπίτι με μισθωτήριο τουλάχιστον ${S.min_lease_months} μηνών. Το επίδομα προϋποθέτει ηλεκτρονικό μισθωτήριο στην πόλη του ιδρύματος, που να είναι άλλη από την πόλη της μόνιμης κατοικίας της οικογένειας, και να μην έχει η οικογένεια σπίτι στην πόλη σπουδών.` },
  { q: 'Μπορώ να πάρω και επιστροφή ενοικίου για το φοιτητικό σπίτι;', a: `Ναι, είναι ξεχωριστό μέτρο της ΑΑΔΕ. Η επιστροφή ενοικίου δίνει ένα δωδέκατο του ετήσιου ενοικίου της φοιτητικής κατοικίας, έως ${$(P.rent_refund.student_cap)}, με μόνο εισοδηματικό κριτήριο. Για ενοίκιο ${$(300)} τον μήνα όλο τον χρόνο, η επιστροφή είναι ${$(rr.amount)}, που προστίθεται στο στεγαστικό επίδομα.` },
];
---
<GuideLayout lang={lang} id="student" breadcrumbLabel={label('student', lang)}
  title={`Φοιτητικό στεγαστικό επίδομα 2025-2026: ${$(S.base)} έως ${$(S.regional_shared)}`}
  h1={`Φοιτητικό στεγαστικό επίδομα 2025-2026: ποσό, όρια και προϋποθέσεις`}
  description={`Φοιτητικό στεγαστικό επίδομα 2025-2026: ${$(S.base)}, ${$(S.regional)} ή ${$(S.regional_shared)} τον χρόνο ανάλογα με πόλη και συγκατοίκηση, όριο ${$(S.income_limit)}. Δείτε αν το δικαιούστε και πόσο.`}
  intro={`Ένα ετήσιο ποσό για τις οικογένειες που πληρώνουν ενοίκιο επειδή το παιδί σπουδάζει σε άλλη πόλη.`}
  resume={`Μια οικογένεια με δύο παιδιά και ${$(24000)} εισόδημα, που νοικιάζει σπίτι για το παιδί της σε πανεπιστήμιο εκτός Αττικής και Θεσσαλονίκης, παίρνει φοιτητικό στεγαστικό επίδομα ${$(ex.amount)} για το ακαδημαϊκό έτος 2025-2026. Το επίδομα του άρθρου 10 του ν. 3220/2004 είναι ${$(S.base)} για σπουδές στην Αττική ή στη Θεσσαλονίκη και ${$(S.regional)} για ίδρυμα σε άλλη πόλη, και ανεβαίνει σε ${$(S.shared)} και ${$(S.regional_shared)} αντίστοιχα όταν ο φοιτητής συγκατοικεί με άλλον φοιτητή. Το οικογενειακό εισόδημα του 2025 πρέπει να μην ξεπερνά τις ${$(S.income_limit)}, συν ${$(S.income_per_child_after_first)} για κάθε παιδί μετά το πρώτο. Χρειάζεται μισθωτήριο τουλάχιστον ${S.min_lease_months} μηνών σε άλλη πόλη από την κατοικία της οικογένειας, επιτυχία στα μισά μαθήματα της προηγούμενης χρονιάς και κατοικίες της οικογένειας έως ${S.max_sqm} m² συνολικά. Οι αιτήσεις του 2026 έκλεισαν στις 22 Σεπτεμβρίου και το πληρώνει κάθε ίδρυμα. Ο υπολογιστής βγάζει το ποσό για την περίπτωσή σας.`}
  faqs={faqs}
  related={[{ href: route('rentrefund', lang), name: label('rentrefund', lang), description: 'Η επιστροφή ενοικίου ισχύει και για φοιτητικές κατοικίες.' }, { href: route('housing', lang), name: label('housing', lang), description: 'Το επίδομα στέγασης της ΟΠΕΚΑ, που δεν δίνεται σε φοιτητές που μένουν μόνοι.' }, { href: route('childben', lang), name: label('childben', lang), description: 'Το επίδομα παιδιού συνεχίζεται έως τα 24 για φοιτητές.' }]}
  sources={[src('student_housing', lang), src('student_housing_law', lang)]}>
  <div data-outil><ToolCalc client:load kind="student" lang={lang} methodHref={route('method', lang)} /></div>

  <h2>Τα τέσσερα ποσά</h2>
  <ContentTable headers={['Πού σπουδάζει', 'Μόνος', 'Με συγκάτοικο φοιτητή']} align={['l', 'r', 'r']} rows={amtRows} />
  <p>Η διάκριση είναι το ίδρυμα, όχι το νησί ή η απόσταση: ένας φοιτητής από την Κρήτη που σπουδάζει στην Αθήνα παίρνει {$(S.base)}, ενώ ένας Αθηναίος στη Θεσσαλία {$(S.regional)}. Η Αττική, εκτός από τα νησιά και τις περιοχές σε απόσταση άνω των 40 χιλιομέτρων, θεωρείται μία πόλη, όπως και το πολεοδομικό συγκρότημα της Θεσσαλονίκης· ένας φοιτητής με οικογένεια στο Μαρούσι δεν μπορεί να ζητήσει επίδομα για σπίτι στον Πειραιά.</p>

  <h2>Εισοδηματικό όριο ανά οικογένεια</h2>
  <ContentTable headers={['Εξαρτώμενα παιδιά', 'Όριο οικογενειακού εισοδήματος']} align={['l', 'r']} rows={limRows} />
  <div data-chrome><MiniSim client:load kind="studentlimit" lang={lang} href={route('student', lang)} /></div>
  <p>Εκτός από το εισόδημα, ελέγχεται η ακίνητη περιουσία: οι κατοικίες γονέων και φοιτητή δεν πρέπει να ξεπερνούν τα {S.max_sqm} τετραγωνικά συνολικά, χωρίς να μετρούν όσες βρίσκονται σε δήμο ή κοινότητα κάτω των {S.small_town_population} κατοίκων ούτε οι ημιτελείς οικοδομές.</p>

  <h2>Ποιος το παίρνει και πότε</h2>
  <p>Δικαιούχος είναι ο γονέας που έχει τον φοιτητή εξαρτώμενο μέλος, ή ο ίδιος ο φοιτητής αν είναι ορφανός, αν οι γονείς ζουν στο εξωτερικό, αν έχει κλείσει τα 25 ή αν κάνει δική του φορολογική δήλωση. Ο φοιτητής πρέπει να είναι Έλληνας ή πολίτης της ΕΕ, να μην έχει ξεπεράσει την κανονική διάρκεια σπουδών και να μην έχει ήδη πτυχίο. Για το 2025-2026 οι αιτήσεις έγιναν στην πλατφόρμα του Υπουργείου από 30 Ιουνίου έως 31 Ιουλίου 2026, με επαναλειτουργία από 17 έως 22 Σεπτεμβρίου. Το ποσό καταβάλλει κάθε ίδρυμα όταν λάβει την πίστωση από το Υπουργείο.</p>
</GuideLayout>
