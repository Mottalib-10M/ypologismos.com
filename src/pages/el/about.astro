---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { AUTHOR_NAME, CONTACT_EMAIL, REVIEW_CYCLE_MONTHS, LANG_TAGS, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts } from '../../lib/facts';
import { salary } from '../../lib/engine/gr';
import { formatMoney, displayDate } from '../../lib/format';
import { organizationSchema, breadcrumbSchema } from '../../lib/seo';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const checked = displayDate(F.retrieved, LANG_TAGS[lang]);
const s = salary({ gross: 1800 });
const title = `${SITE_NAMES[lang]}: ποιοι είμαστε και πώς υπολογίζουμε`;
const description = `Ποιος εκδίδει τον ιστότοπο, γιατί δείχνουμε καθαρά ανά καταβολή και σε 12μηνη βάση, από πού έρχονται οι συντελεστές ${F.year}, ποιος πληρώνει, πώς αναφέρετε λάθος.`;
---
<PageLayout title={title} description={description} lang={lang} noindex={true}
  jsonLd={[organizationSchema(lang), breadcrumbSchema([{ name: label('home', lang), path: route('home', lang) }, { name: label('about', lang), path: route('about', lang) }])]}
  breadcrumbs={[{ label: label('about', lang) }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none">
    <h1>Ποιοι είμαστε και γιατί φτιάξαμε αυτόν τον υπολογιστή</h1>
    <p class="lead">Τον ιστότοπο εκδίδει η {AUTHOR_NAME}, που δημοσιεύει δωρεάν υπολογιστές μισθού, φόρων και παροχών για αρκετές χώρες. Αυτός είναι αφιερωμένος στην Ελλάδα: στον μισθό με τις 14 καταβολές του, στα δώρα, στην αποζημίωση, στα τέλη κυκλοφορίας και στον ΕΝΦΙΑ, με πηγή δίπλα σε κάθε συντελεστή.</p>

    <h2>Γιατί άλλος ένας υπολογιστής μισθού</h2>
    <p>Γιατί οι περισσότεροι απαντούν σε μία μόνο ερώτηση, «πόσα καθαρά βγάζω», και σωπαίνουν για όσα μπερδεύουν πραγματικά. Ένα μικτό {$(1800)} δίνει {$(s.net)} σε κάθε καταβολή, αλλά {$(s.netPer12)} αν μοιράσουμε δώρα και επίδομα αδείας στους δώδεκα μήνες, και η διαφορά αυτή κρίνει μια διαπραγμάτευση ή μια σύγκριση με προσφορά από το εξωτερικό. Γι' αυτό κάθε αποτέλεσμα δείχνει και τα δύο. Το ίδιο ισχύει για τη νέα κλίμακα του ν. 5246/2025, που αλλάζει τον φόρο ανάλογα με τα τέκνα και την ηλικία: θέλαμε να φαίνεται αμέσως τι κερδίζει ένας νέος έως 25 ετών ή μια οικογένεια με τρία παιδιά.</p>
    <p>Η αγγλική έκδοση δεν είναι αυτόματη μετάφραση. Γράφεται για όσους εργάζονται στην Ελλάδα χωρίς να διαβάζουν ελληνικά και εξηγεί όρους όπως ΦΜΥ, ΚΠΚ ή ακινησία σε κάποιον που τους συναντά πρώτη φορά.</p>

    <h2>Πώς βγαίνουν τα νούμερα</h2>
    <p>Όλες οι παράμετροι του {F.year} βρίσκονται σε ένα αρχείο, με σύνδεσμο προς την επίσημη πηγή και ημερομηνία ανάγνωσης: κωδικοποιημένα κείμενα νόμων, εγκύκλιοι του e-ΕΦΚΑ, ανακοινώσεις του Υπουργείου Εργασίας και σελίδες της Επιθεώρησης Εργασίας. Ο μηχανισμός και τα κείμενα διαβάζουν μόνο αυτό το αρχείο. Τελευταίος πλήρης έλεγχος: {checked}. Πριν από κάθε δημοσίευση ο μηχανισμός περνά αυτόματους ελέγχους, ανάμεσά τους τα δώδεκα επίσημα παραδείγματα καθαρών του κατώτατου μισθού. Οι τύποι περιγράφονται στη <a href={route('method', lang)}>μεθοδολογία</a> και οι κανόνες ελέγχου στη <a href={route('editorial', lang)}>συντακτική πολιτική</a>. Πλήρης αναθεώρηση γίνεται τουλάχιστον κάθε {REVIEW_CYCLE_MONTHS} μήνες και σε κάθε αλλαγή νομοθεσίας.</p>

    <h2>Πώς συντηρείται ο ιστότοπος</h2>
    <p>Οι υπολογιστές είναι δωρεάν και δεν απαιτούν λογαριασμό. Σήμερα ο ιστότοπος δεν έχει διαφημίσεις ούτε εργαλεία μέτρησης επισκεψιμότητας. Αν μπει ποτέ διαφήμιση, δεν θα μπει πάνω από τον υπολογιστή και δεν θα επηρεάσει ούτε το αποτέλεσμα ούτε το περιεχόμενο των οδηγών. Δεν πουλάμε δεδομένα, γιατί δεν τα έχουμε: ο υπολογισμός γίνεται στη συσκευή σας. Δεν συνεργαζόμαστε με λογιστικά γραφεία, τράπεζες ή ασφαλιστικές και δεν δεχόμαστε πληρωμή για αναφορές. Λεπτομέρειες στη σελίδα <a href={route('privacy', lang)}>απορρήτου</a>.</p>

    <h2>Τι δεν αντικαθιστά</h2>
    <p>Το αποτέλεσμα είναι μια τεκμηριωμένη εκτίμηση για μια τυπική περίπτωση, όχι φορολογική ή νομική γνωμάτευση. Δεν γνωρίζουμε τα άλλα εισοδήματά σας, ειδικά καθεστώτα ή συμφωνίες με τον εργοδότη. Για μια απόφαση με μακροχρόνιες συνέπειες, όπως μια απόλυση ή η αποδοχή μιας θέσης, δείξτε τους αριθμούς σε λογιστή ή δικηγόρο. Δεν συνδεόμαστε με την ΑΑΔΕ, τον e-ΕΦΚΑ, το Υπουργείο Εργασίας ή άλλη δημόσια υπηρεσία.</p>

    <h2>Βρήκατε λάθος;</h2>
    <p>Κάθε αναφορά ελέγχεται στην πηγή. Βοηθά πολύ ο σύνδεσμος του υπολογισμού, που περιέχει όλες τις επιλογές σας, και το ποσό που περιμένατε, π.χ. από το εκκαθαριστικό. Διεύθυνση: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. Περισσότερα στη σελίδα <a href={route('contact', lang)}>επικοινωνίας</a>. Θέλετε τον υπολογιστή στη δική σας σελίδα; Δείτε το <a href={route('widget', lang)}>widget</a>.</p>

    <h2>Εκδότης</h2>
    <LegalIdentity lang={lang} />
  </div>
</PageLayout>
