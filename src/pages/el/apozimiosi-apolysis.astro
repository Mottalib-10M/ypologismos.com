---
import ToolCalc from '../../components/calc/ToolCalc';
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { severance, PARAMS as P } from '../../lib/engine/gr';
import { RETIRE_SHARE_AUX, RETIRE_SHARE_NO_AUX } from '../../lib/mini-extra-f';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const S = P.severance;
const minM = S.table_months[0].months, maxM = S.table_months[S.table_months.length - 1].months, maxFrom = S.table_months[S.table_months.length - 1].fromYears;
const ex = 1400;
const yrs = (y: number) => `${y} ${y === 1 ? 'έτος' : 'έτη'}`;
const rows = [1, 2, 4, 5, 6, 8, 10, 11, 12, 13, 14, 15, 16, 20, 25].map((y) => { const a = severance({ pay: ex, years: y }), b = severance({ pay: ex, years: y, notice: true }); return [yrs(y), String(a.months), `${a.noticeMonths} ${a.noticeMonths === 1 ? 'μήνας' : 'μήνες'}`, $(a.total), $(b.total)]; });
const e7 = severance({ pay: ex, years: 7 }), e7n = severance({ pay: ex, years: 7, notice: true });
const hiPay = 12000, hi = severance({ pay: hiPay, years: 16 }), hiFree = hiPay * hi.months * (1 + S.holiday_uplift);
const dw = 55, wk = severance({ pay: dw, daily: true, years: 9 });
const old = severance({ pay: 2600, years: 30, yearsAt2012: 20 });
const two = 2 * ex, rest = e7.total - Math.min(e7.total, two), inst = Math.ceil(rest / two - 1e-9);
const ret = severance({ pay: 2100, years: 22 });
const faqs = [
  { q: `Δουλεύω 7 χρόνια με ${$(ex)} μισθό και με απολύουν αύριο χωρίς προειδοποίηση. Πόσα μου οφείλονται;`, a: `Επτά συμπληρωμένα έτη βρίσκονται στη γραμμή «6 έως 8 έτη» του πίνακα, που δίνει ${e7.months} μισθούς. Τέσσερις φορές ${$(ex)} κάνουν ${$(e7.base)}, και η προσαύξηση 1/6 για τα δώρα και το επίδομα αδείας προσθέτει ${$(e7.uplift)}. Σύνολο ${$(e7.total)}. Αν ο εργοδότης σάς είχε δώσει έγκαιρα έγγραφη προειδοποίηση ${e7.noticeMonths} μηνών, θα όφειλε το μισό, δηλαδή ${$(e7n.total)}.` },
  { q: 'Ο εργοδότης λέει ότι θα μου δώσει την αποζημίωση σε δόσεις. Το δικαιούται;', a: `Ναι, αλλά με όρους. Όταν η αποζημίωση ξεπερνά τις αποδοχές δύο μηνών, πληρώνει κατά την απόλυση τουλάχιστον δύο μισθούς και το υπόλοιπο σε διμηνιαίες δόσεις, καθεμία όχι μικρότερη από δύο μισθούς, με την πρώτη την επομένη της συμπλήρωσης διμήνου από την απόλυση (άρθρο 74 ν. 3863/2010). Με ${$(ex)} μισθό και ${$(e7.total)} αποζημίωση, παίρνετε ${$(two)} αμέσως και το υπόλοιπο σε ${inst} δόσεις το πολύ.` },
  { q: 'Με απέλυσαν στον δέκατο μήνα. Δικαιούμαι αποζημίωση;', a: `Όχι. Ο πίνακας του ν. 4093/2012 ξεκινά από το πρώτο συμπληρωμένο έτος, και πριν από τους 12 μήνες η σχέση θεωρείται δοκιμαστική. Ο εργοδότης οφείλει μόνο έγγραφη καταγγελία της σύμβασης, σύμφωνα με την Επιθεώρηση Εργασίας. Δικαιούστε όμως ό,τι έχει ήδη γεννηθεί: τον μισθό των ημερών που δουλέψατε και την αναλογία δώρων και αδείας μέχρι την ημέρα της λύσης.` },
  { q: `Ο μισθός μου είναι ${$(hiPay)} τον μήνα. Γιατί ο υπολογιστής δεν μετράει όλο το ποσό;`, a: `Γιατί το άρθρο 5 του ν. 3198/1955 βάζει ανώτατο μηνιαίο μισθό για την αποζημίωση: οκτώ φορές το ημερομίσθιο του ανειδίκευτου εργάτη επί 30, δηλαδή ${F.sevCap} σήμερα. Με ${maxFrom} χρόνια υπηρεσίας και μισθό ${$(hiPay)}, η αποζημίωση γίνεται ${$(hi.total)} αντί για ${$(hiFree)}. Το όριο ανεβαίνει αυτόματα κάθε φορά που αυξάνεται το κατώτατο ημερομίσθιο.` },
  { q: 'Φεύγω για σύνταξη μετά από 22 χρόνια. Παίρνω ολόκληρη την αποζημίωση;', a: `Όχι ολόκληρη. Όταν ο μισθωτός αποχωρεί ή απομακρύνεται επειδή συμπλήρωσε τις προϋποθέσεις πλήρους σύνταξης γήρατος, δικαιούται ${F.pct(RETIRE_SHARE_AUX)} της αποζημίωσης χωρίς προειδοποίηση αν έχει επικουρική ασφάλιση και ${F.pct(RETIRE_SHARE_NO_AUX)} αν δεν έχει. Με μισθό ${$(2100)}, η πλήρης αποζημίωση των ${ret.months} μισθών είναι ${$(ret.total)}, άρα ${$(ret.total * RETIRE_SHARE_AUX)} ή ${$(ret.total * RETIRE_SHARE_NO_AUX)}.` },
  { q: 'Η επιχειρησιακή σύμβαση δίνει περισσότερους μισθούς από τον νόμο. Ποιο ποσό ισχύει;', a: `Ισχύει το μεγαλύτερο. Ο ν. 4093/2012 ορίζει την αποζημίωση «εκτός αν οφείλεται μεγαλύτερη αποζημίωση βάσει σύμβασης ή εθίμου». Ο πίνακας είναι επομένως το κατώτατο που οφείλει ο εργοδότης. Αν η ατομική σας σύμβαση ή μια συλλογική ρύθμιση προβλέπει περισσότερους μισθούς, ζητήστε αυτούς και χρησιμοποιήστε τον υπολογιστή μόνο ως σημείο ελέγχου.` },
];
---
<GuideLayout lang={lang} id="severance" breadcrumbLabel={label('severance', lang)}
  title={`Αποζημίωση απόλυσης ${F.year}: υπολογισμός με πίνακα και 1/6`}
  h1={`Αποζημίωση απόλυσης ${F.year}: υπολογισμός σε ευρώ, με ή χωρίς προειδοποίηση`}
  description={`Αποζημίωση απόλυσης ${F.year}: ${minM} έως ${maxM} μισθοί ανάλογα με τα έτη, συν 1/6, μισή με έγγραφη προειδοποίηση. Δωρεάν υπολογισμός με ημερομίσθιο και όριο ${F.sevCap}.`}
  intro={`Ο υπολογιστής εφαρμόζει τον πίνακα του ν. 4093/2012, την προσαύξηση 1/6 και το ανώτατο όριο του ν. 3198/1955.`}
  resume={`Η αποζημίωση απόλυσης το ${F.year} είναι από ${minM} έως ${maxM} μηνιαίους μισθούς, ανάλογα με τα συμπληρωμένα έτη στον ίδιο εργοδότη, προσαυξημένους κατά 1/6 για την αναλογία των δώρων και του επιδόματος αδείας. Κάτω από 12 μήνες δεν οφείλεται τίποτα. Από 1 έως 4 έτη αντιστοιχούν ${minM} μισθοί, και από τα ${maxFrom} έτη και πάνω το ανώτατο των ${maxM}. Για παράδειγμα, με μισθό ${$(ex)} και 7 χρόνια υπηρεσίας οφείλονται ${$(e7.total)} όταν η απόλυση γίνεται χωρίς προειδοποίηση, και ${$(e7n.total)} όταν ο εργοδότης έχει δώσει έγγραφη προειδοποίηση ${e7.noticeMonths} μηνών, γιατί τότε πληρώνει το μισό. Ο μισθός που μετράει είναι οι τακτικές αποδοχές του τελευταίου μήνα πλήρους απασχόλησης, με ανώτατο όριο ${F.sevCap} τον μήνα. Για όσους αμείβονται με ημερομίσθιο, ο μήνας λογίζεται ως ${F.sevDailyMonth} ημερομίσθια. Όσοι είχαν ήδη 17 χρόνια στον ίδιο εργοδότη στις 12 Νοεμβρίου 2012 παίρνουν επιπλέον μισθούς. Βάλτε τα δικά σας στοιχεία στον υπολογιστή.`}
  faqs={faqs}
  related={[{ href: route('sevtable', lang), name: label('sevtable', lang), description: 'Κάθε γραμμή του πίνακα και τι αλλάζει με ένα έτος ακόμη.' }, { href: route('notice', lang), name: label('notice', lang), description: 'Μήνες προειδοποίησης και γιατί μειώνουν την αποζημίωση στο μισό.' }, { href: route('home', lang), name: label('home', lang), description: 'Καθαρά από τον μικτό μισθό σας, με ηλικία και παιδιά.' }]}
  sources={[src('severance', lang), src('severance_faq', lang), src('law_3198_5', lang), src('law_4808_64', lang), src('min_wage', lang)]}>
  <div data-outil><ToolCalc client:load kind="severance" lang={lang} methodHref={route('method', lang)} /></div>

  <h2>Ο πίνακας του νόμου μεταφρασμένος σε ευρώ</h2>
  <ContentTable headers={['Υπηρεσία', 'Μισθοί', 'Προειδοποίηση', `Χωρίς προειδοποίηση (${$(ex)})`, 'Με προειδοποίηση']} align={['l', 'r', 'r', 'r', 'r']} rows={rows} highlightRow={4} />
  <p>Τα ποσά αφορούν μισθό {$(ex)} και περιλαμβάνουν ήδη την προσαύξηση 1/6. Η δεύτερη στήλη είναι ο αριθμός μισθών που ορίζει ο ν. 4093/2012 για καταγγελία χωρίς προειδοποίηση· η τρίτη, ο χρόνος έγγραφης ειδοποίησης που πρέπει να δοθεί για να πληρωθεί η τελευταία στήλη. Από το πρώτο ως το δέκατο έτος οι μισθοί ανεβαίνουν κατά κλιμάκια δύο ετών, ενώ από το δέκατο και μετά κάθε νέο έτος προσθέτει έναν μισθό, ώσπου να σταματήσει η κλίμακα στους {maxM}. Μετά τα {maxFrom} χρόνια ο πίνακας δεν ανεβαίνει άλλο: όποιος έχει 20 ή 25 χρόνια παίρνει όσους μισθούς και αυτός με {maxFrom}, εκτός αν ανήκει στους παλαιούς υπαλλήλους του 2012.</p>
  <p>Όσοι αναζητούν «αποζημιωση απολυσης υπολογισμος» ή «apozimiosi apolysis» συνήθως θέλουν ένα νούμερο για το πρώτο τηλεφώνημα στο λογιστήριο. Ο πίνακας το δίνει για έναν μισθό· για τον δικό σας, ο υπολογιστής στην κορυφή κάνει τις ίδιες πράξεις με τις παραμέτρους του {F.year}.</p>

  <h2>Από τον μισθό στο τελικό ποσό: τρεις πράξεις</h2>
  <p>Πρώτη πράξη, η βάση. Λαμβάνονται οι τακτικές αποδοχές του τελευταίου μήνα υπό καθεστώς πλήρους απασχόλησης. Αν κάποιος μετατράπηκε πρόσφατα σε μερική απασχόληση, η βάση είναι ο τελευταίος μήνας πλήρους ωραρίου και όχι ο μειωμένος μισθός. Αν ο μισθός ξεπερνά το όριο του νόμου, κόβεται στο όριο.</p>
  <p>Δεύτερη πράξη, ο πολλαπλασιασμός. Τα συμπληρωμένα έτη στον ίδιο εργοδότη δείχνουν τη γραμμή του πίνακα. Επτά χρόνια και έντεκα μήνες είναι ακόμη επτά χρόνια, άρα {e7.months} μισθοί. Με {$(ex)} αυτό δίνει {$(e7.base)}.</p>
  <p>Τρίτη πράξη, η προσαύξηση. Το σύνολο των μισθών αυξάνεται κατά 1/6, επειδή ο μηνιαίος μισθός δεν περιέχει τα δύο δώρα και το επίδομα αδείας που θα έπαιρνε ο εργαζόμενος αν συνέχιζε. Στο παράδειγμα η προσαύξηση είναι {$(e7.uplift)} και το σύνολο {$(e7.total)}. Πολλά πρόχειρα σημειώματα μισθοδοσίας ξεχνούν αυτό το βήμα· είναι το πρώτο που αξίζει να ελέγξετε.</p>

  <h2>Το ανώτατο όριο του άρθρου 5 ν. 3198/1955</h2>
  <p>Ο νόμος του 1955 εξακολουθεί να ισχύει σε ένα σημείο: ο μηνιαίος μισθός της αποζημίωσης δεν μπορεί να ξεπερνά το οκταπλάσιο του ημερομισθίου του ανειδίκευτου εργάτη, πολλαπλασιασμένο επί 30. Με κατώτατο ημερομίσθιο {F.minDaily} το όριο είναι {F.sevCap}. Αφορά λίγους, κυρίως στελέχη, αλλά γι' αυτούς η διαφορά είναι μεγάλη: με {$(hiPay)} μισθό και {maxFrom} χρόνια, η αποζημίωση είναι {$(hi.total)} αντί για {$(hiFree)}.</p>
  <p>Επειδή το όριο συνδέεται με το κατώτατο ημερομίσθιο, αλλάζει κάθε φορά που αυτό αυξάνεται. Η άνοδος του Απριλίου {F.year} το ανέβασε αυτόματα· ένα σημείωμα που χρησιμοποιεί το παλιό ποσό υπολογίζει λιγότερα.</p>

  <h2>Ημερομίσθιο: ο μήνας λογίζεται {F.sevDailyMonth} ημερομίσθια</h2>
  <p>Από 1η Ιανουαρίου 2022 υπάλληλοι και εργατοτεχνίτες έχουν τον ίδιο πίνακα. Για όσους πληρώνονται με ημερομίσθιο, ο μηνιαίος μισθός της αποζημίωσης είναι {F.sevDailyMonth} ημερομίσθια (άρθρο 64 ν. 4808/2021), εκτός αν ήδη αμείβονται με μηνιαίο μισθό. Με ημερομίσθιο {$(dw)} και 9 χρόνια, ο μήνας λογίζεται {$(wk.monthly)} και η αποζημίωση φτάνει τα {$(wk.total)}. Περισσότερα, μαζί με το παλιό καθεστώς, στον οδηγό για την <a href={route('sevworkers', lang)}>αποζημίωση των εργατοτεχνιτών</a>.</p>

  <h2>Όσοι είχαν 17 χρόνια στις 12 Νοεμβρίου 2012</h2>
  <p>Ο ν. 4093/2012 συνοδεύτηκε από μια μεταβατική ρύθμιση. Όποιος είχε τότε συμπληρώσει τουλάχιστον 17 χρόνια στον ίδιο εργοδότη παίρνει, πάνω από τους {maxM} μισθούς, έναν επιπλέον μισθό στα 17 χρόνια και έως 12 στα 28. Ο αριθμός μένει παγωμένος στην ημερομηνία εκείνη και ο μισθός των επιπλέον μηνών μετράει έως {F.sevExtraCap}. Με 20 χρόνια το 2012, 30 σήμερα και μισθό {$(2600)}, το σύνολο φτάνει {$(old.total)}. Οι λεπτομέρειες βρίσκονται στη σελίδα για την <a href={route('sevold', lang)}>αποζημίωση των παλαιών υπαλλήλων</a>.</p>

  <h2>Έγγραφη προειδοποίηση: γιατί μειώνει το ποσό στο μισό</h2>
  <p>Ο εργοδότης μπορεί να ειδοποιήσει γραπτώς τον εργαζόμενο από {S.notice_months[0].months} έως {S.notice_months[S.notice_months.length - 1].months} μήνες πριν, ανάλογα με τα χρόνια. Ο εργαζόμενος συνεχίζει να δουλεύει και να πληρώνεται σε αυτό το διάστημα, και στο τέλος παίρνει τη μισή αποζημίωση. Στο παράδειγμα των επτά ετών, η διαφορά είναι {$(e7.total - e7n.total)}. Πότε αρχίζει να μετράει η προθεσμία και τι συμφέρει κάθε πλευρά εξηγεί ο οδηγός για την <a href={route('notice', lang)}>προειδοποίηση απόλυσης</a>.</p>

  <div data-chrome><MiniSim client:load kind="sevinstal" lang={lang} href={route('severance', lang)} /></div>

  <h2>Πότε πληρώνεται και πότε επιτρέπονται δόσεις</h2>
  <p>Η αποζημίωση καταβάλλεται μαζί με την καταγγελία της σύμβασης. Μόνο στην τακτική καταγγελία, δηλαδή με προειδοποίηση, πληρώνεται στη λήξη του χρόνου προειδοποίησης. Η πληρωμή γίνεται υποχρεωτικά σε λογαριασμό πληρωμών και όχι με μετρητά (ν. 4611/2019).</p>
  <p>Αν το ποσό ξεπερνά τις αποδοχές δύο μηνών, ο εργοδότης έχει δικαίωμα να πληρώσει δύο μισθούς την ημέρα της απόλυσης και τα υπόλοιπα σε διμηνιαίες δόσεις, καθεμία τουλάχιστον δύο μισθών. Με {$(ex)} μισθό, από τα {$(e7.total)} του παραδείγματος παίρνετε {$(two)} αμέσως και {$(rest)} σε {inst} δόσεις το πολύ. Ο μικρός υπολογιστής παραπάνω δείχνει το χρονοδιάγραμμα για κάθε μισθό.</p>

  <h2>Τι δεν υπολογίζει το εργαλείο</h2>
  <p>Ο υπολογιστής δίνει την ελάχιστη νόμιμη αποζημίωση για σύμβαση αορίστου χρόνου. Δεν βλέπει τρεις περιπτώσεις. Η πρώτη είναι η ευνοϊκότερη σύμβαση ή το έθιμο: ο νόμος ορίζει ρητά ότι υπερισχύει η μεγαλύτερη αποζημίωση. Η δεύτερη είναι η αποχώρηση για σύνταξη: όποιος φεύγει επειδή θεμελίωσε πλήρη σύνταξη γήρατος παίρνει {F.pct(RETIRE_SHARE_AUX)} της αποζημίωσης αν έχει επικουρική ασφάλιση και {F.pct(RETIRE_SHARE_NO_AUX)} αν δεν έχει. Η τρίτη είναι η αποχώρηση με συγκατάθεση του εργοδότη μετά από 15 χρόνια ή στο όριο ηλικίας, που κατά το άρθρο 8 του ν. 3198/1955 δίνει το μισό της νόμιμης αποζημίωσης.</p>
  <p>Επίσης, το εργαλείο δεν προσθέτει ποσά που οφείλονται ξεχωριστά κατά τη λύση, όπως η άδεια που δεν πάρθηκε ή η αναλογία των δώρων. Αυτά πληρώνονται επιπλέον και δεν περιέχονται στην προσαύξηση 1/6, η οποία αφορά μόνο τους μισθούς της αποζημίωσης. Για τα καθαρά του τελευταίου μισθού χρησιμοποιήστε τον βασικό <a href={route('home', lang)}>υπολογισμό μισθού</a>.</p>
</GuideLayout>
