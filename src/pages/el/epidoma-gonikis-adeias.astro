---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { parentalBenefit, salary, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const Q = P.parental;
const b = parentalBenefit(), bs = parentalBenefit({ single: true }), bm = parentalBenefit({ multiple: true });
const ee = b.monthly * P.efka.employee_rate;
const rows = [
  ['Ένας γονέας, ένα παιδί', String(b.months), $(b.perMonth), $(b.total)],
  ['Και οι δύο γονείς (ο καθένας χωριστά)', `${b.months} + ${b.months}`, $(b.perMonth), $(b.total * 2)],
  ['Δίδυμα ή πολύδυμα', String(bm.months), $(bm.perMonth), $(bm.total)],
  ['Μόνος γονέας', String(bs.months), $(bs.perMonth), $(bs.total)],
];
const sMin = salary({ gross: P.minimum_wage.monthly });
const PAT = 14;
const faqs = [
  { q: 'Πόσα είναι τα χρήματα της γονικής άδειας το 2026;', a: `Η ΔΥΠΑ πληρώνει για τους δύο πρώτους μήνες της γονικής άδειας ποσό ίσο με τον κατώτατο μισθό, ${F.minWage}, συν την αναλογία δώρων και επιδόματος αδείας. Με την προσαύξηση του 1/6 που εφαρμόζουμε, αυτό κάνει ${F.parentalMonthly} μικτά τον μήνα και ${F.parentalTotal} συνολικά. Από το ποσό η ΔΥΠΑ παρακρατεί την εισφορά του ασφαλισμένου.` },
  { q: 'Δουλεύω 10 μήνες στη νέα εταιρεία. Δικαιούμαι γονική άδεια;', a: `Όχι ακόμη. Ο νόμος ζητά να έχετε συμπληρώσει ένα έτος εργασίας στον ίδιο εργοδότη, συνεχόμενα ή με διαδοχικές συμβάσεις ορισμένου χρόνου, εκτός αν ευνοϊκότερη ρύθμιση, για παράδειγμα συλλογική σύμβαση, προβλέπει λιγότερο. Μόλις κλείσετε τον χρόνο, το δικαίωμα των ${Q.leave_months} μηνών ισχύει έως ότου το παιδί γίνει ${Q.child_max_age} ετών.` },
  { q: 'Παίρνουμε επίδομα γονικής άδειας και οι δύο γονείς;', a: `Ναι. Το δικαίωμα είναι ατομικό και αμεταβίβαστο: κάθε γονέας έχει τους δικούς του ${Q.leave_months} μήνες και η ΔΥΠΑ πληρώνει το επίδομα στον καθένα για τους πρώτους ${Q.paid_months}. Έτσι η οικογένεια μπορεί να λάβει έως ${$(b.total * 2)} μικτά. Αν δουλεύετε στον ίδιο εργοδότη, αποφασίζετε με κοινή δήλωση ποιος παίρνει πρώτος την άδεια και για πόσο.` },
  { q: 'Μπορώ να πάρω τη γονική άδεια με μειωμένο ωράριο αντί για ολόκληρους μήνες;', a: `Ναι. Η άδεια μπορεί να δοθεί συνεχόμενα, τμηματικά ή με άλλο ευέλικτο τρόπο, όπως μειωμένο ημερήσιο ωράριο ή ημέρες άδειας κατανεμημένες ανά εβδομάδα ή μήνα, χωρίς να χάνεται το επίδομα. Στην αίτηση γράφετε πόσο χρόνο θέλετε ευέλικτα και με ποια μορφή· ο εργοδότης πρέπει να αιτιολογήσει γραπτώς μια απόρριψη μέσα σε έναν μήνα.` },
  { q: 'Πόσες ημέρες είναι η άδεια πατρότητας και πότε την παίρνω;', a: `Δεκατέσσερις εργάσιμες ημέρες με αποδοχές, κατά τη γέννηση του παιδιού (άρθρο 27 ν. 4808/2021). Μπορείτε να πάρετε δύο ημέρες πριν από την πιθανή ημερομηνία τοκετού και τις υπόλοιπες δώδεκα μέσα σε 30 ημέρες από τη γέννηση, ή όλες μετά τη γέννηση. Δεν απαιτείται προϋπηρεσία και ο εργοδότης είναι υποχρεωμένος να τη χορηγήσει.` },
  { q: 'Ο εργοδότης αρνείται να μου δώσει τη γονική άδεια τον μήνα που ζήτησα. Μπορεί;', a: `Μπορεί να την αναβάλει μόνο αν η απουσία θα διατάρασσε σοβαρά τη λειτουργία της επιχείρησης, και τότε οφείλει να το τεκμηριώσει γραπτώς και να προτείνει εναλλακτικές. Σε κάθε περίπτωση πρέπει να τη χορηγήσει μέσα σε δύο μήνες από την αίτηση, η οποία υποβάλλεται τουλάχιστον έναν μήνα πριν. Ορισμένες κατηγορίες, όπως οι μόνοι γονείς, έχουν απόλυτη προτεραιότητα.` },
];
---
<GuideLayout lang={lang} id="parental" breadcrumbLabel={label('parental', lang)}
  title={`Επίδομα γονικής άδειας ${F.year}: ${F.parentalMonthly} τον μήνα από τη ΔΥΠΑ`}
  h1={`Επίδομα γονικής άδειας ${F.year}: ποσό, προϋποθέσεις και διάρκεια`}
  description={`Επίδομα γονικής άδειας ${F.year}: η ΔΥΠΑ πληρώνει ${F.parentalMonthly} τον μήνα για ${F.parentalMonths} μήνες, έως ${F.parentalTotal}. Άδεια ${F.parentalLeave} μηνών, δίδυμα, μόνος γονέας, άδεια πατρότητας ${PAT} ημερών.`}
  intro={`Κάθε εργαζόμενος γονέας έχει ${Q.leave_months} μήνες γονικής άδειας, και για τους δύο πρώτους η ΔΥΠΑ πληρώνει επίδομα ίσο με τον κατώτατο μισθό συν αναλογία δώρων.`}
  resume={`Το επίδομα γονικής άδειας είναι ${F.parentalMonthly} μικτά τον μήνα το ${F.year}: ο κατώτατος μισθός των ${F.minWage} συν την αναλογία δώρων εορτών και επιδόματος αδείας, που υπολογίζουμε στο 1/6. Το πληρώνει η ΔΥΠΑ (πρώην ΟΑΕΔ) για τους ${Q.paid_months} πρώτους από τους ${Q.leave_months} μήνες γονικής άδειας του άρθρου 28 του ν. 4808/2021, δηλαδή ${F.parentalTotal} συνολικά για κάθε γονέα. Δικαιούχος είναι κάθε εργαζόμενος γονέας με ένα έτος εργασίας στον ίδιο εργοδότη, και η άδεια παίρνεται μέχρι το παιδί να κλείσει τα ${Q.child_max_age}. Οι γονείς διδύμων ή πολυδύμων παίρνουν το επίδομα για ${Q.paid_months} μήνες επιπλέον, συνολικά ${$(bm.total)}, και ο μόνος γονέας τα δικαιούται εις διπλούν, επίσης ${$(bs.total)}. Οι υπόλοιποι ${Q.leave_months - Q.paid_months} μήνες είναι χωρίς αποδοχές, εκτός αν συμφωνηθεί διαφορετικά. Ξεχωριστά, ο πατέρας έχει ${PAT} εργάσιμες ημέρες άδειας πατρότητας με αποδοχές. Ο υπολογιστής παρακάτω δείχνει το ποσό για τη δική σας περίπτωση.`}
  faqs={faqs}
  related={[{ href: route('minimum', lang), name: label('minimum', lang), description: `Ο κατώτατος ${F.minWage} πάνω στον οποίο υπολογίζεται το επίδομα.` }, { href: route('leave', lang), name: label('leave', lang), description: 'Η γονική άδεια μετρά για την ετήσια άδεια και το επίδομα.' }, { href: route('severance', lang), name: label('severance', lang), description: 'Ο χρόνος της άδειας μετρά και στην αποζημίωση.' }]}
  sources={[src('parental', lang), { name: 'Ν. 4808/2021, άρθρο 27: άδεια πατρότητας 14 εργάσιμων ημερών', url: 'https://www.taxheaven.gr/law/4808/2021/arthro/27' }, src('min_wage', lang), src('efka_rates', lang)]}>
  <div data-chrome><MiniSim client:load kind="parental" lang={lang} href={route('home', lang)} /></div>

  <h2>Πόσα πληρώνει η ΔΥΠΑ σε κάθε περίπτωση</h2>
  <ContentTable headers={['Περίπτωση', 'Μήνες με επίδομα', 'Ανά μήνα (μικτά)', 'Σύνολο (μικτά)']} align={['l', 'l', 'r', 'r']} rows={rows} highlightRow={0} />
  <p>Το μηνιαίο ποσό είναι ίδιο για όλους, ανεξάρτητα από τον μισθό του γονέα: {F.minWage} κατώτατος μισθός και {$(b.holiday)} αναλογία δώρων και επιδόματος αδείας. Τα ποσά είναι μικτά. Ο νόμος ορίζει ότι για τον επιδοτούμενο χρόνο η ΔΥΠΑ παρακρατεί από το επίδομα την εισφορά του ασφαλισμένου και την αποδίδει στον ασφαλιστικό φορέα μαζί με την εργοδοτική, που βαρύνει την ίδια. Με το ποσοστό του ΚΠΚ {F.kpk}, η εισφορά του γονέα επί του κατώτατου είναι περίπου {$(ee)} τον μήνα.</p>
  <p>Όσοι αναζητούν «επιδομα γονικης αδειας» συχνά υποθέτουν ότι το ποσό είναι ποσοστό του μισθού τους. Δεν είναι: είναι σταθερό και ακολουθεί τον κατώτατο μισθό, άρα αυξήθηκε αυτόματα όταν ο κατώτατος ανέβηκε από {F.minWage2025} σε {F.minWage} την 1η Απριλίου {F.year}. Για όποιον αμείβεται με τον κατώτατο, το επίδομα αντιστοιχεί στις μικτές αποδοχές του· για όποιον παίρνει περισσότερα, η διαφορά είναι αισθητή, όπως δείχνει ο δεύτερος υπολογιστής πιο κάτω.</p>

  <h2>Ποιος δικαιούται και μέχρι πότε</h2>
  <p>Η γονική άδεια είναι ατομικό και αμεταβίβαστο δικαίωμα κάθε εργαζόμενου γονέα, ή του προσώπου που ασκεί τη γονική μέριμνα, για την ανατροφή του παιδιού. Διαρκεί {Q.leave_months} μήνες και μπορεί να χρησιμοποιηθεί συνεχόμενα ή τμηματικά, έως ότου το παιδί συμπληρώσει τα {Q.child_max_age} έτη. Σε υιοθεσία ή αναδοχή παιδιού έως {Q.child_max_age} ετών, ξεκινά από την ένταξη του παιδιού στην οικογένεια.</p>
  <p>Η προϋπόθεση είναι ένα έτος εργασίας στον ίδιο εργοδότη, συνεχόμενα ή με διαδοχικές συμβάσεις ορισμένου χρόνου, εκτός αν νόμος, συλλογική σύμβαση ή συμφωνία προβλέπει κάτι ευνοϊκότερο. Με περισσότερα παιδιά, το δικαίωμα στην άδεια και στο επίδομα είναι αυτοτελές για καθένα, εφόσον από τη λήξη της προηγούμενης άδειας έχει μεσολαβήσει ένας χρόνος πραγματικής απασχόλησης στον ίδιο εργοδότη. Αν η σύμβασή σας είναι ορισμένου χρόνου, η γονική άδεια διακόπτεται όταν λήξει η σύμβαση και μπορεί να συνεχιστεί αν ανανεωθεί ή αν προσληφθείτε από άλλον εργοδότη.</p>

  <h2>Δίδυμα, τρίδυμα και μόνοι γονείς</h2>
  <p>Οι γονείς διδύμων, τριδύμων ή περισσότερων παιδιών που γεννήθηκαν μαζί μπορούν να πάρουν τη γονική άδεια για κάθε παιδί χωριστά, διακεκομμένα ή συνεχόμενα, και δικαιούνται το επίδομα για {Q.paid_months} μήνες επιπλέον, ανεξάρτητα από τον αριθμό των παιδιών. Σε ποσό, αυτό σημαίνει {$(bm.total)} αντί για {F.parentalTotal}.</p>
  <p>Μόνοι γονείς, για τον νόμο, είναι όσοι μεγαλώνουν το παιδί μόνοι λόγω θανάτου του άλλου γονέα, ολικής αφαίρεσης της γονικής μέριμνας ή μη αναγνώρισης του παιδιού από τον άλλο γονέα. Αυτοί δικαιούνται τη γονική άδεια και το επίδομα εις διπλούν: {Q.paid_months * 2} μήνες επιδότησης, {$(bs.total)} μικτά.</p>

  <div data-chrome><MiniSim client:load kind="parentalgap" lang={lang} href={route('home', lang)} /></div>

  <h2>Η αίτηση στον εργοδότη και οι προθεσμίες</h2>
  <p>Η αίτηση υποβάλλεται στον εργοδότη γραπτά ή ηλεκτρονικά, τουλάχιστον έναν μήνα πριν από την έναρξη, εκτός αν έκτακτοι λόγοι επιβάλλουν συντομότερο χρόνο, και ορίζει πότε αρχίζει και πότε τελειώνει η άδεια. Ο εργοδότης απαντά αμέσως και το αργότερο μέσα σε έναν μήνα. Υποχρεούται να τη χορηγήσει στον χρόνο που ζητήσατε, εκτός αν αυτό θα διατάρασσε σοβαρά τη λειτουργία της επιχείρησης· τότε πρέπει να εξηγήσει γραπτώς τον λόγο και μπορεί να προτείνει άλλες ημερομηνίες ή ευέλικτη μορφή. Το αργότερο μέσα σε δύο μήνες από την αίτηση, η άδεια πρέπει να δοθεί. Η άδεια αναρτάται στο ΕΡΓΑΝΗ.</p>
  <p>Απόλυτη προτεραιότητα έχουν οι αιτήσεις γονέων με αναπηρία, γονέων παιδιών με αναπηρία ή με μακροχρόνια ή αιφνίδια ασθένεια, πολύτεκνων, μόνων γονέων, καθώς και γυναικών μετά την άδεια μητρότητας και την ειδική παροχή προστασίας της μητρότητας. Προτεραιότητα δίνεται και σε γονείς διδύμων ή πολυδύμων και μετά από πρόωρο τοκετό.</p>

  <h2>Τι μένει προστατευμένο όσο λείπετε</h2>
  <p>Ο επιδοτούμενος χρόνος λογίζεται ως χρόνος ασφάλισης για κύρια σύνταξη, ασθένεια και επικουρική. Για τους μήνες χωρίς επίδομα, ο γονέας μπορεί να αναγνωρίσει τον χρόνο στον ασφαλιστικό του φορέα, σύμφωνα με το άρθρο 40 του ν. 2084/1992, αν δεν έχει συμφωνηθεί να πληρώνει αποδοχές ο εργοδότης. Όλη η διάρκεια της γονικής άδειας μετρά ως πραγματική υπηρεσία για τις αποδοχές, την ετήσια άδεια και το <a href={route('leave', lang)}>επίδομα αδείας</a>, την εξέλιξη και την <a href={route('severance', lang)}>αποζημίωση απόλυσης</a>. Μετά την άδεια επιστρέφετε στην ίδια ή σε ισοδύναμη θέση, με όχι λιγότερο ευνοϊκούς όρους.</p>

  <h2>Η άδεια πατρότητας των {PAT} ημερών</h2>
  <p>Η γονική άδεια δεν πρέπει να συγχέεται με την άδεια πατρότητας του άρθρου 27 του ίδιου νόμου. Κάθε εργαζόμενος πατέρας δικαιούται {PAT} εργάσιμες ημέρες άδειας με αποδοχές, κατά τη γέννηση του παιδιού: είτε δύο ημέρες πριν από την αναμενόμενη ημερομηνία τοκετού και τις υπόλοιπες δώδεκα μέσα σε 30 ημέρες από τη γέννηση, είτε όλες μετά τη γέννηση. Η άδεια χορηγείται υποχρεωτικά, χωρίς προϋπηρεσία και ανεξάρτητα από την οικογενειακή κατάσταση. Επειδή είναι άδεια με αποδοχές, ο πατέρας με τον κατώτατο μισθό κρατά τα κανονικά του καθαρά, {$(sMin.net)} ανά καταβολή, όπως δείχνει ο <a href={route('home', lang)}>υπολογισμός μισθού</a>.</p>
</GuideLayout>
