---
import ToolCalc from '../../components/calc/ToolCalc';
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { src } from '../../lib/facts';
import { incomeTax, PARAMS as P } from '../../lib/engine/gr';
import { businessTax } from '../../lib/engine/foroi';
import { formatMoney, pct } from '../../lib/format';
const lang = 'el';
const $ = (x: number) => formatMoney(x, 0, lang);
const p = (x: number) => pct(x, lang);
const Y = P.year;
const B = P.business;
const ex = incomeTax(24000);
const exB = businessTax(24000);
const st = businessTax(9000, 0, 'over30', true), st0 = businessTax(9000);
const rows = [8000, 12000, 15000, 20000, 30000, 45000, 70000].map((i) => { const s = incomeTax(i), b = businessTax(i); return [$(i), $(s.tax), p(s.average), $(b.tax), p(b.average)]; });
const kidRows = [0, 1, 2, 3, 4].map((k) => { const s = incomeTax(24000, k), b = businessTax(24000, k); return [String(k), $(s.tax), $(b.tax)]; });
const faqs = [
  { q: 'Πώς υπολογίζεται ο φόρος εισοδήματος για ελεύθερους επαγγελματίες;', a: `Με την ίδια κλίμακα του άρθρου 15 ΚΦΕ που ισχύει για τους μισθωτούς, αλλά χωρίς τη μείωση φόρου του άρθρου 16, σύμφωνα με το άρθρο 29. Για ${$(24000)} καθαρά κέρδη ο φόρος είναι ${$(exB.tax)}, ενώ για τον ίδιο μισθό ${$(ex.tax)}. Τα κέρδη προστίθενται σε τυχόν μισθό ή σύνταξη και φορολογούνται μαζί τους.` },
  { q: 'Υπάρχει έκπτωση φόρου για όσους ξεκινούν δραστηριότητα;', a: `Ναι. Για τα ${B.starter_years} πρώτα έτη από την πρώτη έναρξη, ο συντελεστής του πρώτου κλιμακίου μειώνεται κατά ${p(B.starter_first_bracket_cut)}, εφόσον τα ακαθάριστα έσοδα της χρονιάς δεν ξεπερνούν τις ${$(B.starter_gross_limit)}. Με ${$(9000)} κέρδη ο φόρος πέφτει από ${$(st0.tax)} σε ${$(st.tax)}. Αν ο τζίρος περάσει το όριο, η μείωση χάνεται για εκείνη τη χρονιά.` },
  { q: 'Ο συνταξιούχος πληρώνει τον ίδιο φόρο με τον μισθωτό;', a: `Ναι. Μισθοί και συντάξεις φορολογούνται με την ίδια κλίμακα και παίρνουν την ίδια μείωση φόρου του άρθρου 16, με τα ίδια ποσά ανά αριθμό παιδιών. Για ${$(24000)} φορολογητέο εισόδημα ο φόρος είναι ${$(ex.tax)} και για τους δύο. Η διαφορά βρίσκεται στις κρατήσεις πριν από τον φόρο, που για τη σύνταξη είναι άλλες από τις εισφορές ενός μισθωτού.` },
  { q: 'Τι είναι το ελάχιστο τεκμαρτό εισόδημα των ελεύθερων επαγγελματιών;', a: `Ένα ελάχιστο καθαρό εισόδημα που ορίζει το άρθρο 28Α του ΚΦΕ για τους ατομικούς επιχειρηματίες, όταν τα δηλωμένα κέρδη είναι χαμηλότερα. Εξαρτάται από τον μισθό αναφοράς, το τζίρο και πολλές εξαιρέσεις και μειώσεις, όπως για νέες μητέρες ή μικρούς οικισμούς. Ο υπολογιστής δεν το εφαρμόζει: υπολογίζει τον φόρο πάνω στο ποσό που του δίνετε.` },
];
---
<GuideLayout lang={lang} id="incometax" breadcrumbLabel={label('incometax', lang)}
  title={`Φόρος εισοδήματος ${Y}: μισθωτοί και ελεύθεροι επαγγελματίες`}
  h1={`Φόρος εισοδήματος ${Y}: μισθωτοί, συνταξιούχοι, ελεύθεροι επαγγελματίες`}
  description={`Φόρος εισοδήματος ${Y}: ετήσιος φόρος για μισθό, σύνταξη ή κέρδη ελεύθερου επαγγελματία, με τη νέα κλίμακα, τα παιδιά, την ηλικία και το όφελος των νέων.`}
  intro={`Η κλίμακα είναι κοινή για όλους. Αυτό που αλλάζει ανάμεσα σε μισθωτό και ελεύθερο επαγγελματία είναι η μείωση φόρου του άρθρου 16.`}
  resume={`Με φορολογητέο εισόδημα ${$(24000)} τον χρόνο, ένας μισθωτός ή συνταξιούχος άνω των 30 χωρίς παιδιά πληρώνει φόρο εισοδήματος ${$(ex.tax)} το ${Y}, ενώ ένας ελεύθερος επαγγελματίας με τα ίδια καθαρά κέρδη πληρώνει ${$(exB.tax)}. Και οι δύο φορολογούνται με την κλίμακα του άρθρου 15 ΚΦΕ που έφερε ο ν. 5246/2025, από ${p(P.tax.brackets[0].rate)} έως ${p(P.tax.brackets[P.tax.brackets.length - 1].rate)}, με χαμηλότερους συντελεστές για όσους έχουν παιδιά και για τους νέους έως 30 ετών. Η διαφορά είναι η μείωση φόρου του άρθρου 16, έως ${$(P.tax.credit_by_children[0])} χωρίς παιδιά, που δίνεται μόνο σε μισθούς και συντάξεις· το άρθρο 29 την αποκλείει για τα κέρδη από επιχειρηματική δραστηριότητα. Ο ελεύθερος επαγγελματίας που ξεκινά έχει όμως μισό συντελεστή στο πρώτο κλιμάκιο για ${B.starter_years} χρόνια, αν ο τζίρος του μένει έως ${$(B.starter_gross_limit)}. Ο υπολογιστής δίνει τον φόρο, τον μέσο και τον οριακό συντελεστή, και τον φόρο που θα πληρώνατε στην άλλη περίπτωση.`}
  faqs={faqs}
  related={[{ href: route('brackets', lang), name: label('brackets', lang), description: 'Η κλίμακα αναλυτικά και η σύγκριση με το 2025.' }, { href: route('taxreturn', lang), name: label('taxreturn', lang), description: 'Ο φόρος της δήλωσης μαζί με τα ενοίκια.' }, { href: route('credit', lang), name: label('credit', lang), description: 'Η μείωση φόρου που κρατούν μόνο μισθωτοί και συνταξιούχοι.' }]}
  sources={[src('tax_scale', lang), src('tax_credit', lang), src('business_tax', lang), src('tax_2026_start', lang)]}>
  <div data-outil><ToolCalc client:load kind="incometax" lang={lang} methodHref={route('method', lang)} /></div>

  <h2>Μισθωτός ή ελεύθερος επαγγελματίας: ο φόρος δίπλα δίπλα</h2>
  <ContentTable headers={['Φορολογητέο', 'Μισθός ή σύνταξη', 'Μέσος', 'Ελεύθερο επάγγελμα', 'Μέσος']} align={['r', 'r', 'r', 'r', 'r']} rows={rows} />
  <p>Χαμηλά, η διαφορά είναι μεγάλη σε ποσοστό: με {$(8000)} ο μισθωτός δεν πληρώνει τίποτα, γιατί η μείωση καλύπτει όλο τον φόρο, ενώ ο ελεύθερος επαγγελματίας πληρώνει {p(P.tax.brackets[0].rate)}. Ψηλά, η μείωση φθίνει κατά {$(P.tax.credit_taper_per_1000)} για κάθε {$(1000)} πάνω από τις {$(P.tax.credit_taper_threshold)} και τελικά μηδενίζεται, οπότε οι δύο φόροι συγκλίνουν. Ο πίνακας αφορά φορολογούμενο άνω των 30 χωρίς παιδιά.</p>
  <div data-chrome><MiniSim client:load kind="busvssal" lang={lang} href={route('incometax', lang)} /></div>

  <h2>Τι αλλάζουν τα παιδιά</h2>
  <ContentTable headers={['Παιδιά', `Μισθωτός, ${$(24000)}`, `Ελεύθερος, ${$(24000)}`]} align={['l', 'r', 'r']} rows={kidRows} />
  <p>Τα παιδιά μειώνουν τον συντελεστή του δεύτερου και του τρίτου κλιμακίου για όλους, γιατί αλλάζουν την ίδια την κλίμακα. Μόνο ο μισθωτός κερδίζει επιπλέον από τη μεγαλύτερη μείωση του άρθρου 16. Από τέσσερα παιδιά, τα δύο πρώτα κλιμάκια έχουν συντελεστή μηδέν, και αυτό ωφελεί εξίσου τον ελεύθερο επαγγελματία.</p>

  <h2>Τα τρία πρώτα χρόνια μιας νέας δραστηριότητας</h2>
  <div data-chrome><MiniSim client:load kind="starter" lang={lang} href={route('incometax', lang)} /></div>
  <p>Η μείωση του άρθρου 29 παρ. 2 αφορά όσους έκαναν πρώτη έναρξη από το 2013 και μετά, για τα {B.starter_years} πρώτα έτη, και κόβει στο μισό μόνο τον συντελεστή του πρώτου κλιμακίου. Το μέγιστο όφελος είναι λοιπόν μικρό, όσο το μισό του φόρου στις πρώτες {$(P.tax.brackets[0].upTo as number)}, αλλά για έναν νέο επαγγελματία με χαμηλό τζίρο είναι ουσιαστικό. Η πλήρης <a href={route('taxreturn', lang)}>φορολογική δήλωση</a> προσθέτει τα ενοίκια και την παρακράτηση.</p>
</GuideLayout>
