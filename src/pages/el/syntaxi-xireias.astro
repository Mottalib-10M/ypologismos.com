---
import ToolCalc from '../../components/calc/ToolCalc';
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { src } from '../../lib/facts';
import { PARAMS as P } from '../../lib/engine/gr';
import { widowPension } from '../../lib/engine/epidomata';
import { formatMoney, pct } from '../../lib/format';
const lang = 'el';
const $ = (x: number) => formatMoney(x, 0, lang);
const p = (x: number) => pct(x, lang);
const W = P.widow;
const ex = widowPension({ pension: 1000, age: 58 });
const work = widowPension({ pension: 1000, age: 58, works: true });
const shareRows = [[0, false], [1, false], [2, false], [3, false], [2, true]].map(([k, o]) => { const r = widowPension({ pension: 1000, children: k as number, orphans: o as boolean }); return [o ? `${k} ορφανά και από τους δύο γονείς` : `Σύζυγος${k ? ` και ${k} ${k === 1 ? 'παιδί' : 'παιδιά'}` : ''}`, $(r.spouse), $(r.perChild), $(r.total)]; });
const ageRows = [
  [`${W.lifetime_age} ετών και άνω`, 'Εφ’ όρου ζωής'],
  [`Κάτω των ${W.lifetime_age}, με παιδί που δικαιούται σύνταξη`, 'Όσο το παιδί δικαιούται, και συνεχίζει'],
  [`Κάτω των ${W.lifetime_age}, με αναπηρία 67 %+`, 'Εφ’ όρου ζωής'],
  [`Κάτω των ${W.lifetime_age}, χωρίς παιδιά`, `${W.temporary_years} χρόνια, ξανά από τα ${W.resume_age}`],
];
const faqs = [
  { q: 'Τι ποσοστό της σύνταξης παίρνει η χήρα;', a: `${p(W.spouse_share)} της σύνταξης που έπαιρνε ή δικαιούνταν ο θανών, για θανάτους από 17 Μαΐου 2019· πριν ήταν ${p(W.spouse_share_before_2019)}. Σε σύνταξη ${$(1000)} αυτό κάνει ${$(ex.spouse)} τον μήνα. Ο κανόνας είναι ίδιος για χήρα και χήρο, και η σύνταξη σταματά αν ο επιζών ξαναπαντρευτεί ή συνάψει σύμφωνο συμβίωσης.` },
  { q: 'Κόβεται η σύνταξη χηρείας αν εργάζομαι;', a: `Όχι τα τρία πρώτα χρόνια: η σύνταξη καταβάλλεται ολόκληρη για μια τριετία από τον θάνατο. Μετά, αν εργάζεστε, ασκείτε ελεύθερο επάγγελμα ή παίρνετε δική σας σύνταξη, καταβάλλεται το ${p(W.reduced_share)}, χωρίς να πέφτει κάτω από το νόμιμο ελάχιστο. Σε σύνταξη θανόντος ${$(1000)}, τα ${$(ex.spouse)} γίνονται ${$(work.after3)}. Με αναπηρία 67 % και άνω δεν γίνεται περικοπή.` },
  { q: 'Είμαι 48 ετών χωρίς παιδιά. Θα πάρω σύνταξη χηρείας;', a: `Ναι, αλλά για ${W.temporary_years} χρόνια. Αν ο επιζών σύζυγος δεν έχει κλείσει τα ${W.lifetime_age} κατά τον θάνατο, η σύνταξη δίνεται για μια τριετία και ξαναρχίζει όταν συμπληρώσει τα ${W.resume_age}. Εξαιρούνται όσοι έχουν παιδί που δικαιούται σύνταξη και όσοι έχουν ανικανότητα 67 % και άνω.` },
  { q: 'Πόσα χρόνια γάμου χρειάζονται για σύνταξη χηρείας;', a: `Τουλάχιστον ${W.min_marriage_years}. Αν ο θάνατος συμβεί νωρίτερα, δεν δίνεται σύνταξη, εκτός αν οφείλεται σε ατύχημα, αν γεννήθηκε ή υιοθετήθηκε παιδί μέσα στον γάμο, ή αν η χήρα ήταν έγκυος και το παιδί γεννήθηκε ζωντανό. Εξαίρεση υπάρχει και για επανάληψη γάμου με τον ίδιο σύζυγο, με συνολική διάρκεια τουλάχιστον πέντε ετών.` },
];
---
<GuideLayout lang={lang} id="widow" breadcrumbLabel={label('widow', lang)}
  title={`Σύνταξη χηρείας ${P.year}: ${p(W.spouse_share)} για τον σύζυγο, όροι, περικοπή`}
  h1={`Σύνταξη χηρείας: πόσα παίρνουν ο σύζυγος και τα παιδιά`}
  description={`Σύνταξη χηρείας ${P.year}: ${p(W.spouse_share)} της σύνταξης του θανόντος για τον σύζυγο, ${p(W.child_share)} για κάθε παιδί, τριετία για όσους είναι κάτω των ${W.lifetime_age} και περικοπή ${p(W.reduced_share)} με εργασία.`}
  intro={`Η σύνταξη λόγω θανάτου του ν. 4387/2016 μοιράζει τη σύνταξη του θανόντος σε ποσοστά, με έναν περιορισμό ηλικίας και μια περικοπή που αρχίζει μετά τα τρία χρόνια.`}
  resume={`Αν ο θανών έπαιρνε σύνταξη ${$(1000)}, ο επιζών σύζυγος 58 ετών παίρνει σύνταξη χηρείας ${$(ex.spouse)} τον μήνα, εφ’ όρου ζωής. Το άρθρο 12 του ν. 4387/2016 δίνει στον σύζυγο ${p(W.spouse_share)} της σύνταξης για θανάτους από 17 Μαΐου 2019, και σε κάθε παιδί κάτω των ${W.child_max_age} ${p(W.child_share)}, ή ${p(W.orphan_share)} αν είναι ορφανό και από τους δύο γονείς. Το σύνολο δεν ξεπερνά ποτέ το 100 % της σύνταξης του θανόντος· όταν ξεπερνά, μειώνονται ισόποσα τα μερίδια των παιδιών. Τα τρία πρώτα χρόνια η σύνταξη καταβάλλεται ολόκληρη. Μετά, αν ο σύζυγος εργάζεται ή παίρνει δική του σύνταξη, μειώνεται στο ${p(W.reduced_share)}, στο παράδειγμα σε ${$(work.after3)}. Όποιος είναι κάτω των ${W.lifetime_age} χωρίς παιδί ή αναπηρία την παίρνει μόνο για ${W.temporary_years} χρόνια και ξανά από τα ${W.resume_age}. Χρειάζονται ${W.min_marriage_years} χρόνια γάμου, με εξαιρέσεις. Ο υπολογιστής δείχνει τα ποσά της οικογένειάς σας.`}
  faqs={faqs}
  related={[{ href: route('pension', lang), name: label('pension', lang), description: 'Η σύνταξη από την οποία υπολογίζεται το μερίδιο.' }, { href: route('national', lang), name: label('national', lang), description: 'Το ελάχιστο κάτω από το οποίο δεν πέφτει η σύνταξη χηρείας.' }, { href: route('retireage', lang), name: label('retireage', lang), description: 'Τα όρια ηλικίας για τη δική σας σύνταξη.' }]}
  sources={[src('widow', lang), src('pension', lang)]}>
  <div data-outil><ToolCalc client:load kind="widow" lang={lang} methodHref={route('method', lang)} /></div>

  <h2>Πώς μοιράζεται μια σύνταξη 1.000 €</h2>
  <ContentTable headers={['Οικογένεια', 'Σύζυγος', 'Κάθε παιδί', 'Σύνολο']} align={['l', 'r', 'r', 'r']} rows={shareRows} />
  <p>Με δύο παιδιά το άθροισμα θα ήταν {p(W.spouse_share + 2 * W.child_share)}, πάνω από το ανώτατο όριο του 100 %, οπότε το μερίδιο κάθε παιδιού περιορίζεται ώστε η οικογένεια να πάρει ακριβώς τη σύνταξη του θανόντος. Τα παιδιά δικαιούνται έως τα {W.child_max_age} αν είναι άγαμα, ή χωρίς όριο ηλικίας αν η ανικανότητα για εργασία ξεκίνησε πριν από τα {W.child_max_age}. Όταν ένα παιδί σταματά να δικαιούται, τα μερίδια ξαναϋπολογίζονται.</p>
  <div data-chrome><MiniSim client:load kind="widowshare" lang={lang} href={route('widow', lang)} /></div>

  <h2>Η ηλικία του συζύγου</h2>
  <ContentTable headers={['Κατάσταση στον θάνατο', 'Διάρκεια']} align={['l', 'l']} rows={ageRows} />
  <p>Το όριο κρίνεται την ημέρα του θανάτου. Αν ο σύζυγος κλείσει τα {W.lifetime_age} μέσα στην τριετία, η σύνταξη σταματά στο τέλος της και ξαναρχίζει στα {W.resume_age}.</p>

  <h2>Τι δεν υπολογίζουμε</h2>
  <p>Δεν υπολογίζουμε το νόμιμο ελάχιστο της σύνταξης χηρείας, που συνδέεται με την εθνική σύνταξη και τα έτη ασφάλισης του θανόντος, επειδή το ποσό του {P.year} μετά την αναπροσαρμογή δεν το επιβεβαιώσαμε σε επίσημη πηγή. Ούτε τη μείωση όταν ο γάμος έγινε μετά τη συνταξιοδότηση με μεγάλη διαφορά ηλικίας, ούτε τη μοιρασιά με πρώην σύζυγο που έπαιρνε διατροφή. Για θάνατο ασφαλισμένου που δεν ήταν ακόμη συνταξιούχος, απαιτείται να είχε τον χρόνο ασφάλισης για σύνταξη γήρατος ή αναπηρίας· τον ακριβή χρόνο τον κρίνει ο e-ΕΦΚΑ.</p>
</GuideLayout>
