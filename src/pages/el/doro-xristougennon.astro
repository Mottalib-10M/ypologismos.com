---
import ToolCalc from '../../components/calc/ToolCalc';
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { christmasBonus, bonusNet, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const $2 = (x: number) => formatMoney(x, 2, lang);
const B = P.bonuses;
const M = P.minimum_wage;
const ex = 1300;
const full = christmasBonus({ pay: ex });
const fullNet = bonusNet(full.amount, { gross: ex });
const minB = christmasBonus({ pay: M.monthly });
const minNet = bonusNet(minB.amount, { gross: M.monthly });
const dailyB = christmasBonus({ pay: M.daily, daily: true });
const step = ex * B.christmas_prorata_numerator / B.christmas_prorata_denominator;
const salRows = [M.monthly, 1000, 1300, 1600, 2000, 2500, 3000].map((g) => { const b = christmasBonus({ pay: g }); const n = bonusNet(b.amount, { gross: g }); return [$(g), $(b.base), $(b.leaveShare), $(b.amount), $(n.efka), $(n.tax), $(n.net)]; });
const dayMs = 86400000;
const yr = P.year;
const end = Date.UTC(yr, 11, 31);
const daysFrom = (m: number, d: number) => Math.round((end - Date.UTC(yr, m - 1, d)) / dayMs) + 1;
const months = ['Μαΐου', 'Ιουνίου', 'Ιουλίου', 'Αυγούστου', 'Σεπτεμβρίου', 'Οκτωβρίου', 'Νοεμβρίου', 'Δεκεμβρίου'];
const hires: Array<[number, number, string]> = [[5, 1, `1 ${months[0]}`], [6, 1, `1 ${months[1]}`], [7, 1, `1 ${months[2]}`], [8, 1, `1 ${months[3]}`], [9, 1, `1 ${months[4]}`], [10, 1, `1 ${months[5]}`], [11, 1, `1 ${months[6]}`], [12, 1, `1 ${months[7]}`]];
const hireRows = hires.map(([m, d, lbl]) => { const days = daysFrom(m, d); const b = christmasBonus({ pay: ex, days }); return [lbl, String(days), F.pct(b.share), $(b.amount), $(bonusNet(b.amount, { gross: ex }).net)]; });
const sept = christmasBonus({ pay: ex, days: daysFrom(9, 1) });
const short = christmasBonus({ pay: ex, days: 10 });
const faqs = [
  { q: 'Πότε πρέπει να έχει μπει στον λογαριασμό μου το δώρο Χριστουγέννων;', a: `Το αργότερο στις 21 Δεκεμβρίου. Ο νόμος επιτρέπει στον εργοδότη να πληρώσει το κομμάτι που αντιστοιχεί στις ημέρες 21 έως 31 Δεκεμβρίου μέχρι τις 31 του μήνα, αλλά το κύριο ποσό οφείλεται έως τις 21. Για μισθό ${$(ex)} μικτά, αυτό σημαίνει ${$(full.amount)} μικτά και περίπου ${$(fullNet.net)} καθαρά. Αν δεν πληρωθεί, μπορείτε να απευθυνθείτε στην Επιθεώρηση Εργασίας.` },
  { q: 'Προσλήφθηκα τον Σεπτέμβριο. Παίρνω ολόκληρο δώρο ή κομμάτι;', a: `Κομμάτι. Από 1 Σεπτεμβρίου έως 31 Δεκεμβρίου μετράτε ${daysFrom(9, 1)} ημέρες, και για κάθε 19 ημέρες δικαιούστε τα 2/25 του μισθού. Με ${$(ex)} μικτά το δώρο βγαίνει ${$(sept.amount)} μικτά μαζί με την αναλογία επιδόματος αδείας, δηλαδή περίπου ${F.pct(sept.share)} του πλήρους. Ο υπολογιστής κάνει την αναλογία για οποιαδήποτε ημερομηνία πρόσληψης.` },
  { q: 'Έλειψα δύο εβδομάδες με άδεια ασθενείας. Μου κόβουν από το δώρο;', a: `Εξαρτάται από το ποιος πλήρωσε τις ημέρες. Οι ημέρες ασθένειας για τις οποίες σας κατέβαλε επίδομα ο ασφαλιστικός φορέας δεν μετρούν στο δώρο, όπως και οι αδικαιολόγητες απουσίες, η απεργία και η άδεια άνευ αποδοχών. Αντίθετα, η άδεια μητρότητας μετράει κανονικά. Αφαιρέστε τις ημέρες που δεν μετρούν από το διάστημα 1/5 έως 31/12 και βάλτε το υπόλοιπο στον υπολογιστή.` },
  { q: 'Ο μισθός μου αυξήθηκε τον Νοέμβριο. Το δώρο βγαίνει με τον παλιό ή τον νέο;', a: `Με τον νέο. Βάση του δώρου είναι οι αποδοχές που ισχύουν στις 10 Δεκεμβρίου, όχι ο μέσος όρος του οκταμήνου. Μια αύξηση που ίσχυσε πριν από τις 10/12 περνά ολόκληρη στο δώρο, ενώ μια αύξηση από 15 Δεκεμβρίου δεν το επηρεάζει. Αν η σύμβαση λύθηκε νωρίτερα, βάση είναι ο μισθός της ημέρας της λύσης.` },
  { q: 'Μπορεί ο εργοδότης να μου δώσει το δώρο σε κουπόνια ή δωροεπιταγές;', a: `Όχι. Το Υπουργείο Εργασίας ξεκαθαρίζει ότι το δώρο Χριστουγέννων καταβάλλεται σε χρήμα και ποτέ σε είδος. Κουπόνια, καλάθια ή δωροκάρτες μπορούν να δοθούν μόνο ως κάτι επιπλέον, χωρίς να συμψηφίζονται. Για εργαζόμενο με τον κατώτατο μισθό, το δώρο που οφείλεται σε χρήμα είναι ${$(minB.amount)} μικτά.` },
  { q: 'Πληρώνομαι με ημερομίσθιο. Πώς βγαίνει το δικό μου δώρο;', a: `Για όσους αμείβονται με ημερομίσθιο, το πλήρες δώρο είναι ${F.xmasDaily} ημερομίσθια, και η αναλογία είναι 2 ημερομίσθια για κάθε 19 ημέρες απασχόλησης. Με το κατώτατο ημερομίσθιο των ${F.minDaily}, το πλήρες δώρο φτάνει ${$(dailyB.amount)} μικτά μαζί με την προσαύξηση ${F.leaveShare} για το επίδομα αδείας. Στον υπολογιστή επιλέξτε «Ημερομίσθιο».` },
];
---
<GuideLayout lang={lang} id="christmas" breadcrumbLabel={label('christmas', lang)}
  title={`Δώρο Χριστουγέννων ${F.year}: υπολογισμός, αναλογία και καθαρά`}
  h1={`Δώρο Χριστουγέννων ${F.year}: πόσο είναι και πότε πληρώνεται`}
  description={`Δώρο Χριστουγέννων ${F.year}: ένας μισθός ή ${F.xmasDaily} ημερομίσθια, αναλογία 2/25 ανά 19 ημέρες από 1/5, πληρωμή έως 21/12. Δωρεάν υπολογιστής με το καθαρό σας ποσό.`}
  intro={`Το δώρο Χριστουγέννων ${F.year} είναι ένας μηνιαίος μισθός ή ${F.xmasDaily} ημερομίσθια, μαζί με την αναλογία επιδόματος αδείας, και πληρώνεται έως τις 21 Δεκεμβρίου.`}
  resume={`Όποιος εργάστηκε στον ίδιο εργοδότη από την 1η Μαΐου έως τις 31 Δεκεμβρίου ${F.year} δικαιούται ολόκληρο δώρο Χριστουγέννων: έναν μηνιαίο μισθό αν αμείβεται με μισθό, ${F.xmasDaily} ημερομίσθια αν αμείβεται με ημερομίσθιο. Στο ποσό προστίθεται η αναλογία του επιδόματος αδείας, που ο υπολογισμός μας εφαρμόζει ως ${F.leaveShare}. Για μικτό μισθό ${$(ex)} το δώρο είναι ${$(full.amount)} μικτά και περίπου ${$(fullNet.net)} καθαρά, αφού κρατηθούν ${$(fullNet.efka)} εισφορές e-ΕΦΚΑ και ο φόρος με τον μέσο συντελεστή του έτους. Με τον κατώτατο μισθό των ${F.minWage} το δώρο φτάνει ${$(minB.amount)} μικτά και ${$(minNet.net)} καθαρά. Αν η σχέση εργασίας ξεκίνησε μετά την 1η Μαΐου ή τελείωσε πριν από το τέλος του έτους, το δώρο είναι αναλογικό: 2/25 του μισθού ή 2 ημερομίσθια για κάθε 19 ημέρες απασχόλησης. Ο εργοδότης πρέπει να το καταβάλει το αργότερο στις 21 Δεκεμβρίου, με βάση τον μισθό που ισχύει στις 10 Δεκεμβρίου.`}
  faqs={faqs}
  related={[{ href: route('home', lang), name: label('home', lang), description: 'Τα καθαρά του μηνιαίου μισθού σας, με ηλικία και παιδιά.' }, { href: route('easter', lang), name: label('easter', lang), description: 'Μισός μισθός με αναλογία 1/15 ανά 8 ημέρες.' }, { href: route('fourteen', lang), name: label('fourteen', lang), description: 'Πώς οι 14 καταβολές αλλάζουν τον ετήσιο μισθό.' }]}
  sources={[src('hli_christmas', lang), src('hli_bonuses', lang), src('efka_rates', lang), src('tax_scale', lang)]}>
  <div data-outil><ToolCalc client:load kind="christmas" lang={lang} methodHref={route('method', lang)} /></div>

  <h2>Τι υπολογίζει το εργαλείο και με ποιους κανόνες</h2>
  <p>Συμπληρώνετε τον μικτό μηνιαίο μισθό ή το ημερομίσθιο, τις ημέρες που διήρκεσε η σχέση εργασίας μέσα στο διάστημα 1/5 έως 31/12 και, προαιρετικά, ηλικία και παιδιά. Το αποτέλεσμα είναι το μικτό δώρο, η αναλογία επιδόματος αδείας που περιέχει, οι κρατήσεις και το καθαρό ποσό. Οι κανόνες είναι αυτοί που δημοσιεύει η Επιθεώρηση Εργασίας: ένας μισθός ή {F.xmasDaily} ημερομίσθια για όλη την περίοδο, αναλογικά 2/25 ή 2 ημερομίσθια ανά 19 ημέρες για όσους δεν την κάλυψαν ολόκληρη, και κλάσμα για το υπόλοιπο που δεν συμπληρώνει δεκαεννεαήμερο.</p>
  <p>Για το καθαρό, το εργαλείο αφαιρεί {F.efkaEe} εισφορές e-ΕΦΚΑ και εφαρμόζει στο υπόλοιπο τον μέσο φορολογικό συντελεστή που προκύπτει από τον ετήσιο μισθό σας με την κλίμακα του {F.year}. Έτσι προσεγγίζει τι θα δείτε στην εκκαθάριση του Δεκεμβρίου. Το ακριβές ποσό του ΦΜΥ μπορεί να διαφέρει λίγα ευρώ, επειδή κάθε λογιστικό πρόγραμμα κατανέμει διαφορετικά τον ετήσιο φόρο στις καταβολές.</p>

  <h2>Δώρο Χριστουγέννων ανά μικτό μισθό</h2>
  <ContentTable headers={['Μικτός μισθός', 'Δώρο χωρίς προσαύξηση', 'Αναλογία επιδ. αδείας', 'Μικτό δώρο', 'ΕΦΚΑ', 'Φόρος', 'Καθαρό δώρο']} align={['l', 'r', 'r', 'r', 'r', 'r', 'r']} rows={salRows} highlightRow={0} />
  <p>Ο πίνακας αφορά εργαζόμενο άνω των 30 ετών χωρίς παιδιά, με πλήρη απασχόληση από την 1η Μαΐου. Η πρώτη γραμμή είναι ο κατώτατος μισθός. Παρατηρήστε ότι το καθαρό δεν αυξάνεται γραμμικά: όσο ανεβαίνει ο μισθός, τόσο μεγαλύτερος είναι ο μέσος φορολογικός συντελεστής που «βαραίνει» και το δώρο. Στα {$(3000)} μικτά, ένα σημαντικό μέρος του δώρου φεύγει σε φόρο, ενώ στον κατώτατο ο φόρος είναι μικρός.</p>

  <h2>Πρόσληψη μέσα στο έτος: το δώρο ανά ημερομηνία έναρξης</h2>
  <ContentTable headers={['Έναρξη εργασίας', 'Ημέρες έως 31/12', 'Ποσοστό του πλήρους', 'Μικτό δώρο', 'Καθαρό']} align={['l', 'r', 'r', 'r', 'r']} rows={hireRows} highlightRow={4} />
  <p>Τα ποσά αφορούν μισθό {$(ex)} μικτά και συνεχή απασχόληση έως το τέλος του έτους. Κάθε 19 ημέρες αξίζουν {$2(step)} πριν από την προσαύξηση, δηλαδή τα 2/25 του μισθού. Η περίοδος του δώρου έχει {F.xmasDays} ημέρες, άρα όποιος προσλήφθηκε την 1η Μαΐου συμπληρώνει περισσότερα από δώδεκα δεκαεννεαήμερα και το ποσό «κόβεται» στον έναν μισθό. Ακόμη και όποιος ξεκίνησε τον Δεκέμβριο παίρνει κάτι: με δέκα ημέρες εργασίας το δώρο είναι {$(short.amount)} μικτά.</p>
  <p>Η ίδια αναλογία ισχύει όταν η σχέση εργασίας λύνεται πριν από τα Χριστούγεννα, με παραίτηση ή απόλυση. Οι ημέρες μετριούνται από την 1η Μαΐου (ή από την πρόσληψη, αν ήταν μεταγενέστερη) έως την ημέρα της λύσης, και το αναλογούν δώρο πληρώνεται μαζί με την τελική εκκαθάριση. Αν πρόκειται για απόλυση, το ποσό αυτό είναι χωριστό από την <a href={route('severance', lang)}>αποζημίωση απόλυσης</a>.</p>

  <h2>Ποιες ημέρες μετρούν και ποιες όχι</h2>
  <p>Η συχνότερη αιτία διαφωνίας με το λογιστήριο δεν είναι ο τύπος αλλά οι ημέρες. Σύμφωνα με την Επιθεώρηση Εργασίας, δεν προσμετρώνται οι αδικαιολόγητες απουσίες, οι ημέρες απεργίας, η άδεια άνευ αποδοχών και οι ημέρες ασθένειας για τις οποίες το επίδομα το κατέβαλε ο ασφαλιστικός φορέας. Αντίθετα, η κανονική άδεια μετράει, και μετράει επίσης η άδεια μητρότητας. Αν απουσιάσατε δέκα ημέρες με επίδομα ασθενείας, αφαιρέστε τις από τις {F.xmasDays} και δώστε το υπόλοιπο στον υπολογιστή.</p>
  <p>Για τον εργαζόμενο που ήταν σε άδεια άνευ αποδοχών όλο το καλοκαίρι, η μείωση μπορεί να είναι αισθητή. Αν δεν έχετε την ακριβή καταμέτρηση, ζητήστε από το λογιστήριο την ανάλυση των ημερών: είναι το πρώτο που ελέγχει και ένας επιθεωρητής εργασίας.</p>

  <h2>Η βάση υπολογισμού: ο μισθός της 10ης Δεκεμβρίου</h2>
  <p>Το δώρο δεν υπολογίζεται με τον μέσο μισθό των οκτώ μηνών αλλά με τις τακτικές αποδοχές που ισχύουν στις 10 Δεκεμβρίου. Αν πήρατε αύξηση τον Οκτώβριο, το δώρο θα βγει με τον νέο μισθό, ακόμη κι αν τους προηγούμενους μήνες αμειβόσασταν λιγότερο. Το ίδιο ισχύει για τις <a href={route('trienniums', lang)}>τριετίες</a> που συμπληρώθηκαν μέσα στο έτος. Όταν η σύμβαση λύνεται νωρίτερα, βάση είναι ο μισθός της ημέρας της λύσης.</p>
  <p>Η προσαύξηση με την αναλογία του επιδόματος αδείας εξηγεί γιατί το δώρο είναι λίγο μεγαλύτερο από έναν μισθό: στα {$(ex)} μικτά προστίθενται {$(full.leaveShare)}. Πολλοί εργαζόμενοι το αγνοούν και νομίζουν ότι πληρώθηκαν «παραπάνω» ή ότι κάποιο ποσό είναι λάθος.</p>

  <h2>Μερική απασχόληση, ημερομίσθιο και εποχικοί</h2>
  <p>Στη μερική απασχόληση το δώρο υπολογίζεται με τον μειωμένο μισθό, με τις ίδιες ημέρες και την ίδια αναλογία. Για όσους πληρώνονται με ημερομίσθιο, το πλήρες δώρο είναι {F.xmasDaily} ημερομίσθια: με το κατώτατο των {F.minDaily} αυτό δίνει {$(dailyB.amount)} μικτά. Οι εποχικοί εργαζόμενοι του τουρισμού, που συχνά δουλεύουν από Μάιο έως Οκτώβριο, παίρνουν το αναλογούν δώρο με την εκκαθάριση της λήξης, όχι τον Δεκέμβριο.</p>
  <p>Όσοι αναζητούν «δωρο χριστουγεννων» ή «doro xristougennon» συνήθως θέλουν απλώς έναν αριθμό. Ο αριθμός όμως εξαρτάται από τρία στοιχεία: τον μισθό της 10ης Δεκεμβρίου, τις ημέρες που μετρούν και τον φόρο του έτους. Τα ποσά αυτής της σελίδας υπολογίζονται από τον ίδιο μηχανισμό με τον βασικό <a href={route('home', lang)}>υπολογισμό μισθού</a>.</p>

  <div data-chrome><MiniSim client:load kind="easter" lang={lang} href={route('easter', lang)} /></div>

  <h2>Τι δεν κάνει ο υπολογιστής</h2>
  <p>Δεν γνωρίζει τις ατομικές ή συλλογικές συμβάσεις που δίνουν δώρο μεγαλύτερο από το νόμιμο, ούτε μεταβλητές αποδοχές όπως προμήθειες ή υπερωρίες που ορισμένες συμβάσεις συνυπολογίζουν. Δεν μετράει μόνος του τις ημέρες απουσίας: τις αφαιρείτε εσείς. Και δεν αντικαθιστά τη μισθοδοσία: ο φόρος υπολογίζεται με τον μέσο συντελεστή του έτους, ενώ το λογιστήριο μπορεί να κάνει διορθώσεις στον Δεκέμβριο. Για όλα αυτά δείτε τη <a href={route('method', lang)}>μεθοδολογία</a>.</p>
</GuideLayout>
