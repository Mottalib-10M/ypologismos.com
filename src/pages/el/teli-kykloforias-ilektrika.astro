---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { roadTax, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const $2 = (x: number) => formatMoney(x, 2, lang);
const n = F.num;
const R = P.road_tax;
const w = (g: number) => roadTax({ category: 'co2_wltp', co2: g }).amount;
const ev = roadTax({ category: 'electric' }).amount;
const wltpFree = R.co2_wltp[0].upTo as number;
const rivals = [130, 150, 170, 190, 215, 240];
const rows = rivals.map((g) => [`${n(g)} g/km`, $2(w(g)), $(w(g) * 5), $(w(g) * 8), $(w(g) * 12)]);
const suv = w(170), big = w(215);
const hybCC = roadTax({ category: 'cc_from_2006', cc: 1798 }).amount;
const faqs = [
  { q: 'Πληρώνει τέλη κυκλοφορίας ένα plug-in υβριδικό;', a: `Πληρώνει με τις εκπομπές CO₂ που γράφει η άδεια στο πεδίο V.7, όπως κάθε επιβατικό που ταξινομήθηκε μετά τον Οκτώβριο 2010. Το άρθρο 20 δεν έχει γενική απαλλαγή για υβριδικά. Αν η τιμή WLTP είναι έως ${n(wltpFree)} g/km, το κλιμάκιο έχει συντελεστή μηδέν και τα τέλη είναι ${$(ev)}. Αν είναι ${n(130)} g/km, τα τέλη είναι ${$2(w(130))}.` },
  { q: 'Η ηλεκτρική μοτοσικλέτα πληρώνει τέλη κυκλοφορίας;', a: `Όχι. Το άρθρο 20 του ν. 2948/2001 αναφέρει ρητά ότι τα ηλεκτροκίνητα και υδρογόνου αυτοκίνητα, καθώς και οι ηλεκτροκίνητες και υδρογόνου δίκυκλες και τρίκυκλες μοτοσικλέτες, απαλλάσσονται από τα τέλη κυκλοφορίας. Μια βενζινοκίνητη μοτοσικλέτα ${n(650)} κ.εκ. του ${F.year}, για σύγκριση, πληρώνει ${$(roadTax({ category: 'cc_from_2006', cc: 650 }).amount)} τον χρόνο.` },
  { q: 'Πόσα γλιτώνω σε οκτώ χρόνια με ηλεκτρικό αντί για ένα SUV βενζίνης;', a: `Εξαρτάται από τις εκπομπές του SUV που θα αγοράζατε. Με ${n(170)} g/km κατά WLTP, τα τέλη του είναι ${$2(suv)} τον χρόνο, άρα ${$(suv * 8)} σε οκτώ χρόνια. Με ${n(215)} g/km, το ετήσιο ποσό ανεβαίνει στα ${$2(big)} και η οκταετία στα ${$(big * 8)}. Το ηλεκτρικό πληρώνει ${$(ev)} όλα αυτά τα χρόνια.` },
  { q: 'Αγόρασα υβριδικό σε δημοπρασία του ΟΔΔΥ. Πληρώνω τέλη;', a: `Για τα επιβατικά που εκποιεί το Δημόσιο ή ο ΟΔΔΥ, το άρθρο 20 έχει ειδική ρύθμιση: τα υβριδικά έως ${n(R.cc_bands[4])} κ.εκ. απαλλάσσονται, και από εκεί και πάνω πληρώνουν το εξήντα τοις εκατό των τελών του αντίστοιχου συμβατικού, που υπολογίζονται με τον τρίτο πίνακα κυβισμού. Για συμβατικό ${n(1798)} κ.εκ. τα πλήρη τέλη είναι ${$(hybCC)}.` },
  { q: 'Χρειάζεται να κάνω κάποια αίτηση για να μην πληρώσω τέλη με το ηλεκτρικό;', a: `Ο υπολογισμός γίνεται με τα στοιχεία της άδειας κυκλοφορίας: ένα αμιγώς ηλεκτρικό έχει μηδέν γραμμάρια CO₂ και ο πίνακας δίνει μηδέν ποσό, ενώ ο νόμος το κατατάσσει και ρητά στα απαλλασσόμενα. Αν παρ' όλα αυτά δείτε χρέωση τελών για ηλεκτρικό, ελέγξτε ότι η άδεια γράφει σωστά το είδος καυσίμου και τις εκπομπές, και απευθυνθείτε στη φορολογική διοίκηση.` },
];
---
<GuideLayout lang={lang} id="roadev" breadcrumbLabel={label('roadev', lang)}
  title={`Τέλη κυκλοφορίας ηλεκτρικά ${F.year}: απαλλαγή και υβριδικά`}
  h1={`Ηλεκτρικά αυτοκίνητα και τέλη κυκλοφορίας το ${F.year}`}
  description={`Τέλη κυκλοφορίας ηλεκτρικά ${F.year}: ηλεκτρικά και υδρογόνου απαλλάσσονται, τι ισχύει για υβριδικά και plug-in, πόσα γλιτώνετε σε 5, 8, 12 χρόνια έναντι βενζίνης.`}
  intro={`Τα αμιγώς ηλεκτρικά αυτοκίνητα και τα αυτοκίνητα υδρογόνου δεν πληρώνουν τέλη κυκλοφορίας· τα υβριδικά πληρώνουν με το CO₂ τους, όπως κάθε άλλο αυτοκίνητο.`}
  resume={`Τα τέλη κυκλοφορίας για ηλεκτρικά αυτοκίνητα είναι μηδέν το ${F.year}. Το άρθρο 20 του ν. 2948/2001 απαλλάσσει ρητά τα ηλεκτροκίνητα και υδρογόνου επιβατικά, καθώς και τις ηλεκτρικές και υδρογόνου μοτοσικλέτες, και στην πράξη ένα ηλεκτρικό έχει μηδέν γραμμάρια CO₂ στην άδεια, άρα μηδέν ποσό σε οποιονδήποτε πίνακα. Η διαφορά φαίνεται όταν συγκρίνεται με ένα θερμικό: ένα SUV βενζίνης του ${F.year} με ${n(170)} g/km κατά WLTP πληρώνει ${$2(suv)} τον χρόνο, δηλαδή ${$(suv * 8)} σε οκτώ χρόνια. Τα υβριδικά δεν έχουν γενική απαλλαγή: πληρώνουν με την τιμή CO₂ του πεδίου V.7, και όσα μένουν έως ${n(wltpFree)} g/km κατά WLTP πέφτουν στο μηδενικό κλιμάκιο. Η μόνη ειδική αναφορά του νόμου σε υβριδικά αφορά αυτοκίνητα που αγοράζονται από το Δημόσιο ή τον ΟΔΔΥ. Ο μίνι υπολογιστής δείχνει πόσα τέλη γλιτώνετε σε όσα χρόνια σκοπεύετε να κρατήσετε το αυτοκίνητο, συγκρίνοντας με το θερμικό που θα αγοράζατε.`}
  faqs={faqs}
  related={[{ href: route('road', lang), name: label('road', lang), description: 'Τα τέλη του θερμικού αυτοκινήτου που έχετε σήμερα.' }, { href: route('roadco2', lang), name: label('roadco2', lang), description: 'Τα όρια CO₂ που καθορίζουν τα τέλη ενός υβριδικού.' }, { href: route('home', lang), name: label('home', lang), description: 'Υπολογισμός καθαρών αποδοχών για τον προϋπολογισμό της αγοράς.' }]}
  sources={[src('road_tax', lang), src('road_tax_idle', lang), { name: 'Οδηγία 1999/37/ΕΚ, παράρτημα Ι: κωδικοί της άδειας κυκλοφορίας (V.7)', url: 'https://www.legislation.gov.uk/eudr/1999/37/annex/I' }]}>
  <div data-chrome><MiniSim client:load kind="roadev" lang={lang} href={route('road', lang)} /></div>

  <h2>Τι γράφει ο νόμος για ηλεκτρικά και υδρογόνο</h2>
  <p>Η απαλλαγή στηρίζεται σε δύο σημεία του άρθρου 20. Το πρώτο είναι ο ίδιος ο τρόπος υπολογισμού: για επιβατικά που ταξινομήθηκαν από την 1η Νοεμβρίου 2010, τα τέλη είναι αποκλειστικά γραμμάρια CO₂ επί έναν συντελεστή. Ένα αμιγώς ηλεκτρικό εμφανίζει μηδέν γραμμάρια στο πεδίο V.7 της άδειας, και μηδέν επί οποιονδήποτε συντελεστή κάνει μηδέν. Το δεύτερο είναι ρητή διάταξη: το άρθρο αναφέρει ότι τα ηλεκτροκίνητα και υδρογόνου αυτοκίνητα, και οι ηλεκτροκίνητες και υδρογόνου δίκυκλες και τρίκυκλες μοτοσικλέτες, απαλλάσσονται από τα τέλη κυκλοφορίας.</p>
  <p>Για τον ιδιοκτήτη αυτό σημαίνει ότι δεν υπάρχει ετήσιος λογαριασμός τελών να προγραμματίσει, ούτε λόγος να σκεφτεί ακινησία για να τον αποφύγει. Τα υπόλοιπα έξοδα του αυτοκινήτου, όπως η ασφάλιση, μένουν, αλλά δεν είναι αντικείμενο αυτής της σελίδας.</p>

  <h2>Υβριδικά: όσα λέει και όσα δεν λέει το άρθρο 20</h2>
  <p>Εδώ γίνεται συχνά σύγχυση. Το άρθρο 20 αναφέρει τα υβριδικά μόνο σε ένα σημείο, εκείνο που αφορά επιβατικά που εκποιούνται από το Δημόσιο ή τον Οργανισμό Διαχείρισης Δημόσιου Υλικού (ΟΔΔΥ) και τίθενται σε κυκλοφορία ως ιδιωτικής χρήσης. Για αυτά τα αυτοκίνητα, που ούτως ή άλλως υπολογίζονται με τον τρίτο πίνακα κυβισμού, τα υβριδικά έως {n(R.cc_bands[4])} κ.εκ. απαλλάσσονται, και πάνω από αυτόν τον κυβισμό πληρώνουν το εξήντα τοις εκατό των τελών του αντίστοιχου συμβατικού. Ένα συμβατικό {n(1798)} κ.εκ. αυτής της κατηγορίας θα πλήρωνε {$(hybCC)}.</p>
  <p>Για όλα τα άλλα υβριδικά, δηλαδή για όσα αγοράζει κανείς από αντιπροσωπεία ή μεταχειρισμένα από ιδιώτη, δεν υπάρχει ειδική ρύθμιση. Πληρώνουν όπως κάθε επιβατικό της ηλικίας τους: με κυβικά αν ταξινομήθηκαν έως τις 31.10.2010, με τα γραμμάρια CO₂ της άδειας αν ταξινομήθηκαν αργότερα. Πολλά υβριδικά έχουν χαμηλή τιμή CO₂, και όσα μένουν έως {n(wltpFree)} g/km κατά WLTP πληρώνουν μηδέν απλώς επειδή πέφτουν στο πρώτο κλιμάκιο, όχι λόγω κάποιας απαλλαγής. Ένα υβριδικό με {n(130)} g/km πληρώνει {$2(w(130))}. Ο οδηγός για τα <a href={route('roadco2', lang)}>κλιμάκια CO₂</a> δείχνει πού βρίσκονται τα όρια.</p>

  <h2>Πόσα τέλη γλιτώνετε, ανάλογα με το θερμικό που θα αγοράζατε</h2>
  <ContentTable headers={['Θερμικό με CO₂ (WLTP)', 'Τέλη τον χρόνο', 'Σε 5 χρόνια', 'Σε 8 χρόνια', 'Σε 12 χρόνια']} align={['l', 'r', 'r', 'r', 'r']} rows={rows} highlightRow={2} />
  <p>Ο πίνακας υπολογίζει τα τέλη ενός καινούργιου θερμικού με τον πίνακα WLTP του {F.year}, για τα χρόνια που συνήθως κρατά κανείς ένα αυτοκίνητο. Είναι ακριβώς το ποσό που δεν θα πληρώσει ένα ηλεκτρικό στο ίδιο διάστημα. Η καμπύλη δεν είναι γραμμική: από τα {n(190)} στα {n(215)} g/km τα ετήσια τέλη υπερδιπλασιάζονται, γιατί το αυτοκίνητο περνά το όριο των {n(R.co2_wltp[3].upTo as number)} g/km και όλα του τα γραμμάρια χρεώνονται με {$2(R.co2_wltp[4].rate)} αντί για {$2(R.co2_wltp[3].rate)}.</p>
  <p>Τα ποσά προϋποθέτουν ότι οι συντελεστές του άρθρου 20 μένουν ίδιοι για όλη την περίοδο. Αν ο νόμος αλλάξει, θα αλλάξουν και αυτοί οι αριθμοί· ο πίνακας ενημερώνεται αυτόματα με τις παραμέτρους του site.</p>

  <h2>Δύο παραδείγματα αγοράς</h2>
  <p><strong>Οικογενειακό SUV.</strong> Η επιλογή είναι ανάμεσα σε μια έκδοση βενζίνης με {n(170)} g/km και την ηλεκτρική έκδοση του ίδιου μοντέλου. Το θερμικό πληρώνει {$2(suv)} τον χρόνο. Σε οκτώ χρόνια η διαφορά στα τέλη είναι {$(suv * 8)}, ποσό που μπαίνει στη σύγκριση μαζί με την τιμή αγοράς και το κόστος ενέργειας.</p>
  <p><strong>Μεγάλο SUV.</strong> Με {n(215)} g/km, το θερμικό πληρώνει {$2(big)} τον χρόνο, {$(big * 12)} σε δώδεκα χρόνια. Εδώ τα τέλη από μόνα τους γίνονται σημαντικό κομμάτι του κόστους ιδιοκτησίας, και η απαλλαγή του ηλεκτρικού βαραίνει περισσότερο.</p>

  <div data-chrome><MiniSim client:load kind="roadco2" lang={lang} href={route('roadco2', lang)} /></div>

  <h2>Ηλεκτρικό μεταχειρισμένο ή εισαγωγής</h2>
  <p>Η απαλλαγή δεν εξαρτάται από την ηλικία ή τη χώρα προέλευσης: ένα ηλεκτρικό που εισάγεται μεταχειρισμένο από άλλη χώρα της ΕΕ δεν πληρώνει τέλη, όπως και ένα καινούργιο. Αυτό που αξίζει να ελέγξετε είναι η άδεια κυκλοφορίας: το είδος καυσίμου ή πηγής ενέργειας (πεδίο P.3 στο ευρωπαϊκό υπόδειγμα) και η τιμή CO₂ στο πεδίο V.7. Αν τα στοιχεία είναι σωστά, το ποσό που βγάζει ο <a href={route('road', lang)}>υπολογιστής τελών κυκλοφορίας</a> είναι μηδέν.</p>
  <p>Για όσους κρατούν ένα θερμικό μέχρι να αποφασίσουν, ο οδηγός για τα <a href={route('roadmonth', lang)}>τέλη κυκλοφορίας με το μήνα</a> εξηγεί γιατί τα τέλη του τρέχοντος έτους οφείλονται ολόκληρα, ακόμη κι αν πουλήσετε το αυτοκίνητο νωρίς μέσα στη χρονιά. Και για να δείτε τι σημαίνει το ετήσιο ποσό σε σχέση με τον μισθό σας, ο <a href={route('home', lang)}>υπολογισμός μισθού</a> δίνει τα καθαρά σας σε δύο κλικ.</p>
</GuideLayout>
