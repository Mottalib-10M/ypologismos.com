---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { roadTax, ccBandIndex, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const n = F.num;
const R = P.road_tax;
const LET = ['Α΄', 'Β΄', 'Γ΄', 'Δ΄', 'Ε΄', 'ΣΤ΄', 'Ζ΄', 'Η΄', 'Θ΄', 'Ι΄', 'Κ΄'];
const band = (i: number) => i === 0 ? `έως ${n(R.cc_bands[0])}` : i < R.cc_bands.length ? `${n(R.cc_bands[i - 1] + 1)}-${n(R.cc_bands[i])}` : `${n(R.cc_bands[R.cc_bands.length - 1] + 1)} και άνω`;
const table = (arr: number[]) => arr.map((v, i) => [LET[i], band(i), $(v)]);
type C = 'cc_until_2000' | 'cc_2001_2005' | 'cc_from_2006';
const t = (c: C, cc: number) => roadTax({ category: c, cc }).amount;
const engines = [999, 1197, 1398, 1598, 1798, 1997, 2497, 2998];
const engRows = engines.map((e) => [`${n(e)} κ.εκ.`, $(t('cc_until_2000', e)), $(t('cc_2001_2005', e)), $(t('cc_from_2006', e))]);
const moto = [125, 300, 650, 1200].map((e) => [`${n(e)} κ.εκ.`, band(ccBandIndex(e)), $(t('cc_from_2006', e))]);
const j1928 = { a: t('cc_from_2006', 1928), b: t('cc_from_2006', 1929) };
const j1548 = { a: t('cc_from_2006', 1548), b: t('cc_from_2006', 1549) };
const gap = R.cc_from_2006[R.cc_from_2006.length - 1] - R.cc_until_2000[R.cc_until_2000.length - 1];
const faqs = [
  { q: 'Πόσα τέλη πληρώνει μια μοτοσικλέτα 650 κυβικών του 2022;', a: `${$(t('cc_from_2006', 650))} τον χρόνο. Οι δίκυκλες και τρίκυκλες μοτοσικλέτες πληρώνουν πάντα με τον κυβισμό, όποτε κι αν ταξινομήθηκαν, και μια μοτοσικλέτα του 2022 εμπίπτει στον πίνακα «από το 2006 και μετά». Τα ${n(650)} κ.εκ. ανήκουν στο κλιμάκιο ${band(1)}. Ένα μεγάλο touring ${n(1200)} κ.εκ. θα πλήρωνε ${$(t('cc_from_2006', 1200))}.` },
  { q: 'Γιατί ένα δίλιτρο πληρώνει πάνω από διπλάσια τέλη από ένα 1.900άρι;', a: `Επειδή στα ${n(R.cc_bands[6])} κ.εκ. τελειώνει το κλιμάκιο Ζ΄ και αρχίζει το Η΄. Στον πίνακα για ταξινόμηση από το 2006 έως τις 31.10.2010, ένας κινητήρας ${n(1928)} κ.εκ. πληρώνει ${$(j1928.a)} και ένας ${n(1929)} κ.εκ. ${$(j1928.b)}. Ένα κυβικό εκατοστό διαφορά στο πεδίο P.1 της άδειας μεταφράζεται σε ${$(j1928.b - j1928.a)} τον χρόνο.` },
  { q: 'Αγόρασα σε δημοπρασία του Δημοσίου αυτοκίνητο του 2016. Με τι υπολογίζονται τα τέλη;', a: `Με τον κυβισμό, όχι με το CO₂. Για επιβατικά που εκποιούνται από το Δημόσιο ή τον ΟΔΔΥ και μπαίνουν σε κυκλοφορία ως ιδιωτικής χρήσης, το άρθρο 20 ορίζει υπολογισμό αποκλειστικά με τον τρίτο πίνακα κυβισμού. Ένα τέτοιο αυτοκίνητο με ${n(1598)} κ.εκ. πληρώνει ${$(t('cc_from_2006', 1598))}, όσα κι αν γράφει η άδεια για τις εκπομπές του.` },
  { q: 'Το αυτοκινούμενο τροχόσπιτό μου είναι του 2019. Γιατί πληρώνει με κυβικά;', a: `Επειδή τα αυτοκινούμενα τροχόσπιτα και τα θωρακισμένα επιβατικά εξαιρούνται από τη μέτρηση εκπομπών CO₂, οπότε ο νόμος τα κατατάσσει με τον κυβισμό. Ένα αυτοκινούμενο με κινητήρα ${n(2287)} κ.εκ. ανήκει στο κλιμάκιο ${band(7)} και πληρώνει ${$(t('cc_from_2006', 2287))}. Το ρυμουλκούμενο τροχόσπιτο, που δεν έχει κινητήρα, πληρώνει σταθερά ${$(R.caravan)}.` },
  { q: 'Πόσα τέλη έχει ένα παπάκι 50 κυβικών;', a: `Τα δίτροχα και τρίτροχα μοτοποδήλατα έχουν ενιαίο ποσό ${$(R.moped)} τον χρόνο, χωρίς κλιμάκια και χωρίς διάκριση ανάλογα με τη χρονιά ταξινόμησης. Η μοτοσικλέτα, αντίθετα, μπαίνει στους πίνακες κυβισμού: μια μοτοσικλέτα έως ${n(R.cc_bands[0])} κ.εκ. πληρώνει ${$(R.cc_from_2006[0])}, και ένα σκούτερ ${n(125)} κ.εκ. το ίδιο ποσό. Το ποσό του μοτοποδηλάτου ορίζεται στο τμήμα ΣΤ΄ της παραγράφου 1 του άρθρου 20.` },
];
---
<GuideLayout lang={lang} id="roadcc" breadcrumbLabel={label('roadcc', lang)}
  title={`Τέλη κυκλοφορίας με κυβικά ${F.year}: οι τρεις πίνακες και μοτό`}
  h1={`Τέλη κυκλοφορίας με κυβικά: αυτοκίνητα έως το 2010 και μοτοσικλέτες`}
  description={`Τέλη κυκλοφορίας με κυβικά ${F.year}: οι τρεις πίνακες του άρθρου 20 (έως 2000, 2001-2005, 2006-10/2010), από ${$(R.cc_until_2000[0])} έως ${$(R.cc_from_2006[R.cc_from_2006.length - 1])}, μοτοσικλέτες και παλιά αυτοκίνητα.`}
  intro={`Αυτοκίνητα με πρώτη ταξινόμηση έως τις 31 Οκτωβρίου 2010 και όλες οι μοτοσικλέτες πληρώνουν τέλη κυκλοφορίας με βάση τα κυβικά του κινητήρα.`}
  resume={`Τα τέλη κυκλοφορίας με κυβικά αφορούν το ${F.year} δύο ομάδες οχημάτων: τα επιβατικά με πρώτη ταξινόμηση στην ΕΕ έως τις 31.10.2010 και όλες τις δίκυκλες και τρίκυκλες μοτοσικλέτες, όποτε κι αν ταξινομήθηκαν. Το άρθρο 20 του ν. 2948/2001 έχει τρεις πίνακες, έναν για ταξινόμηση έως το 2000, έναν για 2001-2005 και έναν από το 2006, με τα ίδια έντεκα κλιμάκια κυβισμού. Το ποσό είναι σταθερό ανά κλιμάκιο: από ${$(R.cc_until_2000[0])} για κινητήρες έως ${n(R.cc_bands[0])} κ.εκ. μέχρι ${$(R.cc_from_2006[R.cc_from_2006.length - 1])} πάνω από ${n(R.cc_bands[R.cc_bands.length - 1])} κ.εκ. Έως ${n(R.cc_bands[3])} κ.εκ. οι τρεις πίνακες δίνουν το ίδιο ποσό, ενώ πάνω από εκεί όσο νεότερη η ταξινόμηση τόσο ακριβότερα τα τέλη. Ένα 1.600άρι του 2008 πληρώνει ${$(t('cc_from_2006', 1598))}. Καύσιμο, ισχύς και εκπομπές δεν μετράνε. Το μεγάλο άλμα είναι στα ${n(R.cc_bands[6])} κ.εκ., όπου τα τέλη υπερδιπλασιάζονται. Τα μοτοποδήλατα έχουν σταθερό ποσό ${$(R.moped)}. Γράψτε τα κυβικά από το πεδίο P.1 της άδειας στον μίνι υπολογιστή για να δείτε το ποσό και στους τρεις πίνακες.`}
  faqs={faqs}
  related={[{ href: route('road', lang), name: label('road', lang), description: 'Ο υπολογιστής για κάθε χρονιά ταξινόμησης.' }, { href: route('roadco2', lang), name: label('roadco2', lang), description: 'Για αυτοκίνητα από τον Νοέμβριο 2010 και μετά.' }, { href: route('roadmonth', lang), name: label('roadmonth', lang), description: 'Ακινησία για το παλιό αυτοκίνητο που δεν κινείται.' }]}
  sources={[src('road_tax', lang), src('road_tax_idle', lang), { name: 'Οδηγία 1999/37/ΕΚ, παράρτημα Ι: κωδικοί της άδειας κυκλοφορίας (B, P.1)', url: 'https://www.legislation.gov.uk/eudr/1999/37/annex/I' }]}>
  <div data-chrome><MiniSim client:load kind="roadcc" lang={lang} href={route('road', lang)} /></div>

  <h2>Πρώτη ταξινόμηση έως το 2000</h2>
  <ContentTable headers={['Κατηγορία', 'Κυβισμός (κ.εκ.)', 'Ετήσια τέλη']} align={['l', 'l', 'r']} rows={table(R.cc_until_2000)} />
  <p>Ο παλαιότερος πίνακας ισχύει για αυτοκίνητα που πήραν την πρώτη τους άδεια σε κράτος της ΕΕ ή του ΕΟΧ μέχρι και το 2000. Είναι και ο φθηνότερος για τους μεσαίους και μεγάλους κινητήρες. Ένα αυτοκίνητο με ταξινόμηση πριν από το 2001 και κινητήρα {n(1598)} κ.εκ. πληρώνει {$(t('cc_until_2000', 1598))}, ενώ ένα τρίλιτρο της ίδιας εποχής {$(t('cc_until_2000', 2998))}.</p>

  <h2>Πρώτη ταξινόμηση 2001 έως 2005</h2>
  <ContentTable headers={['Κατηγορία', 'Κυβισμός (κ.εκ.)', 'Ετήσια τέλη']} align={['l', 'l', 'r']} rows={table(R.cc_2001_2005)} />
  <p>Ο δεύτερος πίνακας έχει τα ίδια όρια και ποσά που ξεκινούν να αποκλίνουν από το κλιμάκιο Ε΄ ({band(4)} κ.εκ.). Η διαφορά από τον πρώτο πίνακα είναι μικρή, {$(R.cc_2001_2005[4] - R.cc_until_2000[4])} στο Ε΄ και {$(R.cc_2001_2005[10] - R.cc_until_2000[10])} στο τελευταίο κλιμάκιο, αλλά επαναλαμβάνεται κάθε χρόνο.</p>

  <h2>Πρώτη ταξινόμηση 2006 έως 31.10.2010</h2>
  <ContentTable headers={['Κατηγορία', 'Κυβισμός (κ.εκ.)', 'Ετήσια τέλη']} align={['l', 'l', 'r']} rows={table(R.cc_from_2006)} highlightRow={5} />
  <p>Ο τρίτος πίνακας γράφει στον νόμο «από το έτος 2006 και μετά», όμως για τα επιβατικά σταματά στις 31.10.2010: από την επόμενη μέρα ισχύει το CO₂. Τον ίδιο πίνακα χρησιμοποιούν οι μοτοσικλέτες που ταξινομήθηκαν από το 2006 έως σήμερα, καθώς και ορισμένες ειδικές περιπτώσεις που εξηγούμε πιο κάτω. Στο τελευταίο κλιμάκιο ένα αυτοκίνητο αυτής της περιόδου πληρώνει {$(gap)} περισσότερα από ένα αντίστοιχο του 2000.</p>

  <h2>Συνηθισμένοι κινητήρες στους τρεις πίνακες</h2>
  <ContentTable headers={['Κινητήρας', 'Έως 2000', '2001-2005', '2006-10/2010']} align={['l', 'r', 'r', 'r']} rows={engRows} />
  <p>Ο πίνακας δείχνει τι σημαίνουν τα κλιμάκια για κινητήρες που συναντά κανείς συχνά στην αγορά μεταχειρισμένων. Δύο σημεία ξεχωρίζουν. Πρώτο, το όριο των {n(R.cc_bands[4])} κ.εκ.: ένας κινητήρας {n(1548)} κ.εκ. πληρώνει {$(j1548.a)}, ενώ ένας {n(1549)} κ.εκ. {$(j1548.b)}. Δεύτερο, και πολύ πιο ακριβό, το όριο των {n(R.cc_bands[6])} κ.εκ.: από {$(j1928.a)} σε {$(j1928.b)}, δηλαδή {$(j1928.b - j1928.a)} επιπλέον τον χρόνο για ένα κυβικό εκατοστό.</p>
  <p>Τα κυβικά διαβάζονται στο πεδίο P.1 της άδειας κυκλοφορίας και η ημερομηνία πρώτης ταξινόμησης στο πεδίο B. Για μεταχειρισμένα εισαγωγής, η ημερομηνία που επιλέγει πίνακα είναι η πρώτη ταξινόμηση σε κράτος της ΕΕ ή του ΕΟΧ, όχι η ελληνική.</p>

  <h2>Μοτοσικλέτες: πάντα με κυβικά</h2>
  <ContentTable headers={['Μοτοσικλέτα (ταξινόμηση από 2006)', 'Κλιμάκιο', 'Ετήσια τέλη']} align={['l', 'l', 'r']} rows={moto} />
  <p>Για τις δίκυκλες και τρίκυκλες μοτοσικλέτες το άρθρο 20 δεν άλλαξε ποτέ σύστημα: πληρώνουν με τον κυβισμό ανεξάρτητα από την ημερομηνία πρώτης ταξινόμησης. Μια μοτοσικλέτα του {F.year} μπαίνει στον τρίτο πίνακα, όπως ένα αυτοκίνητο του 2008. Επειδή οι περισσότερες μοτοσικλέτες έχουν μικρούς ή μεσαίους κινητήρες, τα ποσά είναι χαμηλά: ένα σκούτερ {n(125)} κ.εκ. πληρώνει {$(t('cc_from_2006', 125))}, μια μοτοσικλέτα {n(650)} κ.εκ. {$(t('cc_from_2006', 650))}. Τα μοτοποδήλατα δεν μπαίνουν στους πίνακες: πληρώνουν ενιαία {$(R.moped)}. Όπως και στα αυτοκίνητα, τα τέλη της μοτοσικλέτας είναι αδιαίρετα για όλο το έτος.</p>

  <h2>Νεότερα αυτοκίνητα που πληρώνουν με κυβικά</h2>
  <p>Ο κυβισμός δεν αφορά μόνο τα παλιά αυτοκίνητα. Το άρθρο 20 στέλνει στους πίνακες κυβισμού και ορισμένες κατηγορίες νεότερων οχημάτων. Τα μεταχειρισμένα με πρώτο έτος κυκλοφορίας στη διεθνή αγορά πριν από την 1.1.2002 πληρώνουν με κυβικά όποτε κι αν ταξινομήθηκαν στην ΕΕ, επειδή τότε η μέτρηση CO₂ δεν ήταν υποχρεωτική. Τα αυτοκινούμενα τροχόσπιτα και τα θωρακισμένα επιβατικά εξαιρούνται από τη μέτρηση CO₂ και πληρώνουν επίσης με κυβικά. Τα επιβατικά που αγοράζονται από το Δημόσιο ή τον ΟΔΔΥ και κυκλοφορούν ως ιδιωτικής χρήσης υπολογίζονται με τον τρίτο πίνακα. Τέλος, τα οχήματα που εγκρίνονται ως Μεμονωμένα Οχήματα Ιδιαίτερης Κατασκευής από μεταχειρισμένα εξαρτήματα έχουν δικό τους πίνακα, με τα ποσά του πρώτου.</p>
  <p>Ιδιωτικά επιβατικά σε καθεστώς προσωρινής εισαγωγής υπολογίζονται επίσης αποκλειστικά με κυβικά, με κανόνες που δεν καλύπτει ο υπολογιστής μας.</p>

  <div data-chrome><MiniSim client:load kind="roadmonth" lang={lang} href={route('roadmonth', lang)} /></div>

  <h2>Το παλιό αυτοκίνητο: κρατάω, πουλάω ή ακινητοποιώ;</h2>
  <p>Για ένα αυτοκίνητο είκοσι ετών, τα τέλη μπορεί να είναι το μεγαλύτερο σταθερό έξοδο της χρονιάς. Ένα δίλιτρο του 2004 πληρώνει {$(t('cc_2001_2005', 1997))} τον χρόνο, ένα τρίλιτρο του 2009 {$(t('cc_from_2006', 2998))}. Αν το αυτοκίνητο δεν θα κινηθεί καθόλου την επόμενη χρονιά, η ακινησία που δηλώνεται στο gov.gr πριν από την 1η Ιανουαρίου μηδενίζει τα τέλη της, με την υποχρέωση να βγουν οι πινακίδες και το όχημα να μείνει στη δηλωμένη θέση. Ο οδηγός για τα <a href={route('roadmonth', lang)}>τέλη κυκλοφορίας με το μήνα</a> εξηγεί τι γίνεται αν αλλάξετε γνώμη στη μέση της χρονιάς. Αν πάλι συγκρίνετε ένα παλιό με ένα νεότερο αυτοκίνητο, ο οδηγός για τα <a href={route('roadco2', lang)}>κλιμάκια CO₂</a> και ο <a href={route('road', lang)}>υπολογιστής τελών</a> δείχνουν τι πληρώνει το καθένα, ενώ ο <a href={route('home', lang)}>υπολογισμός μισθού</a> βοηθά να μπει το ποσό στον μηνιαίο προϋπολογισμό.</p>
</GuideLayout>
