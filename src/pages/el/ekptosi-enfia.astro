---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { enfia, salary, PARAMS as P } from '../../lib/engine/gr';
import { ENFIA_LOW_WEALTH as W, ENFIA_FULL_CHILDREN, ENFIA_FULL_DISABILITY } from '../../lib/mini-extra-e';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const E = P.enfia;
const Y = P.year;
const red = E.value_reductions;
// Ένα ακίνητο 100 m² χωρίς άλλα στοιχεία: η τιμή ζώνης προκύπτει από την αξία, για να φανεί μόνο η μείωση.
const at = (v: number, o: { insured?: boolean; smallSettlement?: boolean } = {}) => enfia({ sqm: 100, zonePrice: v / 100, buildYear: 1990, floor: 'ground_1', facades: 0, totalValue: v, ...o });
const bandRows = red.map((b, i) => { const lo = i === 0 ? 0 : red[i - 1].upTo + 1; const x = at(b.upTo); return [lo === 0 ? `έως ${$(b.upTo)}` : `${$(lo)} έως ${$(b.upTo)}`, F.pct(b.rate), $(x.principal), $(x.total)]; });
const cliffA = at(red[0].upTo), cliffB = at(red[0].upTo + 1000);
const ex = at(140000), exAll = at(140000, { insured: true, smallSettlement: true });
const combined = 1 - (1 - ex.valueReductionRate) * (1 - E.insurance_reduction) * (1 - E.small_settlement_reduction_2026);
const incRows = [0, 1, 2, 3, 4].map((m) => [m === 0 ? 'Μόνος, χωρίς εξαρτώμενα' : m === 1 ? 'Με σύζυγο ή ένα εξαρτώμενο' : `Με ${m} μέλη (σύζυγο και εξαρτώμενα)`, $(E.low_income_50_income + m * E.low_income_per_member), $(E.low_income_100_income + m * E.low_income_per_member)]);
const low = salary({ gross: 700 });
// Τρία νοικοκυριά: συνταξιούχος μόνος (60 m², ζώνη 900 €, 1975), ζευγάρι με τρία παιδιά (105 m², ζώνη 1.300 €, 1998), ζευγάρι με δύο σπίτια.
const hA = enfia({ sqm: 60, zonePrice: 900, buildYear: 1975, floor: 'ground_1', facades: 1 });
const hB = enfia({ sqm: 105, zonePrice: 1300, buildYear: 1998, floor: 'f2_3', facades: 1 });
const hC1 = enfia({ sqm: 95, zonePrice: 2200, buildYear: 2004, floor: 'f4_5', facades: 1, totalValue: 95 * 2200 + 80 * 1100 });
const hC2 = enfia({ sqm: 80, zonePrice: 1100, buildYear: 1988, detached: true, facades: 2, totalValue: 95 * 2200 + 80 * 1100 });
const faqs = [
  { q: `Πόση έκπτωση ΕΝΦΙΑ παίρνω αν τα ακίνητά μου αξίζουν ${$(140000)};`, a: `Η συνολική αξία ${$(140000)} βρίσκεται στο κλιμάκιο ${$(red[0].upTo + 1)} έως ${$(red[1].upTo)}, άρα ο φόρος μειώνεται κατά ${F.pct(ex.valueReductionRate)}. Για ένα σπίτι 100 m² αυτής της αξίας, χτισμένο πριν από 25 χρόνια και πάνω, ο κύριος φόρος των ${$(ex.principal)} πέφτει στα ${$(ex.total)}. Ο νόμος δεν προβλέπει αίτηση γι' αυτή τη μείωση: εφαρμόζεται στον ίδιο τον υπολογισμό του φόρου.` },
  { q: 'Ποιες προϋποθέσεις έχει η έκπτωση 50 % για χαμηλά εισοδήματα;', a: `Πρέπει να ισχύουν όλες μαζί: οικογενειακό φορολογητέο εισόδημα έως ${$(E.low_income_50_income)}, συν ${$(E.low_income_per_member)} για τον σύζυγο και κάθε εξαρτώμενο μέλος· επιφάνεια κτισμάτων της οικογένειας έως ${E.low_income_max_sqm} m²· συνολική αξία έως ${$(W.single)} για άγαμο, ${$(W.couple)} για ζευγάρι ή μονογονέα με ένα παιδί και ${$(W.family)} για οικογένεια με παιδιά ή μονογονέα με δύο· και όλη η οικογένεια φορολογικοί κάτοικοι Ελλάδας.` },
  { q: 'Ποιος δεν πληρώνει καθόλου ΕΝΦΙΑ λόγω εισοδήματος;', a: `Η έκπτωση 100 % του άρθρου 13 παρ. 2 θέλει οικογενειακό εισόδημα έως ${$(E.low_income_100_income)} συν ${$(E.low_income_per_member)} ανά σύζυγο και εξαρτώμενο, κτίσματα έως ${E.low_income_max_sqm} m², φορολογική κατοικία στην Ελλάδα και, επιπλέον, ${ENFIA_FULL_CHILDREN} τουλάχιστον εξαρτώμενα τέκνα ή αναπηρία ${F.pct(ENFIA_FULL_DISABILITY)} και άνω σε κάποιο μέλος. Εδώ ο νόμος δεν βάζει όριο συνολικής αξίας, σε αντίθεση με την έκπτωση 50 %.` },
  { q: 'Οι εκπτώσεις ΕΝΦΙΑ προστίθενται μεταξύ τους;', a: `Όχι με απλή πρόσθεση στον υπολογιστή μας: κάθε μείωση εφαρμόζεται στο ποσό που άφησε η προηγούμενη. Με αξία ${$(140000)}, ασφαλισμένο σπίτι και κύρια κατοικία σε μικρό οικισμό, τα ${F.pct(ex.valueReductionRate)}, ${F.insurance} και ${F.village} δεν κάνουν ${F.pct(ex.valueReductionRate + E.insurance_reduction + E.small_settlement_reduction_2026)} αλλά ${F.pct(combined)}: ο φόρος πέφτει από ${$(ex.principal)} σε ${$(exAll.total)}.` },
  { q: 'Τα χωράφια εκτός σχεδίου μετράνε στην αξία για τη μείωση;', a: `Όχι. Το άρθρο 13 παρ. 3 ορίζει ρητά ότι στη συνολική αξία για τη μείωση από ${F.pct(red[red.length - 1].rate)} έως ${F.pct(red[0].rate)} δεν συνυπολογίζεται η αξία των δικαιωμάτων σε γήπεδα εκτός σχεδίου πόλης ή οικισμού. Ένα αγροτεμάχιο στο χωριό δεν σας βγάζει λοιπόν από το κλιμάκιο. Τα οικόπεδα εντός σχεδίου όμως μετράνε κανονικά.` },
  { q: 'Αν αλλάξει το εισόδημά μου, χάνω την έκπτωση που πήρα;', a: `Μπορεί. Οι εκπτώσεις 50 % και 100 % χορηγούνται με βάση την τελευταία δήλωση φορολογίας εισοδήματος της οποίας η προθεσμία έχει λήξει, και επανεξετάζονται έως το τέλος Φεβρουαρίου του επόμενου έτους με βάση τις εμπρόθεσμες δηλώσεις. Αν προκύψουν μεταβολές, εκδίδεται νέα πράξη προσδιορισμού του φόρου για εκείνο το έτος.` },
];
---
<GuideLayout lang={lang} id="enfiadisc" breadcrumbLabel={label('enfiadisc', lang)}
  title={`Έκπτωση ΕΝΦΙΑ ${Y}: από ${F.pct(red[red.length - 1].rate)} έως ${F.pct(red[0].rate)} και απαλλαγή 100 %`}
  h1={`Έκπτωση ΕΝΦΙΑ ${Y}: ποια μείωση σας αναλογεί και πώς συνδυάζονται`}
  description={`Έκπτωση ΕΝΦΙΑ ${Y}: μείωση ${F.pct(red[0].rate)} έως ${F.pct(red[red.length - 1].rate)} ανάλογα με την αξία, 50 % ή 100 % για χαμηλά εισοδήματα με τους όρους του άρθρου 13, ${F.insurance} με ασφάλιση, ${F.village} στα χωριά.`}
  intro={`Τέσσερις διαφορετικές διατάξεις μειώνουν τον ΕΝΦΙΑ, και η πιο κοινή δεν χρειάζεται καμία αίτηση.`}
  resume={`Η έκπτωση ΕΝΦΙΑ που παίρνουν σχεδόν όλοι οι ιδιοκτήτες εξαρτάται από τη συνολική αξία της ακίνητης περιουσίας τους: ${F.pct(red[0].rate)} έως ${$(red[0].upTo)}, ${F.pct(red[1].rate)} έως ${$(red[1].upTo)}, ${F.pct(red[2].rate)} έως ${$(red[2].upTo)}, ${F.pct(red[3].rate)} έως ${$(red[3].upTo)} και ${F.pct(red[4].rate)} έως ${$(red[4].upTo)}, σύμφωνα με το άρθρο 13 παρ. 3 του Κώδικα Φορολογίας Περιουσίας. Πάνω από ${$(red[4].upTo)} δεν υπάρχει μείωση. Χωριστά, οικογένειες με χαμηλό εισόδημα κερδίζουν έκπτωση 50 %, αν το οικογενειακό φορολογητέο εισόδημα δεν ξεπερνά τις ${$(E.low_income_50_income)} συν ${$(E.low_income_per_member)} ανά σύζυγο και εξαρτώμενο, τα κτίσματα τα ${E.low_income_max_sqm} m² και η αξία ένα όριο από ${$(W.single)} έως ${$(W.family)}. Με εισόδημα έως ${$(E.low_income_100_income)} συν ${$(E.low_income_per_member)} ανά μέλος και τρία παιδιά ή αναπηρία 80 %, ο φόρος μηδενίζεται. Η ασφάλιση της κατοικίας αφαιρεί ακόμη ${F.insurance} και η κύρια κατοικία σε μικρό οικισμό ${F.village} για το ${Y}. Ο μίνι υπολογιστής δείχνει αμέσως το ποσοστό που σας αναλογεί.`}
  faqs={faqs}
  related={[{ href: route('enfia', lang), name: label('enfia', lang), description: 'Ο πλήρης υπολογισμός, με όροφο, παλαιότητα και τιμή ζώνης.' }, { href: route('enfiains', lang), name: label('enfiains', lang), description: `Η μείωση ${F.insurance} για σπίτια ασφαλισμένα για σεισμό, πυρκαγιά και πλημμύρα.` }, { href: route('enfiavillage', lang), name: label('enfiavillage', lang), description: `Μείωση ${F.village} το ${Y} και απαλλαγή από το 2027.` }]}
  sources={[src('enfia_reductions', lang), src('enfia', lang), src('enfia_exemptions', lang), src('enfia_2026', lang)]}>
  <div data-chrome><MiniSim client:load kind="enfiadisc" lang={lang} href={route('enfia', lang)} /></div>

  <h2>Η κλιμακωτή μείωση ανάλογα με την αξία</h2>
  <ContentTable headers={['Συνολική αξία ακινήτων', 'Μείωση', 'Φόρος πριν (100 m² στο ανώτατο)', 'Φόρος μετά']} align={['l', 'r', 'r', 'r']} rows={bandRows} highlightRow={1} />
  <p>Το παράδειγμα του πίνακα είναι ένα ακίνητο 100 m², με τιμή ζώνης τέτοια ώστε η αξία του να πέφτει ακριβώς στο ανώτατο όριο κάθε κλιμακίου, στο ισόγειο, χωρίς πρόσοψη και με παλαιότητα άνω των 25 ετών. Έτσι φαίνεται μόνο το αποτέλεσμα της μείωσης. Παρατηρήστε ότι ο φόρος πριν από τη μείωση ανεβαίνει απότομα στις υψηλές αξίες, επειδή η τιμή ζώνης περνά σε ακριβότερη φορολογική ζώνη.</p>
  <p>Η αξία που κρίνει το ποσοστό είναι η συνολική αξία όλων των δικαιωμάτων σας, όπως την υπολογίζει η Φορολογική Διοίκηση με το σύστημα των αντικειμενικών αξιών, και όχι η αξία ενός μόνο ακινήτου. Ένας ιδιοκτήτης με ένα διαμέρισμα των {$(90000)} παίρνει {F.pct(red[0].rate)}· αν έχει και ένα κατάστημα των {$(80000)}, η συνολική αξία ανεβαίνει στις {$(170000)} και η μείωση πέφτει στο {F.pct(red[2].rate)} για όλα τα ακίνητά του. Εξαίρεση: τα γήπεδα εκτός σχεδίου πόλης ή οικισμού δεν μετράνε σε αυτόν τον λογαριασμό.</p>

  <h2>Το σκαλοπάτι στα όρια</h2>
  <p>Η μείωση δεν λειτουργεί όπως η φορολογική κλίμακα του εισοδήματος, όπου κάθε συντελεστής αφορά μόνο το κομμάτι μέσα στο κλιμάκιο. Εδώ ένα ποσοστό ισχύει για ολόκληρο τον φόρο. Στο όριο των {$(red[0].upTo)}, το ίδιο σπίτι πληρώνει {$(cliffA.total)} με μείωση {F.pct(cliffA.valueReductionRate)}· με αξία {$(red[0].upTo + 1000)} πληρώνει {$(cliffB.total)}, γιατί η μείωση γίνεται {F.pct(cliffB.valueReductionRate)}. Χίλια ευρώ αξίας παραπάνω κοστίζουν {$(cliffB.total - cliffA.total)} φόρου τον χρόνο.</p>
  <p>Αυτό έχει πρακτική σημασία όταν σκέφτεστε μια γονική παροχή, μια αγορά ή την αποδοχή μιας κληρονομιάς: ένα μικρό ποσοστό σε ακίνητο μπορεί να σας μετακινήσει σε άλλο κλιμάκιο. Πριν από μια τέτοια κίνηση, περάστε τη νέα συνολική αξία στον <a href={route('enfia', lang)}>υπολογιστή ΕΝΦΙΑ</a> και δείτε τη διαφορά.</p>

  <h2>Έκπτωση 50 % λόγω οικονομικής αδυναμίας</h2>
  <p>Η παράγραφος 1 του άρθρου 13 δίνει έκπτωση 50 % στον φορολογούμενο, τον σύζυγο ή το μέρος του συμφώνου συμβίωσης και τα εξαρτώμενα τέκνα, όταν πληρούνται σωρευτικά τρεις όροι. Ο πρώτος αφορά το εισόδημα: το συνολικό φορολογητέο οικογενειακό εισόδημα του τελευταίου έτους για το οποίο έχει λήξει η προθεσμία των δηλώσεων δεν ξεπερνά τις {$(E.low_income_50_income)}, προσαυξημένο κατά {$(E.low_income_per_member)} για τον σύζυγο και για κάθε εξαρτώμενο μέλος. Ο δεύτερος αφορά την περιουσία: τα κτίσματα όλης της οικογένειας, με τα ποσοστά συνιδιοκτησίας, δεν ξεπερνούν τα {E.low_income_max_sqm} m² και η συνολική αξία μένει έως {$(W.single)} για τον άγαμο, {$(W.couple)} για το ζευγάρι ή τη μονογονεϊκή οικογένεια με ένα παιδί και {$(W.family)} για το ζευγάρι με παιδιά ή τον μονογονέα με δύο. Ο τρίτος: όλα τα μέλη είναι φορολογικοί κάτοικοι Ελλάδας.</p>
  <ContentTable headers={['Νοικοκυριό', 'Όριο εισοδήματος για 50 %', 'Όριο εισοδήματος για 100 %']} align={['l', 'r', 'r']} rows={incRows} />
  <p>Τα όρια του πίνακα προκύπτουν από τα ποσά του νόμου. Προσέξτε τη λέξη «φορολογητέο»: μετράει το εισόδημα της δήλωσης, όχι τα καθαρά που μπαίνουν στον λογαριασμό. Ένας μισθωτός με μικτό {$(low.gross)} τον μήνα σε 14 καταβολές έχει φορολογητέο εισόδημα {$(low.taxableAnnual)}, αφού από τα {$(low.annualGross)} αφαιρούνται οι εισφορές του, άρα μένει κάτω από τις {$(E.low_income_50_income)} ακόμη και μόνος. Για να δείτε το δικό σας φορολογητέο από τον μισθό, χρησιμοποιήστε τον <a href={route('home', lang)}>υπολογισμό μισθού</a>.</p>

  <h2>Πότε ο φόρος μηδενίζεται</h2>
  <p>Η παράγραφος 2 ανεβάζει την έκπτωση στο 100 % με παρόμοιους όρους, αλλά πιο γενναιόδωρο όριο εισοδήματος, {$(E.low_income_100_income)} συν {$(E.low_income_per_member)} ανά σύζυγο και εξαρτώμενο, και έναν επιπλέον όρο: η οικογένεια έχει τουλάχιστον {ENFIA_FULL_CHILDREN} εξαρτώμενα τέκνα ή κάποιο μέλος έχει αναπηρία {F.pct(ENFIA_FULL_DISABILITY)} και άνω. Τα {E.low_income_max_sqm} m² και η φορολογική κατοικία ισχύουν και εδώ. Αξίζει να το προσέξει κανείς: στο 100 % ο νόμος δεν αναφέρει όριο συνολικής αξίας, όπως κάνει στο 50 %.</p>

  <div data-chrome><MiniSim client:load kind="enfialow" lang={lang} href={route('enfia', lang)} /></div>

  <h2>Τρία νοικοκυριά, τρεις διαφορετικές εκπτώσεις</h2>
  <p>Μια συνταξιούχος ζει μόνη σε διαμέρισμα 60 m² στο ισόγειο, με τιμή ζώνης {$(900)} και άδεια του 1975. Η αξία του, {$(hA.valueUsed)}, της δίνει μείωση {F.pct(hA.valueReductionRate)} και ΕΝΦΙΑ {$(hA.total)}. Αν το φορολογητέο εισόδημά της δεν ξεπερνά τις {$(E.low_income_50_income)}, έχει και την έκπτωση 50 % του άρθρου 13, αφού η αξία μένει κάτω από τις {$(W.single)}: πληρώνει {$(hA.total / 2)}.</p>
  <p>Ένα ζευγάρι με τρία παιδιά μένει σε 105 m² στον 2ο όροφο, σε ζώνη {$(1300)}, με άδεια του 1998. Ο φόρος μετά τη μείωση λόγω αξίας είναι {$(hB.total)}. Το νοικοκυριό έχει τέσσερα μέλη πέρα από τον υπόχρεο, οπότε το όριο εισοδήματος για την απαλλαγή 100 % είναι {$(E.low_income_100_income + 4 * E.low_income_per_member)}. Αν το οικογενειακό φορολογητέο εισόδημα μένει από κάτω, ο ΕΝΦΙΑ μηδενίζεται· αν το ξεπερνά αλλά μένει έως {$(E.low_income_50_income + 4 * E.low_income_per_member)}, πέφτει στο μισό, εφόσον τα κτίσματα δεν περνούν τα {E.low_income_max_sqm} m² και η αξία τις {$(W.family)}.</p>
  <p>Το τρίτο ζευγάρι έχει ένα διαμέρισμα 95 m² στην πόλη και μια μονοκατοικία 80 m² στο χωριό, συνολικής αξίας {$(hC1.valueUsed)}. Η αξία αυτή αφήνει μείωση μόνο {F.pct(hC1.valueReductionRate)} και στα δύο σπίτια: {$(hC1.total)} για το διαμέρισμα και {$(hC2.total)} για τη μονοκατοικία. Εδώ η ασφάλιση είναι η μόνη μείωση που μπορεί ακόμη να κερδίσει, και ο λογαριασμός της βρίσκεται στον μίνι υπολογιστή στην κορυφή της σελίδας.</p>

  <h2>Ασφάλιση κατοικίας και μικροί οικισμοί</h2>
  <p>Οι δύο άλλες μειώσεις δεν κοιτάζουν το εισόδημα αλλά το ίδιο το ακίνητο. Η κατοικία που ήταν ασφαλισμένη το προηγούμενο έτος για σεισμό, πυρκαγιά και πλημμύρα, για όλη την αξία ανακατασκευής, πληρώνει {F.insurance} λιγότερο αν η αξία της φτάνει έως {$(E.insurance_value_limit)} και {F.insuranceHigh} πάνω από αυτό· τα μισά του χρόνου ασφάλισης δίνουν τη μισή μείωση. Ο οδηγός για την <a href={route('enfiains', lang)}>ασφάλιση κατοικίας</a> εξηγεί τους όρους του συμβολαίου.</p>
  <p>Η κύρια κατοικία σε οικισμό έως {F.villagePop} κατοίκων εκτός ηπειρωτικής Αττικής, με αξία έως {F.villageValue}, κερδίζει {F.village} το {Y}, και από το 2027 απαλλάσσεται εντελώς. Για τα παραμεθόρια το όριο πληθυσμού γίνεται {F.villagePopBorder}. Όλα αυτά στον οδηγό για τον <a href={route('enfiavillage', lang)}>ΕΝΦΙΑ στους μικρούς οικισμούς</a>.</p>

  <h2>Πώς συνδυάζονται οι εκπτώσεις</h2>
  <p>Ο νόμος περιγράφει κάθε μείωση ως ποσοστό επί του φόρου, χωρίς να ορίζει ρητά τη σειρά τους. Ο υπολογιστής τις εφαρμόζει η μία μετά την άλλη, πολλαπλασιαστικά, όπως συνηθίζεται για ποσοστιαίες μειώσεις του ίδιου φόρου. Το πρακτικό συμπέρασμα είναι ότι δεν αθροίζονται: με αξία {$(140000)}, ασφάλιση και χωριό, οι μειώσεις {F.pct(ex.valueReductionRate)}, {F.insurance} και {F.village} δίνουν συνολικά {F.pct(combined)}, και ο φόρος πέφτει από {$(ex.principal)} σε {$(exAll.total)}. Αν σας ενδιαφέρει το ακριβές ποσό, το εκκαθαριστικό δείχνει πώς εφαρμόστηκε κάθε μία.</p>
  <p>Για τη μείωση λόγω αξίας ο νόμος δεν ζητά αίτηση. Οι εκπτώσεις 50 % και 100 % χορηγούνται με πράξη της Διοίκησης, με βάση τη δήλωση φορολογίας εισοδήματος, και επανεξετάζονται έως το τέλος Φεβρουαρίου του επόμενου έτους με τις εμπρόθεσμες δηλώσεις. Τη διαδικασία την ορίζει απόφαση του Διοικητή της ΑΑΔΕ.</p>
  <p>Όσοι γράφουν στην αναζήτηση «εκπτωση ενφια» ή «ekptosi enfia» ρωτούν και για έκπτωση εφάπαξ εξόφλησης. Τέτοια έκπτωση δεν προβλέπεται στα άρθρα 10, 13 και 17 που εξετάζουμε εδώ, και δεν την έχουμε επιβεβαιώσει σε επίσημη πηγή για το {Y}· γι' αυτό ο υπολογιστής δεν την περιλαμβάνει.</p>
</GuideLayout>
