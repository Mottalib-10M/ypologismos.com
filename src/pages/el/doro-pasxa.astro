---
import ToolCalc from '../../components/calc/ToolCalc';
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { easterBonus, bonusNet, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const $2 = (x: number) => formatMoney(x, 2, lang);
const M = P.minimum_wage;
const ex = 1400;
const full = easterBonus({ pay: ex });
const fullNet = bonusNet(full.amount, { gross: ex });
const minB = easterBonus({ pay: M.monthly });
const dailyB = easterBonus({ pay: M.daily, daily: true });
const perStep = ex * P.bonuses.easter_months / 15;
const dayMs = 86400000;
const yr = P.year;
const end = Date.UTC(yr, 3, 30);
const daysFrom = (m: number, d: number) => Math.round((end - Date.UTC(yr, m - 1, d)) / dayMs) + 1;
const starts: Array<[number, number, string]> = [[1, 1, '1 Ιανουαρίου'], [1, 20, '20 Ιανουαρίου'], [2, 10, '10 Φεβρουαρίου'], [3, 1, '1 Μαρτίου'], [3, 20, '20 Μαρτίου'], [4, 10, '10 Απριλίου'], [4, 23, '23 Απριλίου']];
const rows = starts.map(([m, d, lbl]) => { const days = daysFrom(m, d); const b = easterBonus({ pay: ex, days }); const bm = easterBonus({ pay: M.monthly, days }); return [lbl, String(days), F.pct(b.share), $(b.amount), $(bonusNet(b.amount, { gross: ex }).net), $(bm.amount)]; });
const march = easterBonus({ pay: ex, days: daysFrom(3, 1) });
const resign = easterBonus({ pay: ex, days: daysFrom(1, 1) - daysFrom(3, 1) });
const faqs = [
  { q: 'Μέχρι ποια ημέρα πρέπει να πληρωθεί το δώρο Πάσχα;', a: `Μέχρι τη Μεγάλη Τετάρτη. Αν το Πάσχα πέφτει νωρίς και η περίοδος 1/1 έως 30/4 δεν έχει τελειώσει, το κομμάτι που αντιστοιχεί στις ημέρες από τη Μεγάλη Τετάρτη έως τις 30 Απριλίου μπορεί να εξοφληθεί αργότερα. Για μισθό ${$(ex)} μικτά το πλήρες δώρο είναι ${$(full.amount)} μικτά, περίπου ${$(fullNet.net)} καθαρά.` },
  { q: 'Ξεκίνησα δουλειά την 1η Μαρτίου. Πόσο δώρο Πάσχα δικαιούμαι;', a: `Από 1 Μαρτίου έως 30 Απριλίου είναι ${daysFrom(3, 1)} ημέρες. Για κάθε 8 ημέρες παίρνετε το 1/15 του μισού μισθού, δηλαδή ${$2(perStep)} αν ο μισθός είναι ${$(ex)}. Με την αναλογία επιδόματος αδείας, το δώρο σας είναι ${$(march.amount)} μικτά, περίπου ${F.pct(march.share)} του πλήρους ποσού.` },
  { q: 'Παραιτήθηκα στο τέλος Φεβρουαρίου. Χάνω το δώρο Πάσχα;', a: `Όχι. Δικαιούστε την αναλογία για τις ημέρες από 1 Ιανουαρίου έως την ημέρα της λύσης, με βάση τον μισθό εκείνης της ημέρας, και πληρώνεται με την τελική εκκαθάριση. Για δύο μήνες εργασίας με ${$(ex)} μικτά, αυτό σημαίνει ${$(resign.amount)} μικτά. Ο κανόνας είναι ίδιος σε παραίτηση και σε απόλυση.` },
  { q: 'Με ποιον μισθό βγαίνει το δώρο Πάσχα αν πήρα αύξηση τον Απρίλιο;', a: `Βάση είναι οι αποδοχές που ισχύουν τη 15η ημέρα πριν από το Πάσχα. Μια αύξηση που ίσχυσε πριν από εκείνη την ημέρα περνά στο δώρο. Γι' αυτό η αύξηση του κατώτατου μισθού στα ${F.minWage} από 1η Απριλίου μπορεί να μετρήσει ή όχι, ανάλογα με το πότε πέφτει το Πάσχα κάθε χρονιά.` },
];
---
<GuideLayout lang={lang} id="easter" breadcrumbLabel={label('easter', lang)}
  title={`Δώρο Πάσχα ${F.year}: μισός μισθός, αναλογία και καθαρά`}
  h1={`Δώρο Πάσχα ${F.year}: υπολογισμός με αναλογία ημερών`}
  description={`Δώρο Πάσχα ${F.year}: μισός μισθός ή ${F.easterDaily} ημερομίσθια, 1/15 ανά 8 ημέρες από 1/1 έως 30/4, πληρωμή έως τη Μεγάλη Τετάρτη. Δωρεάν υπολογιστής μικτού και καθαρού.`}
  intro={`Το δώρο Πάσχα ${F.year} είναι μισός μηνιαίος μισθός ή ${F.easterDaily} ημερομίσθια, με προσαύξηση για το επίδομα αδείας, και πληρώνεται έως τη Μεγάλη Τετάρτη.`}
  resume={`Το δώρο Πάσχα αντιστοιχεί στο διάστημα από 1 Ιανουαρίου έως 30 Απριλίου. Όποιος εργάστηκε όλο αυτό το τετράμηνο στον ίδιο εργοδότη παίρνει μισό μηνιαίο μισθό, ή ${F.easterDaily} ημερομίσθια αν αμείβεται με ημερομίσθιο, συν την αναλογία του επιδόματος αδείας, που εδώ λογίζεται ως ${F.leaveShare}. Με μισθό ${$(ex)} μικτά το δώρο είναι ${$(full.amount)} μικτά και περίπου ${$(fullNet.net)} καθαρά, ενώ με τον κατώτατο μισθό φτάνει ${$(minB.amount)} μικτά. Όποιος προσλήφθηκε μέσα στο τετράμηνο ή αποχώρησε πριν από τις 30 Απριλίου παίρνει το 1/15 του μισού μισθού, ή ένα ημερομίσθιο, για κάθε 8 ημέρες απασχόλησης. Το ποσό υπολογίζεται με τις αποδοχές της 15ης ημέρας πριν από το Πάσχα και πρέπει να καταβληθεί έως τη Μεγάλη Τετάρτη. Ο υπολογιστής δίνει και το καθαρό, με εισφορές e-ΕΦΚΑ και φόρο.`}
  faqs={faqs}
  related={[{ href: route('christmas', lang), name: label('christmas', lang), description: 'Ο ένας μισθός του Δεκεμβρίου, με αναλογία 2/25.' }, { href: route('home', lang), name: label('home', lang), description: 'Τα καθαρά του μισθού σας για όλο τον χρόνο.' }, { href: route('daily', lang), name: label('daily', lang), description: 'Από ημερομίσθιο σε μηνιαίες αποδοχές.' }]}
  sources={[src('hli_easter', lang), src('hli_bonuses', lang), src('efka_rates', lang), src('tax_scale', lang)]}>
  <div data-outil><ToolCalc client:load kind="easter" lang={lang} methodHref={route('method', lang)} /></div>

  <h2>Ένα τετράμηνο, δεκαπέντε κομμάτια</h2>
  <p>Η λογική του δώρου Πάσχα είναι πιο απλή από του Χριστουγεννιάτικου, γιατί η περίοδος είναι μικρότερη: {F.easterDays} ημέρες, από την Πρωτοχρονιά έως το τέλος Απριλίου. Το πλήρες ποσό χωρίζεται σε δεκαπέντε ίσα μέρη και κάθε μέρος «κερδίζεται» με οκτώ ημέρες απασχόλησης. Στον μισθό των {$(ex)}, κάθε οκτάημερο αξίζει {$2(perStep)}. Οι ημέρες που περισσεύουν και δεν φτάνουν το οκτάημερο δεν χάνονται: δίνουν αναλογικό κλάσμα.</p>
  <p>Στο εργαλείο βάζετε τον μικτό μισθό ή το ημερομίσθιο και τις ημέρες της σχέσης εργασίας μέσα στο τετράμηνο. Αν δουλεύετε από πέρυσι, αφήνετε την προεπιλογή των {F.easterDays} ημερών. Το αποτέλεσμα δείχνει το μικτό, την προσαύξηση για το επίδομα αδείας, τις κρατήσεις και το καθαρό ποσό με τον μέσο φορολογικό συντελεστή του έτους σας.</p>

  <h2>Το δώρο Πάσχα ανά ημερομηνία πρόσληψης</h2>
  <ContentTable headers={['Έναρξη', 'Ημέρες έως 30/4', 'Ποσοστό', `Μικτό (${$(ex)})`, 'Καθαρό', 'Μικτό στον κατώτατο']} align={['l', 'r', 'r', 'r', 'r', 'r']} rows={rows} highlightRow={3} />
  <p>Η τελευταία στήλη δείχνει το ίδιο δώρο για εργαζόμενο με τον κατώτατο μισθό των {F.minWage}. Όποιος ξεκίνησε στις 20 Μαρτίου παίρνει ήδη περισσότερο από το ένα τρίτο του ποσού, και ακόμη μια πρόσληψη λίγες ημέρες πριν από το τέλος Απριλίου δίνει κάτι, έστω μικρό. Με ημερομίσθιο, το πλήρες δώρο είναι {F.easterDaily} ημερομίσθια: με το κατώτατο των {F.minDaily}, {$(dailyB.amount)} μικτά.</p>

  <h2>Κινητή γιορτή, σταθερή περίοδος</h2>
  <p>Η ιδιαιτερότητα του δώρου Πάσχα είναι ότι η προθεσμία μετακινείται κάθε χρόνο μαζί με τη γιορτή, ενώ η περίοδος υπολογισμού μένει σταθερή. Η πληρωμή οφείλεται έως τη Μεγάλη Τετάρτη. Όταν το Πάσχα πέφτει στις αρχές Απριλίου, η Μεγάλη Τετάρτη έρχεται πριν κλείσει το τετράμηνο: ο εργοδότης πληρώνει τότε το δώρο, και το κομμάτι που αντιστοιχεί στις ημέρες έως τις 30 Απριλίου μπορεί να εξοφληθεί αργότερα. Όταν το Πάσχα πέφτει τον Μάιο, το τετράμηνο έχει ήδη τελειώσει και το ποσό είναι οριστικό.</p>
  <p>Η κινητή ημερομηνία επηρεάζει και τη βάση. Το δώρο υπολογίζεται με τις αποδοχές που ισχύουν τη 15η ημέρα πριν από το Πάσχα. Μια χρονιά με αργό Πάσχα, η αύξηση του κατώτατου μισθού που ισχύει από 1η Απριλίου περνά στο δώρο. Μια χρονιά με πολύ πρώιμο Πάσχα, μπορεί να μην περάσει.</p>

  <h2>Ημέρες που αφαιρούνται και λάθη στην εκκαθάριση</h2>
  <p>Όπως και στα Χριστούγεννα, δεν μετρούν οι αδικαιολόγητες απουσίες, η απεργία, η άδεια άνευ αποδοχών και οι ημέρες ασθένειας που πλήρωσε ο ασφαλιστικός φορέας. Σε ένα σύντομο τετράμηνο, δύο εβδομάδες με επίδομα ασθενείας κοστίζουν σχεδόν δύο δεκαπεντημόρια. Ένα συχνό λάθος στη μισθοδοσία είναι να ξεχαστεί η προσαύξηση για το επίδομα αδείας: στα {$(ex)} είναι {$(full.leaveShare)}, και αν δεν τη βλέπετε στο εκκαθαριστικό, αξίζει να ρωτήσετε.</p>

  <div data-chrome><MiniSim client:load kind="leave" lang={lang} href={route('leave', lang)} /></div>

  <h2>Τι μένει εκτός υπολογισμού</h2>
  <p>Το εργαλείο εφαρμόζει το νόμιμο ελάχιστο. Συλλογικές συμβάσεις που δίνουν μεγαλύτερο δώρο, ή συμπεριλαμβάνουν σταθερές υπερωρίες στη βάση, δεν λαμβάνονται υπόψη. Ο φόρος υπολογίζεται με τον μέσο συντελεστή του έτους, όπως εξηγεί η <a href={route('method', lang)}>μεθοδολογία</a>, οπότε το καθαρό μπορεί να διαφέρει λίγο από αυτό του λογιστηρίου. Το δώρο Πάσχα, μαζί με το <a href={route('christmas', lang)}>δώρο Χριστουγέννων</a> και το επίδομα αδείας, είναι ο λόγος που ο μισθός πληρώνεται 14 φορές τον χρόνο, όπως δείχνει ο βασικός <a href={route('home', lang)}>υπολογισμός μισθού</a>.</p>
</GuideLayout>
