---
import ToolCalc from '../../components/calc/ToolCalc';
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { roadTax, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const $2 = (x: number) => formatMoney(x, 2, lang);
const R = P.road_tax;
const n = F.num;
const ccLabel = (i: number) => i === 0 ? `έως ${n(R.cc_bands[0])}` : i < R.cc_bands.length ? `${n(R.cc_bands[i - 1] + 1)}-${n(R.cc_bands[i])}` : `${n(R.cc_bands[R.cc_bands.length - 1] + 1)} και άνω`;
const ccRows = R.cc_until_2000.map((_, i) => [ccLabel(i), $(R.cc_until_2000[i]), $(R.cc_2001_2005[i]), $(R.cc_from_2006[i])]);
const co2Rows = (rows: Array<{ upTo: number | null; rate: number }>) => rows.map((r, i) => {
  const from = i === 0 ? 0 : (rows[i - 1].upTo as number) + 1;
  return [r.upTo === null ? `${n(from)} και άνω` : `${n(from)}-${n(r.upTo)}`, $2(r.rate), $2(from * r.rate), r.upTo === null ? '-' : $2(r.upTo * r.rate)];
});
const nedcFree = R.co2_nedc[0].upTo as number, wltpFree = R.co2_wltp[0].upTo as number;
const ccMax = R.cc_from_2006[R.cc_from_2006.length - 1];
// Παραδείγματα
const ex2022 = roadTax({ category: 'co2_wltp', co2: 140 });
const ex2016a = roadTax({ category: 'co2_nedc', co2: 120 }), ex2016b = roadTax({ category: 'co2_nedc', co2: 121 });
const cc1598 = { a: roadTax({ category: 'cc_from_2006', cc: 1598 }), b: roadTax({ category: 'cc_2001_2005', cc: 1598 }), c: roadTax({ category: 'cc_until_2000', cc: 1598 }) };
const suv = roadTax({ category: 'co2_wltp', co2: 210 }), suvBelow = roadTax({ category: 'co2_wltp', co2: 208 });
const faqs = [
  { q: 'Πώς καταλαβαίνω αν τα τέλη μου βγαίνουν με κυβικά ή με CO₂;', a: `Κοιτάξτε την ημερομηνία πρώτης ταξινόμησης στο πεδίο B της άδειας κυκλοφορίας. Αν είναι έως τις 31 Οκτωβρίου 2010, μετράει ο κυβισμός (πεδίο P.1) και ένας από τους τρεις πίνακες του άρθρου 20, από ${$(R.cc_until_2000[0])} έως ${$(ccMax)}. Από την 1η Νοεμβρίου 2010 μετράνε μόνο τα γραμμάρια CO₂ του πεδίου V.7, κατά NEDC έως το 2020 και κατά WLTP από το 2021.` },
  { q: 'Έφερα μεταχειρισμένο από τη Γερμανία. Ποια χρονιά λαμβάνεται υπόψη;', a: `Η ημερομηνία της πρώτης ταξινόμησης σε οποιοδήποτε κράτος της ΕΕ ή του ΕΟΧ, όχι η ημέρα που πήρε ελληνικές πινακίδες. Ένα αυτοκίνητο που κυκλοφόρησε πρώτη φορά στη Γερμανία το 2019 πληρώνει με τον πίνακα NEDC, ακόμη κι αν ταξινομήθηκε εδώ το ${F.year}. Για αυτοκίνητα με πρώτο έτος στη διεθνή αγορά πριν από το 2002, ο νόμος ορίζει υπολογισμό με κυβικά.` },
  { q: 'Πόσα τέλη πληρώνει ένα 1.600άρι βενζινοκίνητο του 2008;', a: `Ένας κινητήρας ${n(1598)} κ.εκ. ανήκει στο κλιμάκιο ${ccLabel(5)} και, με ταξινόμηση από το 2006 έως τις 31.10.2010, πληρώνει ${$(cc1598.a.amount)} τον χρόνο. Ο ίδιος κινητήρας με πρώτη ταξινόμηση 2001-2005 θα πλήρωνε ${$(cc1598.b.amount)} και έως το 2000 ${$(cc1598.c.amount)}. Το καύσιμο δεν παίζει ρόλο: πετρελαιοκίνητο και βενζινοκίνητο με ίδια κυβικά πληρώνουν το ίδιο.` },
  { q: 'Η άδεια γράφει άλλες εκπομπές από το πιστοποιητικό συμμόρφωσης. Ποιες μετράνε;', a: `Το άρθρο 20 κρατά τις εκπομπές της άδειας μόνο όταν συμφωνούν με το πιστοποιητικό συμμόρφωσης ή το έγγραφο που κατατέθηκε στο τελωνείο. Αν διαφέρουν, τα τέλη υπολογίζονται με τις τιμές του πιστοποιητικού. Η διαφορά μετράει περισσότερο κοντά στα όρια: στον πίνακα WLTP, τα ${n(208)} g/km δίνουν ${$2(suvBelow.amount)}, ενώ τα ${n(210)} δίνουν ${$2(suv.amount)}.` },
  { q: 'Το αυτοκίνητο είναι στο όνομα δύο αδελφών. Ποιος χρωστάει τα τέλη;', a: `Και οι δύο, ο καθένας για ολόκληρο το ποσό. Η παράγραφος 2γ του άρθρου 20 ορίζει ότι σε συνιδιοκτησία όλοι οι συνιδιοκτήτες ευθύνονται εις ολόκληρον για τα τέλη κυκλοφορίας και για το τυχόν πρόστιμο. Στην πράξη η εφορία μπορεί να ζητήσει όλο το ποσό από οποιονδήποτε, και ο λογαριασμός μοιράζεται μετά μεταξύ σας.` },
  { q: 'Τα πετρελαιοκίνητα πληρώνουν περισσότερα τέλη από τα βενζινοκίνητα;', a: `Ο νόμος δεν κάνει καμία διάκριση καυσίμου. Για ταξινόμηση έως τις 31.10.2010 μετρά μόνο ο κυβισμός, και μετά μόνο τα γραμμάρια CO₂. Ένα πετρελαιοκίνητο συχνά εκπέμπει λιγότερο CO₂ από ένα βενζινοκίνητο ίδιας ισχύος, οπότε μετά το 2010 μπορεί να πληρώνει λιγότερα: με ${n(150)} g/km κατά WLTP το ποσό είναι ${$2(roadTax({ category: 'co2_wltp', co2: 150 }).amount)}, όποιο κι αν είναι το καύσιμο.` },
];
---
<GuideLayout lang={lang} id="road" breadcrumbLabel={label('road', lang)}
  title={`Τέλη κυκλοφορίας ${F.year}: υπολογισμός με CO₂ ή κυβικά, πίνακες`}
  h1={`Τέλη κυκλοφορίας ${F.year}: υπολογισμός για κάθε αυτοκίνητο`}
  description={`Τέλη κυκλοφορίας ${F.year}: δωρεάν υπολογισμός με CO₂ (NEDC, WLTP) ή κυβικά, οι πέντε πίνακες του άρθρου 20, ηλεκτρικά χωρίς τέλη, ακινησία και παραδείγματα.`}
  intro={`Τα τέλη κυκλοφορίας ${F.year} βγαίνουν από τον κυβισμό για αυτοκίνητα ταξινομημένα έως τις 31 Οκτωβρίου 2010 και από τα γραμμάρια CO₂ για όλα τα νεότερα.`}
  resume={`Τα τέλη κυκλοφορίας ${F.year} ενός ιδιωτικού επιβατικού εξαρτώνται από ένα πράγμα πρώτα: την ημερομηνία πρώτης ταξινόμησης στην Ευρωπαϊκή Ένωση. Για αυτοκίνητα ταξινομημένα έως τις 31 Οκτωβρίου 2010 μετράει ο κυβισμός, με τρεις πίνακες (έως το 2000, 2001-2005, από το 2006) και ποσά από ${$(R.cc_until_2000[0])} έως ${$(ccMax)}. Από την 1η Νοεμβρίου 2010 έως το τέλος του 2020 μετράνε τα γραμμάρια CO₂ κατά NEDC, και από το 2021 τα γραμμάρια κατά WLTP: όλα τα γραμμάρια πολλαπλασιάζονται με τα ευρώ ανά γραμμάριο του κλιμακίου όπου πέφτει το αυτοκίνητο. Ένα μοντέλο του 2022 με 140 g/km πληρώνει ${$2(ex2022.amount)}, ενώ έως ${n(wltpFree)} g/km κατά WLTP ή ${n(nedcFree)} g/km κατά NEDC τα τέλη είναι μηδέν. Ηλεκτρικά και υδρογόνου δεν πληρώνουν. Το ποσό είναι ετήσιο και αδιαίρετο: χρωστιέται ολόκληρο, εκτός αν το όχημα δηλωθεί σε ακινησία για όλο το έτος. Ο υπολογιστής ζητά μόνο δύο στοιχεία της άδειας κυκλοφορίας.`}
  faqs={faqs}
  related={[{ href: route('roadco2', lang), name: label('roadco2', lang), description: 'Τα κλιμάκια NEDC και WLTP και το άλμα στα όρια.' }, { href: route('roadmonth', lang), name: label('roadmonth', lang), description: 'Γιατί τα τέλη δεν πληρώνονται με δόσεις ανά μήνα.' }, { href: route('home', lang), name: label('home', lang), description: 'Καθαρά από τον μικτό μισθό, για να μπουν τα τέλη στον προϋπολογισμό.' }]}
  sources={[src('road_tax', lang), src('road_tax_idle', lang), { name: 'Οδηγία 1999/37/ΕΚ, παράρτημα Ι: κωδικοί της άδειας κυκλοφορίας (B, P.1, V.7)', url: 'https://www.legislation.gov.uk/eudr/1999/37/annex/I' }]}>
  <div data-outil><ToolCalc client:load kind="road" lang={lang} methodHref={route('method', lang)} /></div>

  <h2>Πίνακες κυβισμού: αυτοκίνητα έως τις 31.10.2010</h2>
  <ContentTable headers={['Κυβισμός (κ.εκ.)', 'Ταξινόμηση έως 2000', '2001-2005', '2006 έως 31.10.2010']} align={['l', 'r', 'r', 'r']} rows={ccRows} highlightRow={5} />
  <p>Ο νόμος 2948/2001 έχει στο άρθρο 20 τρεις ξεχωριστούς πίνακες κυβισμού, που εδώ φαίνονται δίπλα δίπλα. Τα κλιμάκια είναι ίδια και στους τρεις, και έως τα {n(R.cc_bands[3])} κ.εκ. τα ποσά δεν αλλάζουν. Η διαφορά εμφανίζεται από τα {n(R.cc_bands[3] + 1)} κ.εκ. και πάνω: ένα αυτοκίνητο της ίδιας κατηγορίας πληρώνει λίγο περισσότερο όσο νεότερη είναι η πρώτη του ταξινόμηση. Το ποσό είναι σταθερό ανά κλιμάκιο, δεν πολλαπλασιάζεται με τίποτα. Η μεγάλη απότομη αύξηση βρίσκεται στα {n(R.cc_bands[6])} κ.εκ.: ένα κυβικό παραπάνω και το αυτοκίνητο του 2008 περνά από {$(R.cc_from_2006[6])} σε {$(R.cc_from_2006[7])}. Περισσότερα για τα παλιά αυτοκίνητα και τις μοτοσικλέτες στον οδηγό για τα <a href={route('roadcc', lang)}>τέλη με βάση τα κυβικά</a>.</p>

  <h2>Πίνακες CO₂: NEDC έως το 2020, WLTP από το 2021</h2>
  <ContentTable caption="Πίνακας NEDC: πρώτη ταξινόμηση 1.11.2010 έως 31.12.2020" headers={['CO₂ (g/km)', 'Ευρώ ανά g', 'Τέλη στην αρχή', 'Τέλη στο τέλος']} align={['l', 'r', 'r', 'r']} rows={co2Rows(R.co2_nedc)} />
  <ContentTable caption="Πίνακας WLTP: πρώτη ταξινόμηση από 1.1.2021" headers={['CO₂ (g/km)', 'Ευρώ ανά g', 'Τέλη στην αρχή', 'Τέλη στο τέλος']} align={['l', 'r', 'r', 'r']} rows={co2Rows(R.co2_wltp)} />
  <p>Εδώ δεν υπάρχει σταθερό ποσό. Το άρθρο 20 ορίζει ένα ποσό ανά γραμμάριο για κάθε κλιμάκιο, και αυτό εφαρμόζεται σε όλα τα γραμμάρια του αυτοκινήτου, όχι μόνο σε όσα ξεπερνούν το όριο. Έτσι, στο τέλος κάθε κλιμακίου τα τέλη πηδούν. Με NEDC, {n(120)} g/km δίνουν {$2(ex2016a.amount)} και {n(121)} g/km δίνουν {$2(ex2016b.amount)}: ένα γραμμάριο κοστίζει {$2(ex2016b.amount - ex2016a.amount)}. Ο πίνακας WLTP έχει άλλα όρια και χαμηλότερους συντελεστές· οι δύο πίνακες δεν συγκρίνονται γραμμάριο προς γραμμάριο, γιατί στηρίζονται σε διαφορετικές διαδικασίες δοκιμής. Ο οδηγός για τα <a href={route('roadco2', lang)}>κλιμάκια CO₂</a> δείχνει όλα τα όρια όπου αξίζει να προσέξετε πριν αγοράσετε.</p>

  <h2>Πού γράφει η άδεια κυκλοφορίας την ημερομηνία και το CO₂</h2>
  <p>Η ελληνική άδεια κυκλοφορίας ακολουθεί το ευρωπαϊκό υπόδειγμα της οδηγίας 1999/37/ΕΚ, οπότε κάθε στοιχείο έχει έναν κωδικό. Το πεδίο <strong>B</strong> είναι η ημερομηνία πρώτης ταξινόμησης, το <strong>P.1</strong> ο κυβισμός σε κυβικά εκατοστά και το <strong>V.7</strong> οι εκπομπές CO₂ σε γραμμάρια ανά χιλιόμετρο. Με αυτά τα τρία στοιχεία ο υπολογιστής παραπάνω βγάζει το ακριβές ποσό.</p>
  <p>Δύο παγίδες εμφανίζονται συχνά. Η πρώτη αφορά τα μεταχειρισμένα εισαγωγής: για τα τέλη, «πρώτη ταξινόμηση» σημαίνει η πρώτη σε κράτος μέλος της ΕΕ ή του ΕΟΧ, όχι η ελληνική. Ένα αυτοκίνητο που κυκλοφόρησε στην Ιταλία το 2009 και ήρθε εδώ το 2015 πληρώνει με κυβικά, σαν να ταξινομήθηκε το 2009. Το ίδιο ισχύει για όχημα που διαγράφηκε και ξαναταξινομήθηκε: μετρά η πρώτη άδεια πριν από τη διαγραφή. Για μεταχειρισμένα με πρώτο έτος στη διεθνή αγορά πριν από την 1.1.2002, ο νόμος ορίζει υπολογισμό με κυβικά, ανεξάρτητα από το πότε μπήκαν στην ΕΕ.</p>
  <p>Η δεύτερη παγίδα είναι η τιμή CO₂. Το άρθρο 20 λαμβάνει υπόψη τις εκπομπές της άδειας μόνο εφόσον συμφωνούν με το πιστοποιητικό συμμόρφωσης ή το έγγραφο που κατατέθηκε στο τελωνείο για τα τέλη ταξινόμησης. Όταν οι δύο τιμές διαφέρουν, μετρά το πιστοποιητικό. Αν η άδειά σας δείχνει τιμή κοντά σε όριο κλιμακίου, αξίζει να ελέγξετε και το πιστοποιητικό.</p>

  <h2>Τέσσερα αυτοκίνητα, τέσσερις λογαριασμοί</h2>
  <p>Ένα μικρό SUV του 2022 με {n(140)} g/km κατά WLTP πέφτει στο κλιμάκιο {n(140)}-{n(166)}, με {$2(R.co2_wltp[2].rate)} ανά γραμμάριο: {n(140)} × {$2(R.co2_wltp[2].rate)} = {$2(ex2022.amount)} τον χρόνο, δηλαδή {$2(ex2022.amount / 12)} τον μήνα αν θέλετε να τα αποταμιεύετε σταδιακά.</p>
  <p>Ένα οικογενειακό του 2016 με {n(121)} g/km κατά NEDC πληρώνει {$2(ex2016b.amount)}. Αν μια άλλη έκδοση του ίδιου μοντέλου έβγαζε {n(120)} g/km, θα πλήρωνε {$2(ex2016a.amount)}. Η επιλογή έκδοσης στο μεταχειρισμένο μετράει.</p>
  <p>Ένα 1.600άρι του 2008, με {n(1598)} κ.εκ. στο πεδίο P.1, πληρώνει {$(cc1598.a.amount)}. Το ίδιο μοντέλο με πρώτη ταξινόμηση το 2004 πληρώνει {$(cc1598.b.amount)} και του 1999 {$(cc1598.c.amount)}.</p>
  <p>Ένα μεγάλο SUV του 2023 με {n(210)} g/km κατά WLTP περνά στο κλιμάκιο με {$2(R.co2_wltp[4].rate)} ανά γραμμάριο και πληρώνει {$2(suv.amount)}. Με {n(208)} g/km θα έμενε στα {$2(suvBelow.amount)}: δύο γραμμάρια, πάνω από διπλάσια τέλη.</p>

  <div data-chrome><MiniSim client:load kind="roadco2" lang={lang} href={route('roadco2', lang)} /></div>

  <h2>Ηλεκτρικά, μοτοσικλέτες, τροχόσπιτα και μοτοποδήλατα</h2>
  <p>Τα αμιγώς ηλεκτρικά και τα αυτοκίνητα υδρογόνου δεν πληρώνουν τέλη: έχουν μηδέν γραμμάρια CO₂ στην άδεια, άρα και μηδέν ποσό σε οποιονδήποτε πίνακα, και το άρθρο 20 τα αναφέρει ρητά ως απαλλασσόμενα. Ο οδηγός για τα <a href={route('roadev', lang)}>ηλεκτρικά αυτοκίνητα</a> υπολογίζει πόσα γλιτώνει κανείς σε βάθος χρόνου.</p>
  <p>Οι μοτοσικλέτες, δίκυκλες και τρίκυκλες, πληρώνουν πάντα με τον κυβισμό, ακόμη κι αν ταξινομήθηκαν μετά το 2010, με τον πίνακα που αντιστοιχεί στη χρονιά της πρώτης ταξινόμησής τους. Τα ιδιωτικά τροχόσπιτα (ρυμουλκούμενα) πληρώνουν σταθερά {$(R.caravan)} και τα δίτροχα ή τρίτροχα μοτοποδήλατα {$(R.moped)}.</p>

  <h2>Ακινησία: ο μόνος νόμιμος τρόπος να μην πληρώσετε</h2>
  <p>Η παράγραφος 2α του άρθρου 20 είναι σαφής: τα τέλη ιδιωτικών επιβατικών, μοτοσικλετών και τροχόσπιτων είναι αδιαίρετα και οφείλονται για ολόκληρο το έτος, όσους μήνες κι αν κυκλοφόρησε το όχημα. Θεωρείται ότι κυκλοφόρησε όλο το έτος, εκτός αν δηλωθεί σε ακινησία για όλο το έτος.</p>
  <p>Η ακινησία δηλώνεται ηλεκτρονικά στο gov.gr και, για να γλιτώσετε τα τέλη, πρέπει να υποβληθεί <strong>πριν αρχίσει η χρονιά</strong>. Δήλωση μέσα στον Φεβρουάριο δεν μετράει για τα τέλη του ίδιου έτους. Μετά τη δήλωση αφαιρείτε τις πινακίδες, τις φυλάτε, και το αυτοκίνητο μένει στο σημείο που δηλώσατε. Αν εντοπιστεί να κυκλοφορεί ή σταθμευμένο αλλού, η ακινησία αίρεται αυτόματα και επιβάλλεται, πέρα από τα τέλη, διοικητικό πρόστιμο δέκα χιλιάδων ευρώ. Σε υποτροπή μέσα σε πέντε χρόνια το πρόστιμο τριπλασιάζεται και αφαιρείται το δίπλωμα για τρία χρόνια. Για να ξαναβγεί το αυτοκίνητο στον δρόμο, η άρση της ακινησίας προϋποθέτει την πληρωμή των τελών του έτους της άρσης. Γι' αυτό η ιδέα «πληρώνω μόνο τους μήνες που οδηγώ» δεν λειτουργεί, όπως εξηγεί ο οδηγός για τα <a href={route('roadmonth', lang)}>τέλη κυκλοφορίας με το μήνα</a>.</p>

  <h2>Τι δεν υπολογίζει αυτή η σελίδα</h2>
  <p>Ο υπολογιστής αφορά ιδιωτικά επιβατικά. Φορτηγά, λεωφορεία, ταξί και αυτοκίνητα σε καθεστώς προσωρινής εισαγωγής έχουν δικούς τους πίνακες ή κανόνες στο ίδιο άρθρο και δεν περιλαμβάνονται. Δεν υπολογίζουμε επίσης τα πρόστιμα εκπρόθεσμης πληρωμής: δεν βρήκαμε το ισχύον ποσό σε πηγή που μπορέσαμε να ελέγξουμε, οπότε δεν δίνουμε αριθμό. Η προθεσμία πληρωμής κάθε χρονιάς ανακοινώνεται από τη φορολογική διοίκηση. Όσοι γράφουν στην αναζήτηση «τελη κυκλοφοριας», «teli kikloforias» ή «telh kykloforias» καταλήγουν στους ίδιους πίνακες: το ποσό που βλέπετε εδώ είναι αυτό του νόμου για το {F.year}, και αν αλλάξει κάποιος συντελεστής, αλλάζουν μαζί όλοι οι πίνακες της σελίδας. Για το άλλο μεγάλο ετήσιο έξοδο του νοικοκυριού, δείτε τον υπολογιστή <a href={route('enfia', lang)}>ΕΝΦΙΑ</a>.</p>
</GuideLayout>
