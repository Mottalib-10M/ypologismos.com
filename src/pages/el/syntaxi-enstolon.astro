---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { pension, replacementRate, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney, pct } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const $2 = (x: number) => formatMoney(x, 2, lang);
const p = (x: number) => pct(x, lang);
const Q = P.pension;
const avgs = [1500, 1900, 2400];
const grid = [20, 25, 28, 30, 33, 35, 38, 40].map((y) => [`${y}`, p(replacementRate(y)), ...avgs.map((a) => $(pension({ years: y, avgEarnings: a }).contributory))]);
const last = 2300, avg02 = 1750, yrs = 33;
const withLast = pension({ years: yrs, avgEarnings: last }), withAvg = pension({ years: yrs, avgEarnings: avg02 });
const y30 = pension({ years: 30, avgEarnings: 1900 }), y35 = pension({ years: 35, avgEarnings: 1900 });
const art4 = { name: 'Ν. 4387/2016, άρθρο 4: υπαγωγή υπαλλήλων του Δημοσίου και στρατιωτικών στον ΕΦΚΑ', url: 'https://www.taxheaven.gr/law/4387/2016/article/4/view' };
const art6 = { name: 'Ν. 4387/2016, άρθρο 6: ειδικές και μεταβατικές συνταξιοδοτικές διατάξεις του Δημοσίου', url: 'https://www.taxheaven.gr/law/4387/2016/article/6/view' };
const faqs = [
  { q: 'Ο υπολογιστής σας μου λέει σε ποια ηλικία βγαίνω στη σύνταξη ως στρατιωτικός;', a: `Όχι. Το άρθρο 4 του ν. 4387/2016 ορίζει ότι για τις προϋποθέσεις θεμελίωσης και τα όρια ηλικίας των στελεχών των Ενόπλων Δυνάμεων, των Σωμάτων Ασφαλείας και του Πυροσβεστικού Σώματος εξακολουθούν να ισχύουν οι διατάξεις της συνταξιοδοτικής νομοθεσίας του Δημοσίου. Αυτές δεν τις έχουμε επαληθεύσει και δεν τις υπολογίζουμε. Για την ημερομηνία σας ρωτήστε τη διεύθυνση προσωπικού του σώματος και τον e-ΕΦΚΑ.` },
  { q: 'Από ποιο έτος μετράνε οι αποδοχές για το ανταποδοτικό μέρος ενός ενστόλου;', a: `Από το 2002. Για υπαλλήλους του Δημοσίου και στρατιωτικούς, το άρθρο 8 παράγραφος 3 λαμβάνει τον μέσο όρο των μηνιαίων αποδοχών από το ασφαλιστικό έτος 2002 ως την έναρξη της σύνταξης. Για συντάξεις από 1.1.2021, αν μετά το 2002 υπάρχουν λιγότεροι από δέκα χρόνια ασφάλισης, ο υπολογισμός συμπληρώνεται με χρόνο πριν από το 2002, ως τα δέκα έτη συνολικά.` },
  { q: `Με 33 χρόνια υπηρεσίας και τελευταίο μισθό ${$(last)}, γιατί η εκτίμηση βγαίνει χαμηλότερη από ό,τι περίμενα;`, a: `Γιατί η βάση δεν είναι ο τελευταίος μισθός αλλά ο μέσος όρος από το 2002, αναπροσαρμοσμένος. Αν ο μέσος αυτός είναι ${$(avg02)}, το ανταποδοτικό μέρος με ${p(replacementRate(yrs))} είναι ${$(withAvg.contributory)} αντί για ${$(withLast.contributory)} με τον τελευταίο μισθό. Όσο πιο γρήγορα ανέβηκαν οι αποδοχές τα τελευταία χρόνια, τόσο μεγαλύτερη η απόσταση.` },
  { q: 'Παίρνουν και οι ένστολοι εθνική σύνταξη;', a: `Το άρθρο 7 προβλέπει εθνική σύνταξη για όλους όσοι θεμελιώνουν δικαίωμα σύνταξης, με το πλήρες ποσό των ${F.nationalFull} (τελευταίο που δημοσίευσε το Υπουργείο, από 1.1.2025) για ${Q.national_years_full} έτη ασφάλισης και ${Q.residence_years_full} έτη διαμονής. Ο υπολογιστής την προσθέτει με τον γενικό κανόνα. Ειδικές ρυθμίσεις για τον χρόνο που λογίζεται συντάξιμος στα σώματα δεν τις καλύπτουμε.` },
  { q: 'Ισχύει ο ν. 4387/2016 για τις πολεμικές συντάξεις και τις συντάξεις αναπήρων οπλιτών;', a: `Όχι. Το άρθρο 4 παράγραφος 3 εξαιρεί όσους δικαιούνται πολεμική σύνταξη, σύνταξη αναπήρου οπλίτη ειρηνικής περιόδου ή σύνταξη Εθνικής Αντίστασης, κατά τον Κώδικα Πολεμικών Συντάξεων και τον Κώδικα Πολιτικών και Στρατιωτικών Συντάξεων. Αυτές οι συντάξεις ακολουθούν δικούς τους κανόνες, και ο υπολογιστής αυτής της σελίδας δεν τις αφορά.` },
];
---
<GuideLayout lang={lang} id="uniformed" breadcrumbLabel={label('uniformed', lang)}
  title={`Σύνταξη ενστόλων ${F.year}: ανταποδοτική με μέσο όρο από το 2002`}
  h1={`Σύνταξη ενστόλων ${F.year}: τι υπολογίζεται με τον ν. 4387/2016 και τι όχι`}
  description={`Σύνταξη ενστόλων ${F.year}: ανταποδοτικό μέρος με τα ποσοστά του πίνακα 2 και μέσο μισθό από το 2002, συν εθνική σύνταξη. Τι λέει ο νόμος, τι ρωτάτε στην υπηρεσία.`}
  intro={`Στρατιωτικοί, αστυνομικοί και πυροσβέστες: το κομμάτι της σύνταξης που υπολογίζεται με κοινούς κανόνες, και όσα μένουν στη νομοθεσία του Δημοσίου.`}
  resume={`Από το 2016 τα στελέχη των Ενόπλων Δυνάμεων, των Σωμάτων Ασφαλείας και του Πυροσβεστικού Σώματος υπάγονται για κύρια σύνταξη στον ενιαίο φορέα, και οι συντάξεις τους κανονίζονται με τον ν. 4387/2016· για αυτούς η ένταξη ισχύει από 1.7.2016 (άρθρα 4 και 6). Το ποσό έχει δύο μέρη. Το ανταποδοτικό είναι ο μέσος όρος των μηνιαίων αποδοχών από το 2002 ως την έναρξη της σύνταξης, αναπροσαρμοσμένος, επί το ποσοστό αναπλήρωσης του πίνακα 2: ${p(replacementRate(30))} στα 30 έτη, ${p(replacementRate(35))} στα 35 και ${p(replacementRate(40))} στα 40. Με μέσο όρο ${$(1900)}, 30 έτη δίνουν ${$(y30.contributory)} και 35 έτη ${$(y35.contributory)} τον μήνα. Προστίθεται η εθνική σύνταξη, ως ${F.nationalFull}. Αντίθετα, οι προϋποθέσεις θεμελίωσης και τα όρια ηλικίας των ενστόλων παραμένουν στις διατάξεις της συνταξιοδοτικής νομοθεσίας του Δημοσίου. Αυτές, όπως και ο πλασματικός χρόνος ή οι ειδικές ρυθμίσεις κάθε σώματος, δεν υπολογίζονται εδώ.`}
  faqs={faqs}
  related={[{ href: route('pension', lang), name: label('pension', lang), description: 'Ο πλήρης υπολογιστής, με εθνική και ανταποδοτική.' }, { href: route('national', lang), name: label('national', lang), description: 'Πώς υπολογίζεται το σταθερό μέρος της σύνταξης.' }, { href: route('retireage', lang), name: label('retireage', lang), description: 'Τα γενικά όρια ηλικίας του e-ΕΦΚΑ.' }]}
  sources={[src('pension', lang), src('pension_national', lang), art4, art6, src('pension_ministry', lang)]}>
  <div data-chrome><MiniSim client:load kind="uniformed" lang={lang} href={route('pension', lang)} /></div>

  <h2>Τι λέει ο νόμος για τους ενστόλους, λέξη προς λέξη</h2>
  <p>Όσοι αναζητούν «ενστολοι υπολογισμος συνταξης» θέλουν συνήθως δύο απαντήσεις: πότε βγαίνουν και με πόσα. Ο ν. 4387/2016 τις χωρίζει. Το άρθρο 4 παράγραφος 1α εντάσσει για κύρια σύνταξη στον ενιαίο φορέα τους υπαλλήλους του Δημοσίου «καθώς και τα στελέχη των Ενόπλων Δυνάμεων, των Σωμάτων Ασφαλείας και του Πυροσβεστικού Σώματος», και ορίζει ότι οι συντάξεις τους κανονίζονται και καταβάλλονται με βάση τις ρυθμίσεις του ίδιου νόμου. Το άρθρο 6 παράγραφος 4 προσθέτει ότι για τα στελέχη αυτά η ένταξη ισχύει από 1η Ιουλίου 2016.</p>
  <p>Η παράγραφος 1β του ίδιου άρθρου κρατά όμως κάτι απέξω: για τις προϋποθέσεις θεμελίωσης σύνταξης και για τα όρια ηλικίας καταβολής της «εξακολουθούν να έχουν εφαρμογή οι οικείες διατάξεις της συνταξιοδοτικής νομοθεσίας του Δημοσίου». Με απλά λόγια, το «πόσα» ακολουθεί τους κοινούς κανόνες, ενώ το «πότε» ακολουθεί τη δική σας νομοθεσία. Αυτή η σελίδα καλύπτει μόνο το πρώτο.</p>

  <h2>Το ανταποδοτικό μέρος με τον πίνακα 2</h2>
  <ContentTable headers={['Συντάξιμα έτη', 'Ποσοστό', ...avgs.map((a) => `Μέσος όρος ${$(a)}`)]} align={['l', 'r', 'r', 'r', 'r']} rows={grid} highlightRow={3} />
  <p>Το άρθρο 8 παράγραφος 1 ορίζει ότι οι υπάλληλοι του Δημοσίου «καθώς και οι στρατιωτικοί» δικαιούνται ανταποδοτικό μέρος με βάση τις συντάξιμες αποδοχές, τον χρόνο ασφάλισης και τα ποσοστά του πίνακα που ενσωματώνεται στην παράγραφο 5. Από 1.10.2019 εφαρμόζεται ο πίνακας 2, ο ίδιος για όλους τους ασφαλισμένους. Ο παραπάνω πίνακας δείχνει το ανταποδοτικό μέρος για τρεις μέσους όρους αποδοχών· η εθνική σύνταξη προστίθεται χωριστά. Τα ποσοστά ανεβαίνουν απότομα μετά τα 30 έτη, οπότε για στελέχη με μεγάλη υπηρεσία τα τελευταία χρόνια μετράνε περισσότερο από τα πρώτα.</p>

  <h2>Γιατί μετράει ο μέσος όρος από το 2002</h2>
  <p>Η παράγραφος 3 του άρθρου 8 είναι η πιο κρίσιμη για τους ενστόλους. Ως συντάξιμες αποδοχές λαμβάνεται ο μέσος όρος των μηνιαίων αποδοχών «από το ασφαλιστικό έτος 2002 και έως την έναρξη καταβολής της σύνταξης». Αν ο χρόνος ασφάλισης από 1.1.2002 είναι μικρότερος από πέντε έτη, ο υπολογισμός συμπληρώνεται με χρόνο πριν από το 2002 ως τα πέντε έτη· για συντάξεις με έναρξη από 1.1.2021, το όριο αυτό είναι δέκα έτη. Οι αποδοχές κάθε έτους αναπροσαρμόζονται έως και το 2026 με τον δείκτη τιμών καταναλωτή και από το 2027 με τον δείκτη μεταβολής μισθών της ΕΛΣΤΑΤ.</p>
  <p>Η συνέπεια είναι απλή αλλά συχνά απρόσμενη. Σε μια καριέρα με προαγωγές, ο μέσος όρος από το 2002 είναι χαμηλότερος από τον τελευταίο μισθό. Με 33 έτη, τελευταίο μισθό {$(last)} και μέσο όρο {$(avg02)}, το ανταποδοτικό μέρος είναι {$(withAvg.contributory)} και όχι {$(withLast.contributory)}. Στον υπολογιστή βάλτε λοιπόν τον μέσο όρο, όχι τον μισθό του τελευταίου βαθμού. Το ανταποδοτικό ποσό δεν μπορεί, σε κάθε περίπτωση, να ξεπεράσει τις ίδιες τις συντάξιμες αποδοχές.</p>

  <div data-chrome><MiniSim client:load kind="pension" lang={lang} href={route('pension', lang)} /></div>

  <h2>Η εθνική σύνταξη</h2>
  <p>Το άρθρο 7 προβλέπει εθνική σύνταξη για όλους όσοι θεμελιώνουν δικαίωμα σύνταξης. Το πλήρες ποσό είναι {F.nationalFull} από 1.1.2025, το τελευταίο που δημοσίευσε το Υπουργείο Εργασίας, με αναπροσαρμογή κάθε χρόνο. Δίνεται ακέραιο με {Q.national_years_full} έτη ασφάλισης και {Q.residence_years_full} έτη διαμονής στην Ελλάδα, και μειώνεται για λιγότερα. Ο μικρός υπολογιστής παραπάνω τη συνδυάζει με το ανταποδοτικό μέρος. Λεπτομέρειες στον οδηγό για την <a href={route('national', lang)}>εθνική σύνταξη</a>.</p>

  <h2>Τι δεν καλύπτει αυτή η σελίδα</h2>
  <p>Δεν υπολογίζουμε, γιατί δεν τα έχουμε επαληθεύσει σε επίσημη πηγή: τα όρια ηλικίας και τα έτη υπηρεσίας που απαιτούνται για στρατιωτικούς, αστυνομικούς, πυροσβέστες ή λιμενικούς· τον πλασματικό χρόνο και τις προσαυξήσεις χρόνου που μπορεί να ισχύουν σε κάθε σώμα· τις ειδικές ρυθμίσεις για όσους κατατάχθηκαν πριν από το 1993, για τις οποίες το Υπουργείο σημειώνει ότι οι προϋποθέσεις διαφοροποιούνται ανά φορέα ή για το Δημόσιο· το εφάπαξ και τις επικουρικές παροχές. Επίσης, το άρθρο 4 παράγραφος 3 εξαιρεί από τον νόμο τις πολεμικές συντάξεις και τις συντάξεις αναπήρων οπλιτών ειρηνικής περιόδου.</p>
  <p>Για όλα αυτά, η σωστή πηγή είναι η διεύθυνση προσωπικού του σώματός σας και η υπηρεσία συντάξεων του e-ΕΦΚΑ για τον δημόσιο τομέα, με βάση το υπηρεσιακό σας μητρώο. Ο υπολογιστής αυτής της σελίδας σάς βοηθά να ελέγξετε το ποσό που θα σας δώσουν, όχι την ημερομηνία. Τις γενικές ηλικίες του ιδιωτικού τομέα θα βρείτε στη σελίδα για τα <a href={route('retireage', lang)}>όρια ηλικίας</a> και τον πλήρη υπολογισμό στον <a href={route('pension', lang)}>υπολογισμό σύνταξης</a>· για τις κρατήσεις του μισθού σας σήμερα, στον <a href={route('home', lang)}>υπολογισμό μισθού</a>.</p>
</GuideLayout>
