---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { salary, leaveAllowance, christmasBonus, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney, formatMoney as fm, pct } from '../../lib/format';
import { PART_TIME_EXTRA } from '../../lib/mini-extra-c';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const $2 = (x: number) => fm(x, 2, lang);
const M = P.minimum_wage.monthly;
const FT = 40;
const at = (h: number, base = M) => salary({ gross: base * h / FT });
const rows = [10, 15, 20, 24, 25, 30, 35, 40].map((h) => { const s = at(h); return [`${h}`, $(M * h / FT), $(s.efka), $(s.tax), $(s.net), $(s.netPer12)]; });
const s20 = at(20), s30 = at(30), s20b = at(20, 1600);
const rate = 8, extraH = 12, extraPay = rate * (1 + PART_TIME_EXTRA) * extraH;
const leave20 = leaveAllowance({ pay: M * 20 / FT }).amount, xmas20 = christmasBonus({ pay: M * 20 / FT }).amount;
const faqs = [
  { q: 'Δουλεύω 20 ώρες την εβδομάδα με τον κατώτατο. Πόσα πρέπει να παίρνω;', a: `Τουλάχιστον ${$(M * 20 / FT)} μικτά τον μήνα, δηλαδή το μισό του κατώτατου των ${F.minWage}, αφού οι αποδοχές της μερικής απασχόλησης αντιστοιχούν στις ώρες σε σχέση με το πλήρες ωράριο. Από αυτά κρατούνται ${$(s20.efka)} εισφορές και φόρος ${$(s20.tax)}, οπότε μένουν ${$(s20.net)} καθαρά ανά καταβολή, με 14 καταβολές τον χρόνο.` },
  { q: 'Ο εργοδότης μού ζητά να μείνω δύο ώρες παραπάνω. Πώς πληρώνονται;', a: `Η εργασία πέρα από το συμφωνημένο ωράριο πληρώνεται με προσαύξηση ${pct(PART_TIME_EXTRA, lang)} επί της συμφωνημένης αμοιβής για κάθε επιπλέον ώρα, σύμφωνα με τις απαντήσεις του Υπουργείου Εργασίας. Με ωριαία αμοιβή ${$2(rate)}, κάθε επιπλέον ώρα αξίζει ${$2(rate * (1 + PART_TIME_EXTRA))}. Μπορείτε να αρνηθείτε την πρόσθετη εργασία όταν γίνεται συνήθεια.` },
  { q: 'Δικαιούμαι επίδομα αδείας αν δουλεύω μερική απασχόληση;', a: `Ναι. Οι μερικώς απασχολούμενοι έχουν ετήσια άδεια με αποδοχές και επίδομα αδείας, υπολογισμένα στις αποδοχές που θα έπαιρναν αν εργάζονταν τον χρόνο της άδειας. Σε εικοσάωρη απασχόληση με τον κατώτατο, το επίδομα αδείας είναι έως ${$(leave20)} μικτά, όσο δηλαδή το μισό του δικού σας μηνιαίου μισθού.` },
  { q: 'Μπορώ να ζητήσω να περάσω από πλήρη σε μερική απασχόληση;', a: `Ναι, αν η επιχείρηση απασχολεί πάνω από 20 άτομα και έχετε συμπληρώσει ένα ημερολογιακό έτος. Η αίτηση ορίζει τη διάρκεια και το είδος της μερικής απασχόλησης και διατηρείτε δικαίωμα επιστροφής σε πλήρη. Ο εργοδότης μπορεί να αρνηθεί μόνο για επιχειρησιακές ανάγκες· αν δεν απαντήσει εγγράφως μέσα σε έναν μήνα, το αίτημα θεωρείται δεκτό.` },
  { q: 'Δεν υπέγραψα ποτέ σύμβαση μερικής απασχόλησης. Τι ισχύει;', a: `Η συμφωνία για μερική απασχόληση πρέπει να γίνει εγγράφως και να γνωστοποιηθεί μέσα σε 8 ημέρες. Αν δεν καταρτιστεί εγγράφως ή δεν γνωστοποιηθεί εμπρόθεσμα, τεκμαίρεται ότι η απασχόληση είναι πλήρης. Στην πράξη αυτό σημαίνει ότι η μισθοδοσία σας κρίνεται με βάση τον μισθό πλήρους απασχόλησης, ${F.minWage} τουλάχιστον.` },
  { q: 'Μετράει η μερική απασχόληση στις τριετίες και στην προϋπηρεσία;', a: `Ναι. Ο χρόνος της μερικής απασχόλησης λογίζεται ως προϋπηρεσία όπως και για τον συγκρίσιμο εργαζόμενο πλήρους απασχόλησης. Για τον υπολογισμό της, μερική απασχόληση που αντιστοιχεί στον κανονικό ημερήσιο χρόνο του συγκρίσιμου εργαζομένου αντιστοιχεί σε μία ημέρα προϋπηρεσίας, όπως γράφει το Υπουργείο Εργασίας. Όταν συμπληρωθεί τριετία, η προσαύξηση ${F.triennium} περνά και στον αναλογικό μισθό σας.` },
];
---
<GuideLayout lang={lang} id="parttime" breadcrumbLabel={label('parttime', lang)}
  title={`Μερική απασχόληση ${F.year}: μισθός ανά ώρες, +${pct(PART_TIME_EXTRA, lang)} υπερεργασία`}
  h1={`Μερική απασχόληση ${F.year}: μισθός, επιπλέον ώρες και δικαιώματα`}
  description={`Μερική απασχόληση ${F.year}: μισθός αναλογικός με τις ώρες, ${$(M * 20 / FT)} μικτά για 20 ώρες στον κατώτατο, +${pct(PART_TIME_EXTRA, lang)} για επιπλέον ώρες, άδεια, επίδομα αδείας και δώρα.`}
  intro={`Στη μερική απασχόληση ο μισθός υπολογίζεται αναλογικά με τις ώρες, και κάθε ώρα πέρα από το συμφωνημένο ωράριο πληρώνεται με ${pct(PART_TIME_EXTRA, lang)} προσαύξηση.`}
  resume={`Ο εργαζόμενος μερικής απασχόλησης αμείβεται όπως ο συγκρίσιμος συνάδελφος πλήρους απασχόλησης, αλλά αναλογικά με τις ώρες του. Με τον κατώτατο μισθό των ${F.minWage} για πλήρες ωράριο ${FT} ωρών, μια εικοσάωρη σύμβαση δίνει τουλάχιστον ${$(M * 20 / FT)} μικτά και ${$(s20.net)} καθαρά ανά καταβολή, ενώ μια τριαντάωρη ${$(M * 30 / FT)} μικτά και ${$(s30.net)} καθαρά. Οι 14 καταβολές, η ετήσια άδεια και το επίδομα αδείας ισχύουν κανονικά, υπολογισμένα στις μειωμένες αποδοχές. Αν χρειαστεί να δουλέψετε περισσότερο από το συμφωνημένο, κάθε επιπλέον ώρα πληρώνεται με προσαύξηση ${pct(PART_TIME_EXTRA, lang)}. Η σύμβαση πρέπει να είναι γραπτή και να γνωστοποιείται μέσα σε 8 ημέρες, αλλιώς τεκμαίρεται πλήρης απασχόληση. Σε επιχειρήσεις με πάνω από 20 άτομα, όποιος δουλεύει με πλήρες ωράριο ένα ημερολογιακό έτος μπορεί να ζητήσει να περάσει σε μερική, με δικαίωμα επιστροφής. Ο υπολογιστής παρακάτω δίνει τα καθαρά για τις δικές σας ώρες.`}
  faqs={faqs}
  related={[{ href: route('minimum', lang), name: label('minimum', lang), description: `Ο κατώτατος ${F.minWage} από τον οποίο ξεκινά η αναλογία.` }, { href: route('daily', lang), name: label('daily', lang), description: 'Όταν η αμοιβή ορίζεται ανά ημέρα.' }, { href: route('leave', lang), name: label('leave', lang), description: 'Το επίδομα αδείας στις μειωμένες αποδοχές.' }]}
  sources={[src('severance_faq', lang), src('min_wage', lang), src('hli_christmas', lang), src('efka_rates', lang), src('tax_credit', lang)]}>
  <div data-chrome><MiniSim client:load kind="parttime" lang={lang} href={route('home', lang)} /></div>

  <h2>Καθαρά ανά ώρες εβδομαδιαίας εργασίας</h2>
  <ContentTable headers={['Ώρες/εβδομάδα', 'Μικτά (κατώτατος)', 'ΕΦΚΑ', 'Φόρος', 'Καθαρά ανά καταβολή', 'Καθαρά σε 12μηνη βάση']} align={['l', 'r', 'r', 'r', 'r', 'r']} rows={rows} highlightRow={2} />
  <p>Ο πίνακας ξεκινά από τον κατώτατο μισθό πλήρους απασχόλησης και τον επιμερίζει στις ώρες, με πλήρες ωράριο {FT} ωρών την εβδομάδα. Αφορά εργαζόμενο άνω των 30 ετών χωρίς παιδιά. Στις μικρές συμβάσεις ο φόρος είναι μηδενικός, γιατί η μείωση φόρου του άρθρου 16 ΚΦΕ, {F.credit[0]} τον χρόνο χωρίς παιδιά, καλύπτει ολόκληρο τον φόρο της κλίμακας. Οι εισφορές όμως κρατούνται από το πρώτο ευρώ: {F.efkaEe} για τον εργαζόμενο, χωρίς κατώτατο όριο απαλλαγής.</p>
  <p>Αν ο μισθός πλήρους απασχόλησης στη θέση σας είναι μεγαλύτερος από τον κατώτατο, η αναλογία ισχύει με τον ίδιο τρόπο. Μια θέση με {$(1600)} για πλήρες ωράριο δίνει σε εικοσάωρη σύμβαση {$(1600 * 20 / FT)} μικτά και {$(s20b.net)} καθαρά. Ο υπολογιστής στην αρχή της σελίδας δέχεται και τα δύο: τις ώρες σας και τον μισθό πλήρους απασχόλησης.</p>

  <h2>Η σύμβαση: γραπτή, γνωστοποιημένη, με σταθερό ωράριο</h2>
  <p>Σύμφωνα με τις απαντήσεις του Υπουργείου Εργασίας για την ατομική σύμβαση, η μερική απασχόληση μπορεί να συμφωνηθεί σε ημερήσια, εβδομαδιαία, δεκαπενθήμερη ή μηνιαία βάση, για ορισμένο ή αόριστο χρόνο, αρκεί η διάρκειά της να είναι μικρότερη από την κανονική. Η συμφωνία πρέπει να γίνει εγγράφως και να γνωστοποιηθεί μέσα σε οκτώ ημέρες. Αν λείπει το ένα ή το άλλο, ο νόμος υποθέτει πλήρη απασχόληση, κάτι που προστατεύει τον εργαζόμενο από «άτυπες» μειώσεις ωραρίου.</p>
  <p>Όταν το ωράριο είναι μικρότερο ημερήσιο, η εργασία πρέπει να είναι συνεχόμενη και να παρέχεται μία φορά την ημέρα. Το σπαστό τετράωρο, δύο ώρες το πρωί και δύο το απόγευμα, δεν επιτρέπεται, με λίγες εξαιρέσεις, όπως οι οδηγοί και συνοδοί σχολικών λεωφορείων ιδιωτικών εκπαιδευτηρίων και παιδικών σταθμών και οι καθηγητές φροντιστηρίων. Η εργασία την Κυριακή, τις αργίες ή τη νύχτα πληρώνεται με τη νόμιμη προσαύξηση, όπως και για όσους δουλεύουν πλήρες ωράριο.</p>

  <h2>Επιπλέον ώρες: η προσαύξηση του {pct(PART_TIME_EXTRA, lang)}</h2>
  <p>Αν προκύψει ανάγκη για εργασία πέρα από τη συμφωνημένη, ο μερικώς απασχολούμενος οφείλει να την παράσχει όταν μπορεί και η άρνηση θα ήταν αντίθετη με την καλή πίστη. Μπορεί όμως να αρνηθεί όταν η πρόσθετη εργασία γίνεται συνήθεια. Κάθε επιπλέον ώρα πληρώνεται με την αντίστοιχη αμοιβή, προσαυξημένη κατά {pct(PART_TIME_EXTRA, lang)}. Για παράδειγμα, με συμφωνημένη αμοιβή {$2(rate)} την ώρα, {extraH} επιπλέον ώρες σε έναν μήνα δίνουν {$2(extraPay)} μικτά αντί για {$2(rate * extraH)}.</p>
  <p>Αν οι επιπλέον ώρες γίνουν μόνιμες, η σωστή λύση είναι μια νέα γραπτή συμφωνία με περισσότερες ώρες, όχι μια διαρκής «υπερεργασία». Αξίζει επίσης να ζητήσετε η μισθοδοσία να δείχνει χωριστά τις επιπλέον ώρες και την προσαύξησή τους, ώστε να φαίνεται ότι δεν απορροφώνται σιωπηρά στον μισθό.</p>

  <div data-chrome><MiniSim client:load kind="ptextra" lang={lang} href={route('home', lang)} /></div>

  <h2>Άδεια, επίδομα αδείας και δώρα</h2>
  <p>Οι μερικώς απασχολούμενοι έχουν ετήσια άδεια με αποδοχές και επίδομα αδείας, με βάση τις αποδοχές που θα έπαιρναν αν δούλευαν τον χρόνο της άδειας. Για εικοσάωρη σύμβαση στον κατώτατο, το επίδομα αδείας φτάνει τα {$(leave20)} μικτά και το δώρο Χριστουγέννων, με την αναλογία του επιδόματος αδείας, τα {$(xmas20)}. Ο <a href={route('leave', lang)}>υπολογιστής επιδόματος αδείας</a> και ο <a href={route('christmas', lang)}>υπολογιστής δώρου Χριστουγέννων</a> δέχονται τον δικό σας μειωμένο μισθό.</p>

  <h2>Από πλήρη σε μερική, και πίσω</h2>
  <p>Ο εργαζόμενος με πλήρες ωράριο σε επιχείρηση πάνω από είκοσι ατόμων έχει δικαίωμα, αφού συμπληρώσει ένα ημερολογιακό έτος, να ζητήσει μετατροπή της σύμβασής του σε μερική απασχόληση, με δικαίωμα επανόδου. Στην αίτηση γράφει τη διάρκεια και το είδος της μερικής απασχόλησης. Ο εργοδότης μπορεί να αρνηθεί μόνο αν το δικαιολογούν οι ανάγκες της επιχείρησης, και αν δεν απαντήσει εγγράφως μέσα σε έναν μήνα το αίτημα θεωρείται δεκτό. Το αντίστροφο ισχύει επίσης: ο μερικώς απασχολούμενος έχει προτεραιότητα για θέση πλήρους απασχόλησης στην ίδια επιχείρηση, με ίσους όρους.</p>
  <p>Η καταγγελία της σύμβασης επειδή ο εργαζόμενος αρνήθηκε πρόταση του εργοδότη για μερική απασχόληση είναι άκυρη. Και ο χρόνος της μερικής απασχόλησης μετρά ως προϋπηρεσία, κάτι που έχει σημασία για τις <a href={route('trienniums', lang)}>τριετίες</a> και για την αποζημίωση απόλυσης. Για τα καθαρά σας με ηλικία και παιδιά, βάλτε τον αναλογικό μικτό στον κύριο <a href={route('home', lang)}>υπολογισμό μισθού</a>.</p>
</GuideLayout>
