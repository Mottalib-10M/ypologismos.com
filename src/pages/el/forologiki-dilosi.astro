---
import ToolCalc from '../../components/calc/ToolCalc';
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { src } from '../../lib/facts';
import { incomeTax, PARAMS as P } from '../../lib/engine/gr';
import { taxReturn, rentalTax, cardSpending } from '../../lib/engine/foroi';
import { formatMoney, pct } from '../../lib/format';
const lang = 'el';
const $ = (x: number) => formatMoney(x, 0, lang);
const p = (x: number) => pct(x, lang);
const Y = P.year;
const R = P.tax_return;
// Παράδειγμα = προεπιλογές του υπολογιστή.
const ex = { sal: 18000, rent: 6000, card: 6000 };
const wh = incomeTax(ex.sal).tax;
const r = taxReturn({ salaryTaxable: ex.sal, withheld: wh, rent: ex.rent, cardSpent: ex.card });
const noCard = taxReturn({ salaryTaxable: ex.sal, withheld: wh, rent: ex.rent, cardSpent: 0 });
const rent24 = rentalTax(24000), rent24old = rentalTax(24000, 2025);
const cg = cardSpending(ex.sal, 0);
const rentRows = P.rental_tax.brackets_2026.map((b, i, a) => [i === 0 ? `έως ${$(b.upTo as number)}` : b.upTo === null ? `πάνω από ${$(a[i - 1].upTo as number)}` : `${$(a[i - 1].upTo as number)} έως ${$(b.upTo)}`, p(b.rate)]);
const dueRows = R.discounts.map((d) => [`έως ${d.by}`, p(d.rate), $(r.toPay * (1 - d.rate))]);
const faqs = [
  { q: 'Μέχρι πότε υποβάλλεται η φορολογική δήλωση;', a: `Από ${R.filing_from} έως ${R.filing_to} του επόμενου έτους, σύμφωνα με το άρθρο 67 του ΚΦΕ. Για τα εισοδήματα του ${Y} η δήλωση ανοίγει στις ${R.filing_from} ${Y + 1}. Όσοι συμμετέχουν σε εταιρείες με απλογραφικά βιβλία έχουν προθεσμία έως την τελευταία εργάσιμη του Ιουλίου. Αν ο φορολογούμενος αποβιώσει ή μετακομίσει στο εξωτερικό, η δήλωση υποβάλλεται οποτεδήποτε μέσα στο έτος.` },
  { q: 'Πόση έκπτωση παίρνω αν πληρώσω τον φόρο εφάπαξ;', a: `${p(R.discounts[0].rate)} αν η δήλωση υποβληθεί έως ${R.discounts[0].by}, ${p(R.discounts[1].rate)} έως ${R.discounts[1].by} και ${p(R.discounts[2].rate)} έως ${R.discounts[2].by}, με την προϋπόθεση ότι ο φόρος εξοφλείται ολόκληρος μέχρι την προθεσμία της πρώτης δόσης, την τελευταία εργάσιμη του Ιουλίου. Σε φόρο ${$(r.toPay)} η πρώιμη υποβολή σάς γλιτώνει ${$(r.lumpSum[0].saving)}.` },
  { q: 'Σε πόσες δόσεις πληρώνεται ο φόρος εισοδήματος;', a: `Σε ${R.installments} ισόποσες μηνιαίες δόσεις. Η πρώτη λήγει την τελευταία εργάσιμη ημέρα του Ιουλίου και οι επόμενες επτά την τελευταία εργάσιμη καθενός από τους επόμενους μήνες, άρα η τελευταία τον Φεβρουάριο. Στο παράδειγμα της σελίδας, ${$(r.toPay)} γίνονται ${R.installments} δόσεις των ${$(r.installment)}.` },
  { q: 'Τι γίνεται αν δεν ξόδεψα αρκετά με κάρτα;', a: `Ο φόρος της κλίμακας αυξάνεται κατά ${p(R.card_penalty_rate)} της διαφοράς ανάμεσα στο απαιτούμενο και στο δηλωμένο ποσό. Το απαιτούμενο είναι ${p(R.card_spending_share)} του πραγματικού εισοδήματος από μισθούς, συντάξεις και επιχειρηματική δραστηριότητα, με ανώτατο όριο ${$(R.card_spending_cap)} δαπανών. Με εισόδημα ${$(ex.sal)} και καμία ηλεκτρονική πληρωμή, το πρόστιμο φτάνει ${$(cg.penalty)}.` },
  { q: 'Τα ενοίκια φορολογούνται μαζί με τον μισθό;', a: `Όχι. Φορολογούνται αυτοτελώς, με τη δική τους κλίμακα του άρθρου 40 ΚΦΕ, που από το φορολογικό έτος ${Y} ξεκινά από ${p(P.rental_tax.brackets_2026[0].rate)} έως ${$(P.rental_tax.brackets_2026[0].upTo as number)} και έχει νέο κλιμάκιο ${p(P.rental_tax.brackets_2026[1].rate)}. Πριν από την κλίμακα αφαιρείται ${p(P.rental_tax.expense_deduction)} για επισκευές και συντήρηση. Τα ενοίκια δεν επηρεάζουν τη μείωση φόρου του μισθού.` },
];
---
<GuideLayout lang={lang} id="taxreturn" breadcrumbLabel={label('taxreturn', lang)}
  title={`Φορολογική δήλωση για τα εισοδήματα ${Y}: φόρος, δόσεις`}
  h1={`Φορολογική δήλωση: υπολογισμός του φόρου για τα εισοδήματα του ${Y}`}
  description={`Φορολογική δήλωση ${Y + 1} για τα εισοδήματα του ${Y}: υπολογίστε φόρο μισθού ή σύνταξης και ενοικίων, πρόστιμο κάρτας ${p(R.card_penalty_rate)}, ${R.installments} δόσεις και έκπτωση έως ${p(R.discounts[0].rate)}.`}
  intro={`Ο φόρος της δήλωσης είναι ο φόρος της κλίμακας μείον όσα ήδη παρακρατήθηκαν, συν τα ενοίκια που φορολογούνται χωριστά.`}
  resume={`Για μισθωτό με ${$(ex.sal)} φορολογητέο εισόδημα από μισθούς και ${$(ex.rent)} ενοίκια τον χρόνο, η φορολογική δήλωση για τα εισοδήματα του ${Y} βγάζει ${$(r.toPay)} να πληρώσει. Ο φόρος του μισθού, ${$(r.salaryTax)}, έχει ήδη παρακρατηθεί από τον εργοδότη κάθε μήνα, οπότε η δήλωση χρεώνει ουσιαστικά μόνο τα ενοίκια: ${$(ex.rent)} μείον την έκπτωση ${p(P.rental_tax.expense_deduction)} για δαπάνες, επί ${p(P.rental_tax.brackets_2026[0].rate)}. Η δήλωση υποβάλλεται από ${R.filing_from} έως ${R.filing_to} ${Y + 1} και ο φόρος πληρώνεται σε ${R.installments} μηνιαίες δόσεις των ${$(r.installment)}, ή εφάπαξ με έκπτωση ${p(R.discounts[0].rate)} αν η δήλωση υποβληθεί έως ${R.discounts[0].by}. Αν οι πληρωμές με κάρτα δεν φτάνουν το ${p(R.card_spending_share)} του εισοδήματος, προστίθεται πρόστιμο: στο ίδιο παράδειγμα, χωρίς καμία ηλεκτρονική δαπάνη, ο φόρος θα ανέβαινε στα ${$(noCard.toPay)}. Ο υπολογιστής κάνει τον λογαριασμό με τα δικά σας ποσά της βεβαίωσης αποδοχών.`}
  faqs={faqs}
  related={[{ href: route('incometax', lang), name: label('incometax', lang), description: 'Ο φόρος της κλίμακας και η σύγκριση με το 2025.' }, { href: route('withholding', lang), name: label('withholding', lang), description: 'Πώς υπολογίζεται η μηνιαία παρακράτηση που συμψηφίζεται στη δήλωση.' }, { href: route('children', lang), name: label('children', lang), description: 'Τα τέκνα μειώνουν και τον συντελεστή και τον φόρο.' }]}
  sources={[src('tax_return', lang), src('card_spending', lang), src('rental_tax', lang), src('rental_expenses', lang), src('tax_scale', lang), src('tax_credit', lang)]}>
  <div data-outil><ToolCalc client:load kind="taxreturn" lang={lang} methodHref={route('method', lang)} /></div>

  <h2>Από τη βεβαίωση αποδοχών στο εκκαθαριστικό</h2>
  <p>Η δήλωση δεν υπολογίζει ξανά τον μισθό από την αρχή. Παίρνει το φορολογητέο ποσό της βεβαίωσης αποδοχών, δηλαδή τις μικτές αποδοχές μείον τις εισφορές του εργαζομένου, εφαρμόζει την κλίμακα του άρθρου 15 του ΚΦΕ και αφαιρεί τη μείωση φόρου του άρθρου 16. Στο παράδειγμα των {$(ex.sal)}, η κλίμακα δίνει {$(r.salaryScale)} και η μείωση {$(r.credit)}, άρα φόρος μισθού {$(r.salaryTax)}. Επειδή ο εργοδότης παρακράτησε ακριβώς αυτό το ποσό, το αποτέλεσμα για τον μισθό είναι μηδέν. Διαφορές εμφανίζονται όταν αλλάξατε δουλειά μέσα στη χρονιά, όταν είχατε δύο εργοδότες ταυτόχρονα ή όταν ένα τέκνο έγινε εξαρτώμενο αργότερα: τότε η παρακράτηση έγινε με λάθος βάση και η δήλωση τη διορθώνει.</p>
  <p>Τα ενοίκια, αντίθετα, δεν έχουν παρακράτηση. Φορολογούνται για πρώτη φορά στη δήλωση, με δική τους κλίμακα, και γι’ αυτό σχεδόν κάθε ιδιοκτήτης που νοικιάζει βλέπει χρεωστικό εκκαθαριστικό.</p>

  <h2>Η κλίμακα των ενοικίων από το {Y}</h2>
  <ContentTable headers={['Εισόδημα από ενοίκια (μετά την έκπτωση 5 %)', 'Συντελεστής']} align={['l', 'r']} rows={rentRows} />
  <p>Το άρθρο 8 του ν. 5246/2025 έσπασε το παλιό κλιμάκιο του {p(P.rental_tax.brackets_2025[1].rate)}, που ξεκινούσε αμέσως μετά τις {$(P.rental_tax.brackets_2025[0].upTo as number)}, και έβαλε ενδιάμεσο συντελεστή {p(P.rental_tax.brackets_2026[1].rate)}. Ισχύει για εισοδήματα από το φορολογικό έτος {Y}, σύμφωνα με το άρθρο 47 του ίδιου νόμου. Με ενοίκια {$(24000)} τον χρόνο ο φόρος πέφτει από {$(rent24old.tax)} σε {$(rent24.tax)}. Οι δηλώσεις που υποβλήθηκαν το {Y} για τα εισοδήματα του {Y - 1} ακολούθησαν ακόμη την παλιά κλίμακα.</p>
  <div data-chrome><MiniSim client:load kind="rentscale" lang={lang} href={route('taxreturn', lang)} /></div>

  <h2>Το 30 % με κάρτα: πού χάνουν χρήματα οι περισσότεροι</h2>
  <p>Το άρθρο 15 παρ. 6 του ΚΦΕ ζητά δαπάνες με ηλεκτρονικά μέσα πληρωμής ίσες με το {p(R.card_spending_share)} του πραγματικού εισοδήματος από μισθούς, συντάξεις και επιχειρηματική δραστηριότητα, και όχι πάνω από {$(R.card_spending_cap)}. Μετράνε αγορές αγαθών και υπηρεσιών στην Ελλάδα ή στην ΕΕ με κάρτα, e-banking ή ηλεκτρονικό πορτοφόλι. Ο νόμος εξαιρεί ρητά το ενοίκιο, τα τέλη κυκλοφορίας και την αγορά οχήματος, εκτός από ποδήλατο. Δεν έχουν την υποχρέωση όσοι έχουν κλείσει τα 70, τα άτομα με αναπηρία 80 % και άνω, οι δικαιούχοι ΚΕΑ και οι μόνιμοι κάτοικοι χωριών έως 500 κατοίκων. Η διαφορά που λείπει φορολογείται με {p(R.card_penalty_rate)}, ανεξάρτητα από το πόσο φόρο πληρώνετε κατά τα άλλα.</p>
  <div data-chrome><MiniSim client:load kind="cardgap" lang={lang} href={route('taxreturn', lang)} /></div>

  <h2>Πληρωμή: εφάπαξ, με έκπτωση, ή σε {R.installments} δόσεις</h2>
  <ContentTable headers={['Υποβολή της δήλωσης', 'Έκπτωση', `Εφάπαξ για φόρο ${$(r.toPay)}`]} align={['l', 'r', 'r']} rows={dueRows} />
  <p>Η έκπτωση ισχύει μόνο αν ο φόρος εξοφληθεί ολόκληρος μέχρι την προθεσμία της πρώτης δόσης. Αν επιλέξετε τις δόσεις, χάνετε την έκπτωση αλλά όχι τίποτε άλλο: οι {R.installments} δόσεις είναι άτοκες όσο πληρώνονται στην ώρα τους. Για μικρά ποσά η διαφορά είναι λίγα ευρώ· για έναν ιδιοκτήτη με αρκετά ενοίκια, το {p(R.discounts[0].rate)} αξίζει μια πρώιμη υποβολή.</p>
  <div data-chrome><MiniSim client:load kind="lumpsum" lang={lang} href={route('taxreturn', lang)} /></div>

  <h2>Τι δεν κάνει ο υπολογιστής</h2>
  <p>Δεν φορολογεί επιχειρηματικά ή αγροτικά εισοδήματα, που έχουν δικούς τους κανόνες και ελάχιστο τεκμαρτό εισόδημα για τους ελεύθερους επαγγελματίες. Δεν ελέγχει τα τεκμήρια διαβίωσης, τις απαλλαγές για μακροχρόνιες μισθώσεις και τις ιατρικές δαπάνες. Υπολογίζει έναν φορολογούμενο: στην κοινή δήλωση συζύγων ο φόρος βγαίνει χωριστά για τον καθένα και απλώς εμφανίζεται στο ίδιο εκκαθαριστικό. Για τον μηνιαίο φόρο του μισθού, δείτε τον <a href={route('home', lang)}>υπολογισμό μισθού</a>.</p>
</GuideLayout>
