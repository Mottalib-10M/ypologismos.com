---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { salary, incomeTax, bracketRates, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney } from '../../lib/format';
import { tax2025, SCALE_2025, SCALE_2025_SOURCE, ART15_1A, ART29_SOURCE } from '../../lib/mini-extra-b';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const p = F.pct;
const B = P.tax.brackets;
const T = P.tax;
const lows = B.map((_, i) => (i === 0 ? 0 : (B[i - 1].upTo as number)));
const bandName = (i: number) => (B[i].upTo === null ? `άνω των ${$(lows[i])}` : `${$(lows[i])} – ${$(B[i].upTo as number)}`);
// Πίνακας συντελεστών ανά αριθμό παιδιών (bracketRates του μηχανισμού).
const kidCols = [0, 1, 2, 3, 4, 5];
const rateRows = B.map((_, i) => [bandName(i), ...kidCols.map((k) => p(bracketRates(k)[i]))]);
// Παράδειγμα βήμα βήμα με 25.000 € φορολογητέο.
const ex = 25000;
const exT = incomeTax(ex);
const parts = B.map((b, i) => Math.max(0, Math.min(ex, b.upTo ?? Infinity) - lows[i]) * exT.rates[i]);
const exTaper = (ex - T.credit_taper_threshold) / 1000 * T.credit_taper_per_1000;
// Πίνακας παραδειγμάτων εισοδήματος.
const incomes = [10000, 15000, 20000, 30000, 40000, 50000, 60000, 80000];
const exRows = incomes.map((i) => { const t = incomeTax(i); return [$(i), $(t.scale), $(t.credit), $(t.tax), p(Math.round(t.average * 1000) / 1000), p(t.marginal)]; });
// Σύγκριση με το 2025 (χωρίς παιδιά).
const cmpRows = incomes.map((i) => { const now = incomeTax(i).tax, old = tax2025(i); return [$(i), $(old), $(now), $(old - now)]; });
const maxGain = tax2025(T.brackets[4].upTo as number) - incomeTax(T.brackets[4].upTo as number).tax;
const g30 = tax2025(30000) - incomeTax(30000).tax;
const g20 = tax2025(20000) - incomeTax(20000).tax;
// Από μικτό μηνιαίο σε φορολογητέο.
const s1500 = salary({ gross: 1500 });
const avg = salary({ gross: P.minimum_wage.average_wage_2025 });
const taper = T.credit_taper_per_1000 / 1000;
const keep100 = 100 * (1 - P.efka.employee_rate) * (1 - (avg.marginal + taper));
const k3 = incomeTax(ex, 3), k4 = incomeTax(ex, 4);
const faqs = [
  { q: `Αν περάσω τις ${F.limits[1]} φορολογητέο, φορολογείται όλο μου το εισόδημα με ${F.r[2]};`, a: `Όχι. Η κλίμακα είναι προοδευτική: μόνο το κομμάτι πάνω από ${F.limits[1]} φορολογείται με ${F.r[2]}. Τα πρώτα ${F.limits[0]} φορολογούνται πάντα με ${F.r[0]} και τα επόμενα έως ${F.limits[1]} με ${F.r[1]}. Γι' αυτό μια αύξηση που σας «ανεβάζει κλιμάκιο» δεν μειώνει ποτέ τα καθαρά σας· απλώς το επιπλέον ποσό φορολογείται με τον υψηλότερο συντελεστή.` },
  { q: `Με ${$(ex)} φορολογητέο εισόδημα, πόσο φόρο πληρώνω το ${F.year};`, a: `Χωρίς παιδιά, ο φόρος της κλίμακας είναι ${$(exT.scale)} και η μείωση του άρθρου 16 ${$(exT.credit)}, άρα πληρώνετε ${$(exT.tax)}, δηλαδή μέσο συντελεστή ${p(Math.round(exT.average * 1000) / 1000)}. Με τρία παιδιά ο τελικός φόρος πέφτει στα ${$(k3.tax)} και με τέσσερα στα ${$(k4.tax)}, επειδή μειώνονται οι συντελεστές των πρώτων κλιμακίων και μεγαλώνει η μείωση φόρου.` },
  { q: 'Η ίδια κλίμακα ισχύει για συνταξιούχους και ελεύθερους επαγγελματίες;', a: `Η κλίμακα του άρθρου 15 ΚΦΕ, όπως την αντικατέστησε ο ν. 5246/2025, εφαρμόζεται σε μισθούς, συντάξεις και κέρδη από επιχειρηματική δραστηριότητα, με τα ίδια όρια (${F.limits[0]}, ${F.limits[1]} κ.ο.κ.). Τα κέρδη του ελεύθερου επαγγελματία προστίθενται σε τυχόν μισθό, αλλά το άρθρο 29 αποκλείει γι' αυτά τη μείωση φόρου του άρθρου 16.` },
  { q: 'Πόσα κερδίζω από τη νέα κλίμακα σε σχέση με το 2025;', a: `Χωρίς παιδιά, το όφελος είναι ${$(g20)} τον χρόνο με ${$(20000)} φορολογητέο, ${$(g30)} με ${$(30000)} και φτάνει τα ${$(maxGain)} από ${F.limits[4]} και πάνω, όπου σταματά να αυξάνεται. Η μείωση του άρθρου 16 δεν άλλαξε, οπότε όλη η διαφορά προέρχεται από τους χαμηλότερους συντελεστές των μεσαίων κλιμακίων.` },
  { q: 'Ποιος είναι ο υψηλότερος συντελεστής φόρου εισοδήματος;', a: `Το ${F.r[5]}, για το τμήμα του φορολογητέου εισοδήματος πάνω από ${F.limits[4]}. Δεν άλλαξε με τη μεταρρύθμιση. Ακόμη και σε πολύ υψηλά εισοδήματα ο μέσος φόρος μένει χαμηλότερα: με ${$(80000)} φορολογητέο είναι ${p(Math.round(incomeTax(80000).average * 1000) / 1000)}, γιατί τα πρώτα κλιμάκια φορολογούνται με μικρότερους συντελεστές.` },
];
---
<GuideLayout lang={lang} id="brackets" breadcrumbLabel={label('brackets', lang)}
  title={`Φορολογική κλίμακα ${F.year}: συντελεστές ${F.r[0]} έως ${F.r[5]} και παιδιά`}
  h1={`Φορολογική κλίμακα ${F.year}: τα έξι κλιμάκια του φόρου εισοδήματος`}
  description={`Φορολογική κλίμακα ${F.year} για μισθωτούς: έξι κλιμάκια από ${F.r[0]} έως ${F.r[5]}, μικρότεροι συντελεστές με παιδιά, σύγκριση με το 2025 και υπολογισμός του φόρου σας.`}
  intro={`Από το φορολογικό έτος ${F.year} ο φόρος εισοδήματος υπολογίζεται με νέα κλίμακα έξι κλιμακίων, με συντελεστές από ${F.r[0]} έως ${F.r[5]}.`}
  resume={`Η φορολογική κλίμακα ${F.year} του ν. 5246/2025 έχει έξι κλιμάκια: ${F.r[0]} έως ${F.limits[0]}, ${F.r[1]} έως ${F.limits[1]}, ${F.r[2]} έως ${F.limits[2]}, ${F.r[3]} έως ${F.limits[3]}, ${F.r[4]} έως ${F.limits[4]} και ${F.r[5]} για ό,τι υπερβαίνει αυτό το ποσό. Οι συντελεστές του δεύτερου και του τρίτου κλιμακίου μειώνονται με τα εξαρτώμενα τέκνα: με ένα παιδί είναι ${F.second[1]} και ${F.third[1]}, με τρία ${F.second[3]} και ${F.third[3]}, ενώ από τέσσερα παιδιά τα δύο πρώτα κλιμάκια μηδενίζονται. Από τον φόρο της κλίμακας αφαιρείται η μείωση φόρου μισθωτών του άρθρου 16 (${F.credit[0]} χωρίς παιδιά). Ένας μισθωτός χωρίς παιδιά με ${$(ex)} φορολογητέο πληρώνει ${$(exT.tax)} τον χρόνο, έναντι ${$(tax2025(ex))} με την κλίμακα του 2025. Το όφελος από τη μεταρρύθμιση φτάνει τα ${$(maxGain)} τον χρόνο από ${F.limits[4]} φορολογητέο και πάνω. Ο υπολογιστής δίνει τον φόρο για το δικό σας εισόδημα και τα παιδιά σας.`}
  faqs={faqs}
  related={[{ href: route('home', lang), name: label('home', lang), description: 'Από το μικτό στα καθαρά, με την κλίμακα και τις εισφορές.' }, { href: route('children', lang), name: label('children', lang), description: 'Πόσο μειώνει κάθε παιδί τους συντελεστές.' }, { href: route('credit', lang), name: label('credit', lang), description: `Η μείωση των ${F.credit[0]} και πώς σβήνει.` }]}
  sources={[src('tax_scale', lang), src('tax_credit', lang), SCALE_2025_SOURCE.el, ART29_SOURCE.el, src('efka_rates', lang), src('min_wage', lang)]}>
  <div data-chrome><MiniSim client:load kind="brackets" lang={lang} href={route('home', lang)} /></div>

  <h2>Οι συντελεστές ανά κλιμάκιο και αριθμό παιδιών</h2>
  <ContentTable headers={['Φορολογητέο εισόδημα', 'Χωρίς παιδιά', '1 παιδί', '2 παιδιά', '3 παιδιά', '4 παιδιά', '5 παιδιά']} align={['l', 'r', 'r', 'r', 'r', 'r', 'r']} rows={rateRows} />
  <p>Ο πίνακας διαβάζεται κατά στήλη. Κάθε φορολογούμενος έχει τη δική του κλίμακα, ανάλογα με τα εξαρτώμενα τέκνα του κατά την έννοια του άρθρου 11 ΚΦΕ. Το πρώτο κλιμάκιο μένει στο {F.r[0]} για όλους εκτός από όσους έχουν τέσσερα ή περισσότερα παιδιά, για τους οποίους η περίπτωση γ' του άρθρου 15 ορίζει μηδενικό συντελεστή στα δύο πρώτα κλιμάκια. Στο τρίτο κλιμάκιο ο συντελεστής κατεβαίνει κατά δύο μονάδες για κάθε παιδί, και μετά το τέταρτο συνεχίζει να πέφτει κατά {F.thirdStep} ανά επιπλέον παιδί. Από τα {F.limits[2]} και πάνω η κλίμακα είναι κοινή για όλους, με ή χωρίς παιδιά.</p>
  <p>Υπάρχει και μια τρίτη διάσταση, η ηλικία. Για φορολογούμενους έως 25 ετών, τα δύο πρώτα κλιμάκια έως {F.youthLimit} φορολογούνται με {F.youthU25}, και από 26 έως 30 ετών με {F.youth2630}. Ο πίνακας αφορά όσους είναι άνω των 30· για τους νεότερους υπάρχει ξεχωριστός οδηγός για τον <a href={route('youth', lang)}>φόρο των νέων</a>.</p>

  <h2>Ο υπολογισμός βήμα βήμα: {$(ex)} φορολογητέο</h2>
  <p>Ας πάρουμε έναν υπάλληλο χωρίς παιδιά με φορολογητέο εισόδημα {$(ex)}. Τα πρώτα {F.limits[0]} φορολογούνται με {F.r[0]}, δηλαδή {$(parts[0])}. Τα επόμενα {$(B[1].upTo as number - lows[1])}, έως τις {F.limits[1]}, με {F.r[1]}: {$(parts[1])}. Τα υπόλοιπα {$(ex - lows[2])} πέφτουν στο τρίτο κλιμάκιο του {F.r[2]} και δίνουν {$(parts[2])}. Ο φόρος της κλίμακας είναι το άθροισμα, {$(exT.scale)}.</p>
  <p>Ακολουθεί η μείωση του άρθρου 16. Η πλήρης μείωση χωρίς παιδιά είναι {F.credit[0]}, αλλά επειδή το εισόδημα ξεπερνά τις {F.creditThreshold}, χάνονται {F.creditTaper} για κάθε 1.000 € πάνω από το όριο: {$(exTaper)} συνολικά. Μένει μείωση {$(exT.credit)} και τελικός φόρος {$(exT.tax)}. Ο μέσος συντελεστής είναι {p(Math.round(exT.average * 1000) / 1000)}, ενώ ο οριακός, αυτός που θα πληρώσει το επόμενο ευρώ, είναι {p(exT.marginal)}.</p>

  <h2>Φόρος για οκτώ επίπεδα εισοδήματος</h2>
  <ContentTable headers={['Φορολογητέο', 'Φόρος κλίμακας', 'Μείωση άρθρ. 16', 'Τελικός φόρος', 'Μέσος', 'Οριακός']} align={['l', 'r', 'r', 'r', 'r', 'r']} rows={exRows} highlightRow={2} />
  <p>Δύο πράγματα φαίνονται αμέσως. Στα χαμηλά εισοδήματα η μείωση φόρου τρώει σχεδόν όλο τον φόρο της κλίμακας, γι' αυτό με {$(10000)} ο τελικός φόρος είναι μόλις {$(incomeTax(10000).tax)}. Στα υψηλά, η μείωση έχει σβήσει και ο φόρος ακολουθεί σχεδόν αποκλειστικά την κλίμακα. Ανάμεσα, κάθε επιπλέον χίλια ευρώ κοστίζουν λίγο περισσότερο από όσο δείχνει ο συντελεστής, επειδή μαζί με τον φόρο χάνεται και ένα κομμάτι της μείωσης.</p>

  <h2>Τι άλλαξε σε σχέση με την κλίμακα του 2025</h2>
  <p>Η προηγούμενη κλίμακα είχε πέντε κλιμάκια ανά {F.limits[0]}: {p(SCALE_2025[0].rate)}, {p(SCALE_2025[1].rate)}, {p(SCALE_2025[2].rate)}, {p(SCALE_2025[3].rate)} και {p(SCALE_2025[4].rate)} πάνω από {$(SCALE_2025[3].upTo)}. Ο ν. 5246/2025 κράτησε το {F.r[0]} στην αρχή και το {F.r[5]} στην κορυφή, αλλά κατέβασε το δεύτερο κλιμάκιο στο {F.r[1]}, το τρίτο στο {F.r[2]}, το τέταρτο στο {F.r[3]} και πρόσθεσε ενδιάμεσο κλιμάκιο {F.r[4]} από {F.limits[3]} έως {F.limits[4]}. Τα ποσά της μείωσης του άρθρου 16 έμειναν όπως ήταν.</p>
  <ContentTable headers={['Φορολογητέο', 'Φόρος 2025', `Φόρος ${F.year}`, 'Όφελος τον χρόνο']} align={['l', 'r', 'r', 'r']} rows={cmpRows} />
  <p>Για όποιον δηλώνει έως {F.limits[0]}, τίποτα δεν αλλάζει. Το όφελος ξεκινά από το δεύτερο κλιμάκιο, μεγαλώνει σταδιακά και σταθεροποιείται στα {$(maxGain)} από τις {F.limits[4]} και πάνω, γιατί εκεί οι δύο κλίμακες ξανασυναντιούνται στο {F.r[5]}. Ο πίνακας αφορά φορολογούμενο χωρίς παιδιά άνω των 30· με παιδιά ή σε νεαρή ηλικία η διαφορά είναι μεγαλύτερη, επειδή οι μειωμένοι συντελεστές για τέκνα και νέους είναι επίσης καινούργιοι.</p>

  <div data-chrome><MiniSim client:load kind="scalecompare" lang={lang} href={route('home', lang)} /></div>

  <h2>Από τον μικτό μισθό στο φορολογητέο εισόδημα</h2>
  <p>Η κλίμακα δεν εφαρμόζεται στον μικτό μισθό αλλά στο φορολογητέο εισόδημα, δηλαδή στις ετήσιες αποδοχές μετά την αφαίρεση των εισφορών του εργαζομένου στον e-ΕΦΚΑ ({F.efkaEe} για τον ιδιωτικό τομέα). Ένας μισθός {$(1500)} μικτά σε 14 καταβολές δίνει {$(s1500.annualGross)} τον χρόνο, από τα οποία αφαιρούνται {$(s1500.efkaAnnual)} εισφορές, και το φορολογητέο είναι {$(s1500.taxableAnnual)}. Αυτό το ποσό μπαίνει στην κλίμακα, και ο ετήσιος φόρος που προκύπτει είναι {$(s1500.taxAnnual)}.</p>
  <p>Όταν λοιπόν ψάχνετε σε ποιο κλιμάκιο ανήκετε, μην κοιτάτε τον μηνιαίο μικτό επί δώδεκα. Ο μηχανισμός του <a href={route('home', lang)}>υπολογισμού μισθού</a> κάνει αυτή τη μετατροπή αυτόματα, με τα δώρα και το επίδομα αδείας μέσα στις 14 καταβολές. Πώς μοιράζεται ο ετήσιος φόρος στις μισθοδοσίες εξηγεί ο οδηγός για την <a href={route('withholding', lang)}>παρακράτηση φόρου</a>.</p>

  <h2>Σε ποιο κλιμάκιο βρίσκεται ο μέσος μισθός</h2>
  <p>Σύμφωνα με το Υπουργείο Εργασίας, ο μέσος μισθός του 2025 στο σύστημα ΕΡΓΑΝΗ ήταν {F.avgWage}. Με 14 καταβολές αυτό δίνει φορολογητέο {$(avg.taxableAnnual)}, άρα ο μέσος μισθωτός βρίσκεται στο δεύτερο κλιμάκιο, με οριακό συντελεστή {p(avg.marginal)} και ετήσιο φόρο {$(avg.taxAnnual)} χωρίς παιδιά. Κανένα ευρώ του εισοδήματός του δεν φτάνει στο {F.r[2]}. Γι' αυτό η μείωση του δεύτερου κλιμακίου από {p(SCALE_2025[1].rate)} σε {F.r[1]}, και ακόμη χαμηλότερα με παιδιά, αγγίζει τόσο πολλούς εργαζόμενους, ενώ η κορυφή της κλίμακας δεν άλλαξε.</p>
  <p>Για όποιον διαπραγματεύεται αύξηση, ο οριακός συντελεστής λέει περισσότερα από τον μέσο. Στο ύψος του μέσου μισθού, από κάθε {$(100)} μικτής αύξησης φεύγουν πρώτα οι εισφορές e-ΕΦΚΑ και στο υπόλοιπο ο φόρος του κλιμακίου μαζί με την απώλεια μείωσης φόρου. Στην τσέπη μένουν περίπου {$(keep100)}. Η αναλογία χειροτερεύει όταν το φορολογητέο περάσει τις {F.limits[1]}, γιατί από εκεί και πέρα κάθε επιπλέον ευρώ φορολογείται με {F.r[2]}.</p>

  <h2>Μισθοί, συντάξεις και επιχειρηματικό εισόδημα</h2>
  <p>Η κλίμακα του άρθρου 15 ΚΦΕ είναι κοινή για μισθούς, συντάξεις και κέρδη από επιχειρηματική δραστηριότητα. Η διαφορά βρίσκεται αλλού: τα κέρδη από επιχειρηματική δραστηριότητα δεν παίρνουν τη μείωση φόρου του άρθρου 16 (άρθρο 29 ΚΦΕ). Για πολύ χαμηλά εισοδήματα, η νέα παράγραφος 1Α ορίζει ότι όταν το πραγματικό εισόδημα δεν ξεπερνά τα {$(ART15_1A.real)} και το τεκμαρτό τα {$(ART15_1A.presumed)}, χωρίς επιχειρηματική ή ατομική αγροτική δραστηριότητα, φορολογούνται με την κλίμακα και τη μείωση του άρθρου 16.</p>
  <p>Ορισμένες κατηγορίες μένουν εκτός κλίμακας, όπως οι αξιωματικοί και τα πληρώματα του εμπορικού ναυτικού, που φορολογούνται αυτοτελώς με δικούς τους συντελεστές. Όσοι αναζητούν «φορολογικη κλιμακα 2026» συνήθως θέλουν απλώς να μάθουν πόσο φόρο θα πληρώσουν· για αυτούς η απάντηση είναι ο πίνακας παραπάνω και το μικρό εργαλείο στην αρχή της σελίδας, που χρησιμοποιούν τις ίδιες παραμέτρους με τον βασικό υπολογιστή.</p>
</GuideLayout>
