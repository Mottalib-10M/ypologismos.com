---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { salary, taxCredit, bracketRates, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney } from '../../lib/format';
import { ART11, ART11_SOURCE, SCALE_2025_SOURCE } from '../../lib/mini-extra-b';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const p = F.pct;
const T = P.tax;
const kids = [0, 1, 2, 3, 4, 5, 6];
const wages = [1500, 2000, 3000];
const tax = (g: number, k: number) => salary({ gross: g, children: k }).taxAnnual;
const rows = kids.map((k) => { const r = bracketRates(k); return [String(k), `${p(r[0])} / ${p(r[1])} / ${p(r[2])}`, $(taxCredit(0, k)), ...wages.map((g) => $(tax(g, k)))]; });
// Όφελος κάθε επόμενου παιδιού στα 2.000 € μικτά.
const mid = 2000;
const step = [1, 2, 3, 4, 5].map((k) => tax(mid, k - 1) - tax(mid, k));
const best = step.indexOf(Math.max(...step)) + 1;
const s0 = salary({ gross: mid }), s2 = salary({ gross: mid, children: 2 }), s4 = salary({ gross: mid, children: 4 });
const low = 1200;
const l0 = salary({ gross: low }), l2 = salary({ gross: low, children: 2 });
const hi = 3000;
const h1 = salary({ gross: hi, children: 1 }), h0 = salary({ gross: hi });
const jump = F.dec((T.second_bracket_by_children[2] - T.second_bracket_by_children[3]) * 100, 0);
const h5 = tax(hi, 4) - tax(hi, 5);
const fam3 = salary({ gross: 2500, children: 3 }), fam2 = salary({ gross: 2500, children: 2 });
const ord = ['', 'πρώτο', 'δεύτερο', 'τρίτο', 'τέταρτο', 'πέμπτο'];
const faqs = [
  { q: 'Το παιδί μου σπουδάζει και είναι 22. Μετράει ακόμη για τον φόρο μου;', a: `Ναι, εφόσον είναι άγαμο και φοιτά σε σχολή ή ινστιτούτο επαγγελματικής κατάρτισης, στην Ελλάδα ή στο εξωτερικό. Το άρθρο 11 ΚΦΕ θεωρεί εξαρτώμενα τα παιδιά έως 25 ετών που σπουδάζουν, είναι εγγεγραμμένα στο μητρώο ανέργων ή υπηρετούν τη θητεία τους. Χάνει την ιδιότητα αν το δικό του φορολογητέο εισόδημα ξεπεράσει τα ${$(ART11.incomeLimit)} τον χρόνο και μένει μαζί σας.` },
  { q: 'Ποιο παιδί μειώνει περισσότερο τον φόρο, το δεύτερο ή το τρίτο;', a: `Στους περισσότερους μισθούς, το τρίτο. Με το τρίτο παιδί ο συντελεστής του δεύτερου κλιμακίου πέφτει από ${F.second[2]} σε ${F.second[3]}, ένα άλμα ${jump} μονάδων, και η μείωση φόρου ανεβαίνει από ${F.credit[2]} σε ${F.credit[3]}. Με μικτά ${$(mid)} τον μήνα, το δεύτερο παιδί γλιτώνει ${$(step[1])} τον χρόνο και το τρίτο ${$(step[2])}. Σε αυτόν τον μισθό το τέταρτο, που μηδενίζει τα δύο πρώτα κλιμάκια, φέρνει ακόμη περισσότερα: ${$(step[3])}.` },
  { q: `Με δύο παιδιά και μισθό ${$(low)} πληρώνω καθόλου φόρο;`, a: `Πολύ λίγο ή καθόλου. Με ${$(low)} μικτά σε 14 καταβολές, ο ετήσιος φόρος χωρίς παιδιά είναι ${$(l0.taxAnnual)}, ενώ με δύο παιδιά πέφτει στα ${$(l2.taxAnnual)}. Ο λόγος είναι ότι η μείωση του άρθρου 16 ανεβαίνει στα ${F.credit[2]} και καλύπτει σχεδόν ολόκληρο τον φόρο της κλίμακας, που είναι ήδη μικρότερος επειδή το δεύτερο κλιμάκιο φορολογείται με ${F.second[2]}.` },
  { q: 'Γιατί με πέντε παιδιά η μείωση φόρου δεν μικραίνει όσο ανεβαίνει ο μισθός;', a: `Επειδή το άρθρο 16 εξαιρεί ρητά τους φορολογούμενους με πέντε ή περισσότερα εξαρτώμενα τέκνα από τη σταδιακή μείωση. Για όλους τους άλλους, η μείωση χάνει ${F.creditTaper} για κάθε 1.000 € φορολογητέου πάνω από ${F.creditThreshold}. Με πέντε παιδιά μένει ολόκληρη, ${F.credit[5]}, σε οποιοδήποτε εισόδημα, και αυξάνεται κατά ${F.creditStep} για κάθε επιπλέον παιδί.` },
  { q: `Η μείωση για παιδιά ισχύει και πάνω από ${F.limits[2]} εισόδημα;`, a: `Οι μειωμένοι συντελεστές σταματούν στο τρίτο κλιμάκιο, δηλαδή στα ${F.limits[2]} φορολογητέο. Πάνω από αυτό η κλίμακα είναι ίδια για όλους. Το όφελος όμως δεν χάνεται: όσοι έχουν υψηλότερο εισόδημα κρατούν την έκπτωση στα πρώτα κλιμάκια. Με ${$(hi)} μικτά και ένα παιδί, ο ετήσιος φόρος είναι ${$(h1.taxAnnual)} έναντι ${$(h0.taxAnnual)} χωρίς παιδιά.` },
];
---
<GuideLayout lang={lang} id="children" breadcrumbLabel={label('children', lang)}
  title={`Μείωση φόρου για παιδιά ${F.year}: συντελεστές και έκπτωση`}
  h1={`Μείωση φόρου για παιδιά ${F.year}: πόσα γλιτώνει κάθε τέκνο`}
  description={`Μείωση φόρου για παιδιά ${F.year}: ${F.second[1]} έως ${F.second[3]} στο 2ο κλιμάκιο, μηδέν από 4 παιδιά, μείωση άρθρου 16 από ${F.credit[1]}. Ετήσιος φόρος για 0 έως 6 τέκνα σε τρεις μισθούς.`}
  intro={`Τα εξαρτώμενα τέκνα μειώνουν τον φόρο εισοδήματος με δύο τρόπους: χαμηλότερους συντελεστές στην κλίμακα και μεγαλύτερη μείωση φόρου μισθωτών.`}
  resume={`Από το ${F.year}, κάθε εξαρτώμενο τέκνο κατεβάζει τους συντελεστές του δεύτερου και του τρίτου κλιμακίου. Στο δεύτερο κλιμάκιο (από ${F.limits[0]} έως ${F.limits[1]}) ο συντελεστής γίνεται ${F.second[1]} με ένα παιδί, ${F.second[2]} με δύο και ${F.second[3]} με τρία, και μηδενίζεται μαζί με το πρώτο από το τέταρτο παιδί. Στο τρίτο κλιμάκιο, έως ${F.limits[2]}, πέφτει σε ${F.third[1]}, ${F.third[2]}, ${F.third[3]} και ${F.third[4]}, με επιπλέον ${F.thirdStep} λιγότερο για κάθε παιδί μετά το τέταρτο. Παράλληλα, η μείωση φόρου του άρθρου 16 ανεβαίνει από ${F.credit[0]} σε ${F.credit[1]}, ${F.credit[2]}, ${F.credit[3]}, ${F.credit[4]} και ${F.credit[5]}. Σε μισθό ${$(mid)} μικτά τον μήνα, ο ετήσιος φόρος είναι ${$(s0.taxAnnual)} χωρίς παιδιά, ${$(s2.taxAnnual)} με δύο και ${$(s4.taxAnnual)} με τέσσερα. Το μεγαλύτερο άλμα σε αυτόν τον μισθό το φέρνει το ${ord[best]} παιδί, με ${$(Math.max(...step))} λιγότερο φόρο τον χρόνο. Βάλτε τον μισθό σας και τον αριθμό των παιδιών στο εργαλείο παρακάτω.`}
  faqs={faqs}
  related={[{ href: route('home', lang), name: label('home', lang), description: 'Καθαρά από τον μικτό με τα παιδιά σας.' }, { href: route('brackets', lang), name: label('brackets', lang), description: 'Η πλήρης κλίμακα με τα όρια κάθε κλιμακίου.' }, { href: route('credit', lang), name: label('credit', lang), description: 'Τα ποσά του άρθρου 16 και η σταδιακή μείωσή τους.' }]}
  sources={[src('tax_scale', lang), src('tax_credit', lang), ART11_SOURCE.el, SCALE_2025_SOURCE.el]}>
  <div data-chrome><MiniSim client:load kind="children" lang={lang} href={route('home', lang)} /></div>

  <h2>Ο φόρος από μηδέν έως έξι παιδιά</h2>
  <ContentTable headers={['Τέκνα', 'Συντελεστές 1ου / 2ου / 3ου κλιμακίου', 'Πλήρης μείωση άρθρ. 16', `Φόρος με ${$(wages[0])}`, `Φόρος με ${$(wages[1])}`, `Φόρος με ${$(wages[2])}`]} align={['l', 'l', 'r', 'r', 'r', 'r']} rows={rows} highlightRow={2} />
  <p>Οι στήλες φόρου δίνουν τον ετήσιο φόρο για μηνιαίο μικτό μισθό σε 14 καταβολές, εργαζόμενο άνω των 30 ετών στον ιδιωτικό τομέα. Η στήλη της μείωσης δείχνει το πλήρες ποσό, πριν από τη σταδιακή μείωση που ισχύει πάνω από {F.creditThreshold} φορολογητέο για όσους έχουν έως τέσσερα παιδιά. Στον μισθό των {$(wages[0])}, ήδη με τέσσερα παιδιά ο φόρος μηδενίζεται· στον μισθό των {$(wages[2])}, ακόμη και με έξι παιδιά μένει φόρος, γιατί μεγάλο μέρος του εισοδήματος βρίσκεται στα κλιμάκια πάνω από τα {F.limits[2]}, όπου τα παιδιά δεν αλλάζουν τον συντελεστή.</p>

  <h2>Δύο μηχανισμοί που δουλεύουν μαζί</h2>
  <p>Ο πρώτος μηχανισμός είναι η κλίμακα. Μέχρι το 2025 η κλίμακα ήταν ίδια για όλους και τα παιδιά μετρούσαν μόνο στη μείωση φόρου. Ο ν. 5246/2025 έφερε διαφορετικούς συντελεστές ανά αριθμό τέκνων στο δεύτερο και στο τρίτο κλιμάκιο, δηλαδή στο εισόδημα από {F.limits[0]} έως {F.limits[2]}.</p>
  <p>Ο δεύτερος είναι η μείωση φόρου του άρθρου 16, ένα σταθερό ποσό που αφαιρείται από τον φόρο της κλίμακας. Για χαμηλούς μισθούς αυτό είναι το πιο σημαντικό κομμάτι: όταν ο φόρος της κλίμακας είναι μικρός, η μείωση τον καλύπτει ολόκληρο. Για υψηλότερους μισθούς, η μείωση συρρικνώνεται κατά {F.creditTaper} ανά 1.000 € πάνω από το όριο και το βάρος περνά στους χαμηλότερους συντελεστές. Γι' αυτό δεν υπάρχει ένα ενιαίο «ποσό ανά παιδί»: το όφελος εξαρτάται από το πού πέφτει το εισόδημά σας στην κλίμακα.</p>

  <h2>Το κάθε επόμενο παιδί, σε μισθό {$(mid)}</h2>
  <p>Για έναν γονιό με {$(mid)} μικτά τον μήνα, το πρώτο παιδί μειώνει τον ετήσιο φόρο κατά {$(step[0])}, το δεύτερο κατά {$(step[1])}, το τρίτο κατά {$(step[2])}, το τέταρτο κατά {$(step[3])} και το πέμπτο κατά {$(step[4])}. Το τρίτο ξεχωρίζει επειδή ο συντελεστής του δεύτερου κλιμακίου κατεβαίνει απότομα στο {F.second[3]}, όσο και το πρώτο κλιμάκιο. Το τέταρτο είναι ακόμη πιο ισχυρό: τα δύο πρώτα κλιμάκια μηδενίζονται, οπότε τα πρώτα {F.limits[1]} του εισοδήματος δεν φορολογούνται καθόλου.</p>
  <p>Με τέσσερα παιδιά ο φόρος σε αυτόν τον μισθό είναι {$(s4.taxAnnual)}, οπότε για το πέμπτο δεν μένει σχεδόν τίποτα να μειωθεί. Η εικόνα αλλάζει σε υψηλότερο μισθό: με {$(hi)} μικτά, το πέμπτο παιδί γλιτώνει {$(h5)} τον χρόνο, γιατί εκτός από το {F.thirdStep} λιγότερο στο τρίτο κλιμάκιο καταργεί και τη σταδιακή μείωση της έκπτωσης, που για έναν γονιό με τέσσερα παιδιά σε αυτό το εισόδημα έχει ήδη αρχίσει.</p>

  <div data-chrome><MiniSim client:load kind="kidsstep" lang={lang} href={route('home', lang)} /></div>

  <h2>Ποια παιδιά θεωρούνται εξαρτώμενα</h2>
  <p>Το άρθρο 11 ΚΦΕ ορίζει ποιοι μετρούν. Είναι τα άγαμα παιδιά έως 18 ετών, και τα ενήλικα έως 25 ετών εφόσον σπουδάζουν σε σχολή ή ινστιτούτο κατάρτισης στην Ελλάδα ή στο εξωτερικό, είναι εγγεγραμμένα στο μητρώο ανέργων της ΔΥΠΑ (πρώην ΟΑΕΔ) ή υπηρετούν τη στρατιωτική θητεία. Παιδιά με αναπηρία τουλάχιστον {p(ART11.disability)} μετρούν χωρίς όριο ηλικίας, εφόσον είναι άγαμα, διαζευγμένα ή σε χηρεία.</p>
  <p>Ένα παιδί που δουλεύει μπορεί να πάψει να είναι εξαρτώμενο. Αν μένει μαζί σας και το ετήσιο φορολογητέο εισόδημά του ξεπεράσει τα {$(ART11.incomeLimit)}, δεν μετρά πια για τον δικό σας φόρο. Η διατροφή που καταβάλλεται σε ανήλικο με δικαστική απόφαση ή συμβολαιογραφική πράξη δεν υπολογίζεται σε αυτό το όριο. Ένας φοιτητής με καλοκαιρινή δουλειά θέλει λοιπόν προσοχή: μερικοί μήνες εργασίας αρκούν για να αλλάξει ο φόρος των γονιών.</p>

  <h2>Όταν ένα παιδί παύει να μετρά</h2>
  <p>Η αντίστροφη διαδρομή συχνά ξαφνιάζει. Μια οικογένεια με τρία παιδιά και μισθό {$(2500)} μικτά πληρώνει {$(fam3.taxAnnual)} τον χρόνο. Όταν το μεγαλύτερο παιδί κλείσει τα 25 ή ολοκληρώσει τις σπουδές του και δεν είναι εγγεγραμμένο άνεργο, παύει να θεωρείται εξαρτώμενο, και ο φόρος του γονιού υπολογίζεται πλέον με δύο παιδιά: {$(fam2.taxAnnual)}. Η αύξηση, {$(fam2.taxAnnual - fam3.taxAnnual)} τον χρόνο, οφείλεται κυρίως στο δεύτερο κλιμάκιο, που ανεβαίνει από {F.second[3]} σε {F.second[2]}.</p>
  <p>Αξίζει να το προβλέψετε. Αν ο εργοδότης συνεχίσει να παρακρατεί με τρία παιδιά, η διαφορά θα έρθει ως χρεωστικό στην εκκαθάριση της επόμενης δήλωσης. Ενημερώστε το λογιστήριο όταν αλλάζει ο αριθμός των εξαρτώμενων τέκνων, προς τα πάνω ή προς τα κάτω.</p>

  <h2>Γιατί ο μισθός μου δεν δείχνει τη μείωση</h2>
  <p>Η μισθοδοσία εφαρμόζει τους μειωμένους συντελεστές και τη μεγαλύτερη έκπτωση μόνο αν ο εργοδότης γνωρίζει πόσα παιδιά έχετε. Αν δεν το δηλώσατε στην πρόσληψη ή αν γεννήθηκε παιδί μέσα στη χρονιά, η παρακράτηση συνεχίζει σαν να μην έχετε τέκνα και η διαφορά επιστρέφεται με την ετήσια εκκαθάριση. Ο οδηγός για την <a href={route('withholding', lang)}>παρακράτηση φόρου</a> δείχνει πώς προκύπτει αυτή η διαφορά. Όσοι ψάχνουν «μειωση φορου για παιδια» βρίσκουν συνήθως μόνο τα ποσά του άρθρου 16· στην πράξη η αλλαγή των συντελεστών μετράει εξίσου, και ο <a href={route('home', lang)}>υπολογισμός μισθού</a> λαμβάνει υπόψη και τα δύο.</p>
</GuideLayout>
