---
import ToolCalc from '../../components/calc/ToolCalc';
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { pension, replacementRate, nationalPension, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney, pct } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const $2 = (x: number) => formatMoney(x, 2, lang);
const p = (x: number) => pct(x, lang);
const Q = P.pension;
let lo = 0;
const bands = Q.replacement_rates.map((r) => { const from = lo + 1; const to = r.upTo; lo = r.upTo ?? lo; return [to === null ? `πάνω από ${from - 1}` : `${from} έως ${to}`, p(r.rate), to === null ? '–' : p(replacementRate(to))]; });
const avg = 1300;
const byYears = [15, 20, 25, 30, 35, 40, 43].map((y) => { const r = pension({ years: y, avgEarnings: avg }); return [`${y}`, p(r.rate), $(r.contributory), $2(r.national), $(r.total)]; });
const ex = pension({ years: 35, avgEarnings: avg });
const ex30 = pension({ years: 30, avgEarnings: avg }), ex33 = pension({ years: 33, avgEarnings: avg });
const last = Q.replacement_rates[Q.replacement_rates.length - 1].rate;
const fullBand = Q.replacement_rates[Q.replacement_rates.length - 2];
const faqs = [
  { q: `Έχω 35 χρόνια ένσημα και μέσο μισθό ${$(avg)}. Τι σύνταξη να περιμένω;`, a: `Περίπου ${$(ex.total)} μικτά τον μήνα με τους κανόνες των άρθρων 7 και 8 του ν. 4387/2016. Το ανταποδοτικό μέρος είναι ${p(ex.rate)} του μέσου μισθού, δηλαδή ${$(ex.contributory)}, και η εθνική σύνταξη ${$2(ex.national)}, το τελευταίο πλήρες ποσό που δημοσίευσε το Υπουργείο Εργασίας. Από το μικτό αφαιρούνται ακόμη η εισφορά υγείας και ο φόρος, που ο υπολογιστής δεν αφαιρεί.` },
  { q: 'Γιατί τα έτη από το 31ο ως το 40ό ανεβάζουν τόσο πολύ τη σύνταξη;', a: `Επειδή ο πίνακας 2 του άρθρου 8 δίνει μεγαλύτερο ποσοστό στα τελευταία έτη. Μέχρι τα 15 έτη κάθε χρόνος αξίζει ${p(Q.replacement_rates[0].rate)}, ενώ από το 37ο ως το 40ό αξίζει ${p(fullBand.rate)}. Με μέσο μισθό ${$(avg)}, η μετάβαση από 30 σε 33 έτη προσθέτει ${$(ex33.total - ex30.total)} τον μήνα. Μετά τα 40 έτη κάθε επιπλέον χρόνος δίνει μόνο ${p(last)}.` },
  { q: 'Ο μέσος μισθός σταδιοδρομίας είναι σε σημερινά ευρώ ή στα ποσά της εποχής;', a: `Σε αναπροσαρμοσμένα ποσά. Το άρθρο 8 παράγραφος 4 προβλέπει ότι οι αποδοχές κάθε έτους προσαυξάνονται, έως και το 2026 με τη μεταβολή του δείκτη τιμών καταναλωτή της ΕΛΣΤΑΤ και από το 2027 με τον δείκτη μεταβολής μισθών. Στον υπολογιστή βάζετε λοιπόν έναν μέσο όρο σε σημερινές τιμές. Ο e-ΕΦΚΑ κάνει την αναπροσαρμογή έτος προς έτος από το ιστορικό σας.` },
  { q: 'Μπορεί η σύνταξη να ξεπεράσει τον μισθό μου;', a: `Το ανταποδοτικό μέρος όχι: ο νόμος ορίζει ότι δεν μπορεί να υπερβαίνει τις συντάξιμες αποδοχές, και ο υπολογιστής εφαρμόζει το όριο αυτό. Σε πολύ χαμηλούς μέσους μισθούς όμως η εθνική σύνταξη των ${F.nationalFull} προστίθεται από πάνω, οπότε το σύνολο μπορεί να βγει μεγαλύτερο από τον μέσο μισθό.` },
  { q: 'Ο υπολογιστής δείχνει τη μειωμένη σύνταξη στα 62;', a: `Όχι. Δείχνει την πλήρη σύνταξη. Για τη μειωμένη, ο νόμος κόβει την εθνική σύνταξη κατά 1/200 για κάθε μήνα που λείπει ως το όριο της πλήρους, και το ανταποδοτικό μέρος ακολουθεί τις διατάξεις κάθε ταμείου, που δεν μοντελοποιούμε. Η σελίδα για τα όρια ηλικίας της σύνταξης υπολογίζει την περικοπή της εθνικής σύνταξης μήνα προς μήνα.` },
];
---
<GuideLayout lang={lang} id="pension" breadcrumbLabel={label('pension', lang)}
  title={`Υπολογισμός σύνταξης ${F.year}: εθνική και ανταποδοτική σύνταξη`}
  h1={`Υπολογισμός σύνταξης ${F.year}: εθνική συν ανταποδοτική, με τον πίνακα του ν. 4387/2016`}
  description={`Υπολογισμός σύνταξης ${F.year}: εθνική σύνταξη έως ${F.nationalFull} συν ανταποδοτική με τα ποσοστά του πίνακα 2. Δωρεάν εκτίμηση με έτη ασφάλισης και μέσο μηνιαίο μισθό.`}
  intro={`Ο υπολογιστής προσθέτει την εθνική σύνταξη του άρθρου 7 και το ανταποδοτικό μέρος του άρθρου 8 του ν. 4387/2016.`}
  resume={`Η κύρια σύνταξη γήρατος στην Ελλάδα έχει δύο κομμάτια. Το πρώτο είναι η εθνική σύνταξη, ${F.nationalFull} τον μήνα στο τελευταίο πλήρες ποσό που δημοσίευσε το Υπουργείο Εργασίας (από 1.1.2025), ολόκληρη με ${Q.national_years_full} έτη ασφάλισης και ${Q.residence_years_full} έτη διαμονής, μειωμένη κατά ${p(Q.national_reduction_per_year)} για κάθε έτος που λείπει έως τα ${Q.national_min_years}. Το δεύτερο είναι η ανταποδοτική σύνταξη: ο μέσος μηνιαίος μισθός όλου του ασφαλιστικού βίου επί ένα ποσοστό αναπλήρωσης που μεγαλώνει με τα χρόνια, ${p(replacementRate(15))} στα 15 έτη, ${p(replacementRate(35))} στα 35 και ${p(replacementRate(40))} στα 40. Με μέσο μισθό ${$(avg)} και 35 έτη, η μικτή σύνταξη υπολογίζεται σε ${$(ex.total)}: ${$(ex.contributory)} ανταποδοτική και ${$2(ex.national)} εθνική. Χρειάζονται τουλάχιστον ${F.minYears} έτη ασφάλισης, και η πλήρης σύνταξη δίνεται στα ${F.fullAge}. Τα ποσά είναι μικτά, πριν από την εισφορά υγείας και τον φόρο.`}
  faqs={faqs}
  related={[{ href: route('national', lang), name: label('national', lang), description: 'Πώς μειώνεται η εθνική σύνταξη με λιγότερα έτη ή διαμονή.' }, { href: route('retireage', lang), name: label('retireage', lang), description: 'Πότε βγαίνει κανείς στη σύνταξη και τι κοστίζει η μειωμένη.' }, { href: route('home', lang), name: label('home', lang), description: 'Οι εισφορές του μισθού σας που χτίζουν τη σύνταξη.' }]}
  sources={[src('pension', lang), src('pension_national', lang), src('pension_ministry', lang)]}>
  <div data-outil><ToolCalc client:load kind="pension" lang={lang} methodHref={route('method', lang)} /></div>

  <h2>Πόση σύνταξη δίνουν τα χρόνια ασφάλισης</h2>
  <ContentTable headers={['Έτη', 'Ποσοστό', 'Ανταποδοτική', 'Εθνική', 'Σύνολο']} align={['l', 'r', 'r', 'r', 'r']} rows={byYears} highlightRow={4} />
  <p>Ο πίνακας αφορά μέσο μισθό σταδιοδρομίας {$(avg)} και πλήρη διαμονή στην Ελλάδα. Η εθνική σύνταξη μένει σταθερή από τα 20 έτη και μετά, άρα όλη η αύξηση πέρα από αυτό το σημείο έρχεται από το ανταποδοτικό μέρος. Η απόσταση ανάμεσα στα 30 και στα 40 έτη είναι σχεδόν διπλασιασμός της ανταποδοτικής σύνταξης, ενώ ανάμεσα στα 15 και στα 25 η άνοδος είναι πολύ πιο ήπια.</p>

  <h2>Ο πίνακας 2 των ποσοστών αναπλήρωσης</h2>
  <ContentTable headers={['Κλίμακα ετών', 'Ποσοστό ανά έτος', 'Αθροιστικά στο τέλος της κλίμακας']} align={['l', 'r', 'r']} rows={bands} />
  <p>Από 1η Οκτωβρίου 2019 ισχύει ο πίνακας 2 του άρθρου 8, που αντικατέστησε τον πίνακα 1. Το ποσοστό κάθε έτους εξαρτάται από την κλίμακα στην οποία πέφτει: τα πρώτα 15 έτη μετράνε το καθένα {p(Q.replacement_rates[0].rate)}, τα έτη από το 16ο ως το 18ο λίγο περισσότερο, και ούτω καθεξής. Το συνολικό ποσοστό είναι το άθροισμα όλων των ετών, όπως φαίνεται στην τρίτη στήλη. Πάνω από τα 40 έτη το κάθε έτος προσθέτει μόλις {p(last)}.</p>
  <p>Η λογική του πίνακα είναι ότι η καριέρα ανταμείβεται περισσότερο στο τέλος. Για κάποιον που σκέφτεται να σταματήσει στα 33 έτη αντί για 36, η διαφορά δεν είναι τρία «μέσα» έτη αλλά τρία από τα πιο ακριβά της κλίμακας.</p>

  <h2>Τι είναι οι συντάξιμες αποδοχές</h2>
  <p>Ως βάση λαμβάνεται ο μέσος όρος των μηνιαίων αποδοχών πάνω στις οποίες πληρώθηκαν εισφορές σε όλο τον ασφαλιστικό βίο: το σύνολο των αποδοχών διαιρείται με τον συνολικό χρόνο ασφάλισης. Οι αποδοχές κάθε έτους δεν μπαίνουν με την ονομαστική τους αξία· προσαυξάνονται έως και το 2026 με τη μεταβολή του γενικού δείκτη τιμών καταναλωτή και από το 2027 με τον δείκτη μεταβολής μισθών της ΕΛΣΤΑΤ. Γι' αυτό στον υπολογιστή ζητάμε έναν μέσο όρο σε σημερινά ευρώ.</p>
  <p>Για υπαλλήλους του Δημοσίου και στρατιωτικούς, ο μέσος όρος υπολογίζεται από το 2002 και μετά, όπως ορίζει η παράγραφος 3 του ίδιου άρθρου. Η σελίδα για τη <a href={route('uniformed', lang)}>σύνταξη των ενστόλων</a> εξηγεί τι σημαίνει αυτό και τι δεν καλύπτουμε.</p>

  <div data-chrome><MiniSim client:load kind="national" lang={lang} href={route('national', lang)} /></div>

  <h2>Η εθνική σύνταξη μέσα στον λογαριασμό</h2>
  <p>Η εθνική σύνταξη δεν χρηματοδοτείται από εισφορές αλλά από τον κρατικό προϋπολογισμό. Το πλήρες ποσό από 1.1.2025 είναι {F.nationalFull}, όπως το δημοσιεύει το Υπουργείο Εργασίας· αναπροσαρμόζεται κάθε χρόνο, οπότε το ποσό του {F.year} μπορεί να είναι λίγο μεγαλύτερο. Με 15 έτη ασφάλισης πέφτει στα {F.national15}. Με λιγότερα από {Q.residence_years_full} έτη διαμονής ανάμεσα στο 15ο έτος της ηλικίας και το όριο συνταξιοδότησης χάνεται 1/40 για κάθε έτος που λείπει: με 30 έτη διαμονής και 20 ασφάλισης, η εθνική σύνταξη είναι {$2(nationalPension(20, 30))}. Ο υπολογιστής δέχεται τα έτη διαμονής στο τρίτο πεδίο.</p>

  <h2>Τι δεν κάνει ο υπολογιστής</h2>
  <p>Η εκτίμηση αφορά πλήρη σύνταξη γήρατος. Δεν υπολογίζει τη μειωμένη σύνταξη των 62 ετών, τις συντάξεις αναπηρίας και χηρείας, την επικουρική σύνταξη ή το εφάπαξ, ούτε τις ειδικές προϋποθέσεις όσων ασφαλίστηκαν πριν από το 1993. Δεν αφαιρεί την εισφορά υγείας ούτε τον φόρο. Χρησιμοποιεί το ποσό εθνικής σύνταξης του 2025 και έναν ενιαίο μέσο μισθό, ενώ ο e-ΕΦΚΑ δουλεύει με το πραγματικό ιστορικό αποδοχών σας. Για μια επίσημη εκτίμηση, συγκρίνετε το αποτέλεσμα με το ασφαλιστικό σας βιογραφικό.</p>
  <p>Αυτό που κάνει καλά είναι να δείχνει πώς αλλάζει η σύνταξη αν δουλέψετε περισσότερα χρόνια ή αν ο μέσος μισθός σας είναι υψηλότερος. Όσοι αναζητούν «υπολογισμος συνταξης» για να αποφασίσουν πότε να σταματήσουν, μπορούν να δοκιμάσουν δύο-τρία σενάρια ετών και να δουν πόσα ευρώ τον μήνα κρίνονται. Για τις εισφορές που χτίζουν σήμερα τον μέσο μισθό του αύριο, δείτε τον <a href={route('home', lang)}>υπολογισμό μισθού</a>.</p>
</GuideLayout>
