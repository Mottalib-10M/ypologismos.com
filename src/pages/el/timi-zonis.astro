---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { enfia, enfiaBasicRate, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney } from '../../lib/format';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const $2 = (x: number) => formatMoney(x, 2, lang);
const E = P.enfia;
const Y = P.year;
const B = E.zone_bands;
// Διαμέρισμα αναφοράς: 80 m², άδεια 2000, 2ος όροφος, μία πρόσοψη (όπως ο μίνι υπολογιστής).
const ref = (z: number) => enfia({ sqm: 80, zonePrice: z, buildYear: 2000, floor: 'f2_3', facades: 1 });
const rows = B.map((b, i) => { const from = i === 0 ? 1 : (B[i - 1].upTo as number) + 1; const mid = b.upTo === null ? from + 500 : Math.round((from + b.upTo) / 2); const x = ref(mid); return [`${i + 1}η`, b.upTo === null ? `${$(from)} και πάνω` : `${$(from)} – ${$(b.upTo)}`, $2(b.rate), $(mid), $(x.estimatedValue), $(x.total)]; });
const edges = B.slice(0, -1).map((b, i) => { const u = b.upTo as number; const lo = ref(u), hi = ref(u + 1); return [`${$(u)} → ${$(u + 1)}`, `${$2(b.rate)} → ${$2(B[i + 1].rate)}`, $(hi.mainBuilding - lo.mainBuilding), $(hi.total - lo.total)]; });
const same1 = ref((B[1].upTo as number) + 1), same2 = ref(B[2].upTo as number);
const z5 = ref(B[3].upTo as number), z6 = ref((B[3].upTo as number) + 1);
const nA = ref(2950), nB = ref(3050);
const faqs = [
  { q: 'Τι ακριβώς είναι η τιμή ζώνης ενός ακινήτου;', a: `Είναι η τιμή εκκίνησης ανά τετραγωνικό που έχει οριστεί από το κράτος για κάθε ζώνη ή οικοδομικό τετράγωνο, με αποφάσεις του Υπουργού Εθνικής Οικονομίας και Οικονομικών (άρθρο 4 του Κώδικα Φορολογίας Περιουσίας). Από αυτήν ξεκινά ο υπολογισμός της αντικειμενικής αξίας, και με βάση αυτήν το κτίσμα κατατάσσεται σε μία από τις ${B.length} φορολογικές ζώνες του ΕΝΦΙΑ, με βασικό φόρο από ${$2(B[0].rate)} έως ${$2(B[B.length - 1].rate)} το τετραγωνικό.` },
  { q: 'Πού βρίσκω την τιμή ζώνης του σπιτιού μου;', a: `Η ΑΑΔΕ έχει εφαρμογή χαρτών με τις ζώνες των αντικειμενικών αξιών στη διεύθυνση maps.gsis.gr/valuemaps, όπου εντοπίζετε τον δρόμο σας. Βοηθά να έχετε μπροστά σας τη διεύθυνση και τα στοιχεία του ακινήτου όπως είναι δηλωμένα στο Ε9. Οι ίδιες τιμές περιέχονται στους πίνακες των υπουργικών αποφάσεων που τις καθορίζουν. Για τον ΕΝΦΙΑ μετράει η τιμή που ίσχυε την 1η Ιανουαρίου του έτους.` },
  { q: 'Είναι η τιμή ζώνης το ίδιο με την αντικειμενική αξία;', a: `Όχι. Η τιμή ζώνης είναι η αφετηρία· η αντικειμενική αξία προκύπτει αφού η τιμή αυτή αυξηθεί ή μειωθεί με συντελεστές για την παλαιότητα, τον όροφο, την πρόσοψη και άλλα στοιχεία, και πολλαπλασιαστεί με τα τετραγωνικά. Ένα διαμέρισμα 80 m² σε ζώνη ${$(2000)} δεν αξίζει απαραίτητα ${$(160000)} για την εφορία. Ο υπολογιστής μας χρησιμοποιεί το απλό γινόμενο ως εκτίμηση.` },
  { q: 'Αν η τιμή ζώνης αλλάξει μέσα στο έτος, ποια μετράει για τον ΕΝΦΙΑ;', a: `Αυτή που ίσχυε την 1η Ιανουαρίου του έτους φορολογίας, όπως ορίζει το άρθρο 11. Μια αναπροσαρμογή που δημοσιεύεται τον Μάιο, για παράδειγμα, δεν αλλάζει τον ΕΝΦΙΑ της ίδιας χρονιάς, αλλά της επόμενης. Το ίδιο ισχύει για την ιδιοκτησία: ο φόρος βαραίνει όποιον είχε το ακίνητο την 1η Ιανουαρίου, ανεξάρτητα από αγοραπωλησίες μέσα στη χρονιά.` },
  { q: 'Το χωριό μου δεν έχει τιμή ζώνης. Πώς φορολογείται το σπίτι;', a: `Το άρθρο 11 ορίζει ότι κτίσματα για τα οποία δεν έχει καθοριστεί τιμή ζώνης εντάσσονται στην κατώτερη τιμή ζώνης της δημοτικής ενότητας όπου βρίσκονται. Αν η δημοτική ενότητα δεν έχει καμία, λαμβάνεται η κατώτερη του δήμου, μετά της περιφερειακής ενότητας και τέλος της περιφέρειας. Η κατώτερη τιμή καθορίζει μετά τη φορολογική ζώνη, όπως για κάθε άλλο κτίσμα.` },
  { q: `Πόσο ακριβαίνει ο ΕΝΦΙΑ αν η τιμή ζώνης περάσει από ${$(B[3].upTo as number)} σε ${$(B[3].upTo as number + 1)};`, a: `Περισσότερο από κάθε άλλο όριο: ο βασικός φόρος πηδά από ${$2(B[3].rate)} σε ${$2(B[4].rate)} το τετραγωνικό. Για ένα διαμέρισμα 80 m² με άδεια του 2000 στον 2ο όροφο, ο ΕΝΦΙΑ περνά από ${$(z5.total)} σε ${$(z6.total)} τον χρόνο, για ένα ευρώ διαφορά στην τιμή ζώνης. Γι' αυτό μια αναπροσαρμογή που περνά ένα όριο φαίνεται αμέσως στο εκκαθαριστικό.` },
];
---
<GuideLayout lang={lang} id="zone" breadcrumbLabel={label('zone', lang)}
  title={`Τιμή ζώνης ${Y}: οι ${B.length} ζώνες του ΕΝΦΙΑ και πού τη βρίσκετε`}
  h1={`Τιμή ζώνης: τι είναι και πόσο κοστίζει στον ΕΝΦΙΑ`}
  description={`Τιμή ζώνης ${Y}: πώς κατατάσσει το ακίνητο σε μία από τις ${B.length} φορολογικές ζώνες του ΕΝΦΙΑ, βασικός φόρος ${$2(B[0].rate)} έως ${$2(B[B.length - 1].rate)}/m², πού τη βρίσκετε, τα άλματα.`}
  intro={`Ένας αριθμός ανά τετραγωνικό, ορισμένος για κάθε δρόμο, αποφασίζει σε ποια από τις εννέα φορολογικές ζώνες μπαίνει το σπίτι σας.`}
  resume={`Η τιμή ζώνης είναι η τιμή εκκίνησης ανά τετραγωνικό που ορίζει το κράτος για κάθε ζώνη ή οικοδομικό τετράγωνο, με αποφάσεις του Υπουργού Εθνικής Οικονομίας και Οικονομικών, και αποτελεί τη βάση του συστήματος αντικειμενικών αξιών. Για τον ΕΝΦΙΑ ${Y}, η τιμή που ίσχυε την 1η Ιανουαρίου κατατάσσει κάθε κτίσμα σε μία από ${B.length} φορολογικές ζώνες: έως ${$(B[0].upTo as number)} ο βασικός φόρος είναι ${$2(B[0].rate)} το τετραγωνικό, από ${$(B[1].upTo as number + 1)} έως ${$(B[2].upTo as number)} είναι ${$2(B[2].rate)}, και από ${$(B[7].upTo as number + 1)} και πάνω ${$2(B[8].rate)}. Μέσα σε μια ζώνη, η ακριβής τιμή δεν αλλάζει τον βασικό φόρο: ένα σπίτι με τιμή ζώνης ${$(B[1].upTo as number + 1)} πληρώνει τον ίδιο κύριο φόρο με ένα στα ${$(B[2].upTo as number)}. Αλλάζει όμως την αξία του ακινήτου, άρα και τη μείωση λόγω αξίας. Την τιμή ζώνης του δρόμου σας τη βρίσκετε στην εφαρμογή χαρτών της ΑΑΔΕ. Ο μίνι υπολογιστής δείχνει τη ζώνη και τον φόρο για τη δική σας τιμή.`}
  faqs={faqs}
  related={[{ href: route('enfia', lang), name: label('enfia', lang), description: 'Ο πλήρης υπολογισμός με τιμή ζώνης, όροφο και παλαιότητα.' }, { href: route('enfiadisc', lang), name: label('enfiadisc', lang), description: 'Πώς η αξία που βγαίνει από την τιμή ζώνης καθορίζει τη μείωση.' }, { href: route('enfiavillage', lang), name: label('enfiavillage', lang), description: 'Οι χαμηλές τιμές ζώνης των χωριών και η μείωση του 2026.' }]}
  sources={[src('enfia', lang), { name: 'Κώδικας Φορολογίας Περιουσίας (ν. 5219/2025), άρθρο 4: τιμές εκκίνησης κατά ζώνες και συντελεστές', url: 'https://www.taxheaven.gr/law/5219/2025/article/4/view' }, { name: 'ΑΑΔΕ: χάρτες ζωνών τιμών αντικειμενικών αξιών ακινήτων', url: 'https://maps.gsis.gr/valuemaps/' }, src('enfia_reductions', lang)]}>
  <div data-chrome><MiniSim client:load kind="zone" lang={lang} href={route('enfia', lang)} /></div>

  <h2>Από την τιμή ζώνης στη φορολογική ζώνη</h2>
  <ContentTable headers={['Φ.Ζ.', 'Τιμή ζώνης', 'Βασικός φόρος/m²', 'Παράδειγμα τιμής', 'Αξία 80 m²', 'ΕΝΦΙΑ 80 m²']} align={['l', 'l', 'r', 'r', 'r', 'r']} rows={rows} highlightRow={2} />
  <p>Για κάθε ζώνη ο πίνακας παίρνει μια τιμή στη μέση του διαστήματος και υπολογίζει τον ΕΝΦΙΑ ενός διαμερίσματος 80 m² στον 2ο όροφο, με μία πρόσοψη και άδεια του 2000, χωρίς άλλα ακίνητα. Η στήλη της αξίας είναι το απλό γινόμενο τετραγωνικά × τιμή ζώνης· από αυτήν κρίνεται η μείωση, γι' αυτό ο τελικός φόρος δεν ανεβαίνει με τον ίδιο ρυθμό που ανεβαίνει ο βασικός φόρος.</p>
  <p>Η κατάταξη είναι κλιμακωτή με τον πιο απλό τρόπο. Δεν υπάρχει αναλογία μέσα στη ζώνη: ένα διαμέρισμα 80 m² με τιμή ζώνης {$(B[1].upTo as number + 1)} και ένα με {$(B[2].upTo as number)} έχουν τον ίδιο κύριο φόρο, {$(same1.mainBuilding)}. Η διαφορά τους εμφανίζεται μόνο στην αξία, {$(same1.estimatedValue)} έναντι {$(same2.estimatedValue)}, και από εκεί στο ποσοστό μείωσης: {F.pct(same1.valueReductionRate)} έναντι {F.pct(same2.valueReductionRate)}.</p>

  <h2>Τα όρια όπου ο φόρος πηδά</h2>
  <ContentTable headers={['Τιμή ζώνης', 'Βασικός φόρος/m²', 'Επιπλέον κύριος φόρος 80 m²', 'Επιπλέον ΕΝΦΙΑ μετά τις μειώσεις']} align={['l', 'l', 'r', 'r']} rows={edges} highlightRow={3} />
  <p>Για τον κύριο φόρο, ένα ευρώ στην τιμή ζώνης κοστίζει είτε μηδέν είτε ένα άλμα. Τα άλματα στις χαμηλές ζώνες είναι μέτρια. Το μεγάλο βρίσκεται στο πέρασμα από την 4η στην 5η ζώνη, όπου ο βασικός φόρος σχεδόν διπλασιάζεται. Στο τελευταίο όριο, των {$(B[7].upTo as number)}, το άλμα στην τελευταία στήλη είναι ακόμη μεγαλύτερο από εκείνο του κύριου φόρου: για 80 m² η αξία περνά ταυτόχρονα τις {$(E.value_reductions[E.value_reductions.length - 1].upTo)} και χάνεται κάθε μείωση λόγω αξίας.</p>
  <p>Όταν το κράτος αναπροσαρμόζει τις τιμές ζώνης, όσοι βρίσκονται λίγο κάτω από ένα όριο είναι εκείνοι που βλέπουν τη μεγαλύτερη αλλαγή. Αν η τιμή του δρόμου σας είναι, ας πούμε, {$(2950)}, αξίζει να ξέρετε ότι μια μικρή αύξηση θα σας περάσει στη ζώνη με βασικό φόρο {$2(enfiaBasicRate(3001).rate)}.</p>

  <h2>Δύο γειτονικοί δρόμοι, δύο λογαριασμοί</h2>
  <p>Πάρτε δύο ίδια διαμερίσματα 80 m², στον 2ο όροφο, με άδεια του 2000. Το πρώτο βρίσκεται σε δρόμο με τιμή ζώνης {$(2950)}, το δεύτερο στον παράλληλο με {$(3050)}. Η αξία τους διαφέρει μόλις {F.pct(nB.estimatedValue / nA.estimatedValue - 1)}, {$(nA.estimatedValue)} έναντι {$(nB.estimatedValue)}. Ο ΕΝΦΙΑ τους όμως είναι {$(nA.total)} και {$(nB.total)}: το δεύτερο πληρώνει {F.pct(nB.total / nA.total - 1)} περισσότερο, μόνο επειδή ο δρόμος του ανήκει στην 5η φορολογική ζώνη.</p>
  <p>Η διαφορά αυτή δεν φαίνεται στις αγγελίες ούτε στις τιμές πώλησης. Όποιος αγοράζει σπίτι σε περιοχή όπου οι τιμές ζώνης κινούνται γύρω από ένα όριο καλό είναι να ελέγξει τη ζώνη του συγκεκριμένου οικοδομικού τετραγώνου πριν υπογράψει, αφού θα πληρώνει αυτόν τον φόρο κάθε χρόνο. Το ίδιο ισχύει για τα επαγγελματικά ακίνητα, που φορολογούνται με την ίδια κλίμακα κτισμάτων.</p>

  <h2>Πού βρίσκετε την τιμή ζώνης σας</h2>
  <p>Η ΑΑΔΕ διαθέτει εφαρμογή χαρτών με τίτλο «Ζώνες τιμών αντικειμενικών αξιών ακινήτων», στη διεύθυνση maps.gsis.gr/valuemaps. Εντοπίζετε τον δρόμο ή το οικοδομικό τετράγωνο και βλέπετε τη ζώνη και την τιμή της. Οι τιμές αυτές προέρχονται από τις υπουργικές αποφάσεις που προβλέπει το άρθρο 4, οι οποίες καταχωρίζουν τις τιμές εκκίνησης σε πίνακες και τις συσχετίζουν με διαγράμματα και χάρτες.</p>
  <p>Βοηθά να έχετε μπροστά σας το Ε9, όπου είναι δηλωμένα η διεύθυνση, τα τετραγωνικά, ο όροφος και το έτος άδειας κάθε ακινήτου. Αν το ακίνητο βρίσκεται σε γωνία ή σε δρόμο που χωρίζει δύο ζώνες, ελέγξτε σε ποια πλευρά ανήκει το οικοδομικό σας τετράγωνο, γιατί οι δύο πλευρές ενός δρόμου μπορεί να έχουν διαφορετική τιμή.</p>
  <p>Μόλις βρείτε την τιμή, περάστε τη στον μίνι υπολογιστή στην αρχή της σελίδας μαζί με τα τετραγωνικά σας: θα δείτε σε ποια φορολογική ζώνη πέφτει το ακίνητο, τον βασικό φόρο ανά τετραγωνικό και μια πρώτη εκτίμηση του ΕΝΦΙΑ. Αν η τιμή σας βρίσκεται λίγα ευρώ κάτω ή πάνω από ένα όριο του πίνακα, δοκιμάστε και τις δύο πλευρές του ορίου, για να δείτε τι θα σήμαινε μια αναπροσαρμογή. Ο πλήρης υπολογιστής προσθέτει μετά την παλαιότητα, τον όροφο, τις προσόψεις και τις μειώσεις.</p>

  <div data-chrome><MiniSim client:load kind="enfiaage" lang={lang} href={route('enfia', lang)} /></div>

  <h2>Όταν δεν υπάρχει τιμή ζώνης</h2>
  <p>Σε ορισμένες περιοχές, εντός ή εκτός σχεδίου, δεν έχει οριστεί τιμή ζώνης. Ο νόμος δεν τα αφήνει αφορολόγητα: το κτίσμα εντάσσεται στην κατώτερη τιμή ζώνης της δημοτικής ενότητας. Αν εκεί δεν υπάρχει καμία, ανεβαίνουμε στον δήμο, μετά στην περιφερειακή ενότητα και στο τέλος στην περιφέρεια. Τον ίδιο κανόνα ακολουθούν τα ειδικά κτήρια που ορίζει ο νόμος, ανάμεσά τους και κτίσματα αγροτικής χρήσης, τα οποία έχουν και δικούς τους συντελεστές. Ο κανόνας γράφεται στο ίδιο το άρθρο 11, αμέσως μετά τον πίνακα των φορολογικών ζωνών, και εφαρμόζεται κατά τον υπολογισμό του φόρου. Στον υπολογιστή, βάλτε σε αυτή την περίπτωση την κατώτερη τιμή ζώνης της δημοτικής σας ενότητας, όπως φαίνεται στους χάρτες της ΑΑΔΕ.</p>

  <h2>Τιμή ζώνης, αντικειμενική αξία και εμπορική τιμή</h2>
  <p>Τρεις αριθμοί μπερδεύονται συχνά. Η τιμή ζώνης είναι η αφετηρία, ίδια για όλα τα ακίνητα της ζώνης. Η αντικειμενική αξία ενός συγκεκριμένου διαμερίσματος προκύπτει από την τιμή ζώνης, αυξημένη ή μειωμένη με συντελεστές για την ποιότητα κατασκευής, την παλαιότητα, τη θέση στον όροφο και άλλους παράγοντες, όπως ορίζει το άρθρο 4. Η εμπορική τιμή είναι αυτό που πληρώνει ένας αγοραστής και δεν παίζει κανέναν ρόλο στον ΕΝΦΙΑ.</p>
  <p>Ο ΕΝΦΙΑ χρησιμοποιεί την τιμή ζώνης με δύο τρόπους. Για τον κύριο φόρο, μόνο για να διαλέξει τη φορολογική ζώνη· οι δικοί του συντελεστές παλαιότητας, ορόφου και πρόσοψης, που φαίνονται στον <a href={route('enfia', lang)}>υπολογιστή ΕΝΦΙΑ</a>, είναι άλλοι από εκείνους της αντικειμενικής αξίας. Για τις μειώσεις και την προσαύξηση, μέσω της συνολικής αξίας της περιουσίας, που υπολογίζεται με το σύστημα των αντικειμενικών αξιών. Ο οδηγός για την <a href={route('enfiadisc', lang)}>έκπτωση ΕΝΦΙΑ</a> δείχνει τα κλιμάκια αυτής της αξίας.</p>
  <p>Για τα οικόπεδα ισχύει άλλη κλίμακα. Το άρθρο 11 κατατάσσει το οικόπεδο σε μία από 19 ζώνες με βάση τη μοναδιαία αξία του, όχι την τιμή ζώνης των κτισμάτων, και ο υπολογιστής μας δεν το υπολογίζει. Αν θέλετε να δείτε τι μένει από τον μισθό σας για να πληρώσετε τον φόρο, ο <a href={route('home', lang)}>υπολογισμός μισθού</a> κάνει τον λογαριασμό. Όσοι ψάχνουν «τιμη ζωνης» ή «timi zonis» για αγοραπωλησία να ξέρουν ότι το δικαίωμα προσφυγής του άρθρου 4, όταν η προκαθορισμένη αξία είναι μεγαλύτερη από την αγοραία, αφορά τις μεταβιβάσεις και ασκείται μέσα σε 30 ημέρες από τη δήλωση.</p>
</GuideLayout>
