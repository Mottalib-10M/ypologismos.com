---
import MiniSim from '../../components/calc/MiniSim';
import GuideLayout from '../../components/GuideLayout.astro';
import ContentTable from '../../components/ContentTable.astro';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { facts, src } from '../../lib/facts';
import { salary, incomeTax, PARAMS as P } from '../../lib/engine/gr';
import { formatMoney } from '../../lib/format';
import { ART60, ART60_SOURCE } from '../../lib/mini-extra-b';
const lang = 'el';
const F = facts(lang);
const $ = (x: number) => formatMoney(x, 0, lang);
const $2 = (x: number) => formatMoney(x, 2, lang);
const p = F.pct;
const grosses = [P.minimum_wage.monthly, 1200, 1500, 1800, 2200, 2800, 3500, 5000];
const rows = grosses.map((g) => { const s = salary({ gross: g }), k = salary({ gross: g, children: 2 }); return [$(g), $(s.taxableAnnual), $(s.taxAnnual), $2(s.tax), p(Math.round(s.averageTax * 1000) / 1000), $2(k.tax)]; });
// Παράδειγμα ετησιοποίησης.
const g = 1600;
const s = salary({ gross: g });
// Περίπτωση 1: δύο εργοδότες.
const a = salary({ gross: 1200 }), b = salary({ gross: 700 });
const both = incomeTax(a.taxableAnnual + b.taxableAnnual).tax;
const due = both - a.taxAnnual - b.taxAnnual;
// Περίπτωση 2: παιδιά που δεν δηλώθηκαν στον εργοδότη.
const kg = 1800;
const k0 = salary({ gross: kg }), k2 = salary({ gross: kg, children: 2 });
// Περίπτωση 3: εργασία μόνο το μισό έτος (απλοποίηση: οι μισές καταβολές του έτους).
const hg = 1500;
const h = salary({ gross: hg });
const halfPayments = 7;
const halfWithheld = h.tax * halfPayments;
const halfReal = incomeTax(h.taxable * halfPayments).tax;
const r0 = salary({ gross: 1800 }), r1 = salary({ gross: 2000 });
const t12 = salary({ gross: 1500 * 14 / 12, payments: 12 }), t14 = salary({ gross: 1500 });
// Αναδρομικά και πρόσθετες αμοιβές.
const extra = 1000;
const faqs = [
  { q: 'Τι σημαίνει ΦΜΥ στο εκκαθαριστικό της μισθοδοσίας;', a: `ΦΜΥ είναι ο φόρος μισθωτών υπηρεσιών, δηλαδή ο φόρος εισοδήματος που παρακρατεί ο εργοδότης σε κάθε πληρωμή. Δεν είναι ξεχωριστός φόρος: είναι προκαταβολή του ετήσιου φόρου, υπολογισμένη με την κλίμακα και τη μείωση του άρθρου 16. Με μικτά ${$(g)} σε 14 καταβολές, ο ΦΜΥ είναι ${$2(s.tax)} ανά καταβολή και ${$(s.taxAnnual)} τον χρόνο.` },
  { q: 'Δουλεύω σε δύο εργοδότες. Γιατί πρέπει να πληρώσω φόρο στη δήλωση;', a: `Επειδή κάθε εργοδότης παρακρατεί σαν να είναι ο μόνος σας μισθός: εφαρμόζει από την αρχή τα χαμηλά κλιμάκια και ολόκληρη τη μείωση φόρου. Με ${$(1200)} και ${$(700)} μικτά, οι δύο παρακρατούν μαζί ${$(a.taxAnnual + b.taxAnnual)} τον χρόνο, ενώ ο φόρος για το συνολικό εισόδημα είναι ${$(both)}. Η διαφορά, ${$(due)}, βεβαιώνεται με την εκκαθάριση της δήλωσης.` },
  { q: 'Παρακρατείται φόρος από αναδρομικά ή από ένα έκτακτο μπόνους;', a: `Το άρθρο 60 παρ. 4 ΚΦΕ ορίζει παρακράτηση ${p(ART60.extra)} στα αναδρομικά και στις πρόσθετες αμοιβές που δεν περιλαμβάνονται στις τακτικές αποδοχές. Για ένα έκτακτο ποσό ${$(extra)}, ο εργοδότης κρατά ${$(extra * ART60.extra)}. Η παρακράτηση αυτή δεν είναι ο τελικός φόρος: το ποσό προστίθεται στο εισόδημα της δήλωσης και ο φόρος ξαναϋπολογίζεται με την κλίμακα.` },
  { q: 'Ξεκίνησα δουλειά τον Ιούλιο. Θα πάρω πίσω φόρο;', a: `Κατά πάσα πιθανότητα ναι. Η μισθοδοσία αναγάγει τον μηνιαίο μισθό σε ετήσιο σαν να δουλεύατε όλο τον χρόνο. Με μικτά ${$(hg)} και περίπου ${halfPayments} καταβολές στο εξάμηνο (μισθοί και αναλογία δώρων), παρακρατούνται περίπου ${$(halfWithheld)}, ενώ ο φόρος για το πραγματικό εισόδημα είναι ${$(halfReal)}. Τη διαφορά σας την επιστρέφει η εκκαθάριση της δήλωσης.` },
  { q: 'Πόσο γρήγορα αποδίδει ο εργοδότης τον φόρο που μου κρατά;', a: `Το άρθρο 60 παρ. 5 ΚΦΕ ορίζει ότι ο φόρος που παρακρατήθηκε αποδίδεται στο Δημόσιο το αργότερο μέχρι το τέλος του ${ART60.remitMonths === 2 ? 'δεύτερου' : String(ART60.remitMonths) + 'ου'} μήνα από την πληρωμή του μισθού. Η απόδοση είναι υποχρέωση του εργοδότη που έκανε την παρακράτηση· για εσάς, ο φόρος θεωρείται πληρωμένος από τη στιγμή που κρατήθηκε από τον μισθό σας και συμψηφίζεται με τον φόρο της δήλωσης.` },
];
---
<GuideLayout lang={lang} id="withholding" breadcrumbLabel={label('withholding', lang)}
  title={`ΦΜΥ ${F.year}: παρακράτηση φόρου μισθωτών και αναγωγή σε ετήσιο`}
  h1={`ΦΜΥ ${F.year}: πώς υπολογίζεται η παρακράτηση φόρου στον μισθό`}
  description={`ΦΜΥ ${F.year}: πώς η μισθοδοσία αναγάγει τον μισθό σε ετήσιο (άρθρο 60 ΚΦΕ), πίνακας παρακράτησης ανά μισθό και γιατί η εκκαθάριση βγάζει χρεωστικό ή επιστροφή.`}
  intro={`Ο φόρος μισθωτών υπηρεσιών (ΦΜΥ) είναι η προκαταβολή του φόρου εισοδήματος που κρατά ο εργοδότης σε κάθε μισθοδοσία.`}
  resume={`Ο ΦΜΥ, ο φόρος που παρακρατεί ο εργοδότης από κάθε μισθό, υπολογίζεται σύμφωνα με το άρθρο 60 ΚΦΕ: ο μηνιαίος μισθός αναγάγεται σε ετήσιο, εφαρμόζονται η κλίμακα του άρθρου 15 και η μείωση φόρου του άρθρου 16, και ο ετήσιος φόρος μοιράζεται στις καταβολές. Με 14 καταβολές, ένας μισθός ${$(g)} μικτά δίνει ${$(s.annualGross)} τον χρόνο, ${$(s.taxableAnnual)} φορολογητέο μετά τις εισφορές e-ΕΦΚΑ, ετήσιο φόρο ${$(s.taxAnnual)} και ΦΜΥ ${$2(s.tax)} ανά καταβολή. Ο ΦΜΥ είναι προκαταβολή: ο οριστικός φόρος βγαίνει με την ετήσια δήλωση. Όταν έχετε δύο εργοδότες, παιδιά που δεν δηλώσατε στη μισθοδοσία ή δουλέψατε μόνο μέρος του έτους, η παρακράτηση αποκλίνει από τον τελικό φόρο, άλλοτε προς τα πάνω και άλλοτε προς τα κάτω. Για αναδρομικά και πρόσθετες αμοιβές εκτός τακτικών αποδοχών ο νόμος ορίζει παρακράτηση ${p(ART60.extra)}. Βάλτε τον μισθό σας στο εργαλείο για να δείτε τον δικό σας ΦΜΥ.`}
  faqs={faqs}
  related={[{ href: route('home', lang), name: label('home', lang), description: 'Καθαρά, εισφορές και ΦΜΥ για κάθε μισθό.' }, { href: route('brackets', lang), name: label('brackets', lang), description: 'Η κλίμακα που χρησιμοποιεί η μισθοδοσία.' }, { href: route('credit', lang), name: label('credit', lang), description: 'Η μείωση που αφαιρείται πριν από την παρακράτηση.' }]}
  sources={[ART60_SOURCE.el, src('tax_scale', lang), src('tax_credit', lang), src('efka_rates', lang), src('min_wage', lang)]}>
  <div data-chrome><MiniSim client:load kind="withholding" lang={lang} href={route('home', lang)} /></div>

  <h2>Η αναγωγή σε ετήσιο, με αριθμούς</h2>
  <p>Το άρθρο 60 παρ. 1 ΚΦΕ λέει ότι το μηνιαίο εισόδημα από μισθωτή εργασία, μαζί με παροχές σε είδος, ημερομίσθια και εφάπαξ παροχές, υπόκειται σε παρακράτηση με βάση την κλίμακα και τη μείωση φόρου «μετά από προηγούμενη αναγωγή του σε ετήσιο». Ο τρόπος της αναγωγής ορίζεται με απόφαση του Υπουργού Οικονομικών, όπως προβλέπει η παρ. 3 του ίδιου άρθρου.</p>
  <p>Για έναν υπάλληλο με {$(g)} μικτά, η μισθοδοσία κάνει τέσσερα βήματα. Πολλαπλασιάζει τον μισθό επί 14, γιατί στο έτος περιλαμβάνονται τα δύο δώρα και το επίδομα αδείας: {$(s.annualGross)}. Αφαιρεί τις εισφορές του εργαζομένου, {$(s.efkaAnnual)}, και βρίσκει φορολογητέο {$(s.taxableAnnual)}. Εφαρμόζει την κλίμακα, που βγάζει {$(s.scaleAnnual)}, και αφαιρεί τη μείωση του άρθρου 16, {$(s.creditAnnual)}. Ο ετήσιος φόρος, {$(s.taxAnnual)}, διαιρείται με 14 και κάθε καταβολή έχει ΦΜΥ {$2(s.tax)}.</p>

  <h2>Ο ΦΜΥ για οκτώ μισθούς</h2>
  <ContentTable headers={['Μικτά τον μήνα', 'Ετήσιο φορολογητέο', 'Ετήσιος φόρος', 'ΦΜΥ ανά καταβολή', 'Μέσος συντελεστής', 'ΦΜΥ με 2 παιδιά']} align={['l', 'r', 'r', 'r', 'r', 'r']} rows={rows} highlightRow={2} />
  <p>Ο πίνακας αφορά εργαζόμενο άνω των 30 ετών στον ιδιωτικό τομέα, με 14 καταβολές. Η τελευταία στήλη δείχνει πόσο αλλάζει η παρακράτηση όταν ο εργοδότης γνωρίζει ότι υπάρχουν δύο εξαρτώμενα τέκνα: στους χαμηλούς μισθούς ο ΦΜΥ σχεδόν εξαφανίζεται. Ο μέσος συντελεστής είναι ο ετήσιος φόρος ως ποσοστό του φορολογητέου, όχι του μικτού.</p>

  <h2>Γιατί η παρακράτηση δεν συμπίπτει με τον τελικό φόρο</h2>
  <p>Ο εργοδότης βλέπει μόνο τον μισθό που πληρώνει ο ίδιος, και τον βλέπει τη στιγμή που τον πληρώνει. Δεν ξέρει αν έχετε δεύτερη δουλειά, ενοίκια ή μπλοκάκι, και υποθέτει ότι ο σημερινός μισθός θα ισχύει όλο τον χρόνο. Τρεις καταστάσεις δημιουργούν τις μεγαλύτερες αποκλίσεις, και καμία δεν σημαίνει λάθος της μισθοδοσίας.</p>
  <p><strong>Δύο εργοδότες ταυτόχρονα.</strong> Κάθε εργοδότης αρχίζει την κλίμακα από το {F.r[0]} και αφαιρεί ολόκληρη τη μείωση φόρου. Με {$(1200)} στον έναν και {$(700)} στον άλλον, ο πρώτος παρακρατεί {$(a.taxAnnual)} τον χρόνο και ο δεύτερος {$(b.taxAnnual)}, γιατί ο μικρός μισθός μόνος του καλύπτεται από τη μείωση. Στη δήλωση όμως τα δύο εισοδήματα αθροίζονται, η μείωση μετρά μία φορά και ο φόρος είναι {$(both)}. Χρεωστικό εκκαθαριστικό: {$(due)}.</p>
  <p><strong>Παιδιά που δεν δηλώθηκαν.</strong> Αν ο εργοδότης δεν γνωρίζει τα εξαρτώμενα τέκνα σας, εφαρμόζει την κλίμακα και τη μείωση χωρίς παιδιά. Με {$(kg)} μικτά και δύο παιδιά, παρακρατούνται {$(k0.taxAnnual)} τον χρόνο αντί για {$(k2.taxAnnual)}: {$(k0.taxAnnual - k2.taxAnnual)} επιστρέφονται με την εκκαθάριση, αλλά μήνες αργότερα. Η λύση είναι απλή: δηλώστε τα τέκνα στο λογιστήριο, ιδίως μετά από γέννηση.</p>
  <p><strong>Μέρος του έτους.</strong> Όποιος ξεκινά ή σταματά να εργάζεται μέσα στη χρονιά παρακρατείται σαν να είχε τον ίδιο μισθό δώδεκα μήνες. Με {$(hg)} μικτά για ένα εξάμηνο, δηλαδή περίπου {halfPayments} καταβολές με τα αναλογικά δώρα, παρακρατούνται περίπου {$(halfWithheld)}, ενώ ο φόρος για το πραγματικό εισόδημα είναι {$(halfReal)}. Η διαφορά επιστρέφεται με τη δήλωση.</p>

  <div data-chrome><MiniSim client:load kind="twojobs" lang={lang} href={route('home', lang)} /></div>

  <h2>Αύξηση μέσα στη χρονιά</h2>
  <p>Όταν αλλάζει ο μισθός, αλλάζει και η αναγωγή. Ένας υπάλληλος που περνά από {$(1800)} σε {$(2000)} μικτά βλέπει τον ΦΜΥ να ανεβαίνει από {$2(r0.tax)} σε {$2(r1.tax)} ανά καταβολή, γιατί η μισθοδοσία υπολογίζει πλέον σαν να έπαιρνε τον νέο μισθό όλο τον χρόνο. Οι μήνες πριν από την αύξηση έχουν παρακρατηθεί με τον παλιό υπολογισμό, οι επόμενοι με τον νέο, και το άθροισμα βρίσκεται συνήθως κοντά στον τελικό φόρο. Η μικρή διαφορά που μένει τακτοποιείται στην εκκαθάριση.</p>
  <p>Το ίδιο ισχύει όταν αλλάζουν τα δεδομένα της οικογένειας. Ένα παιδί που γεννιέται μέσα στη χρονιά μετρά στη μισθοδοσία μόνο από τη στιγμή που θα το δηλώσετε στο λογιστήριο· μέχρι τότε η παρακράτηση γίνεται σαν να μην υπήρχε.</p>

  <h2>Δώδεκα ή δεκατέσσερις καταβολές</h2>
  <p>Ορισμένες συμβάσεις ορίζουν τις ετήσιες αποδοχές σε 12 ίσες δόσεις. Ο ετήσιος φόρος δεν αλλάζει, αλλάζει μόνο το πώς μοιράζεται. Για ετήσιες αποδοχές {$(1500 * 14)}, με 14 καταβολές ο ΦΜΥ είναι {$2(t14.tax)} ανά πληρωμή· με 12 είναι {$2(t12.tax)}, σε μεγαλύτερο μηνιαίο μισθό. Ο οδηγός για τους <a href={route('fourteen', lang)}>14 μισθούς</a> δείχνει πώς να συγκρίνετε δύο τέτοιες προσφορές.</p>

  <h2>Ειδικοί συντελεστές του άρθρου 60</h2>
  <p>Δύο περιπτώσεις δεν ακολουθούν την αναγωγή σε ετήσιο. Στα αναδρομικά και στις πρόσθετες αμοιβές που δεν ανήκουν στις τακτικές αποδοχές, ο εργοδότης παρακρατεί σταθερό {p(ART60.extra)}, ανεξάρτητα από το έτος στο οποίο ανάγονται. Στις καθαρές αμοιβές ημερομισθίων που απασχολούνται ορισμένου χρόνου για λιγότερο από ένα έτος, η παρακράτηση είναι {p(ART60.shortDaily)}. Και στις δύο περιπτώσεις πρόκειται για προκαταβολή, που συμψηφίζεται με τον φόρο της δήλωσης.</p>
  <p>Τα δώρα εορτών και το επίδομα αδείας είναι τακτικές αποδοχές που οφείλονται κάθε χρόνο. Στον υπολογισμό μας, όπως και στα παραδείγματα καθαρών που δημοσίευσε το Υπουργείο Εργασίας για τον κατώτατο μισθό, μετρούν μέσα στις 14 καταβολές της αναγωγής, και ο ετήσιος φόρος μοιράζεται ισόποσα σε όλες.</p>

  <h2>Πώς να ελέγξετε το εκκαθαριστικό σας</h2>
  <p>Πάρτε τον μικτό μισθό, πολλαπλασιάστε επί 14 και αφαιρέστε τις εισφορές ({F.efkaEe} για τον ιδιωτικό τομέα). Βρείτε τον φόρο του αποτελέσματος με την <a href={route('brackets', lang)}>φορολογική κλίμακα</a>, αφαιρέστε τη <a href={route('credit', lang)}>μείωση φόρου μισθωτών</a> και διαιρέστε με 14. Αν η διαφορά από τον ΦΜΥ του εκκαθαριστικού είναι πάνω από λίγα ευρώ, ρωτήστε αν η μισθοδοσία έχει σωστά στοιχεία για παιδιά και ηλικία. Όσοι γράφουν «ΦΜΥ υπολογισμός» ή «φορος μισθωτων υπηρεσιων» στην αναζήτηση μπορούν να κάνουν τον ίδιο έλεγχο σε δευτερόλεπτα με τον <a href={route('home', lang)}>υπολογισμό μισθού</a>.</p>
</GuideLayout>
